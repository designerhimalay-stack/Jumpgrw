---
import GridRules from "@/components/GridRules.astro";
import SectionHead from "@/components/SectionHead.astro";
import TechLogo from "@/components/TechLogo.astro";
import Joints from "@/components/process/Joints.astro";
import type { TechLogoSlug } from "@/lib/tech-logos";

/* A model router. Column 1: the incoming request and a three-way switch
   for what to optimise (native radio buttons, so it works by keyboard and
   without a script). Column 2: the router, its routes fanning out to every
   provider. Columns 3–4: the providers, each by its logo with price,
   latency and eval score. The best provider for the chosen priority takes
   the route: its line lights and draws itself again each time the switch
   moves, its row lights and the winning figure is marked. A strip along
   the foot names the orchestration, retrieval and self-hosting tools. All
   CSS (:has); nothing moves. See docs/sections.md. */

type Priority = "quality" | "latency" | "cost";

interface Model {
  slug: TechLogoSlug;
  provider: string;
  note: string;
  /** USD per million tokens. */
  cost: number;
  /** Seconds, p50. */
  latency: number;
  /** Eval score out of 100. */
  quality: number;
}

interface Props {
  id: string;
  eyebrow: string;
  headline: string[];
  accent?: number;
  lede: string;
  request: { label: string; text: string; meta: string };
  priorities: { value: Priority; label: string }[];
  models: Model[];
  tools: { label: string; items: { slug: TechLogoSlug; name: string }[] }[];
  footnote: string;
}

const { id, eyebrow, headline, accent, lede, request, priorities, models, tools, footnote } = Astro.props;

const best: Record<Priority, number> = {
  quality: models.reduce((b, m, i) => (m.quality > models[b].quality ? i : b), 0),
  latency: models.reduce((b, m, i) => (m.latency < models[b].latency ? i : b), 0),
  cost: models.reduce((b, m, i) => (m.cost < models[b].cost ? i : b), 0),
};
const winsFor = (i: number) => (Object.keys(best) as Priority[]).filter((p) => best[p] === i).join(" ");

/* The fan: from the hub at the left middle to each row's centre on the
   right. Drawn here for a typical desktop column; the script redraws it at
   the column's real size, so the curves never stretch. */
const n = models.length;
const W = 300;
const H = n * 78;
const route = (i: number, w = W, h = H) => {
  const y = ((i + 0.5) / n) * h;
  return `M0 ${h / 2} C ${w * 0.55} ${h / 2}, ${w * 0.45} ${y}, ${w} ${y}`;
};
const money = (v: number) => `$${v.toFixed(2)}`;
const name = `ac-route-${id}`;
---

<section data-ac-sec="light" data-ac-router id={id}>
  <GridRules />

  <div data-ac-sec-container>
    <SectionHead eyebrow={eyebrow} headline={headline} accent={accent} lede={lede} />

    <div data-ac-sec-frame data-ac-router-frame style={`--ac-rows:${n}`}>
      <Joints />

      <div data-ac-router-control data-ac-sec-rise>
        <div data-ac-router-request>
          <p class="mono-label">{request.label}</p>
          <p data-ac-router-ask>“{request.text}”</p>
          <p class="mono-label-sm">{request.meta}</p>
        </div>

        <fieldset data-ac-router-switch>
          <legend class="mono-label">Route by</legend>
          <div>
            {priorities.map((p, i) => (
              <label>
                <input type="radio" name={name} value={p.value} checked={i === 0} />
                <span>{p.label}</span>
              </label>
            ))}
          </div>
        </fieldset>

        <p data-ac-router-result aria-live="polite">
          <span class="mono-label-sm">Routed to</span>
          <span data-ac-router-picks>
            {priorities.map((p) => (
              <span data-pick={p.value}>{models[best[p.value]].provider}</span>
            ))}
          </span>
        </p>
      </div>

      <div data-ac-router-fan aria-hidden="true">
        <svg viewBox={`0 0 ${W} ${H}`} preserveAspectRatio="none">
          {models.map((_, i) => (
            <path data-ac-router-path data-i={i} data-wins={winsFor(i) || undefined} d={route(i)} pathLength="1" />
          ))}
        </svg>
        <span data-ac-router-hub>
          <i />
          <span class="mono-label-sm">Router</span>
        </span>
      </div>

      <div data-ac-router-table>
        <p data-ac-router-heads class="mono-label-sm" aria-hidden="true">
          <span>Provider</span>
          <span data-metric="cost">Price / 1M</span>
          <span data-metric="latency">Latency</span>
          <span data-metric="quality">Eval score</span>
        </p>
        <ul data-ac-router-models>
          {models.map((m, i) => (
            <li data-ac-router-model data-wins={winsFor(i) || undefined} style={`--ac-i:${i}`}>
              <span data-ac-router-logo data-dark={m.slug === "huggingface" || undefined}>
                <TechLogo slug={m.slug} size={26} tone="brand" />
              </span>
              <span data-ac-router-name>
                <span>{m.provider}</span>
                <span data-ac-router-note>{m.note}</span>
              </span>
              <span data-metric="cost" data-best={best.cost === i || undefined}>
                <span class="sr-only">Cost per million tokens:</span>
                {money(m.cost)}
              </span>
              <span data-metric="latency" data-best={best.latency === i || undefined}>
                <span class="sr-only">Latency:</span>
                {m.latency.toFixed(1)} s
              </span>
              <span data-metric="quality" data-best={best.quality === i || undefined}>
                <span class="sr-only">Eval score:</span>
                {m.quality}
              </span>
            </li>
          ))}
        </ul>
      </div>

      <div data-ac-router-tools>
        {tools.map((group) => (
          <div data-ac-router-group>
            <span class="mono-label-sm">{group.label}</span>
            <ul>
              {group.items.map((t) => (
                <li>
                  <TechLogo slug={t.slug} size={22} tone={t.slug === "huggingface" ? "ink" : "brand"} />
                  {t.name}
                </li>
              ))}
            </ul>
          </div>
        ))}
        <p data-ac-router-foot class="mono-label-sm">{footnote}</p>
      </div>
    </div>
  </div>
</section>

<script>
  import { toggleInView } from "@/lib/in-view";

  document.querySelectorAll<HTMLElement>("[data-ac-router]").forEach((section) => {
    toggleInView(section);

    /* Redraw the fan at the column's real size. */
    const svg = section.querySelector<SVGSVGElement>("[data-ac-router-fan] svg")!;
    const paths = Array.from(svg.querySelectorAll<SVGPathElement>("[data-ac-router-path]"));
    const fit = () => {
      const { width: w, height: h } = svg.getBoundingClientRect();
      if (!w || !h) return;
      svg.setAttribute("viewBox", `0 0 ${w} ${h}`);
      paths.forEach((p, i) => {
        const y = ((i + 0.5) / paths.length) * h;
        p.setAttribute("d", `M0 ${h / 2} C ${w * 0.55} ${h / 2}, ${w * 0.45} ${y}, ${w} ${y}`);
      });
    };
    fit();
    new ResizeObserver(fit).observe(svg);
  });
</script>
