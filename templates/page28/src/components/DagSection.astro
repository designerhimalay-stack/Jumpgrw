---
import GridRules from "@/components/GridRules.astro";
import SectionHead from "@/components/SectionHead.astro";
import TechLogo from "@/components/TechLogo.astro";
import Joints from "@/components/process/Joints.astro";

/* The DAG, on the dark tone. Columns 1–3: one night's pipeline as a graph,
   stage by stage (extract, validate, transform, load, publish), its edges
   drawn behind the task boxes. Each task waits on everything upstream, then
   goes queued → running → success; one extract fails on its first try, sits
   up for retry, and passes on the second. Edges light as their task
   finishes. Column 4: the run itself: the DAG's name and schedule, a run
   clock, the count of tasks in each state, the retry note, and a button to
   run it again. The run plays when the section arrives and resets when it
   leaves. States share one grid cell and figures are tabular, so nothing
   moves. Without the script, or under reduced motion, the finished run
   shows. Phones turn the graph to run top to bottom. See docs/sections.md. */

interface Task {
  id: string;
  stage: number;
  /** Seconds of animation the task runs for. */
  dur: number;
  /** Fails this many seconds into its first try, then retries. */
  failAfter?: number;
  after: string[];
}

interface Props {
  id: string;
  eyebrow: string;
  headline: string[];
  accent?: number;
  lede: string;
  stages: string[];
  tasks: Task[];
  dag: string;
  schedule: string;
  /** The run's length in real seconds, shown on the clock. */
  runtime: number;
  labels: { queued: string; running: string; retry: string; success: string };
  retryNote: string;
  replay: string;
  footnote: string;
}

const { id, eyebrow, headline, accent, lede, stages, tasks, dag, schedule, runtime, labels, retryNote, replay, footnote } =
  Astro.props;

/* Schedule: each task starts once everything upstream has finished. */
const GAP = 0.25;
const RETRY_WAIT = 0.8;
const timing = new Map<string, { start: number; fail?: number; restart?: number; end: number }>();
for (const t of tasks) {
  const start = Math.max(0.4, ...t.after.map((a) => timing.get(a)!.end + GAP));
  if (t.failAfter) {
    const fail = start + t.failAfter;
    const restart = fail + RETRY_WAIT;
    timing.set(t.id, { start, fail, restart, end: restart + t.dur });
  } else {
    timing.set(t.id, { start, end: start + t.dur });
  }
}
const total = Math.max(...[...timing.values()].map((v) => v.end));

/* Positions, in % of the plot: across on wide screens, down on phones. */
const S = stages.length;
const NODE_W = 15;
const STEP = (100 - NODE_W) / (S - 1);
const pos = new Map<string, { x: number; y: number; px: number; py: number }>();
stages.forEach((_, s) => {
  const inStage = tasks.filter((t) => t.stage === s);
  inStage.forEach((t, k) => {
    const off = k - (inStage.length - 1) / 2;
    pos.set(t.id, {
      x: s * STEP + NODE_W / 2,
      y: 50 + off * (inStage.length > 2 ? 33 : 34),
      px: 50 + off * (inStage.length > 2 ? 33.5 : 34),
      py: ((s + 0.5) / S) * 100,
    });
  });
});

const edges = tasks.flatMap((t) => t.after.map((from) => ({ from, to: t.id })));
const across = (a: { x: number; y: number }, b: { x: number; y: number }) => {
  const mx = (a.x + b.x) / 2;
  return `M${a.x} ${a.y} C${mx} ${a.y} ${mx} ${b.y} ${b.x} ${b.y}`;
};
const down = (a: { px: number; py: number }, b: { px: number; py: number }) => {
  const my = (a.py + b.py) / 2;
  return `M${a.px} ${a.py} C${a.px} ${my} ${b.px} ${my} ${b.px} ${b.py}`;
};
const clock = (s: number) => `${String(Math.floor(s / 60)).padStart(2, "0")}:${String(Math.round(s % 60)).padStart(2, "0")}`;
const retried = tasks.filter((t) => t.failAfter).length;
---

<section data-ac-sec="dark" data-ac-dag id={id}>
  <GridRules />

  <div data-ac-sec-container>
    <SectionHead eyebrow={eyebrow} headline={headline} accent={accent} lede={lede} />

    <div data-ac-sec-frame data-ac-dag-frame data-total={total.toFixed(2)} data-runtime={runtime}>
      <Joints />

      <figure data-ac-dag-graph aria-label={`${dag}: ${tasks.length} tasks across ${S} stages, run in dependency order.`}>
        <ol data-ac-dag-stages aria-hidden="true">
          {stages.map((s, i) => (
            <li class="mono-label-sm" style={`--x:${i * STEP + NODE_W / 2}`}>
              <b>{String(i + 1).padStart(2, "0")}</b> {s}
            </li>
          ))}
        </ol>

        <div data-ac-dag-plot>
          <svg data-ac-dag-edges="across" viewBox="0 0 100 100" preserveAspectRatio="none" aria-hidden="true">
            {edges.map((e) => <path d={across(pos.get(e.from)!, pos.get(e.to)!)} data-from={e.from} data-to={e.to} data-done />)}
          </svg>
          <svg data-ac-dag-edges="down" viewBox="0 0 100 100" preserveAspectRatio="none" aria-hidden="true">
            {edges.map((e) => <path d={down(pos.get(e.from)!, pos.get(e.to)!)} data-from={e.from} data-to={e.to} data-done />)}
          </svg>

          <ul data-ac-dag-nodes>
            {tasks.map((t) => {
              const p = pos.get(t.id)!;
              const tm = timing.get(t.id)!;
              return (
                <li
                  data-ac-dag-node
                  data-task={t.id}
                  data-state="success"
                  data-start={tm.start.toFixed(2)}
                  data-fail={tm.fail?.toFixed(2)}
                  data-restart={tm.restart?.toFixed(2)}
                  data-end={tm.end.toFixed(2)}
                  data-retried={t.failAfter ? "" : undefined}
                  style={`--x:${p.x};--y:${p.y};--px:${p.px};--py:${p.py}`}
                >
                  <i aria-hidden="true" />
                  <span data-ac-dag-name>{t.id}</span>
                  <span data-ac-dag-state>
                    <span data-s="queued">{labels.queued}</span>
                    <span data-s="running">{labels.running}</span>
                    <span data-s="retry">{labels.retry}</span>
                    <span data-s="success">{t.failAfter ? `${labels.success} · try 2` : labels.success}</span>
                  </span>
                </li>
              );
            })}
          </ul>
        </div>
      </figure>

      <aside data-ac-dag-run>
        <header data-ac-dag-id>
          <span data-ac-dag-logo><TechLogo slug="apacheairflow" size={22} tone="white" label /></span>
          <span>
            <b>{dag}</b>
            <span class="mono-label-sm">{schedule}</span>
          </span>
        </header>

        <p data-ac-dag-clock>
          <span class="mono-label-sm">Run time</span>
          <b data-read="clock">{clock(runtime)}</b>
        </p>

        <dl data-ac-dag-counts aria-live="polite">
          <div data-s="success"><dt class="mono-label-sm">{labels.success}</dt><dd data-read="success">{tasks.length}</dd></div>
          <div data-s="running"><dt class="mono-label-sm">{labels.running}</dt><dd data-read="running">0</dd></div>
          <div data-s="queued"><dt class="mono-label-sm">{labels.queued}</dt><dd data-read="queued">0</dd></div>
          <div data-s="retry"><dt class="mono-label-sm">Retried</dt><dd data-read="retried">{retried}</dd></div>
        </dl>

        <p data-ac-dag-note data-on>{retryNote}</p>

        <div data-ac-dag-foot>
          <button type="button" data-ac-dag-replay>
            {replay}
            <svg width="14" height="14" viewBox="0 0 16 16" aria-hidden="true"><path d="M13 8a5 5 0 1 1-1.6-3.7M13 2.5v2.8h-2.8" fill="none" stroke="currentColor" stroke-width="1.6" /></svg>
          </button>
          <span class="mono-label-sm">{footnote}</span>
        </div>
      </aside>
    </div>
  </div>
</section>

<script>
  document.querySelectorAll<HTMLElement>("[data-ac-dag]").forEach((section) => {
    const frame = section.querySelector<HTMLElement>("[data-ac-dag-frame]")!;
    const nodes = [...section.querySelectorAll<HTMLElement>("[data-ac-dag-node]")];
    const paths = [...section.querySelectorAll<SVGPathElement>("[data-ac-dag-edges] path")];
    const note = section.querySelector<HTMLElement>("[data-ac-dag-note]")!;
    const replay = section.querySelector<HTMLButtonElement>("[data-ac-dag-replay]")!;
    const read = (k: string) => section.querySelector<HTMLElement>(`[data-read="${k}"]`)!;
    const total = Number(frame.dataset.total);
    const runtime = Number(frame.dataset.runtime);
    const reduced = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
    const num = (el: HTMLElement, k: string) => (el.dataset[k] ? Number(el.dataset[k]) : NaN);
    let raf = 0;

    const stateAt = (el: HTMLElement, t: number) => {
      const start = num(el, "start");
      const fail = num(el, "fail");
      const restart = num(el, "restart");
      const end = num(el, "end");
      if (t < start) return "queued";
      if (t >= end) return "success";
      if (!Number.isNaN(fail) && t >= fail && t < restart) return "retry";
      return "running";
    };

    const clock = (s: number) =>
      `${String(Math.floor(s / 60)).padStart(2, "0")}:${String(Math.floor(s % 60)).padStart(2, "0")}`;

    const paint = (t: number) => {
      const states = new Map<string, string>();
      const counts: Record<string, number> = { queued: 0, running: 0, retry: 0, success: 0 };
      let retried = 0;
      nodes.forEach((el) => {
        const s = stateAt(el, t);
        states.set(el.dataset.task!, s);
        el.dataset.state = s;
        counts[s === "retry" ? "running" : s] += 1;
        if (el.hasAttribute("data-retried") && t >= num(el, "fail")) retried += 1;
      });
      paths.forEach((p) => {
        const from = states.get(p.dataset.from!);
        const to = states.get(p.dataset.to!);
        p.toggleAttribute("data-done", from === "success");
        p.toggleAttribute("data-flow", from === "success" && to === "running");
      });
      read("success").textContent = String(counts.success);
      read("running").textContent = String(counts.running);
      read("queued").textContent = String(counts.queued);
      read("retried").textContent = String(retried);
      read("clock").textContent = clock(Math.min(t / total, 1) * runtime);
      note.toggleAttribute("data-on", retried > 0);
    };

    const play = () => {
      cancelAnimationFrame(raf);
      if (reduced) return paint(total);
      const t0 = performance.now();
      const tick = (now: number) => {
        const t = (now - t0) / 1000;
        paint(Math.min(t, total));
        if (t < total) raf = requestAnimationFrame(tick);
      };
      raf = requestAnimationFrame(tick);
    };

    replay.addEventListener("click", play);

    new IntersectionObserver(
      ([entry]) => {
        section.toggleAttribute("data-ac-in", entry.isIntersecting);
        if (entry.isIntersecting) play();
        else if (!reduced) {
          cancelAnimationFrame(raf);
          paint(0);
        }
      },
      { threshold: 0, rootMargin: "-10% 0px -10% 0px" },
    ).observe(section);
  });
</script>
