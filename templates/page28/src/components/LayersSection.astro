---
import GridRules from "@/components/GridRules.astro";
import SectionHead from "@/components/SectionHead.astro";
import Joints from "@/components/process/Joints.astro";
import type { SectionPhoto } from "@/types/page";

/* Bronze, silver, gold. The header splits around a photo of the team.
   Under it, one frame in three layers, read left to right: bronze (column
   1) holds the raw rows as they landed, every problem cell marked and the
   duplicate struck through; silver (columns 2–3) the same orders trimmed,
   typed, deduplicated and joined to their region, with the row that could
   not be fixed held back; gold (column 4) the business number, summed by
   region, its bars growing. What each step did is named on the layer's
   edge. The marks, rows and bars arrive in turn with the section, and
   reverse when it leaves. On phones the three layers become tabs (native
   radio buttons, so they work by keyboard and without a script), all
   three sharing one grid cell. See docs/sections.md. */

type Cell = string | { t: string; issue: true };

interface Props {
  id: string;
  eyebrow: string;
  headline: string[];
  accent?: number;
  lede: string;
  media: SectionPhoto;
  bronze: { title: string; note: string; rows: { cells: Cell[]; dup?: boolean }[]; foot: string };
  silver: { title: string; note: string; steps: string; cols: string[]; rows: string[][]; held: string; foot: string };
  gold: {
    title: string;
    note: string;
    steps: string;
    metric: string;
    total: string;
    rows: { label: string; count: string; value: string; share: number }[];
    foot: string;
  };
}

const { id, eyebrow, headline, accent, lede, media, bronze, silver, gold } = Astro.props;
const LAYERS = ["bronze", "silver", "gold"] as const;
const titles = { bronze: bronze.title, silver: silver.title, gold: gold.title };
---

<section data-ac-sec="light" data-ac-layers id={id}>
  <GridRules />

  <div data-ac-sec-container>
    <SectionHead eyebrow={eyebrow} headline={headline} accent={accent} lede={lede} media={media} />

    <div data-ac-sec-frame data-ac-layers-frame>
      <Joints />

      <fieldset data-ac-layers-tabs>
        <legend class="sr-only">Layer to show</legend>
        {LAYERS.map((l, i) => (
          <label data-layer={l}>
            <input type="radio" name={`${id}-layer`} value={l} checked={i === 0} />
            <i aria-hidden="true" />
            {titles[l]}
          </label>
        ))}
      </fieldset>

      <div data-ac-layers-panels>
        <article data-ac-layer="bronze" aria-label={bronze.title}>
          <header data-ac-layer-head>
            <p><i aria-hidden="true" />{bronze.title}</p>
            <span class="mono-label-sm">{bronze.note}</span>
          </header>
          <ol data-ac-layer-raw>
            {bronze.rows.map((r, i) => (
              <li data-dup={r.dup || undefined} style={`--ac-i:${i}`}>
                {r.cells.map((c, k) => (
                  <>
                    {k > 0 && <span data-sep>,</span>}
                    {typeof c === "string" ? <span>{c}</span> : <mark>{c.t}</mark>}
                  </>
                ))}
              </li>
            ))}
          </ol>
          <p class="mono-label-sm" data-ac-layer-foot>{bronze.foot}</p>
        </article>

        <article data-ac-layer="silver" aria-label={silver.title}>
          <header data-ac-layer-head>
            <p><i aria-hidden="true" />{silver.title}</p>
            <span class="mono-label-sm">{silver.note}</span>
          </header>
          <p data-ac-layer-steps><span>{silver.steps}</span></p>
          <table data-ac-layer-table>
            <thead>
              <tr>{silver.cols.map((c) => <th class="mono-label-sm" scope="col">{c}</th>)}</tr>
            </thead>
            <tbody>
              {silver.rows.map((r, i) => (
                <tr style={`--ac-i:${i}`}>{r.map((c) => <td>{c}</td>)}</tr>
              ))}
            </tbody>
          </table>
          <p data-ac-layer-held>{silver.held}</p>
          <p class="mono-label-sm" data-ac-layer-foot>{silver.foot}</p>
        </article>

        <article data-ac-layer="gold" aria-label={gold.title}>
          <header data-ac-layer-head>
            <p><i aria-hidden="true" />{gold.title}</p>
            <span class="mono-label-sm">{gold.note}</span>
          </header>
          <p data-ac-layer-steps><span>{gold.steps}</span></p>
          <p data-ac-layer-total>
            <span class="mono-label-sm">{gold.metric}</span>
            <b>{gold.total}</b>
          </p>
          <ul data-ac-layer-sums>
            {gold.rows.map((r, i) => (
              <li style={`--ac-v:${r.share};--ac-i:${i}`}>
                <span>{r.label}</span>
                <span class="mono-label-sm">{r.count}</span>
                <b>{r.value}</b>
                <span data-bar aria-hidden="true"><i /></span>
              </li>
            ))}
          </ul>
          <p class="mono-label-sm" data-ac-layer-foot>{gold.foot}</p>
        </article>
      </div>
    </div>
  </div>
</section>

<script>
  import { toggleInView } from "@/lib/in-view";

  document.querySelectorAll<HTMLElement>("[data-ac-layers]").forEach(toggleInView);
</script>
