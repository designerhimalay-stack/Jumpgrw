---
import { Image } from "astro:assets";
import GridRules from "@/components/GridRules.astro";
import SectionHead from "@/components/SectionHead.astro";
import TechLogo from "@/components/TechLogo.astro";
import Joints from "@/components/process/Joints.astro";
import type { TechLogoSlug } from "@/lib/tech-logos";
import type { SectionPhoto } from "@/types/page";

/* The platform as a flow diagram. Data moves left to right through four
   stages (ingest, store, process, serve); each tool is a node whose height is
   its share of the volume, and soft bands join the nodes, as wide as the
   flow between them. The tools that schedule and run it all sit on a rail
   under the flow. Column 1 holds the team's photo and a readout: hover,
   focus or tap a tool and its bands light, the rest fade, and the readout
   says what it does and where its data comes from and goes. The geometry is
   worked out here from `links`, so tools and volumes can be changed in
   index.astro. The bands draw in stage by stage with the section, and
   reverse when it leaves. Phones: the stages stack and the flow runs top to
   bottom, each stage's name set over the bands that run into it. See
   docs/sections.md. */

interface Tool {
  slug: TechLogoSlug;
  name: string;
  /** A shorter name for the node, where the full one is long. */
  short?: string;
  /** What the tool does here: a few words, shown in the readout. */
  note: string;
  /** Light marks that need the ink tone. */
  ink?: boolean;
}

interface RailTool extends Tool {
  /** The stages (0-based) the tool schedules or runs. */
  touches: number[];
}

interface Props {
  id: string;
  eyebrow: string;
  headline: string[];
  accent?: number;
  lede: string;
  media: SectionPhoto;
  stages: { name: string; tools: Tool[] }[];
  /** [from slug, to slug, volume], between neighbouring stages only. */
  links: [TechLogoSlug, TechLogoSlug, number][];
  rail: { label: string; groups: { name: string; tools: RailTool[] }[] };
  readout: { title: string; hint: string; also: string; from: string; to: string; touches: string };
}

const { id, eyebrow, headline, accent, lede, media, stages, links, rail, readout } = Astro.props;

const pad = (v: number) => String(v).padStart(2, "0");
const f = (v: number) => Math.round(v * 100) / 100;

/* Each node's stage, its in and out volume, and its value (the larger). */
const stageOf = new Map<string, number>();
const toolOf = new Map<string, Tool>();
stages.forEach((s, i) => s.tools.forEach((t) => (stageOf.set(t.slug, i), toolOf.set(t.slug, t))));
const sum = (pick: (l: [string, string, number]) => string, slug: string) =>
  links.filter((l) => pick(l) === slug).reduce((n, l) => n + l[2], 0);
const valueOf = (slug: string) => Math.max(sum((l) => l[0], slug), sum((l) => l[1], slug), 1);

/* Desktop: each stage column is 1000 units tall; nodes share one scale, a
   fixed gap between them, and each stage is centred. */
const H = 1000;
const GAP = 30;
const totals = stages.map((s) => s.tools.reduce((n, t) => n + valueOf(t.slug), 0));
const maxN = Math.max(...stages.map((s) => s.tools.length));
const unit = Math.min(
  ...stages.map((s, i) => (H - (s.tools.length - 1) * GAP) / totals[i]),
  (H - (maxN - 1) * GAP) / Math.max(...totals),
);
const box = new Map<string, { y: number; h: number }>();
stages.forEach((s, i) => {
  const used = totals[i] * unit + (s.tools.length - 1) * GAP;
  let y = (H - used) / 2;
  s.tools.forEach((t) => {
    const h = valueOf(t.slug) * unit;
    box.set(t.slug, { y, h });
    y += h + GAP;
  });
});

/* Phone: each stage is a row of equal cells; a band leaves its source cell
   in proportion to the source's outflow and reaches its target cell in
   proportion to the target's inflow. */
const cell = (slug: string) => {
  const s = stages[stageOf.get(slug)!];
  const i = s.tools.findIndex((t) => t.slug === slug);
  const w = 1000 / s.tools.length;
  return { x: i * w + w * 0.12, w: w * 0.76 };
};

const order = (slug: string) => {
  const s = stages[stageOf.get(slug)!];
  return s.tools.findIndex((t) => t.slug === slug);
};

const gaps = stages.slice(0, -1).map((_, g) => {
  const own = links.filter((l) => stageOf.get(l[0]) === g && stageOf.get(l[1]) === g + 1);
  const outAt = new Map<string, number>();
  const inAt = new Map<string, number>();
  const pOutAt = new Map<string, number>();
  const pInAt = new Map<string, number>();
  const bySource = [...own].sort((a, b) => order(a[0]) - order(b[0]) || order(a[1]) - order(b[1]));
  const byTarget = [...own].sort((a, b) => order(a[1]) - order(b[1]) || order(a[0]) - order(b[0]));
  const ends = new Map<(typeof own)[number], { a: number; b: number; pa: number; pb: number }>();
  for (const l of bySource) {
    const o = outAt.get(l[0]) ?? 0;
    const po = pOutAt.get(l[0]) ?? 0;
    outAt.set(l[0], o + l[2]);
    pOutAt.set(l[0], po + l[2]);
    ends.set(l, { a: o, b: 0, pa: po, pb: 0 });
  }
  for (const l of byTarget) {
    const i = inAt.get(l[1]) ?? 0;
    const pi = pInAt.get(l[1]) ?? 0;
    inAt.set(l[1], i + l[2]);
    pInAt.set(l[1], pi + l[2]);
    const e = ends.get(l)!;
    e.b = i;
    e.pb = pi;
  }
  return own.map((l) => {
    const e = ends.get(l)!;
    const s = box.get(l[0])!;
    const t = box.get(l[1])!;
    const a0 = s.y + e.a * unit;
    const a1 = a0 + l[2] * unit;
    const b0 = t.y + e.b * unit;
    const b1 = b0 + l[2] * unit;
    const desk = `M0 ${f(a0)}C50 ${f(a0)} 50 ${f(b0)} 100 ${f(b0)}L100 ${f(b1)}C50 ${f(b1)} 50 ${f(a1)} 0 ${f(a1)}Z`;
    const sc = cell(l[0]);
    const tc = cell(l[1]);
    const sOut = sum((x) => x[0], l[0]);
    const tIn = sum((x) => x[1], l[1]);
    const x0 = sc.x + (e.pa / sOut) * sc.w;
    const x1 = x0 + (l[2] / sOut) * sc.w;
    const y0 = tc.x + (e.pb / tIn) * tc.w;
    const y1 = y0 + (l[2] / tIn) * tc.w;
    const phone = `M${f(x0)} 0C${f(x0)} 50 ${f(y0)} 50 ${f(y0)} 100L${f(y1)} 100C${f(y1)} 50 ${f(x1)} 50 ${f(x1)} 0Z`;
    return { from: l[0], to: l[1], desk, phone };
  });
});

/* The readout's lines for each flow tool and rail tool. */
const names = (slugs: string[]) => slugs.map((s) => toolOf.get(s)!.name).join(", ");
const flowNotes = stages.flatMap((s, i) =>
  s.tools.map((t) => ({
    ...t,
    stage: `${pad(i + 1)} · ${s.name}`,
    from: names(links.filter((l) => l[1] === t.slug).map((l) => l[0])),
    to: names(links.filter((l) => l[0] === t.slug).map((l) => l[1])),
  })),
);
const railNotes = rail.groups.flatMap((g) =>
  g.tools.map((t) => ({ ...t, stage: g.name, touched: t.touches.map((i) => stages[i].name).join(", ") })),
);
const count = flowNotes.length + railNotes.length;
const noteId = (slug: string) => `${id}-note-${slug}`;
---

<section data-ac-sec="light" data-ac-flow id={id}>
  <GridRules />

  <div data-ac-sec-container>
    <SectionHead eyebrow={eyebrow} headline={headline} accent={accent} lede={lede} />

    <div data-ac-sec-frame data-ac-flow-frame>
      <Joints />

      <div data-ac-flow-side>
        <figure data-ac-flow-photo>
          <Image
            src={media.image}
            alt={media.alt}
            widths={[640, 960, 1280]}
            sizes="(max-width: 599px) 60vw, (max-width: 991px) 70vw, 50vw"
            quality={78}
            style={media.focus ? `object-position:${media.focus}` : undefined}
          />
        </figure>

        <div data-ac-flow-readout>
          <div data-ac-flow-note data-key="" data-on>
            <p class="mono-label-sm" data-ac-flow-note-stage>{readout.title}</p>
            <p data-ac-flow-count><b>{count}</b> tools</p>
            <p data-ac-flow-note-text>{readout.hint}</p>
            <p data-ac-flow-note-meta>{readout.also}</p>
          </div>
          {flowNotes.map((t) => (
            <div data-ac-flow-note data-key={t.slug} id={noteId(t.slug)}>
              <p class="mono-label-sm" data-ac-flow-note-stage>{t.stage}</p>
              <p data-ac-flow-note-name>
                <TechLogo slug={t.slug} size={24} tone={t.ink ? "ink" : "brand"} />
                {t.name}
              </p>
              <p data-ac-flow-note-text>{t.note}</p>
              <p data-ac-flow-note-meta>
                {t.from && <span><b>{readout.from}</b> {t.from}</span>}
                {t.to && <span><b>{readout.to}</b> {t.to}</span>}
              </p>
            </div>
          ))}
          {railNotes.map((t) => (
            <div data-ac-flow-note data-key={t.slug} id={noteId(t.slug)}>
              <p class="mono-label-sm" data-ac-flow-note-stage>{t.stage}</p>
              <p data-ac-flow-note-name>
                <TechLogo slug={t.slug} size={24} tone={t.ink ? "ink" : "brand"} />
                {t.name}
              </p>
              <p data-ac-flow-note-text>{t.note}</p>
              <p data-ac-flow-note-meta><span><b>{readout.touches}</b> {t.touched}</span></p>
            </div>
          ))}
        </div>
      </div>

      <div data-ac-flow-main>
        <div data-ac-flow-chart role="group" aria-label={`${stages.map((s) => s.name).join(", then ")}`}>
          {stages.map((s, i) => (
            <Fragment>
              <p class="mono-label-sm" data-ac-flow-stage data-first={i === 0 || undefined} style={`--dc:${i * 2 + 1};--pr:${i * 2 + 1};--s:${i}`}>
                <span>{pad(i + 1)}</span> {s.name}
              </p>
              <ul data-ac-flow-nodes role="list" style={`--dc:${i * 2 + 1};--pr:${i * 2 + 2};--s:${i}`}>
                {s.tools.map((t) => {
                  const b = box.get(t.slug)!;
                  return (
                    <li style={`--y:${f(b.y / 10)}%;--h:${f(b.h / 10)}%`}>
                      <button
                        type="button"
                        data-ac-flow-node={t.slug}
                        data-stage={i}
                        aria-label={`${t.name}, ${s.name}`}
                        aria-describedby={noteId(t.slug)}
                      >
                        <TechLogo slug={t.slug} size={18} tone={t.ink ? "ink" : "brand"} />
                        <span>{t.short ?? t.name}</span>
                      </button>
                    </li>
                  );
                })}
              </ul>
            </Fragment>
          ))}
          {gaps.map((bands, g) => (
            <Fragment>
              <svg data-ac-flow-bands="desk" viewBox="0 0 100 1000" preserveAspectRatio="none" aria-hidden="true" style={`--dc:${g * 2 + 2};--s:${g}`}>
                {bands.map((b) => <path d={b.desk} data-from={b.from} data-to={b.to} data-stage={g} />)}
              </svg>
              <svg data-ac-flow-bands="phone" viewBox="0 0 1000 100" preserveAspectRatio="none" aria-hidden="true" style={`--pr:${g * 2 + 3};--s:${g}`}>
                {bands.map((b) => <path d={b.phone} data-from={b.from} data-to={b.to} data-stage={g} />)}
              </svg>
            </Fragment>
          ))}
        </div>

        <div data-ac-flow-rail>
          <p class="mono-label-sm" data-ac-flow-rail-label>{rail.label}</p>
          {rail.groups.map((g) => (
            <div data-ac-flow-rail-group style={`--n:${g.tools.length}`}>
              <p class="mono-label-sm">{g.name}</p>
              <ul role="list">
                {g.tools.map((t) => (
                  <li>
                    <button
                      type="button"
                      data-ac-flow-node={t.slug}
                      data-touches={t.touches.join(" ")}
                      aria-label={`${t.name}, ${g.name}`}
                      aria-describedby={noteId(t.slug)}
                    >
                      <TechLogo slug={t.slug} size={18} tone={t.ink ? "ink" : "brand"} />
                      <span>{t.short ?? t.name}</span>
                    </button>
                  </li>
                ))}
              </ul>
            </div>
          ))}
        </div>
      </div>
    </div>
  </div>
</section>

<script>
  import { toggleInView } from "@/lib/in-view";

  /* Tracing: the active tool lights its own bands and the tools at their far
     ends (a rail tool lights the stages it touches); the readout shows its
     note. The mouse traces on hover; focus and taps hold a tool until
     another is picked or focus leaves. */
  document.querySelectorAll<HTMLElement>("[data-ac-flow]").forEach((section) => {
    toggleInView(section);

    const nodes = [...section.querySelectorAll<HTMLButtonElement>("[data-ac-flow-node]")];
    const bands = [...section.querySelectorAll<SVGPathElement>("[data-ac-flow-bands] path")];
    const notes = [...section.querySelectorAll<HTMLElement>("[data-ac-flow-note]")];
    let held = "";

    const show = (key: string) => {
      const node = nodes.find((n) => n.dataset.acFlowNode === key);
      const touches = node?.dataset.touches?.split(" ").map(Number);
      const lit = new Set<string>(key ? [key] : []);
      bands.forEach((b) => {
        const s = Number(b.dataset.stage);
        const on = touches
          ? touches.includes(s) && touches.includes(s + 1)
          : b.dataset.from === key || b.dataset.to === key;
        b.toggleAttribute("data-lit", on);
        if (on && !touches) lit.add(b.dataset.from!).add(b.dataset.to!);
      });
      nodes.forEach((n) => {
        const inStage = touches?.includes(Number(n.dataset.stage)) && n.dataset.stage !== undefined;
        n.toggleAttribute("data-lit", lit.has(n.dataset.acFlowNode!) || !!inStage);
      });
      notes.forEach((n) => n.toggleAttribute("data-on", n.dataset.key === key));
      section.toggleAttribute("data-tracing", key !== "");
    };

    nodes.forEach((n) => {
      const key = n.dataset.acFlowNode!;
      n.addEventListener("pointerenter", (e) => {
        if (e.pointerType === "mouse") show(key);
      });
      n.addEventListener("pointerleave", (e) => {
        if (e.pointerType === "mouse") show(held);
      });
      n.addEventListener("focus", () => show((held = key)));
      n.addEventListener("click", () => show((held = key)));
      n.addEventListener("blur", (e) => {
        if (!nodes.includes(e.relatedTarget as HTMLButtonElement)) show((held = ""));
      });
    });

    section.addEventListener("keydown", (e) => {
      if (e.key === "Escape" && held) {
        (document.activeElement as HTMLElement | null)?.blur();
        show((held = ""));
      }
    });
  });
</script>
