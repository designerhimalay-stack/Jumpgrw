---
import { Image } from "astro:assets";
import GridRules from "@/components/GridRules.astro";
import RevealText from "@/components/RevealText.astro";
import Joints from "@/components/process/Joints.astro";
import type { SectionPhoto } from "@/types/page";

/* Smooth at 60 fps, on the dark tone. The headline, lede and three
   readings hold columns 1–2; a photo of an engineer at work holds
   columns 3–4. Across the foot, a frame chart: each frame as a pair of
   bars (UI thread, raster thread) under a dashed budget line, the frames
   streaming in from the right while the section is in view, every one
   under the line, so the jank count stays at zero. A switch moves the
   budget from 60 Hz to 120 Hz and the frames and readings follow; both
   rates are drawn in the same cell, so nothing moves. It is a native
   radio pair and the state lives in CSS, so it works by keyboard and
   without the script. The frame times are illustrative. See
   docs/sections.md. */

interface Rate {
  hz: number;
  label: string;
}

interface Props {
  id: string;
  eyebrow: string;
  headline: string[];
  accent?: number;
  lede: string;
  media: SectionPhoto;
  chartLabel: string;
  switchLabel: string;
  rates: [Rate, Rate];
  readings: { rate: string; jank: string; worst: string };
  legend: { ui: string; raster: string };
}

const { id, eyebrow, headline, accent = headline.length - 1, lede, media, chartLabel, switchLabel, rates, readings, legend } =
  Astro.props;
const offsets = headline.map((_, i) => headline.slice(0, i).reduce((n, line) => n + Array.from(line).length + 1, 0));

/* Frame times in ms, a fixed pseudo-random spread well under each
   budget. The chart's scale runs 0–20 ms. */
const FRAMES = 64;
const SCALE = 20;
const noise = (n: number) => {
  const x = Math.sin(n * 12.9898) * 43758.5453;
  return x - Math.floor(x);
};
const sets = rates.map((rate) => {
  const budget = 1000 / rate.hz;
  const frames = Array.from({ length: FRAMES }, (_, i) => ({
    ui: budget * (0.26 + noise(i + 1) * 0.22),
    raster: budget * (0.32 + noise(i + 101) * 0.36),
  }));
  const worst = Math.max(...frames.map((f) => Math.max(f.ui, f.raster)));
  return { rate, budget, frames, worst };
});
const pct = (ms: number) => `${((ms / SCALE) * 100).toFixed(1)}%`;
---

<section data-ac-sec="dark" data-ac-fps id={id}>
  <GridRules />

  <div data-ac-sec-container data-ac-fps-grid>
    <div data-ac-fps-copy>
      <p data-ac-sec-eyebrow class="mono-label">
        <span aria-hidden="true">+</span>
        {eyebrow}
      </p>
      <h2 data-ac-fps-headline aria-label={headline.join(" ")}>
        {headline.map((line, i) => (
          <Fragment>
            {i > 0 && <Fragment>{" "}<br aria-hidden="true" /></Fragment>}
            <span data-ac-sec-line data-accent={i === accent || undefined}>
              <RevealText text={line} offset={offsets[i]} />
            </span>
          </Fragment>
        ))}
      </h2>
      <p data-ac-fps-lede data-ac-sec-rise>{lede}</p>

      <dl data-ac-fps-readings data-ac-sec-rise>
        <div>
          <dt class="mono-label-sm">{readings.rate}</dt>
          <dd data-ac-fps-swap>
            {sets.map((s) => <span data-hz={s.rate.hz}>{s.rate.hz}<small>fps</small></span>)}
          </dd>
        </div>
        <div data-good>
          <dt class="mono-label-sm">{readings.jank}</dt>
          <dd>0<small>frames</small></dd>
        </div>
        <div>
          <dt class="mono-label-sm">{readings.worst}</dt>
          <dd data-ac-fps-swap>
            {sets.map((s) => <span data-hz={s.rate.hz}>{s.worst.toFixed(1)}<small>ms</small></span>)}
          </dd>
        </div>
      </dl>
    </div>

    <div data-ac-fps-photo>
      <Joints />
      <div data-ac-fps-image>
        <Image
          src={media.image}
          alt={media.alt}
          widths={[480, 800, 1200]}
          sizes="(max-width: 991px) 100vw, 46vw"
          quality={78}
          style={media.focus ? `object-position:${media.focus}` : undefined}
        />
      </div>
    </div>

    <div data-ac-fps-chart>
      <header data-ac-fps-head>
        <span class="mono-label">{chartLabel}</span>
        <span data-ac-fps-legend aria-hidden="true">
          <span><i data-k="ui" />{legend.ui}</span>
          <span><i data-k="raster" />{legend.raster}</span>
        </span>
        <fieldset data-ac-fps-switch>
          <legend class="mono-label-sm">{switchLabel}</legend>
          {sets.map((s, i) => (
            <label>
              <input type="radio" name={`${id}-rate`} value={String(s.rate.hz)} data-ac-fps-opt={s.rate.hz} checked={i === 0} />
              <span>{s.rate.label}</span>
            </label>
          ))}
        </fieldset>
      </header>

      <div
        data-ac-fps-plot
        role="img"
        aria-label={`${FRAMES} frames, each rendered under the frame budget at ${rates[0].hz} and ${rates[1].hz} Hz: no janky frames.`}
      >
        {sets.map((s) => (
          <div data-ac-fps-set data-hz={s.rate.hz} aria-hidden="true">
            <span data-ac-fps-budget style={`bottom:${pct(s.budget)}`}>
              <b class="mono-label-sm">{s.budget.toFixed(1)} ms · {s.rate.hz} fps</b>
            </span>
            <div data-ac-fps-track>
              {[0, 1].map(() => (
                <ol data-ac-fps-strip>
                  {s.frames.map((f, i) => (
                    <li style={`--ac-i:${i}`}>
                      <i data-k="ui" style={`height:${pct(f.ui)}`} />
                      <i data-k="raster" style={`height:${pct(f.raster)}`} />
                    </li>
                  ))}
                </ol>
              ))}
            </div>
          </div>
        ))}
      </div>
    </div>
  </div>
</section>

<script>
  import { toggleInView } from "@/lib/in-view";

  document.querySelectorAll<HTMLElement>("[data-ac-fps]").forEach(toggleInView);
</script>
