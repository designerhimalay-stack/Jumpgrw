---
import GridRules from "@/components/GridRules.astro";
import SectionHead from "@/components/SectionHead.astro";
import TechLogo from "@/components/TechLogo.astro";
import Joints from "@/components/process/Joints.astro";
import { TECH_LOGOS, type TechLogoSlug } from "@/lib/tech-logos";

/* Six platforms, on the light tone. A honeycomb in columns 1–2: Flutter
   and Dart at the heart on the accent, the six platforms round it, each
   with its logo (Windows, which has no logo in the set, by its name and a
   plain screen glyph). The cells open outward from the heart as the
   section arrives. Columns 3–4: the build sheet for the platform that is
   lit, with the one command that builds it, what comes out and where it
   ships, and under it the tools around the build. Pointing at or
   focusing a cell picks it; in view and untouched, the pick steps round
   the ring. Every sheet shares one grid cell, so nothing moves. Without
   the script, iOS stays picked. See docs/sections.md. */

interface Platform {
  key: string;
  name: string;
  slug?: TechLogoSlug;
  command: string;
  output: string;
  ships: string;
}

interface Props {
  id: string;
  eyebrow: string;
  headline: string[];
  accent?: number;
  lede: string;
  core: { name: string; note: string };
  sheetLabel: string;
  labels: { command: string; output: string; ships: string };
  /** Clockwise from the top left. */
  platforms: Platform[];
  toolsLabel: string;
  tools: TechLogoSlug[];
}

const { id, eyebrow, headline, accent, lede, core, sheetLabel, labels, platforms, toolsLabel, tools } = Astro.props;

/* Cell centres, in hex widths across and rows down (a row is 3/4 of a
   hex's height), clockwise from the top left. */
const RING: [number, number][] = [
  [-0.5, -1],
  [0.5, -1],
  [1, 0],
  [0.5, 1],
  [-0.5, 1],
  [-1, 0],
];
---

<section data-ac-sec="light" data-ac-hive id={id}>
  <GridRules />

  <div data-ac-sec-container>
    <SectionHead eyebrow={eyebrow} headline={headline} accent={accent} lede={lede} />

    <div data-ac-sec-frame data-ac-hive-frame>
      <Joints />

      <div data-ac-hive-comb>
        <div data-ac-hive-cell data-core style="--qx:0;--qy:0;--ac-i:0">
          <span data-ac-hive-face>
            <span data-ac-hive-logos>
              <TechLogo slug="flutter" size={30} tone="white" label />
              <TechLogo slug="dart" size={30} tone="white" label />
            </span>
            <span data-ac-hive-name>{core.name}</span>
            <span data-ac-hive-note>{core.note}</span>
          </span>
        </div>
        {platforms.map((p, i) => (
          <button
            type="button"
            data-ac-hive-cell
            data-ac-hive-pick={p.key}
            data-lit={i === 0 || undefined}
            aria-pressed={i === 0 ? "true" : "false"}
            style={`--qx:${RING[i % 6][0]};--qy:${RING[i % 6][1]};--ac-i:${i + 1}`}
          >
            <span data-ac-hive-face>
              {p.slug ? (
                <TechLogo slug={p.slug} size={30} />
              ) : (
                <svg data-ac-hive-glyph viewBox="0 0 24 24" aria-hidden="true"><path d="M3 5h18v11H3zM9 20h6M12 16v4" /></svg>
              )}
              <span data-ac-hive-name>{p.name}</span>
            </span>
          </button>
        ))}
      </div>

      <div data-ac-hive-side>
        <div data-ac-hive-sheets>
          {platforms.map((p, i) => (
            <dl data-ac-hive-sheet={p.key} data-lit={i === 0 || undefined}>
              <p data-ac-hive-sheet-head>
                <span class="mono-label">{sheetLabel}</span>
                <span data-ac-hive-sheet-name>{p.name}</span>
              </p>
              <div>
                <dt class="mono-label-sm">{labels.command}</dt>
                <dd data-ac-hive-cmd><span aria-hidden="true">$</span> {p.command}</dd>
              </div>
              <div>
                <dt class="mono-label-sm">{labels.output}</dt>
                <dd data-ac-hive-out>{p.output}</dd>
              </div>
              <div>
                <dt class="mono-label-sm">{labels.ships}</dt>
                <dd>{p.ships}</dd>
              </div>
            </dl>
          ))}
        </div>

        <div data-ac-hive-tools>
          <p class="mono-label">{toolsLabel}</p>
          <ul>
            {tools.map((slug) => (
              <li>
                <TechLogo slug={slug} size={22} />
                <span>{TECH_LOGOS[slug].title}</span>
              </li>
            ))}
          </ul>
        </div>
      </div>
    </div>
  </div>
</section>

<script>
  import { toggleInView } from "@/lib/in-view";

  document.querySelectorAll<HTMLElement>("[data-ac-hive]").forEach((section) => {
    toggleInView(section);

    const comb = section.querySelector<HTMLElement>("[data-ac-hive-comb]")!;
    const cells = Array.from(section.querySelectorAll<HTMLButtonElement>("[data-ac-hive-pick]"));
    const sheets = Array.from(section.querySelectorAll<HTMLElement>("[data-ac-hive-sheet]"));
    const keys = cells.map((c) => c.dataset.acHivePick ?? "");
    const reduced = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
    let step = 0;
    let timer = 0;
    let held = false;
    let inView = false;

    const pick = (key: string) => {
      cells.forEach((c) => {
        const on = c.dataset.acHivePick === key;
        c.toggleAttribute("data-lit", on);
        c.setAttribute("aria-pressed", on ? "true" : "false");
      });
      sheets.forEach((s) => s.toggleAttribute("data-lit", s.dataset.acHiveSheet === key));
    };

    const stop = () => {
      window.clearInterval(timer);
      timer = 0;
    };

    const start = () => {
      if (reduced || held || !inView || timer) return;
      timer = window.setInterval(() => {
        step = (step + 1) % keys.length;
        pick(keys[step]);
      }, 2200);
    };

    cells.forEach((c, i) => {
      const choose = () => {
        step = i;
        pick(keys[i]);
      };
      c.addEventListener("pointerenter", choose);
      c.addEventListener("focus", choose);
      c.addEventListener("click", choose);
    });

    comb.addEventListener("pointerenter", () => {
      held = true;
      stop();
    });
    comb.addEventListener("pointerleave", () => {
      held = comb.contains(document.activeElement);
      start();
    });
    comb.addEventListener("focusin", () => {
      held = true;
      stop();
    });
    comb.addEventListener("focusout", (e) => {
      if (comb.contains(e.relatedTarget as Node | null)) return;
      held = false;
      start();
    });

    new IntersectionObserver(
      ([entry]) => {
        inView = entry.isIntersecting;
        if (inView) start();
        else stop();
      },
      { threshold: 0.35 },
    ).observe(comb);
  });
</script>
