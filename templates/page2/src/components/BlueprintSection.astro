---
import GridRules from "@/components/GridRules.astro";
import SectionHead from "@/components/SectionHead.astro";
import Joints from "@/components/process/Joints.astro";
import { LINE_ICONS } from "@/lib/line-icons";
import type { Deliverable } from "@/types/page";

/* The deliverables, previewed. Column 1 lists them; columns 2–4 are a dark
   viewer that draws the chosen one live: a requirements document writing
   itself, an architecture diagram connecting up, a prototype being tapped
   through, a budget filling its ring. It moves on to the next by itself
   every few seconds until the reader picks one, and pauses off screen.
   Every preview sits in the same cell, so the viewer never changes size.
   See docs/sections.md. */

interface Props {
  id: string;
  eyebrow: string;
  headline: string[];
  accent?: number;
  lede: string;
  items: [Deliverable, Deliverable, Deliverable, Deliverable];
  files: [string, string, string, string];
}

const { id, eyebrow, headline, accent, lede, items, files } = Astro.props;
const kinds = ["doc", "diagram", "proto", "budget"] as const;
/* Budget split for the ring: share of 1, and a label. */
const split = [
  { share: 0.18, label: "Discovery & design" },
  { share: 0.52, label: "Build" },
  { share: 0.18, label: "QA & release" },
  { share: 0.12, label: "Cloud & DevOps" },
];
const circ = 2 * Math.PI * 70;
---

<section data-ac-sec="light" data-ac-blueprint id={id}>
  <GridRules />

  <div data-ac-sec-container>
    <SectionHead eyebrow={eyebrow} headline={headline} accent={accent} lede={lede} />

    <div data-ac-sec-frame data-ac-bp-frame>
      <Joints />
      <div role="tablist" aria-label={eyebrow} aria-orientation="vertical" data-ac-bp-tabs>
        {items.map((item, i) => (
          <button
            type="button"
            role="tab"
            id={`${id}-tab-${i}`}
            aria-controls={`${id}-panel-${i}`}
            aria-selected={i === 0 ? "true" : "false"}
            tabindex={i === 0 ? 0 : -1}
            data-ac-bp-tab
          >
            <span data-ac-bp-icon>
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" set:html={LINE_ICONS[item.icon]} />
            </span>
            <span data-ac-bp-tab-text>
              <span data-ac-bp-tab-title>{item.title}</span>
              <span data-ac-bp-tab-body>{item.body}</span>
            </span>
            <span data-ac-bp-timer aria-hidden="true"><i /></span>
          </button>
        ))}
      </div>

      <div data-ac-bp-viewer>
        <p data-ac-bp-bar aria-hidden="true">
          <i /><i /><i />
          <span data-ac-bp-file>{files[0]}</span>
        </p>
        <div data-ac-bp-stage>
          {items.map((item, i) => (
            <div
              role="tabpanel"
              id={`${id}-panel-${i}`}
              aria-labelledby={`${id}-tab-${i}`}
              data-ac-bp-panel={kinds[i]}
              data-file={files[i]}
              data-active={i === 0 || undefined}
              inert={i !== 0}
            >
              <p class="sr-only">{item.body} Arrives as {item.format}.</p>

              {kinds[i] === "doc" && (
                <div data-ac-bp-doc aria-hidden="true">
                  <span data-l="h1" style="--ac-i:0" />
                  <span data-l="meta" style="--ac-i:1" />
                  {[0, 1, 2].map((s) => (
                    <span data-ac-bp-story style={`--ac-i:${2 + s * 2}`}>
                      <i data-check />
                      <span><i data-l="line" /><i data-l="short" /></span>
                    </span>
                  ))}
                </div>
              )}

              {kinds[i] === "diagram" && (
                <svg data-ac-bp-diagram viewBox="0 0 520 260" aria-hidden="true">
                  <path d="M120 60 H200" pathLength="1" style="--ac-i:0" />
                  <path d="M320 60 H400" pathLength="1" style="--ac-i:1" />
                  <path d="M260 88 V172" pathLength="1" style="--ac-i:2" />
                  <path d="M320 200 H400" pathLength="1" style="--ac-i:3" />
                  <g style="--ac-i:0"><rect x="20" y="36" width="100" height="48" rx="8" /><text x="70" y="65">Web app</text></g>
                  <g style="--ac-i:1"><rect x="200" y="36" width="120" height="48" rx="8" data-core /><text x="260" y="65">API</text></g>
                  <g style="--ac-i:2"><rect x="400" y="36" width="100" height="48" rx="8" /><text x="450" y="65">Auth</text></g>
                  <g style="--ac-i:3"><rect x="200" y="172" width="120" height="56" rx="8" /><text x="260" y="205">Database</text></g>
                  <g style="--ac-i:4"><rect x="400" y="176" width="100" height="48" rx="8" /><text x="450" y="205">Queue</text></g>
                </svg>
              )}

              {kinds[i] === "proto" && (
                <div data-ac-bp-proto aria-hidden="true">
                  <span data-ac-bp-phone data-n="1"><i data-l="title" /><i data-l="card" /><i data-l="card" /><i data-l="btn" data-target /></span>
                  <span data-ac-bp-link><i /></span>
                  <span data-ac-bp-phone data-n="2"><i data-l="title" /><i data-l="field" /><i data-l="field" /><i data-l="btn" /></span>
                  <span data-ac-bp-cursor />
                </div>
              )}

              {kinds[i] === "budget" && (
                <div data-ac-bp-budget aria-hidden="true">
                  <svg viewBox="0 0 180 180">
                    <circle cx="90" cy="90" r="70" data-track />
                    {split.map((s, k) => {
                      const before = split.slice(0, k).reduce((n, x) => n + x.share, 0);
                      return (
                        <circle
                          cx="90"
                          cy="90"
                          r="70"
                          data-seg={k}
                          style={`--ac-i:${k};--ac-len:${(s.share * circ - 3).toFixed(1)};--ac-circ:${circ.toFixed(1)};--ac-off:${(-before * circ).toFixed(1)}`}
                        />
                      );
                    })}
                  </svg>
                  <span data-ac-bp-total>
                    <b>12</b>
                    <span class="mono-label-sm">Sprints</span>
                  </span>
                  <ul>
                    {split.map((s, k) => (
                      <li data-seg={k}>
                        <i />
                        <span>{s.label}</span>
                        <b>{Math.round(s.share * 100)}%</b>
                      </li>
                    ))}
                  </ul>
                </div>
              )}
            </div>
          ))}
        </div>
      </div>
    </div>
  </div>
</section>

<script>
  import { toggleInView } from "@/lib/in-view";

  document.querySelectorAll<HTMLElement>("[data-ac-blueprint]").forEach((section) => {
    toggleInView(section);

    const tabs = Array.from(section.querySelectorAll<HTMLButtonElement>("[data-ac-bp-tab]"));
    const panels = Array.from(section.querySelectorAll<HTMLElement>("[data-ac-bp-panel]"));
    const file = section.querySelector<HTMLElement>("[data-ac-bp-file]")!;
    const reduced = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
    const DWELL = 5200;
    let current = 0;
    let timer = 0;
    let auto = !reduced;
    let visible = false;

    const choose = (index: number, focus = false) => {
      current = index;
      tabs.forEach((tab, i) => {
        const on = i === index;
        tab.setAttribute("aria-selected", String(on));
        tab.tabIndex = on ? 0 : -1;
        panels[i].toggleAttribute("data-active", on);
        panels[i].inert = !on;
      });
      file.textContent = panels[index].dataset.file ?? "";
      /* Replays the chosen preview's drawing from the start. */
      const panel = panels[index];
      panel.removeAttribute("data-play");
      void panel.offsetWidth;
      panel.setAttribute("data-play", "");
      if (focus) tabs[index].focus();
      schedule();
    };

    const schedule = () => {
      window.clearTimeout(timer);
      section.toggleAttribute("data-auto", auto && visible);
      if (auto && visible) timer = window.setTimeout(() => choose((current + 1) % tabs.length), DWELL);
    };

    /* Picking one stops the tour. */
    const stop = () => {
      auto = false;
      schedule();
    };

    tabs.forEach((tab, i) => {
      tab.addEventListener("click", () => {
        stop();
        choose(i);
      });
      tab.addEventListener("keydown", (event) => {
        const last = tabs.length - 1;
        const next =
          event.key === "ArrowDown" || event.key === "ArrowRight" ? (i === last ? 0 : i + 1)
          : event.key === "ArrowUp" || event.key === "ArrowLeft" ? (i === 0 ? last : i - 1)
          : -1;
        if (next < 0) return;
        event.preventDefault();
        stop();
        choose(next, true);
      });
    });

    new IntersectionObserver(
      ([entry]) => {
        visible = entry.isIntersecting;
        if (visible) choose(current);
        else schedule();
      },
      { threshold: 0.25 },
    ).observe(section);
  });
</script>
