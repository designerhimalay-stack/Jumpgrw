---
import GridRules from "@/components/GridRules.astro";
import SectionHead from "@/components/SectionHead.astro";
import TechLogo from "@/components/TechLogo.astro";
import Joints from "@/components/process/Joints.astro";
import type { SectionPhoto } from "@/types/page";

/* Modernise, on the dark tone. The header splits around a photo of an
   engineer at her code. Under it, one frame: a switch between the old
   runtime and the new along its top, then four metrics, each a bar on a
   shared scale with the old runtime's mark (100) always drawn on it. As the
   section arrives the bars stand at "before", then move to "after", where
   they rest, the change written at the end of each row. The switch flips
   between the two by hand. Both readouts share one grid cell and the bars
   only change width inside a fixed track, so nothing moves. Without the
   script, or under reduced motion, the "after" state shows. The figures are
   relative and illustrative. See docs/sections.md. */

interface Metric {
  label: string;
  /** "higher" or "lower" is better. */
  better: "higher" | "lower";
  /** Relative to the old runtime at 100. */
  after: number;
  change: string;
}

interface Props {
  id: string;
  eyebrow: string;
  headline: string[];
  accent?: number;
  lede: string;
  media: SectionPhoto;
  before: string;
  after: string;
  metrics: Metric[];
  note: string;
}

const { id, eyebrow, headline, accent, lede, media, before, after, metrics, note } = Astro.props;
const MAX = 240;
const pct = (v: number) => `${((v / MAX) * 100).toFixed(2)}%`;
---

<section data-ac-sec="dark" data-ac-mod id={id} data-view="after">
  <GridRules />

  <div data-ac-sec-container>
    <SectionHead eyebrow={eyebrow} headline={headline} accent={accent} lede={lede} media={media} />

    <div data-ac-sec-frame data-ac-mod-frame>
      <Joints />
      <div data-ac-mod-bar>
        <fieldset data-ac-mod-switch>
          <legend class="sr-only">Show the figures for</legend>
          <label>
            <input type="radio" name={`${id}-view`} value="before" />
            <span>{before}</span>
          </label>
          <label>
            <input type="radio" name={`${id}-view`} value="after" checked />
            <span><TechLogo slug="dotnet" size={16} tone="current" />{after}</span>
          </label>
        </fieldset>
        <p data-ac-mod-note class="mono-label-sm">{note}</p>
      </div>

      <ul data-ac-mod-rows>
        {metrics.map((m, i) => (
          <li data-ac-mod-row style={`--ac-before:${pct(100)};--ac-after:${pct(m.after)};--ac-i:${i}`}>
            <span data-ac-mod-label>
              <span>{m.label}</span>
              <span class="mono-label-sm">{m.better === "higher" ? "Higher is better" : "Lower is better"}</span>
            </span>
            <span data-ac-mod-track aria-hidden="true">
              <i data-ac-mod-fill />
              <b data-ac-mod-mark />
            </span>
            <span data-ac-mod-read>
              <span data-v="before">Baseline</span>
              <span data-v="after" data-better={m.better}>{m.change}</span>
            </span>
          </li>
        ))}
      </ul>

      <div data-ac-mod-scale aria-hidden="true">
        <span data-ac-mod-ticks>
          <span style="--ac-at:0%">0</span>
          <span style={`--ac-at:${pct(100)}`} data-base>100 · {before.replace(".NET Framework ", "")}</span>
          <span style={`--ac-at:${pct(200)}`}>200</span>
        </span>
      </div>
    </div>
  </div>
</section>

<script>
  document.querySelectorAll<HTMLElement>("[data-ac-mod]").forEach((section) => {
    const inputs = Array.from(section.querySelectorAll<HTMLInputElement>("[data-ac-mod-switch] input"));
    const reduced = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
    let timer = 0;
    let touched = false;

    const show = (view: string) => {
      section.dataset.view = view;
      inputs.forEach((input) => (input.checked = input.value === view));
    };

    inputs.forEach((input) =>
      input.addEventListener("change", () => {
        touched = true;
        window.clearTimeout(timer);
        show(input.value);
      }),
    );

    /* On arrival: before, then after, where it rests. Reset on leaving. */
    new IntersectionObserver(
      ([entry]) => {
        section.toggleAttribute("data-ac-in", entry.isIntersecting);
        if (reduced || touched) return;
        window.clearTimeout(timer);
        if (entry.isIntersecting) timer = window.setTimeout(() => show("after"), 1300);
        else show("before");
      },
      { threshold: 0, rootMargin: "-10% 0px -10% 0px" },
    ).observe(section);
  });
</script>
