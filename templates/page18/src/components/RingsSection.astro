---
import GridRules from "@/components/GridRules.astro";
import SectionHead from "@/components/SectionHead.astro";
import TechLogo from "@/components/TechLogo.astro";
import type { TechLogoSlug } from "@/lib/tech-logos";

/* Clean architecture, as rings. Columns 1–2: four concentric rings, Domain
   at the centre, then Application, Infrastructure and UI / API, each named
   along its top and labelled with what lives there along its foot; chevrons
   on the boundaries point inward, the way dependencies run. The rings draw
   in from the centre outward as the section arrives. Columns 3–4: the rings
   as tabs, and under them the chosen ring's projects. Picking a ring, in the
   diagram or the tabs, lights it and shows its projects; every panel shares
   one grid cell, so nothing moves. The first ring is chosen in the markup.
   See docs/sections.md. */

interface Project {
  name: string;
  note: string;
  logo?: TechLogoSlug;
}

interface Ring {
  name: string;
  lives: string;
  rule: string;
  projects: Project[];
}

interface Props {
  id: string;
  eyebrow: string;
  headline: string[];
  accent?: number;
  lede: string;
  /** Centre first. */
  rings: Ring[];
  caption: string;
}

const { id, eyebrow, headline, accent, lede, rings, caption } = Astro.props;

/* A 400-unit square: the Domain disc, then three bands of 44. */
const C = 200;
const CORE = 64;
const BAND = 44;
const outer = (i: number) => (i === 0 ? CORE : CORE + i * BAND);
const mid = (i: number) => (i === 0 ? CORE / 2 : outer(i) - BAND / 2);
const top = (r: number) => `M${C - r} ${C} A${r} ${r} 0 0 1 ${C + r} ${C}`;
const foot = (r: number) => `M${C - r} ${C} A${r} ${r} 0 0 0 ${C + r} ${C}`;
/* An arrowhead on each boundary, up and to the right, pointing at the centre. */
const chevrons = rings.slice(0, -1).map((_, i) => {
  const r = outer(i);
  const a = -Math.PI / 4;
  const [px, py] = [C + Math.cos(a) * r, C + Math.sin(a) * r];
  const [ux, uy] = [-Math.cos(a), -Math.sin(a)];
  const pt = (along: number, across: number) =>
    `${(px + ux * along - uy * across).toFixed(1)} ${(py + uy * along + ux * across).toFixed(1)}`;
  return `M${pt(7, 0)} L${pt(-5, 4.5)} L${pt(-5, -4.5)} Z`;
});
---

<section data-ac-sec="light" data-ac-rings id={id}>
  <GridRules />

  <div data-ac-sec-container>
    <SectionHead eyebrow={eyebrow} headline={headline} accent={accent} lede={lede} />

    <div data-ac-rings-grid>
      <figure data-ac-rings-figure>
        <svg viewBox="0 0 400 400" aria-hidden="true">
          <defs>
            {rings.map((_, i) =>
              i === 0 ? null : (
                <Fragment>
                  <path id={`${id}-top-${i}`} d={top(mid(i) - 4)} />
                  <path id={`${id}-foot-${i}`} d={foot(mid(i) + 4)} />
                </Fragment>
              ),
            )}
          </defs>
          <circle data-ac-rings-backdrop cx={C} cy={C} r={outer(rings.length - 1)} />
          {rings.map((_, i) => i).reverse().map((i) => (
            <g data-ac-rings-ring data-ring={i} data-on={i === 0 || undefined} style={`--ac-i:${i}`}>
              {i === 0 ? (
                <circle data-ac-rings-band cx={C} cy={C} r={CORE - 1.5} />
              ) : (
                <circle data-ac-rings-band data-stroke cx={C} cy={C} r={mid(i)} stroke-width={BAND - 3} pathLength="1" />
              )}
              {i === 0 ? (
                <Fragment>
                  <text data-ac-rings-name x={C} y={C - 2}>{rings[0].name}</text>
                  <text data-ac-rings-lives x={C} y={C + 15}>{rings[0].lives}</text>
                </Fragment>
              ) : (
                <Fragment>
                  <text data-ac-rings-name><textPath href={`#${id}-top-${i}`} startOffset="50%">{rings[i].name}</textPath></text>
                  <text data-ac-rings-lives><textPath href={`#${id}-foot-${i}`} startOffset="50%">{rings[i].lives}</textPath></text>
                </Fragment>
              )}
            </g>
          ))}
          {chevrons.map((d, i) => (
            <g data-ac-rings-chev style={`--ac-i:${i + 1}`}>
              <path d={d} />
            </g>
          ))}
        </svg>
        <figcaption class="mono-label-sm">{caption}</figcaption>
      </figure>

      <div data-ac-rings-side>
        <div data-ac-rings-tabs role="tablist" aria-label="Architecture rings">
          {rings.map((ring, i) => (
            <button
              type="button"
              role="tab"
              id={`${id}-tab-${i}`}
              aria-controls={`${id}-panel-${i}`}
              aria-selected={i === 0 ? "true" : "false"}
              tabindex={i === 0 ? 0 : -1}
              data-ac-rings-tab
              data-ring={i}
            >
              <span data-ac-rings-swatch aria-hidden="true" style={`--ac-i:${i}`} />
              <span data-ac-rings-tabname>{ring.name}</span>
              <span data-ac-rings-tablives class="mono-label-sm">{ring.lives}</span>
            </button>
          ))}
        </div>

        <div data-ac-rings-panels>
          {rings.map((ring, i) => (
            <div
              role="tabpanel"
              id={`${id}-panel-${i}`}
              aria-labelledby={`${id}-tab-${i}`}
              data-ac-rings-panel
              data-ring={i}
              data-on={i === 0 || undefined}
            >
              <p data-ac-rings-rule class="mono-label-sm">{ring.rule}</p>
              <ul>
                {ring.projects.map((project) => (
                  <li>
                    <span data-ac-rings-logo>
                      <TechLogo slug={project.logo ?? "dotnet"} size={20} />
                    </span>
                    <span data-ac-rings-proj>{project.name}<span aria-hidden="true">.csproj</span></span>
                    <span data-ac-rings-note>{project.note}</span>
                  </li>
                ))}
              </ul>
            </div>
          ))}
        </div>
      </div>
    </div>
  </div>
</section>

<script>
  import { toggleInView } from "@/lib/in-view";

  document.querySelectorAll<HTMLElement>("[data-ac-rings]").forEach((section) => {
    toggleInView(section);

    const tabs = Array.from(section.querySelectorAll<HTMLButtonElement>("[data-ac-rings-tab]"));
    const lit = Array.from(section.querySelectorAll<HTMLElement>("[data-ac-rings-ring], [data-ac-rings-panel]"));

    const choose = (ring: string, focus = false) => {
      tabs.forEach((tab) => {
        const on = tab.dataset.ring === ring;
        tab.setAttribute("aria-selected", String(on));
        tab.tabIndex = on ? 0 : -1;
        if (on && focus) tab.focus();
      });
      lit.forEach((el) => el.toggleAttribute("data-on", el.dataset.ring === ring));
    };

    tabs.forEach((tab, i) => {
      tab.addEventListener("click", () => choose(tab.dataset.ring ?? "0"));
      tab.addEventListener("keydown", (event) => {
        const step = { ArrowDown: 1, ArrowRight: 1, ArrowUp: -1, ArrowLeft: -1 }[event.key];
        if (event.key === "Home" || event.key === "End" || step) {
          event.preventDefault();
          const next = event.key === "Home" ? 0 : event.key === "End" ? tabs.length - 1 : (i + (step ?? 0) + tabs.length) % tabs.length;
          choose(tabs[next].dataset.ring ?? "0", true);
        }
      });
    });

    /* The rings in the diagram pick too, for a pointer; the tabs are the
       keyboard's way in. */
    section.querySelectorAll<SVGGElement>("[data-ac-rings-ring]").forEach((ring) => {
      ring.addEventListener("click", () => choose(ring.dataset.ring ?? "0"));
    });
  });
</script>
