---
import GridRules from "@/components/GridRules.astro";
import SectionHead from "@/components/SectionHead.astro";
import Joints from "@/components/process/Joints.astro";

/* Swimlane process map, on the dark tone. One process in BPMN-style lanes
   (customer, support, finance, system), drawn twice from one model: lanes
   across for tablets and desktop, lanes down for phones, so the labels stay
   readable at both sizes. A token walks the process while the section is on
   screen. As-is, every refund stops at finance and the approval is flagged
   as the bottleneck; then the map switches to the to-be design, where a
   gateway sends small refunds straight to the system and the token runs
   through. Two buttons (aria-pressed) pick a view and stop the loop; the
   read-outs underneath share one grid cell per state. The loop pauses off
   screen. Without the script the to-be map shows; under reduced motion the
   token stays hidden and the buttons still switch. See docs/sections.md. */

interface Node {
  id: string;
  label: [string, string];
}

interface Props {
  id: string;
  eyebrow: string;
  headline: string[];
  accent?: number;
  lede: string;
  title: string;
  lanes: [string, string, string, string];
  nodes: Node[];
  yes: string;
  no: string;
  states: { asis: string; tobe: string };
  stateLabel: string;
  flags: { asis: string; tobe: string };
  readouts: { label: string; asis: string; tobe: string }[];
}

const { id, eyebrow, headline, accent = headline.length - 1, lede, title, lanes, nodes, yes, no, states, stateLabel, flags, readouts } =
  Astro.props;

/* The model, in abstract units: c along the process, l across the lanes. */
type Kind = "task" | "gate" | "start" | "end";
const PLACE: Record<string, { c: number; l: number; kind: Kind; only?: "asis" | "tobe"; hot?: boolean }> = {
  ask: { c: 0, l: 0, kind: "start" },
  check: { c: 1, l: 1, kind: "task" },
  gate: { c: 2, l: 1, kind: "gate", only: "tobe" },
  approve: { c: 3, l: 2, kind: "task", hot: true },
  post: { c: 4, l: 3, kind: "task" },
  paid: { c: 5, l: 0, kind: "end" },
};

type Pt = [number, number];
const EDGES: { pts: Pt[]; only?: "asis" | "tobe"; dash?: boolean }[] = [
  { pts: [[0.5, 0.5], [1.5, 0.5], [1.5, 1.5]] },
  { pts: [[1.5, 1.5], [1.5, 2.5], [3.5, 2.5]], only: "asis" },
  { pts: [[1.5, 1.5], [2.5, 1.5]], only: "tobe" },
  { pts: [[2.5, 1.5], [3.5, 1.5], [3.5, 2.5]], only: "tobe", dash: true },
  { pts: [[2.5, 1.5], [2.5, 3.5], [4.5, 3.5]], only: "tobe" },
  { pts: [[3.5, 2.5], [3.5, 3.5], [4.5, 3.5]] },
  { pts: [[4.5, 3.5], [5.5, 3.5], [5.5, 0.5]] },
];
const ROUTES: Record<"asis" | "tobe", { pts: Pt[]; hold?: number }> = {
  asis: { pts: [[0.5, 0.5], [1.5, 0.5], [1.5, 1.5], [1.5, 2.5], [3.5, 2.5], [3.5, 3.5], [4.5, 3.5], [5.5, 3.5], [5.5, 0.5]], hold: 4 },
  tobe: { pts: [[0.5, 0.5], [1.5, 0.5], [1.5, 1.5], [2.5, 1.5], [2.5, 3.5], [4.5, 3.5], [5.5, 3.5], [5.5, 0.5]] },
};
/* Gateway labels: where they sit and which way their line runs. */
const LABELS: { text: string; c: number; l: number; along: "c" | "l" }[] = [
  { text: yes, c: 2.5, l: 2.25, along: "l" },
  { text: no, c: 3.05, l: 1.5, along: "c" },
];

interface Geo {
  key: "wide" | "tall";
  w: number;
  h: number;
  /* Map (c, l) to (x, y). */
  at: (c: number, l: number) => Pt;
  /* Half the node's size along c and along l. */
  half: { c: number; l: number };
  gate: number;
  font: number;
  token: number;
}

const WIDE: Geo = {
  key: "wide",
  w: 1000,
  h: 384,
  at: (c, l) => [100 + c * 150, l * 96],
  half: { c: 60, l: 25 },
  gate: 28,
  font: 13,
  token: 7,
};
const TALL: Geo = {
  key: "tall",
  w: 340,
  h: 484,
  at: (c, l) => [l * 85, 40 + c * 74],
  half: { c: 23, l: 37 },
  gate: 24,
  font: 11,
  token: 6,
};

const r1 = (n: number) => Math.round(n * 10) / 10;
const path = (g: Geo, pts: Pt[]) => pts.map(([c, l], i) => `${i ? "L" : "M"}${r1(g.at(c, l)[0])} ${r1(g.at(c, l)[1])}`).join(" ");

/* An edge stops short of the node it enters, by half that node's size along
   the last segment, so its arrowhead shows. */
const edgePath = (g: Geo, pts: Pt[]) => {
  const out = pts.map((p) => [...p] as Pt);
  const [a, b] = [out[out.length - 2], out[out.length - 1]];
  const target = Object.values(PLACE).find((n) => n.c + 0.5 === b[0] && n.l + 0.5 === b[1]);
  const along: "c" | "l" = a[0] !== b[0] ? "c" : "l";
  const unit = along === "c" ? g.at(1, 0)[0] - g.at(0, 0)[0] || g.at(1, 0)[1] - g.at(0, 0)[1] : g.at(0, 1)[1] - g.at(0, 0)[1] || g.at(0, 1)[0] - g.at(0, 0)[0];
  const size = target?.kind === "gate" ? g.gate : g.half[along];
  const back = (size + 3) / unit;
  const dir = Math.sign(b[along === "c" ? 0 : 1] - a[along === "c" ? 0 : 1]);
  if (along === "c") b[0] -= dir * back;
  else b[1] -= dir * back;
  return path(g, out);
};

const lanePos = (g: Geo, l: number) => g.at(0, l);
---

<section data-ac-sec="dark" data-ac-lane id={id} data-state="tobe">
  <GridRules />

  <div data-ac-sec-container>
    <SectionHead eyebrow={eyebrow} headline={headline} accent={accent} lede={lede} />

    <div data-ac-sec-frame data-ac-lane-frame>
      <Joints />

      <div data-ac-lane-bar>
        <span class="mono-label-sm">{title}</span>
        <div data-ac-lane-switch role="group" aria-label={stateLabel}>
          <button type="button" data-ac-lane-pick="asis" aria-pressed="false">{states.asis}</button>
          <button type="button" data-ac-lane-pick="tobe" aria-pressed="true">{states.tobe}</button>
        </div>
      </div>

      <div data-ac-lane-maps>
        {[WIDE, TALL].map((g) => (
          <svg
            data-ac-lane-map={g.key}
            viewBox={`0 0 ${g.w} ${g.h}`}
            role="img"
            aria-label={`${title}: ${nodes.map((n) => n.label.join(" ")).join(", then ")}.`}
            style={`--ac-font:${g.font}px`}
          >
            <defs>
              <marker id={`${id}-${g.key}-arrow`} viewBox="0 0 10 10" refX="9" refY="5" markerWidth="7" markerHeight="7" orient="auto-start-reverse">
                <path d="M0 1 9 5 0 9Z" fill="currentColor" />
              </marker>
            </defs>

            {lanes.map((name, l) => {
              const [x, y] = lanePos(g, l);
              return g.key === "wide" ? (
                <g data-ac-lane-row>
                  <rect x="0" y={y} width={g.w} height="96" />
                  <text x="16" y={y + 52} data-ac-lane-name>{name}</text>
                </g>
              ) : (
                <g data-ac-lane-row>
                  <rect x={x} y="0" width="85" height={g.h} />
                  <text x={x + 42.5} y="24" text-anchor="middle" data-ac-lane-name>{name}</text>
                </g>
              );
            })}

            {EDGES.map((e) => (
              <path
                d={edgePath(g, e.pts)}
                data-ac-lane-edge
                data-only={e.only}
                data-dash={e.dash ? "" : undefined}
                marker-end={`url(#${id}-${g.key}-arrow)`}
              />
            ))}

            {LABELS.map((lb) => {
              const [x, y] = g.at(lb.c, lb.l);
              const across = (g.key === "wide") === (lb.along === "l");
              return (
                <text
                  data-ac-lane-tag
                  data-only="tobe"
                  x={across ? x + 7 : x}
                  y={across ? y + 4 : y - 7}
                  text-anchor={across ? "start" : "middle"}
                >{lb.text}</text>
              );
            })}

            {nodes.map((n) => {
              const p = PLACE[n.id];
              const [x, y] = g.at(p.c + 0.5, p.l + 0.5);
              const hw = g.key === "wide" ? g.half.c : g.half.l;
              const hh = g.key === "wide" ? g.half.l : g.half.c;
              return (
                <g data-ac-lane-node={p.kind} data-only={p.only} data-hot={p.hot ? "" : undefined} style={`transform-origin:${r1(x)}px ${r1(y)}px`}>
                  {p.kind === "gate" ? (
                    <path d={`M${x} ${y - g.gate}L${x + g.gate} ${y}L${x} ${y + g.gate}L${x - g.gate} ${y}Z`} />
                  ) : (
                    <rect x={r1(x - hw)} y={r1(y - hh)} width={hw * 2} height={hh * 2} rx="6" />
                  )}
                  {(p.kind === "start" || p.kind === "end") && (
                    <circle data-ac-lane-event cx={r1(x - hw)} cy={r1(y - hh)} r="6" />
                  )}
                  {p.kind === "gate" ? (
                    <text x={x} y={y + g.font * 0.35} text-anchor="middle" data-ac-lane-gate-text>{n.label[1]}</text>
                  ) : (
                    <text x={x} y={y} text-anchor="middle">
                      <tspan x={x} dy={-g.font * 0.25}>{n.label[0]}</tspan>
                      <tspan x={x} dy={g.font * 1.2}>{n.label[1]}</tspan>
                    </text>
                  )}
                  {p.hot && (
                    <g data-ac-lane-flag data-only="asis">
                      <rect data-ac-lane-ring x={r1(x - hw - 5)} y={r1(y - hh - 5)} width={hw * 2 + 10} height={hh * 2 + 10} rx="9" />
                      <circle cx={r1(x + hw)} cy={r1(y - hh)} r="9" />
                      <text x={r1(x + hw)} y={r1(y - hh + 4)} text-anchor="middle">!</text>
                    </g>
                  )}
                </g>
              );
            })}

            <path data-ac-lane-route="asis" d={path(g, ROUTES.asis.pts)} data-hold={path(g, ROUTES.asis.pts.slice(0, (ROUTES.asis.hold ?? 0) + 1))} data-hold-back={g.half.c + 14} />
            <path data-ac-lane-route="tobe" d={path(g, ROUTES.tobe.pts)} />
            <circle data-ac-lane-token r={g.token} cx={g.at(0.5, 0.5)[0]} cy={g.at(0.5, 0.5)[1]} />
          </svg>
        ))}
      </div>

      <div data-ac-lane-foot>
        <p data-ac-lane-note aria-live="polite">
          <span data-only="asis"><b aria-hidden="true">!</b>{flags.asis}</span>
          <span data-only="tobe"><b aria-hidden="true">✓</b>{flags.tobe}</span>
        </p>
        <dl data-ac-lane-reads>
          {readouts.map((r) => (
            <div>
              <dt class="mono-label-sm">{r.label}</dt>
              <dd>
                <span data-only="asis">{r.asis}</span>
                <span data-only="tobe">{r.tobe}</span>
              </dd>
            </div>
          ))}
        </dl>
      </div>
    </div>
  </div>
</section>

<script>
  import { toggleInView } from "@/lib/in-view";

  const reduced = window.matchMedia("(prefers-reduced-motion: reduce)").matches;

  document.querySelectorAll<HTMLElement>("[data-ac-lane]").forEach((section) => {
    toggleInView(section);
    const buttons = Array.from(section.querySelectorAll<HTMLButtonElement>("[data-ac-lane-pick]"));
    const maps = Array.from(section.querySelectorAll<SVGSVGElement>("[data-ac-lane-map]"));
    let state: "asis" | "tobe" = "asis";
    let auto = !reduced;
    let visible = false;
    let frame = 0;
    let timer = 0;

    const set = (next: "asis" | "tobe") => {
      state = next;
      section.dataset.state = next;
      buttons.forEach((b) => b.setAttribute("aria-pressed", String(b.dataset.acLanePick === next)));
    };

    const activeMap = () => maps.find((m) => m.getBoundingClientRect().width > 0) ?? maps[0];

    /* Walks the token along the state's route; as-is, it waits at the
       approval. Resolves when it reaches the end. */
    const run = (done: () => void) => {
      cancelAnimationFrame(frame);
      if (reduced) return;
      const map = activeMap();
      const route = map.querySelector<SVGPathElement>(`[data-ac-lane-route="${state}"]`)!;
      const token = map.querySelector<SVGCircleElement>("[data-ac-lane-token]")!;
      maps.forEach((m) => m.querySelector("[data-ac-lane-token]")?.removeAttribute("data-on"));
      const total = route.getTotalLength();
      const holdSrc = route.getAttribute("data-hold");
      let holdAt = -1;
      if (holdSrc) {
        const probe = document.createElementNS("http://www.w3.org/2000/svg", "path");
        probe.setAttribute("d", holdSrc);
        holdAt = probe.getTotalLength() - Number(route.getAttribute("data-hold-back") ?? 0);
      }
      const speed = total / (state === "asis" ? 2600 : 2000);
      const hold = 1500;
      const t0 = performance.now();
      token.setAttribute("data-on", "");
      section.removeAttribute("data-waiting");
      const tick = (now: number) => {
        let t = now - t0;
        let d = t * speed;
        if (holdAt >= 0 && d > holdAt) {
          if (t < holdAt / speed + hold) {
            d = holdAt;
            section.setAttribute("data-waiting", "");
          } else {
            section.removeAttribute("data-waiting");
            t -= hold;
            d = t * speed;
          }
        }
        const p = route.getPointAtLength(Math.min(total, d));
        token.setAttribute("cx", p.x.toFixed(1));
        token.setAttribute("cy", p.y.toFixed(1));
        if (d < total) frame = requestAnimationFrame(tick);
        else {
          token.removeAttribute("data-on");
          done();
        }
      };
      frame = requestAnimationFrame(tick);
    };

    /* The loop: as-is, a pause on the flag, to-be, a rest, again. */
    const cycle = () => {
      if (!visible || !auto) return;
      set("asis");
      run(() => {
        timer = window.setTimeout(() => {
          if (!visible || !auto) return;
          set("tobe");
          run(() => {
            timer = window.setTimeout(cycle, 2600);
          });
        }, 900);
      });
    };

    const stop = () => {
      cancelAnimationFrame(frame);
      clearTimeout(timer);
      section.removeAttribute("data-waiting");
    };

    buttons.forEach((b, i) => {
      b.addEventListener("click", () => {
        auto = false;
        stop();
        set(b.dataset.acLanePick as "asis" | "tobe");
        run(() => {});
      });
      b.addEventListener("keydown", (e) => {
        if (e.key !== "ArrowLeft" && e.key !== "ArrowRight") return;
        e.preventDefault();
        const next = buttons[(i + (e.key === "ArrowRight" ? 1 : buttons.length - 1)) % buttons.length];
        next.focus();
        next.click();
      });
    });

    set(reduced ? "tobe" : "asis");

    new IntersectionObserver(
      ([entry]) => {
        visible = entry.isIntersecting;
        stop();
        if (visible && auto) cycle();
      },
      { threshold: 0.25 },
    ).observe(section.querySelector("[data-ac-lane-frame]")!);
  });
</script>
