---
import GridRules from "@/components/GridRules.astro";
import SectionHead from "@/components/SectionHead.astro";
import Joints from "@/components/process/Joints.astro";
import type { SectionPhoto } from "@/types/page";

/* Requirement to story, on the light tone. The header splits around a photo
   of an analyst at a board. Under it, one frame: on the left a stakeholder's
   words as said on a discovery call, on the right the user story they
   become. As the section arrives the analyst's marker picks out three
   phrases in turn (who, what, why), each numbered, and the matching slot of
   the story fills with the rewritten line; then the Given / When / Then
   criteria arrive and the story is stamped ready. It all runs back when the
   section leaves. Every slot holds its placeholder and its text in one grid
   cell, so nothing moves. Without the script, or under reduced motion, the
   finished story shows. See docs/sections.md. */

type QuotePart = string | { text: string; mark: number };

interface Props {
  id: string;
  eyebrow: string;
  headline: string[];
  accent?: number;
  lede: string;
  media: SectionPhoto;
  quote: { label: string; who: string; parts: QuotePart[] };
  story: {
    label: string;
    ref: string;
    meta: string;
    status: string;
    lines: { lead: string; text: string }[];
  };
  criteriaLabel: string;
  criteria: { given: string; when: string; then: string }[];
}

const { id, eyebrow, headline, accent = headline.length - 1, lede, media, quote, story, criteriaLabel, criteria } =
  Astro.props;
---

<section data-ac-sec="light" data-ac-story id={id}>
  <GridRules />

  <div data-ac-sec-container>
    <SectionHead eyebrow={eyebrow} headline={headline} accent={accent} lede={lede} media={media} />

    <div data-ac-sec-frame data-ac-story-frame>
      <Joints />

      <figure data-ac-story-quote>
        <figcaption class="mono-label-sm">{quote.label}</figcaption>
        <blockquote>
          <p>
            “{quote.parts.map((part) =>
              typeof part === "string" ? (
                part
              ) : (
                <mark data-ac-story-mark={part.mark} style={`--ac-n:${part.mark}`}>
                  <sup aria-hidden="true">{part.mark}</sup>{part.text}
                </mark>
              ),
            )}”
          </p>
        </blockquote>
        <p data-ac-story-who class="mono-label-sm">{quote.who}</p>
      </figure>

      <div data-ac-story-arrow aria-hidden="true">
        <svg viewBox="0 0 24 24" width="20" height="20"><path d="M4 12h15m-6-6 6 6-6 6" fill="none" stroke="currentColor" stroke-width="1.6" /></svg>
      </div>

      <article data-ac-story-card aria-label={`${story.label} ${story.ref}`}>
        <header data-ac-story-top>
          <span class="mono-label-sm">{story.label}</span>
          <span data-ac-story-ref class="mono-label-sm">{story.ref} · {story.meta}</span>
        </header>

        <ol data-ac-story-lines>
          {story.lines.map((line, i) => (
            <li style={`--ac-n:${i + 1}`}>
              <span data-ac-story-num aria-hidden="true">{i + 1}</span>
              <span data-ac-story-lead>{line.lead}</span>
              <span data-ac-story-slot>
                <span data-ac-story-text>{line.text}</span>
                <span data-ac-story-blank aria-hidden="true" />
              </span>
            </li>
          ))}
        </ol>

        <p data-ac-story-crit-label class="mono-label-sm">{criteriaLabel}</p>
        <ul data-ac-story-crit>
          {criteria.map((c, i) => (
            <li style={`--ac-i:${i}`}>
              <span><b>Given</b> {c.given}</span>{" "}
              <span><b>When</b> {c.when}</span>{" "}
              <span><b>Then</b> {c.then}</span>
            </li>
          ))}
        </ul>

        <p data-ac-story-status>
          <svg viewBox="0 0 16 16" width="14" height="14" aria-hidden="true"><path d="m3.5 8.5 3 3 6-7" fill="none" stroke="currentColor" stroke-width="1.8" /></svg>
          <span class="mono-label-sm">{story.status}</span>
        </p>
      </article>
    </div>
  </div>
</section>

<script>
  import { toggleInView } from "@/lib/in-view";

  /* Arming the start state only here keeps the finished story for readers
     without the script. */
  const reduced = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
  document.querySelectorAll<HTMLElement>("[data-ac-story]").forEach((section) => {
    if (!reduced) section.setAttribute("data-ac-armed", "");
    toggleInView(section);
  });
</script>
