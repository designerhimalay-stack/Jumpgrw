---
import { Image } from "astro:assets";
import GridRules from "@/components/GridRules.astro";
import SectionHead from "@/components/SectionHead.astro";
import TechLogo from "@/components/TechLogo.astro";
import Joints from "@/components/process/Joints.astro";
import type { TechLogoSlug } from "@/lib/tech-logos";
import type { SectionPhoto } from "@/types/page";
import { codeLines } from "@/lib/code-lines";

/* One feature, built end to end, on the dark tone. A frame on the columns:
   a photo of developers at work in column 1, the running feature (a team
   settings screen with an invite form) in column 2, and its code in columns
   3–4 as three tabs, schema, API and component. The tabs step on their own
   while the section is in view, a rail under the open tab filling as it
   plays; each step lights the part of the screen that code produces (the
   pending row, the 201 toast, the form). Picking a tab (click, or arrow
   keys) stops the stepping. All panes share one grid cell, so nothing
   moves. Without the script the schema tab shows. See docs/sections.md. */

interface Step {
  label: string;
  logo: TechLogoSlug;
  file: string;
  /** Plain source; lightly coloured on the server. */
  code: string;
  /** The part of the screen this step lights, and its tag there. */
  tag: string;
}

interface Member {
  name: string;
  role: string;
  initials: string;
  pending?: boolean;
}

interface Props {
  id: string;
  eyebrow: string;
  headline: string[];
  accent?: number;
  lede: string;
  media: SectionPhoto;
  screen: {
    path: string;
    title: string;
    members: Member[];
    field: string;
    value: string;
    button: string;
    toast: string;
  };
  steps: [Step, Step, Step];
  tabsLabel: string;
}

const { id, eyebrow, headline, accent, lede, media, screen, steps, tabsLabel } = Astro.props;

const panes = steps.map((s) => codeLines(s.code));
---

<section data-ac-sec="dark" data-ac-e2e id={id}>
  <GridRules />

  <div data-ac-sec-container>
    <SectionHead eyebrow={eyebrow} headline={headline} accent={accent} lede={lede} />

    <div data-ac-sec-frame data-ac-e2e-frame data-step="0">
      <Joints />

      <div data-ac-e2e-photo>
        <Image
          src={media.image}
          alt={media.alt}
          widths={[400, 700, 1000]}
          sizes="(max-width: 991px) 100vw, 24vw"
          quality={78}
          style={media.focus ? `object-position:${media.focus}` : undefined}
        />
      </div>

      <div data-ac-e2e-screen aria-label={screen.title} role="img">
        <p data-ac-e2e-chrome aria-hidden="true">
          <i /><i /><i />
          <span>{screen.path}</span>
        </p>
        <div data-ac-e2e-app aria-hidden="true">
          <p data-ac-e2e-title>{screen.title}</p>
          <ul data-ac-e2e-members>
            {screen.members.map((m) => (
              <li data-pending={m.pending || undefined} data-part={m.pending ? "0" : undefined}>
                <span data-ac-e2e-avatar>{m.initials}</span>
                <span data-ac-e2e-who>{m.name}</span>
                <span data-ac-e2e-role>{m.role}</span>
                {m.pending && <em data-ac-e2e-tag>{steps[0].tag}</em>}
              </li>
            ))}
          </ul>
          <div data-ac-e2e-form data-part="2">
            <em data-ac-e2e-tag>{steps[2].tag}</em>
            <span data-ac-e2e-field>{screen.field}</span>
            <span data-ac-e2e-input>{screen.value}</span>
            <span data-ac-e2e-button>{screen.button}</span>
          </div>
          <p data-ac-e2e-toast data-part="1">
            <em data-ac-e2e-tag>{steps[1].tag}</em>
            <b>201</b>
            {screen.toast}
          </p>
        </div>
      </div>

      <div data-ac-e2e-code>
        <div data-ac-e2e-tabs role="tablist" aria-label={tabsLabel}>
          {steps.map((s, i) => (
            <button
              type="button"
              role="tab"
              id={`${id}-tab-${i}`}
              aria-controls={`${id}-pane-${i}`}
              aria-selected={i === 0 ? "true" : "false"}
              tabindex={i === 0 ? 0 : -1}
              data-ac-e2e-tab={i}
            >
              <span data-ac-e2e-num class="mono-label-sm">0{i + 1}</span>
              <TechLogo slug={s.logo} size={16} tone="white" />
              <span>{s.label}</span>
              <span data-ac-e2e-rail aria-hidden="true"><i /></span>
            </button>
          ))}
        </div>
        <div data-ac-e2e-panes>
          {steps.map((s, i) => (
            <div
              data-ac-e2e-pane={i}
              role="tabpanel"
              id={`${id}-pane-${i}`}
              aria-labelledby={`${id}-tab-${i}`}
              tabindex="0"
            >
              <pre><code set:html={panes[i]} /></pre>
              <p data-ac-e2e-file class="mono-label-sm">{s.file}</p>
            </div>
          ))}
        </div>
      </div>
    </div>
  </div>
</section>

<script>
  document.querySelectorAll<HTMLElement>("[data-ac-e2e]").forEach((section) => {
    const frame = section.querySelector<HTMLElement>("[data-ac-e2e-frame]")!;
    const tabs = Array.from(section.querySelectorAll<HTMLButtonElement>("[data-ac-e2e-tab]"));
    const reduced = window.matchMedia("(prefers-reduced-motion: reduce)").matches;

    const select = (i: number, focus = false) => {
      frame.dataset.step = String(i);
      tabs.forEach((t, n) => {
        t.setAttribute("aria-selected", String(n === i));
        t.tabIndex = n === i ? 0 : -1;
      });
      if (focus) tabs[i].focus();
    };

    /* Steps on its own: the open tab's rail fills (CSS), and when it ends
       the next tab opens. A pick by the reader stops it for good. */
    let auto = !reduced;
    const stop = () => {
      auto = false;
      frame.removeAttribute("data-playing");
    };

    tabs.forEach((tab, i) => {
      tab.addEventListener("click", () => {
        stop();
        select(i);
      });
      tab.addEventListener("keydown", (e) => {
        const k = e.key;
        let next = -1;
        if (k === "ArrowRight" || k === "ArrowDown") next = (i + 1) % tabs.length;
        if (k === "ArrowLeft" || k === "ArrowUp") next = (i - 1 + tabs.length) % tabs.length;
        if (k === "Home") next = 0;
        if (k === "End") next = tabs.length - 1;
        if (next < 0) return;
        e.preventDefault();
        stop();
        select(next, true);
      });
      tab.querySelector("[data-ac-e2e-rail] i")?.addEventListener("animationend", () => {
        if (auto) select((i + 1) % tabs.length);
      });
    });

    new IntersectionObserver(
      ([entry]) => {
        section.toggleAttribute("data-ac-in", entry.isIntersecting);
        /* The rail only runs on screen. */
        frame.toggleAttribute("data-playing", auto && entry.isIntersecting);
      },
      { threshold: 0, rootMargin: "-10% 0px -10% 0px" },
    ).observe(section);
  });
</script>
