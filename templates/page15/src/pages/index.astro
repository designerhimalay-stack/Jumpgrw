---
import Layout from "@/layouts/Layout.astro";
import CtaSection from "@/components/CtaSection.astro";
import EndToEndSection from "@/components/EndToEndSection.astro";
import FaqSection from "@/components/FaqSection.astro";
import Footer from "@/components/Footer.astro";
import Navbar from "@/components/Navbar.astro";
import PageHero from "@/components/PageHero.astro";
import SmoothScroll from "@/components/SmoothScroll.astro";
import StackPickerSection from "@/components/StackPickerSection.astro";
import WaterfallSection from "@/components/WaterfallSection.astro";
import type { PageHeroContent } from "@/types/page";
import heroPhoto from "@/assets/pages/p15-hero.jpg";
import featurePhoto from "@/assets/pages/p15-feature.jpg";
import teamPhoto from "@/assets/pages/p15-team.jpg";
import faqPhoto from "@/assets/pages/p15-faq.jpg";
import { BRAND } from "@/lib/brand";

/* Full stack developers. The request timings, the feature's code and the
   pods are illustrative: the timings are plausible for one API call, not
   measurements. The FAQ answers are drafts. Have them checked before
   launch. See docs/sections.md. */

const HERO: PageHeroContent = {
  trail: ["Technologies", "Backend", "Full stack"],
  headline: ["Full stack", "developers."],
  lede: "Engineers who own a feature from database to button: schema, API and interface, shipped by one person who sees the whole request.",
  ctas: [
    { label: "Hire full stack developers", href: "#contact", arrow: "diagonal" },
    { label: "Follow one request", href: "#request", arrow: "right" },
  ],
  image: heroPhoto,
  imageAlt: "A developer with headphones works on a laptop at a bright desk.",
  specs: [
    { label: "Front end", value: "React, Vue, Angular" },
    { label: "Back end", value: "Node.js, Python, Go" },
    { label: "Data", value: "SQL and NoSQL" },
    { label: "Starts", value: "Within two weeks" },
  ],
};

const FAQS = [
  {
    q: "Is one full stack developer enough?",
    a: "For a feature, often yes. For a product, we pair them with a lead and add specialists where depth matters, such as data or design.",
  },
  {
    q: "Which side are they stronger on?",
    a: "We tell you up front. Every profile shows a lean, front end or back end, and we match it to the work you have queued.",
  },
  {
    q: "Can they work in our existing stack?",
    a: "Yes. We staff to your stack, not ours, and the first week is spent reading your code, pipeline and conventions.",
  },
  {
    q: "Who handles deployment?",
    a: "They do, through your pipeline: containers, preview environments and the checks that guard a release.",
  },
];
---

<Layout
  title={`Full stack developers · ${BRAND.name}`}
  description="Full stack engineers who own a feature from database to interface: schema, API and UI, shipped end to end."
  navTone="field"
>
  <SmoothScroll />
  <Navbar />
  <main>
    <PageHero content={HERO} />
    <WaterfallSection
      id="request"
      eyebrow="One request"
      headline={["One click.", "Every layer, timed."]}
      accent={1}
      lede="Follow one checkout request from the browser to the database and back. Our developers own every bar on this chart."
      request={{ method: "POST", path: "/api/checkout", status: "200 OK" }}
      switchLabel="Cache hit"
      totalLabel="Total"
      skippedLabel="Skipped"
      scale={600}
      firstByte={{ label: "First byte", cold: 306, warm: 134 }}
      layers={{ network: "Network", edge: "Edge", backend: "Service", data: "Data", frontend: "Browser" }}
      phases={[
        { name: "DNS lookup", layer: "network", cold: [0, 18], warm: [0, 18] },
        { name: "TCP and TLS", layer: "network", logo: "cloudflare", cold: [18, 46], warm: [18, 46] },
        { name: "Gateway", layer: "edge", logo: "nginx", cold: [64, 14], warm: [64, 14] },
        { name: "Service", layer: "backend", logo: "nodedotjs", cold: [78, 52], warm: [78, 52] },
        {
          name: "Cache",
          layer: "data",
          logo: "redis",
          cold: [130, 6],
          warm: [130, 4],
          note: { cold: "Miss · 6 ms", warm: "Hit · 4 ms" },
        },
        { name: "Database", layer: "data", logo: "postgresql", cold: [136, 170], warm: [134, 0], skippedWarm: true },
        { name: "Response", layer: "network", cold: [306, 38], warm: [134, 38] },
        { name: "Render", layer: "frontend", logo: "react", cold: [344, 68], warm: [172, 68] },
      ]}
    />
    <EndToEndSection
      id="end-to-end"
      eyebrow="End to end"
      headline={["One feature.", "Every layer."]}
      accent={1}
      lede="Invite a teammate: one developer writes the table, the endpoint and the screen, so nothing gets lost between handoffs."
      media={{ image: featurePhoto, alt: "Two developers work through a feature together on a laptop.", focus: "62% 40%" }}
      tabsLabel="The feature's code, layer by layer"
      screen={{
        path: "/settings/team",
        title: "Team",
        members: [
          { name: "Maya Chen", role: "Admin", initials: "MC" },
          { name: "Luis Ortega", role: "Member", initials: "LO" },
          { name: "sam@example.com", role: "Pending", initials: "S", pending: true },
        ],
        field: "Invite by email",
        value: "sam@example.com",
        button: "Send invite",
        toast: "Invite sent",
      }}
      steps={[
        {
          label: "Schema",
          logo: "prisma",
          file: "prisma/schema.prisma",
          tag: "Data",
          code: `
model Invite {
  id        String   @id @default(cuid())
  email     String
  role      Role     @default(MEMBER)
  status    Status   @default(PENDING)
  team      Team     @relation(fields: [teamId])
  teamId    String
  createdAt DateTime @default(now())

  @@unique([email, teamId])
}`,
        },
        {
          label: "API",
          logo: "nodedotjs",
          file: "server/routes/invites.ts",
          tag: "API",
          code: `
app.post("/api/invites", auth, async (req, res) => {
  const { email, role } = InviteInput.parse(req.body);

  const invite = await db.invite.create({
    data: { email, role, teamId: req.team.id },
  });

  await mailer.send(inviteEmail(invite));
  res.status(201).json(invite);
});`,
        },
        {
          label: "Component",
          logo: "react",
          file: "web/team/InviteForm.tsx",
          tag: "UI",
          code: `
export function InviteForm() {
  const invite = useMutation(api.createInvite);

  return (
    <form action={invite.mutate}>
      <input name="email" type="email" required />
      <button disabled={invite.isPending}>
        Send invite
      </button>
    </form>
  );
}`,
        },
      ]}
    />
    <StackPickerSection
      id="stack"
      eyebrow="Your stack"
      headline={["Pick your stack.", "We match the pod."]}
      accent={1}
      lede="Choose one tool for each layer and see the pod that fits it. We staff most combinations within two weeks."
      media={{ image: teamPhoto, alt: "Three developers review work together on two laptops in an open office.", focus: "50% 45%" }}
      layers={[
        {
          key: "front",
          name: "Front end",
          options: [
            { key: "react", name: "React", logo: "react" },
            { key: "vue", name: "Vue", logo: "vuedotjs" },
            { key: "angular", name: "Angular", logo: "angular" },
            { key: "next", name: "Next.js", logo: "nextdotjs" },
          ],
        },
        {
          key: "back",
          name: "Back end",
          options: [
            { key: "node", name: "Node.js", logo: "nodedotjs" },
            { key: "python", name: "Python", logo: "python" },
            { key: "go", name: "Go", logo: "go" },
          ],
        },
        {
          key: "data",
          name: "Data",
          options: [
            { key: "postgres", name: "PostgreSQL", logo: "postgresql" },
            { key: "mongo", name: "MongoDB", logo: "mongodb" },
            { key: "supabase", name: "Supabase", logo: "supabase" },
          ],
        },
        {
          key: "api",
          name: "API",
          options: [
            { key: "rest", name: "REST", glyph: "{ }" },
            { key: "graphql", name: "GraphQL", logo: "graphql" },
          ],
        },
        {
          key: "ship",
          name: "Shipping",
          options: [
            { key: "docker", name: "Docker", logo: "docker" },
            { key: "k8s", name: "Kubernetes", logo: "kubernetes" },
            { key: "vercel", name: "Vercel", logo: "vercel" },
          ],
        },
      ]}
      pod={{
        title: "Your pod",
        roles: [
          { role: "Lead", line: "{front} + {back}" },
          { role: "Developer", line: "{back} + {data}" },
          { role: "Developer", line: "{front} + {api}" },
          { role: "Shared", line: "{ship} + CI" },
        ],
        note: "Three developers and a shared DevOps engineer, ready in about two weeks.",
      }}
    />
    <FaqSection
      eyebrow="Full stack questions"
      headline={["Front to back,", "answered."]}
      accent={1}
      cta="Talk to a full stack lead"
      faqs={FAQS}
      media={{ image: faqPhoto, alt: "Two developers smile as they review code together at a desk.", focus: "50% 40%" }}
    />
    <CtaSection
      eyebrow="Ready to ship"
      headline={["From schema", "to screen."]}
      body="Tell us your stack and the feature you need next. We’ll put forward developers who can own it end to end."
      cta="Meet full stack developers"
    />
  </main>
  <Footer />
</Layout>
