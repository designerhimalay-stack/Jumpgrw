---
import Layout from "@/layouts/Layout.astro";
import BilingualSection from "@/components/BilingualSection.astro";
import CtaSection from "@/components/CtaSection.astro";
import FaqSection from "@/components/FaqSection.astro";
import FlightsSection from "@/components/FlightsSection.astro";
import Footer from "@/components/Footer.astro";
import FrostSection from "@/components/FrostSection.astro";
import MosaicSection from "@/components/MosaicSection.astro";
import Navbar from "@/components/Navbar.astro";
import PageHero from "@/components/PageHero.astro";
import PassSection from "@/components/PassSection.astro";
import SmoothScroll from "@/components/SmoothScroll.astro";
import type { PageHeroContent } from "@/types/page";
import heroPhoto from "@/assets/pages/p32-hero.jpg";
import flightsPhoto from "@/assets/pages/p32-flights.jpg";
import bilingualPhoto from "@/assets/pages/p32-bilingual.jpg";
import torontoPhoto from "@/assets/pages/p32-dev-toronto.jpg";
import vancouverPhoto from "@/assets/pages/p32-dev-vancouver.jpg";
import montrealPhoto from "@/assets/pages/p32-dev-montreal.jpg";
import libertyPhoto from "@/assets/pages/p32-dev-liberty.jpg";
import passPhoto from "@/assets/pages/p32-pass.jpg";
import faqPhoto from "@/assets/pages/p32-faq-toronto.jpg";
import { BRAND } from "@/lib/brand";

/* Nearshore engineers, Canada. The same kinds of content as the Mexico
   page, turned to what Canada brings: US time-zone alignment, a short
   flight away, and a bilingual English and French talent pool. Flight
   times are approximate nonstop times; the FAQ answers are drafts. Have
   them checked before launch. See docs/sections.md. */

const HERO: PageHeroContent = {
  trail: ["X-Shore", "Nearshore", "Canada"],
  headline: ["Nearshore,", "in Canada."],
  accent: 1,
  lede: "Senior engineers in Toronto, Vancouver and Montréal: your time zones, a short flight away, and fluent in English and French.",
  ctas: [
    { label: "Plan a Canadian team", href: "#contact", arrow: "diagonal" },
    { label: "See the flight times", href: "#flights", arrow: "right" },
  ],
  image: heroPhoto,
  imageAlt: "An engineer in Ottawa works on a laptop at a counter by a tall window.",
  specs: [
    { label: "Time zones", value: "Pacific to Eastern" },
    { label: "Hubs", value: "Toronto, Vancouver, Montréal" },
    { label: "Languages", value: "English and French" },
    { label: "Led from", value: "Dallas" },
  ],
};

const FAQS = [
  {
    q: "Why Canada rather than offshore?",
    a: "Your working hours, a short flight for workshops, and engineers used to US teams and standards.",
  },
  {
    q: "Can the team build in French?",
    a: "Yes. Engineers in Montréal and Québec City work in both languages, from copy to testing.",
  },
  {
    q: "Can engineers visit our office?",
    a: "Yes. Most US cities are a direct flight from Toronto, Vancouver or Montréal.",
  },
  {
    q: "Can we start with one engineer?",
    a: "Yes. Start with one, add a squad or a full pod as the roadmap grows.",
  },
];
---

<Layout
  title={`Nearshore engineers, Canada · ${BRAND.name}`}
  description="Senior nearshore engineers in Toronto, Vancouver and Montréal: US time zones, a short flight away, and fluent in English and French."
  navTone="field"
>
  <SmoothScroll />
  <Navbar />
  <main>
    <PageHero content={HERO} />
    <FlightsSection
      id="flights"
      eyebrow="A short flight away"
      headline={["Closer than", "your next office."]}
      accent={1}
      lede="Pick a hub to see how far it is from the cities where our clients work."
      media={{ image: flightsPhoto, alt: "An engineer works on a laptop in a bright open office in Montréal.", focus: "62% 70%" }}
      hubs={[
        {
          name: "Toronto",
          lon: -79.4,
          lat: 43.7,
          routes: [
            { to: "New York", time: "1h 30m" },
            { to: "Chicago", time: "1h 45m" },
            { to: "Atlanta", time: "2h 15m" },
            { to: "Dallas", time: "3h 30m" },
            { to: "San Francisco", time: "5h 30m" },
          ],
        },
        {
          name: "Vancouver",
          lon: -123.1,
          lat: 49.3,
          routes: [
            { to: "Seattle", time: "1h" },
            { to: "San Francisco", time: "2h 15m" },
            { to: "Denver", time: "2h 45m" },
            { to: "Los Angeles", time: "2h 50m" },
            { to: "Dallas", time: "4h" },
          ],
        },
        {
          name: "Montréal",
          lon: -73.6,
          lat: 45.5,
          routes: [
            { to: "Boston", time: "1h 20m" },
            { to: "New York", time: "1h 25m" },
            { to: "Chicago", time: "2h 10m" },
            { to: "Atlanta", time: "2h 40m" },
            { to: "Dallas", time: "4h" },
          ],
        },
      ]}
      cities={[
        { name: "Seattle", lon: -122.3, lat: 47.6 },
        { name: "San Francisco", lon: -122.4, lat: 37.8 },
        { name: "Los Angeles", lon: -118.2, lat: 34.1 },
        { name: "Denver", lon: -105, lat: 39.7 },
        { name: "Dallas", lon: -96.8, lat: 32.8 },
        { name: "Chicago", lon: -87.6, lat: 41.9 },
        { name: "Atlanta", lon: -84.4, lat: 33.7 },
        { name: "New York", lon: -74, lat: 40.7 },
        { name: "Boston", lon: -71.1, lat: 42.4, side: "right" },
      ]}
      footnote="Approximate nonstop flight times. Map not to scale."
    />
    <BilingualSection
      id="bilingual"
      eyebrow="English and French"
      headline={["Two languages.", "One team."]}
      accent={1}
      lede="Canada’s talent pool works in English and French, so products for both markets are built right the first time."
      media={{ image: bilingualPhoto, alt: "Web developers work at a row of screens in a studio in Québec City.", focus: "50% 50%" }}
      points={[
        { title: "Built in both", body: "Copy, forms and tests in English and French." },
        { title: "Ready for Québec", body: "French-first screens where the market expects them." },
      ]}
      screen={{
        app: "app · sign in",
        title: { en: "Welcome back", fr: "Bon retour" },
        body: { en: "Sign in to manage your account.", fr: "Connectez-vous pour gérer votre compte." },
        fields: [
          { en: "Email", fr: "Courriel" },
          { en: "Password", fr: "Mot de passe" },
        ],
        button: { en: "Sign in", fr: "Se connecter" },
        note: { en: "Forgot your password?", fr: "Mot de passe oublié?" },
      }}
    />
    <MosaicSection
      id="people"
      eyebrow="The people"
      headline={["Engineers in", "three cities."]}
      accent={1}
      lede="Senior engineers across Canada, matched to your stack and your team."
      tiles={[
        {
          kind: "photo",
          media: { image: torontoPhoto, alt: "A developer in Toronto works through code on a monitor.", focus: "60% 40%" },
          role: "Full-stack developer",
          city: "Toronto",
        },
        {
          kind: "skill",
          title: "Web and mobile",
          body: "Product features, end to end.",
          stack: "React · Swift · Kotlin",
        },
        {
          kind: "photo",
          media: { image: vancouverPhoto, alt: "An engineer in Vancouver works at a desk in a bright room.", focus: "55% 50%" },
          role: "Software engineer",
          city: "Vancouver",
        },
        {
          kind: "skill",
          title: "Cloud and platform",
          body: "Infrastructure your team can run.",
          stack: "Kubernetes · Terraform",
        },
        {
          kind: "skill",
          title: "Data and AI",
          body: "Pipelines and models in production.",
          stack: "Python · PyTorch",
        },
        {
          kind: "photo",
          media: { image: montrealPhoto, alt: "A front-end developer in Montréal reads code on a screen.", focus: "70% 50%" },
          role: "Front-end developer",
          city: "Montréal",
        },
        {
          kind: "photo",
          media: { image: libertyPhoto, alt: "An engineer in Toronto works on a laptop in a meeting room.", focus: "70% 50%" },
          role: "Product engineer",
          city: "Toronto",
        },
      ]}
      footnote={`Example roles. ${BRAND.name} confirms availability and fit before you decide.`}
    />
    <FrostSection
      id="stack"
      eyebrow="Tech we use"
      headline={["Your stack,", "in clear view."]}
      accent={1}
      lede="Engineers who already work in the tools your product runs on."
      label="Toronto · 8:40 a.m. · −14 °C"
      panes={[
        {
          name: "Web and mobile",
          leaves: [
            { slug: "react", note: "Web apps" },
            { slug: "nextdotjs", note: "Full-stack web" },
            { slug: "swift", note: "iOS" },
            { slug: "kotlin", note: "Android" },
          ],
        },
        {
          name: "Back end and APIs",
          leaves: [
            { slug: "nodedotjs", note: "APIs and services" },
            { slug: "python", note: "Services and data" },
            { slug: "spring", note: "Java services" },
            { slug: "graphql", note: "API layer" },
          ],
        },
        {
          name: "Data and AI",
          leaves: [
            { slug: "postgresql", note: "Relational data" },
            { slug: "mongodb", note: "Document data" },
            { slug: "pytorch", note: "Model training" },
            { slug: "tensorflow", note: "Models in production" },
          ],
        },
        {
          name: "Cloud and DevOps",
          leaves: [
            { slug: "docker", note: "Containers" },
            { slug: "kubernetes", note: "Orchestration" },
            { slug: "terraform", note: "Infrastructure as code" },
            { slug: "googlecloud", note: "Cloud platform" },
          ],
        },
      ]}
      footnote="AWS and Azure too: we work in the cloud you already run."
    />
    <PassSection
      id="how"
      eyebrow="How it works"
      headline={["Five steps", "to take-off."]}
      accent={1}
      lede="From the first call to an engineer shipping in your sprint."
      media={{ image: passPhoto, alt: "An engineer in Toronto smiles during a team meeting.", focus: "65% 40%" }}
      stub={[
        { label: "From", value: "Canada" },
        { label: "To", value: "Your team" },
        { label: "Class", value: "Senior" },
        { label: "Overlap", value: "Full US day" },
      ]}
      legs={[
        { gate: "Check-in", title: "Discovery call", body: "Your roadmap, team gap and stack.", when: "Day 1" },
        { gate: "Seat", title: "Pick the model", body: "One engineer, a squad or a pod.", when: "Week 1" },
        { gate: "Boarding", title: "Pre-vetted profiles", body: "Matched to your stack and hours.", when: "Week 1" },
        { gate: "Gate", title: "Interview & select", body: "Meet them and choose who joins.", when: "Week 2" },
        { gate: "Take-off", title: "Onboard & kick off", body: "Access, rituals, a first task.", when: "Week 3" },
      ]}
      stamp="Cleared"
    />
    <FaqSection
      eyebrow="Common questions"
      headline={["Before you", "hire in Canada."]}
      accent={1}
      cta="Talk to our team"
      faqs={FAQS}
      media={{ image: faqPhoto, alt: "An engineer in Toronto works at her desk by a tall office window.", focus: "62% 50%" }}
    />
    <CtaSection
      eyebrow="Bonjour, hello"
      headline={["Your next team,", "one flight north."]}
      body="Tell us what you’re building, and we’ll shape a Canadian team in your hours and your languages."
      cta="Plan my Canadian team"
    />
  </main>
  <Footer />
</Layout>
