---
import GridRules from "@/components/GridRules.astro";
import SectionHead from "@/components/SectionHead.astro";
import Joints from "@/components/process/Joints.astro";

/* The roadmap, in motion. A Now / Next / Later board under a milestone rail.
   The board's progress is tied to the scroll: as it travels up the screen
   the rail fills from its first milestone to its last, and at each one every
   card moves a column to the left (Later to Next to Now), the card that was
   in Now marking itself shipped. Scroll back and it all runs in reverse.
   Cards are outcome statements with a small metric chip. Every card sits in
   one fixed field and moves by transform, so nothing on the page moves.
   Without the script the board shows its last stage. See docs/sections.md. */

interface Card {
  title: string;
  metric: string;
}

interface Props {
  id: string;
  eyebrow: string;
  headline: string[];
  accent?: number;
  lede: string;
  /** Column names, left to right: Now, Next, Later. */
  columns: [string, string, string];
  /** Three milestones on the rail, one per stage. */
  milestones: [string, string, string];
  /** Six cards, in priority order: the first is in Now at the start. */
  cards: Card[];
  shippedLabel: string;
}

const { id, eyebrow, headline, accent, lede, columns, milestones, cards, shippedLabel } = Astro.props;
const STAGES = 3;

/* Where card k sits at stage s. Now holds cards 0..s (those before s are
   shipped), Next the two after, Later the rest; rows fill from the top. */
const place = (k: number, s: number) => {
  if (k <= s) return { col: 0, row: k, state: k < s ? "shipped" : "now" };
  if (k <= s + 2) return { col: 1, row: k - s - 1, state: "next" };
  return { col: 2, row: k - s - 3, state: "later" };
};
const counts = Array.from({ length: STAGES }, (_, s) =>
  [0, 1, 2].map((c) => cards.filter((_, k) => place(k, s).col === c).length),
);
---

<section data-ac-sec="light" data-ac-road id={id}>
  <GridRules />

  <div data-ac-sec-container>
    <SectionHead eyebrow={eyebrow} headline={headline} accent={accent} lede={lede} />

    <div data-ac-road-rail aria-hidden="true">
      <span data-ac-road-track><i data-ac-road-fill /></span>
      {milestones.map((m, i) => (
        <span data-ac-road-stop style={`--ac-at:${i / (STAGES - 1)}`} data-reached>
          <i />
          <span class="mono-label-sm">{m}</span>
        </span>
      ))}
    </div>

    <div data-ac-sec-frame data-ac-road-board data-stage={STAGES - 1}>
      <Joints />
      <div data-ac-road-heads>
        {columns.map((name, c) => (
          <p data-ac-road-head data-col={c}>
            <span>{name}</span>
            <span data-ac-road-count aria-hidden="true">
              {counts.map((row, s) => <b data-at={s}>{row[c]}</b>)}
            </span>
          </p>
        ))}
      </div>

      <div data-ac-road-field>
        <span data-ac-road-slots aria-hidden="true">
          {Array.from({ length: 9 }, () => <i />)}
        </span>
        <ol data-ac-road-cards>
          {cards.map((card, k) => {
            const at = Array.from({ length: STAGES }, (_, s) => place(k, s));
            const vars = at.map((p, s) => `--c${s}:${p.col};--r${s}:${p.row}`).join(";");
            const attrs = Object.fromEntries(at.map((p, s) => [`data-s${s}`, p.state]));
            return (
              <li data-ac-road-card style={vars} {...attrs}>
                <span data-ac-road-title>{card.title}</span>
                <span data-ac-road-chip>
                  <svg viewBox="0 0 12 12" aria-hidden="true"><path d="M2 8.5 5 5.5l2 2L10 4" /></svg>
                  {card.metric}
                </span>
                <span data-ac-road-shipped class="mono-label-sm" aria-hidden="true">
                  <svg viewBox="0 0 24 24"><path d="M20 6 9 17l-5-5" /></svg>
                  {shippedLabel}
                </span>
              </li>
            );
          })}
        </ol>
      </div>
    </div>
  </div>
</section>

<script>
  import { toggleInView } from "@/lib/in-view";

  document.querySelectorAll<HTMLElement>("[data-ac-road]").forEach((section) => {
    toggleInView(section);

    const board = section.querySelector<HTMLElement>("[data-ac-road-board]")!;
    const rail = section.querySelector<HTMLElement>("[data-ac-road-rail]")!;
    const stops = Array.from(section.querySelectorAll<HTMLElement>("[data-ac-road-stop]"));
    const last = stops.length - 1;
    let queued = false;

    /* Progress runs from the board's top at 85% of the screen to its foot
       at 62%; the rail is full at 80% of that, and each milestone the rail
       reaches is a stage. */
    const update = () => {
      queued = false;
      const vh = window.innerHeight;
      const r = board.getBoundingClientRect();
      const start = vh * 0.85;
      const end = vh * 0.62 - r.height;
      const p = Math.min(1, Math.max(0, (start - r.top) / Math.max(200, start - end)));
      const fill = Math.min(1, p / 0.8);
      const stage = Math.min(last, Math.floor(fill * last + 0.0001));
      rail.style.setProperty("--ac-fill", fill.toFixed(4));
      stops.forEach((stop, i) => stop.toggleAttribute("data-reached", i <= stage));
      if (board.dataset.stage !== String(stage)) board.dataset.stage = String(stage);
    };
    const queue = () => {
      if (queued) return;
      queued = true;
      requestAnimationFrame(update);
    };

    /* Only listen while the section is near the screen. */
    new IntersectionObserver(
      ([entry]) => {
        if (entry.isIntersecting) window.addEventListener("scroll", queue, { passive: true });
        else window.removeEventListener("scroll", queue);
        queue();
      },
      { rootMargin: "200px 0px" },
    ).observe(section);
    window.addEventListener("resize", queue);
    update();
  });
</script>
