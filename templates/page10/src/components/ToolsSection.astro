---
import GridRules from "@/components/GridRules.astro";
import SectionHead from "@/components/SectionHead.astro";
import TechLogo from "@/components/TechLogo.astro";
import Joints from "@/components/process/Joints.astro";
import { TECH_LOGOS, type TechLogoSlug } from "@/lib/tech-logos";

/* The tools they drive, as a keyboard. Columns 1–3: a deck of keycaps, one
   per tool, each carrying the tool's logo, laid out in staggered rows like a
   real board, a category on each row's modifier key and a wide space bar
   at the foot. Keys press down under the pointer and on focus, and ripple
   down in turn as the section arrives. Column 4: a display that reads out
   the last key pressed, its logo, name and a one-line note, every reading
   stacked in one cell so nothing moves. Phones drop the modifier keys and
   show the display above the keys. See docs/sections.md. */

interface Key {
  slug: TechLogoSlug;
  note: string;
}

interface Row {
  /** The category, on the row's modifier key. */
  label: string;
  keys: Key[];
}

interface Props {
  id: string;
  eyebrow: string;
  headline: string[];
  accent?: number;
  lede: string;
  /** Three rows of keys (5, 4 and 4 fit the board). */
  rows: [Row, Row, Row];
  /** The foot row: a modifier, a key either side of the space bar. */
  foot: { label: string; left: Key; right: Key; space: { label: string; note: string } };
  prompt: { label: string; title: string; note: string };
}

const { id, eyebrow, headline, accent, lede, rows, foot, prompt } = Astro.props;

/* Widths in quarter-key units; every row adds up to 29. A key is 4. */
const LEAD = [6, 7, 9];
const TRAIL = ["⌫", "return", "⇧"];
const trailWidth = (r: number) => 29 - LEAD[r] - rows[r].keys.length * 4;
const spaceWidth = 29 - 5 - 8;

let n = 0;
const allKeys = [...rows.flatMap((r) => r.keys), foot.left, foot.right];
---

<section data-ac-sec="light" data-ac-keys id={id}>
  <GridRules />

  <div data-ac-sec-container>
    <SectionHead eyebrow={eyebrow} headline={headline} accent={accent} lede={lede} />

    <div data-ac-keys-grid>
      <div data-ac-sec-frame data-ac-keys-deck>
        <Joints />
        {rows.map((row, r) => (
          <div data-ac-keys-row>
            <span data-ac-keys-mod style={`--ac-w:${LEAD[r]}`}>
              <span class="mono-label-sm">{row.label}</span>
            </span>
            {row.keys.map((key) => (
              <button type="button" data-ac-keys-key data-slug={key.slug} style={`--ac-w:4;--ac-i:${n++}`}>
                <span data-ac-keys-cap>
                  <TechLogo slug={key.slug} size={30} />
                  <span data-ac-keys-name>{TECH_LOGOS[key.slug].title}</span>
                  <span class="sr-only">: {key.note}</span>
                </span>
              </button>
            ))}
            {trailWidth(r) > 0 && (
              <span data-ac-keys-mod data-trail style={`--ac-w:${trailWidth(r)}`} aria-hidden="true">
                <span class="mono-label-sm">{TRAIL[r]}</span>
              </span>
            )}
          </div>
        ))}
        <div data-ac-keys-row data-foot>
          <span data-ac-keys-mod style="--ac-w:5">
            <span class="mono-label-sm">{foot.label}</span>
          </span>
          {[foot.left].map((key) => (
            <button type="button" data-ac-keys-key data-slug={key.slug} style={`--ac-w:4;--ac-i:${n++}`}>
              <span data-ac-keys-cap>
                <TechLogo slug={key.slug} size={30} />
                <span data-ac-keys-name>{TECH_LOGOS[key.slug].title}</span>
                <span class="sr-only">: {key.note}</span>
              </span>
            </button>
          ))}
          <button type="button" data-ac-keys-key data-space data-slug="space" style={`--ac-w:${spaceWidth};--ac-i:${n++}`}>
            <span data-ac-keys-cap>
              <span data-ac-keys-name>{foot.space.label}</span>
              <span class="sr-only">: {foot.space.note}</span>
            </span>
          </button>
          {[foot.right].map((key) => (
            <button type="button" data-ac-keys-key data-slug={key.slug} style={`--ac-w:4;--ac-i:${n++}`}>
              <span data-ac-keys-cap>
                <TechLogo slug={key.slug} size={30} />
                <span data-ac-keys-name>{TECH_LOGOS[key.slug].title}</span>
                <span class="sr-only">: {key.note}</span>
              </span>
            </button>
          ))}
        </div>
      </div>

      <div data-ac-keys-screen aria-hidden="true">
        <Joints />
        <span data-ac-keys-screen-label class="mono-label-sm"><i />{prompt.label}</span>
        <p data-ac-keys-read data-slug="" data-on>
          <span data-ac-keys-read-mark data-prompt>
            <svg viewBox="0 0 24 24"><path d="M9 3v4M15 3v4M9 17v4M15 17v4M3 9h4M3 15h4M17 9h4M17 15h4M7 7h10v10H7z" /></svg>
          </span>
          <span data-ac-keys-read-title>{prompt.title}</span>
          <span data-ac-keys-read-note>{prompt.note}</span>
        </p>
        {allKeys.map((key) => (
          <p data-ac-keys-read data-slug={key.slug}>
            <span data-ac-keys-read-mark>
              <TechLogo slug={key.slug} size={40} />
            </span>
            <span data-ac-keys-read-title>{TECH_LOGOS[key.slug].title}</span>
            <span data-ac-keys-read-note>{key.note}</span>
          </p>
        ))}
        <p data-ac-keys-read data-slug="space">
          <span data-ac-keys-read-mark data-prompt>
            <svg viewBox="0 0 24 24"><path d="M4 10v4h16v-4" /></svg>
          </span>
          <span data-ac-keys-read-title>{foot.space.label}</span>
          <span data-ac-keys-read-note>{foot.space.note}</span>
        </p>
      </div>
    </div>
  </div>
</section>

<script>
  import { toggleInView } from "@/lib/in-view";

  document.querySelectorAll<HTMLElement>("[data-ac-keys]").forEach((section) => {
    toggleInView(section);

    const reads = Array.from(section.querySelectorAll<HTMLElement>("[data-ac-keys-read]"));
    const show = (slug: string) => reads.forEach((r) => r.toggleAttribute("data-on", r.dataset.slug === slug));

    /* The display keeps the last key pressed, pointed at or focused. */
    section.querySelectorAll<HTMLElement>("[data-ac-keys-key]").forEach((key) => {
      const slug = key.dataset.slug ?? "";
      key.addEventListener("pointerenter", () => show(slug));
      key.addEventListener("focus", () => show(slug));
      key.addEventListener("click", () => show(slug));
    });
  });
</script>
