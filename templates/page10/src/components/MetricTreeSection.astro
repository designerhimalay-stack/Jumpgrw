---
import { Image } from "astro:assets";
import GridRules from "@/components/GridRules.astro";
import RevealText from "@/components/RevealText.astro";
import Joints from "@/components/process/Joints.astro";
import type { SectionPhoto } from "@/types/page";

/* A metric tree, on the dark tone. The header splits: headline and lede in
   columns 1–2, a photo of the team reading the numbers in columns 3–4.
   Under it, across the page, the north-star metric at the head of the tree,
   branching into four input metrics, each with the lever the team is
   pulling on it. As the section arrives the branches draw down from the
   north star (stem, then the bar, then a drop to each input) and every
   figure counts up from zero; it all runs back when the section leaves.
   Phones hang the inputs off a rail down the left, the rail ending at the
   last input's joint. Without the script the figures show as
   written. See docs/sections.md. */

interface Metric {
  label: string;
  value: number;
  /** Decimal places to count in. */
  decimals?: number;
  prefix?: string;
  suffix?: string;
  change: string;
}

interface Props {
  id: string;
  eyebrow: string;
  headline: string[];
  accent?: number;
  lede: string;
  media: SectionPhoto;
  northStar: Metric & { tag: string };
  inputs: (Metric & { lever: string })[];
  leverLabel: string;
}

const { id, eyebrow, headline, accent = headline.length - 1, lede, media, northStar, inputs, leverLabel } = Astro.props;
const offsets = headline.map((_, i) => headline.slice(0, i).reduce((n, line) => n + Array.from(line).length + 1, 0));
const format = (m: Metric) =>
  `${m.prefix ?? ""}${m.value.toLocaleString("en-US", { minimumFractionDigits: m.decimals ?? 0, maximumFractionDigits: m.decimals ?? 0 })}${m.suffix ?? ""}`;
---

<section data-ac-sec="dark" data-ac-tree id={id} style={`--ac-n:${inputs.length}`}>
  <GridRules />

  <div data-ac-sec-container data-ac-tree-grid>
    <div data-ac-tree-head>
      <p data-ac-sec-eyebrow class="mono-label">
        <span aria-hidden="true">+</span>
        {eyebrow}
      </p>
      <h2 data-ac-tree-headline aria-label={headline.join(" ")}>
        {headline.map((line, i) => (
          <Fragment>
            {i > 0 && <Fragment>{" "}<br aria-hidden="true" /></Fragment>}
            <span data-ac-sec-line data-accent={i === accent || undefined}>
              <RevealText text={line} offset={offsets[i]} />
            </span>
          </Fragment>
        ))}
      </h2>
    </div>
    <p data-ac-tree-lede data-ac-sec-rise>{lede}</p>

    <div data-ac-tree-photo>
      <Joints />
      <div data-ac-tree-image>
        <Image
          src={media.image}
          alt={media.alt}
          widths={[480, 800, 1200]}
          sizes="(max-width: 991px) 100vw, 46vw"
          quality={78}
          style={media.focus ? `object-position:${media.focus}` : undefined}
        />
      </div>
    </div>

    <figure data-ac-tree-figure>
      <Joints />
      <div data-ac-tree-star>
        <span data-ac-tree-tag class="mono-label-sm">{northStar.tag}</span>
        <span data-ac-tree-label>{northStar.label}</span>
        <span data-ac-tree-big>
          <span
            data-ac-tree-num
            data-value={northStar.value}
            data-decimals={northStar.decimals ?? 0}
            data-prefix={northStar.prefix ?? ""}
            data-suffix={northStar.suffix ?? ""}
          >{format(northStar)}</span>
        </span>
        <span data-ac-tree-change>{northStar.change}</span>
      </div>

      <span data-ac-tree-stem aria-hidden="true" />
      <span data-ac-tree-bus aria-hidden="true" />

      <ul data-ac-tree-inputs>
        {inputs.map((m, i) => (
          <li data-ac-tree-input style={`--ac-i:${i}`}>
            <span data-ac-tree-drop aria-hidden="true" />
            <span data-ac-tree-joint aria-hidden="true" />
            <div data-ac-tree-card>
              <span data-ac-tree-label>{m.label}</span>
              <span data-ac-tree-value>
                <span
                  data-ac-tree-num
                  data-value={m.value}
                  data-decimals={m.decimals ?? 0}
                  data-prefix={m.prefix ?? ""}
                  data-suffix={m.suffix ?? ""}
                >{format(m)}</span>
              </span>
              <span data-ac-tree-change>{m.change}</span>
              <span data-ac-tree-lever>
                <span class="mono-label-sm">{leverLabel}</span>
                <span>{m.lever}</span>
              </span>
            </div>
          </li>
        ))}
      </ul>
    </figure>
  </div>
</section>

<script>
  document.querySelectorAll<HTMLElement>("[data-ac-tree]").forEach((section) => {
    const nums = Array.from(section.querySelectorAll<HTMLElement>("[data-ac-tree-num]"));
    const reduced = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
    const fmt = (el: HTMLElement, v: number) => {
      const d = Number(el.dataset.decimals ?? 0);
      el.textContent = `${el.dataset.prefix ?? ""}${v.toLocaleString("en-US", { minimumFractionDigits: d, maximumFractionDigits: d })}${el.dataset.suffix ?? ""}`;
    };
    let frame = 0;

    /* Counts every figure up together, the north star last to land. */
    const count = () => {
      cancelAnimationFrame(frame);
      const t0 = performance.now();
      const tick = (now: number) => {
        let running = false;
        nums.forEach((el, i) => {
          const delay = i === 0 ? 700 : 900 + (i - 1) * 120;
          const dur = i === 0 ? 1800 : 1200;
          const t = Math.min(1, Math.max(0, (now - t0 - delay) / dur));
          if (t < 1) running = true;
          const eased = 1 - Math.pow(1 - t, 3);
          fmt(el, Number(el.dataset.value) * eased);
        });
        if (running) frame = requestAnimationFrame(tick);
      };
      frame = requestAnimationFrame(tick);
    };
    const reset = () => {
      cancelAnimationFrame(frame);
      nums.forEach((el) => fmt(el, 0));
    };

    new IntersectionObserver(
      ([entry]) => {
        section.toggleAttribute("data-ac-in", entry.isIntersecting);
        if (reduced) return;
        if (entry.isIntersecting) count();
        else reset();
      },
      { threshold: 0, rootMargin: "-10% 0px -10% 0px" },
    ).observe(section);
  });
</script>
