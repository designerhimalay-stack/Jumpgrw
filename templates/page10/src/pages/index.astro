---
import Layout from "@/layouts/Layout.astro";
import CtaSection from "@/components/CtaSection.astro";
import FaqSection from "@/components/FaqSection.astro";
import Footer from "@/components/Footer.astro";
import MetricTreeSection from "@/components/MetricTreeSection.astro";
import Navbar from "@/components/Navbar.astro";
import PageHero from "@/components/PageHero.astro";
import RoadmapSection from "@/components/RoadmapSection.astro";
import SmoothScroll from "@/components/SmoothScroll.astro";
import ToolsSection from "@/components/ToolsSection.astro";
import WeekSection from "@/components/WeekSection.astro";
import type { PageHeroContent } from "@/types/page";
import heroPhoto from "@/assets/pages/p10-hero.jpg";
import weekPhoto from "@/assets/pages/p10-week.jpg";
import metricsPhoto from "@/assets/pages/p10-metrics.jpg";
import faqPhoto from "@/assets/pages/p10-faq.jpg";
import { BRAND } from "@/lib/brand";

/* Product managers. The roadmap cards, the week's rituals, the metric tree's
   figures and the FAQ answers are illustrative drafts; have them checked
   before launch. See docs/sections.md. */

const HERO: PageHeroContent = {
  trail: ["Technologies", "Product & experience", "Product managers"],
  headline: ["Product", "managers."],
  lede: "Product managers who turn strategy into shipped outcomes: they run discovery, own the roadmap and measure what actually moved.",
  ctas: [
    { label: "Add a product manager", href: "#contact", arrow: "diagonal" },
    { label: "See the roadmap", href: "#roadmap", arrow: "right" },
  ],
  image: heroPhoto,
  imageAlt: "A product manager presents charts on a screen to her team in a bright meeting room.",
  specs: [
    { label: "Owns", value: "Roadmap to outcome" },
    { label: "Runs", value: "Discovery and delivery" },
    { label: "Works in", value: "Your tools and rituals" },
    { label: "Measures", value: "Every release" },
  ],
};

const FAQS = [
  {
    q: "Will the PM replace our product lead?",
    a: "No. They work to your product lead's strategy and take the day-to-day: discovery, backlog, rituals and reporting.",
  },
  {
    q: "How fast can they own a roadmap?",
    a: "Usually within two sprints: the first to listen and map, the second to run the rituals themselves.",
  },
  {
    q: "Do they write the tickets or the strategy?",
    a: "Both, at the right altitude: outcomes and bets for leadership, clear stories for the team.",
  },
  {
    q: "Which tools do they need?",
    a: "Yours. They work in your tracker, docs and analytics, and set up what’s missing.",
  },
];
---

<Layout
  title={`Product managers · ${BRAND.name}`}
  description="Product managers who run discovery, own the roadmap and measure outcomes, working in your tools and your rituals."
  navTone="field"
>
  <SmoothScroll />
  <Navbar />
  <main>
    <PageHero content={HERO} />
    <RoadmapSection
      id="roadmap"
      eyebrow="Roadmap in motion"
      headline={["Outcomes,", "not a feature list."]}
      accent={1}
      lede="Scroll the quarter forward. Every card is a result the team is chasing, with the number that proves it."
      columns={["Now", "Next", "Later"]}
      milestones={["Week 1", "Week 6", "Week 12"]}
      shippedLabel="Shipped"
      cards={[
        { title: "Checkout in two taps", metric: "Conversion +3 pts" },
        { title: "Self-serve onboarding", metric: "Time to value −40%" },
        { title: "Search that finds it", metric: "Dead ends −25%" },
        { title: "Team workspaces", metric: "Seats +1.5" },
        { title: "Usage-based pricing", metric: "Revenue +8%" },
        { title: "Works offline", metric: "Churn −2 pts" },
      ]}
    />
    <WeekSection
      id="week"
      eyebrow="A PM’s week"
      headline={["Five days,", "one rhythm."]}
      lede="The rituals that keep a team pointed at the same outcome, run by the PM every week."
      media={{ image: weekPhoto, alt: "A product manager leads a whiteboard session with his team around a table.", focus: "50% 38%" }}
      label="The week's rituals"
      days={[
        { day: "Monday", short: "Mon", time: "09:30", ritual: "Discovery calls", note: "Three customers, one problem.", with: "With customers" },
        { day: "Tuesday", short: "Tue", time: "11:00", ritual: "Backlog refinement", note: "Stories sized, risks named.", with: "With engineering" },
        { day: "Wednesday", short: "Wed", time: "14:00", ritual: "Design review", note: "Flows checked against the goal.", with: "With design" },
        { day: "Thursday", short: "Thu", time: "10:00", ritual: "Metrics review", note: "What moved, and why.", with: "With data" },
        { day: "Friday", short: "Fri", time: "15:00", ritual: "Sprint review", note: "Shipped work, shown live.", with: "With stakeholders" },
      ]}
    />
    <ToolsSection
      id="tools"
      eyebrow="The tools they drive"
      headline={["Your stack,", "at their fingertips."]}
      accent={1}
      lede="Plan, shape and measure in the tools your team already runs. Press a key to see what each one is for."
      rows={[
        {
          label: "Plan",
          keys: [
            { slug: "jira", note: "Backlog, sprints and release plans." },
            { slug: "linear", note: "Fast issue triage and cycles." },
            { slug: "asana", note: "Cross-team launch plans." },
            { slug: "trello", note: "Light boards for small bets." },
            { slug: "clickup", note: "Tasks, docs and goals in one place." },
          ],
        },
        {
          label: "Shape",
          keys: [
            { slug: "confluence", note: "Specs and decision records." },
            { slug: "notion", note: "One-pagers and product briefs." },
            { slug: "figma", note: "Flows reviewed with design." },
            { slug: "miro", note: "Story maps and workshops." },
          ],
        },
        {
          label: "Measure",
          keys: [
            { slug: "googleanalytics", note: "Traffic and funnel health." },
            { slug: "mixpanel", note: "Events, cohorts and retention." },
            { slug: "posthog", note: "Feature flags and experiments." },
            { slug: "hotjar", note: "Heatmaps and session replays." },
          ],
        },
      ]}
      foot={{
        label: "Share",
        left: { slug: "loom", note: "Async demos for stakeholders." },
        right: { slug: "airtable", note: "The research repository." },
        space: { label: "Your stack", note: "They start in the tools you already use." },
      }}
      prompt={{ label: "Read-out", title: "Press a key", note: "Each tool, and what the PM uses it for." }}
    />
    <MetricTreeSection
      id="metrics"
      eyebrow="Metric tree"
      headline={["One north star.", "Four levers."]}
      lede="The PM maps the number that matters to the inputs a team can move, then works the levers."
      media={{ image: metricsPhoto, alt: "Two colleagues review a product dashboard on a laptop at a shared desk.", focus: "55% 50%" }}
      northStar={{ tag: "North star", label: "Weekly active teams", value: 18400, change: "+12% this quarter" }}
      leverLabel="Lever"
      inputs={[
        { label: "New team activation", value: 42, suffix: "%", change: "+6 pts", lever: "Guided setup" },
        { label: "Invites per team", value: 3.4, decimals: 1, change: "+0.8", lever: "Invite prompts" },
        { label: "Sessions per week", value: 9.2, decimals: 1, change: "+1.1", lever: "Saved views" },
        { label: "Week-8 retention", value: 74, suffix: "%", change: "+4 pts", lever: "Weekly digests" },
      ]}
    />
    <FaqSection
      eyebrow="PM questions"
      headline={["Questions,", "prioritised."]}
      accent={1}
      cta="Talk to a product lead"
      faqs={FAQS}
      media={{ image: faqPhoto, alt: "Two product managers plan the week on a whiteboard of sticky notes.", focus: "50% 45%" }}
    />
    <CtaSection
      eyebrow="Ready to prioritise"
      headline={["Less guessing.", "More shipping."]}
      body="Tell us where the roadmap is stuck. We’ll match a product manager who can own it from the next sprint."
      cta="Find my PM"
    />
  </main>
  <Footer />
</Layout>
