---
import GridRules from "@/components/GridRules.astro";
import RevealText from "@/components/RevealText.astro";
import Joints from "@/components/process/Joints.astro";

/* Tokens to component, on the dark tone. Columns 1–2: the design tokens in
   four groups (colour, type, spacing, radius). Columns 3–4: an artboard
   holding a card component, first as a grey wireframe. As the section
   plays, each group lights in turn and is applied: colour fills the card
   and its button, the type scale replaces the placeholder text, the
   spacing opens the cramped layout out (with redlines to show it), and the
   corners round. A replay button runs it again.

   Nothing changes size: the card's final layout is fixed, the wireframe
   text and the set text share one grid cell, and the cramped spacing is
   drawn with transforms. Without the script, or under reduced motion, the
   finished component shows. See docs/sections.md. */

interface Group {
  name: string;
  hint: string;
}

interface Props {
  id: string;
  eyebrow: string;
  headline: string[];
  accent?: number;
  lede: string;
  /** Colour, type, spacing, radius, in that order. */
  groups: [Group, Group, Group, Group];
  artboard: string;
  card: { eyebrow: string; title: string; body: string; primary: string; secondary: string };
  done: string;
  replay: string;
}

const { id, eyebrow, headline, accent = headline.length - 1, lede, groups, artboard, card, done, replay } = Astro.props;
const offsets = headline.map((_, i) => headline.slice(0, i).reduce((n, line) => n + Array.from(line).length + 1, 0));

const SWATCHES = [
  { name: "ink-900", hex: "#0a1022" },
  { name: "blue-600", hex: "#3a65eb" },
  { name: "blue-500", hex: "#507af7" },
  { name: "blue-50", hex: "#eef2fe" },
  { name: "grey-100", hex: "#f1f3f7" },
];
const TYPE = [
  { name: "display", size: 26 },
  { name: "body", size: 16 },
  { name: "label", size: 11 },
];
const SPACE = [4, 8, 16, 24];
const RADIUS = [0, 4, 8, 12];
---

<section data-ac-sec="dark" data-ac-tok id={id}>
  <GridRules />

  <div data-ac-sec-container data-ac-tok-grid>
    <div data-ac-tok-head>
      <p data-ac-sec-eyebrow class="mono-label">
        <span aria-hidden="true">+</span>
        {eyebrow}
      </p>
      <h2 data-ac-tok-headline aria-label={headline.join(" ")}>
        {headline.map((line, i) => (
          <Fragment>
            {i > 0 && <Fragment>{" "}<br aria-hidden="true" /></Fragment>}
            <span data-ac-sec-line data-accent={i === accent || undefined}>
              <RevealText text={line} offset={offsets[i]} />
            </span>
          </Fragment>
        ))}
      </h2>
    </div>
    <p data-ac-tok-lede data-ac-sec-rise>{lede}</p>

    <div data-ac-tok-body data-step="5">
      <ol data-ac-tok-groups>
        {groups.map((group, g) => (
          <li data-ac-tok-group style={`--ac-g:${g}`}>
            <span data-ac-tok-num class="mono-label-sm">{String(g + 1).padStart(2, "0")}</span>
            <span data-ac-tok-name>{group.name}</span>
            <span data-ac-tok-hint class="mono-label-sm">{group.hint}</span>
            <span data-ac-tok-values aria-hidden="true">
              {g === 0 && SWATCHES.map((s) => <i data-ac-tok-swatch style={`background:${s.hex}`} title={s.name} />)}
              {g === 1 && TYPE.map((t) => <b data-ac-tok-type style={`font-size:${Math.round(t.size * 0.9)}px`}>Aa<small>{t.size}</small></b>)}
              {g === 2 && SPACE.map((s) => <i data-ac-tok-space style={`--ac-s:${s}`}><small>{s}</small></i>)}
              {g === 3 && RADIUS.map((r) => <i data-ac-tok-radius style={`border-top-left-radius:${r}px`}><small>{r}</small></i>)}
            </span>
            <span data-ac-tok-check aria-hidden="true">
              <svg viewBox="0 0 24 24"><path d="M20 6 9 17l-5-5" /></svg>
            </span>
          </li>
        ))}
      </ol>

      <div data-ac-tok-stage>
        <Joints />
        <p data-ac-tok-board class="mono-label-sm">
          <span>{artboard}</span>
          <span data-ac-tok-done>{done}</span>
        </p>

        <div data-ac-tok-card role="img" aria-label={`A finished card component: ${card.eyebrow}, ${card.title}. ${card.body} Buttons: ${card.primary}, ${card.secondary}.`}>
          <span data-ac-tok-fill aria-hidden="true" />
          <span data-ac-tok-media data-piece="0" aria-hidden="true" />
          <span data-ac-tok-chip data-piece="1" aria-hidden="true">
            <span data-wire />
            <span data-set>{card.eyebrow}</span>
          </span>
          <span data-ac-tok-title data-piece="2" aria-hidden="true">
            <span data-wire>{card.title}</span>
            <span data-set>{card.title}</span>
          </span>
          <span data-ac-tok-text data-piece="3" aria-hidden="true">
            <span data-wire>{card.body}</span>
            <span data-set>{card.body}</span>
          </span>
          <span data-ac-tok-actions data-piece="4" aria-hidden="true">
            <span data-ac-tok-btn>{card.primary}</span>
            <span data-ac-tok-btn data-ghost>{card.secondary}</span>
          </span>

          {/* Redlines for the spacing step. */}
          <span data-ac-tok-red data-red="pad" aria-hidden="true"><b>24</b></span>
          <span data-ac-tok-red data-red="gap" aria-hidden="true"><b>16</b></span>
          <span data-ac-tok-corner aria-hidden="true"><b>12</b></span>
        </div>

        <button type="button" data-ac-tok-replay>
          <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M4 12a8 8 0 1 0 2.4-5.7M4 4v4h4" /></svg>
          {replay}
        </button>
      </div>
    </div>
  </div>
</section>

<script>
  document.querySelectorAll<HTMLElement>("[data-ac-tok]").forEach((section) => {
    const body = section.querySelector<HTMLElement>("[data-ac-tok-body]")!;
    const replay = section.querySelector<HTMLButtonElement>("[data-ac-tok-replay]")!;
    const reduced = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
    let timers: number[] = [];

    const set = (step: number) => body.setAttribute("data-step", String(step));
    const clear = () => {
      timers.forEach(clearTimeout);
      timers = [];
    };
    /* Wireframe, then one group every 1.2s, then done (5). */
    const play = () => {
      clear();
      set(0);
      for (let s = 1; s <= 5; s++) timers.push(window.setTimeout(() => set(s), 500 + s * 1200));
    };

    replay.addEventListener("click", () => (reduced ? set(5) : play()));

    new IntersectionObserver(
      ([entry]) => {
        section.toggleAttribute("data-ac-in", entry.isIntersecting);
        if (reduced) return;
        if (entry.isIntersecting) play();
        else {
          clear();
          set(0);
        }
      },
      { threshold: 0, rootMargin: "-10% 0px -10% 0px" },
    ).observe(section);
  });
</script>
