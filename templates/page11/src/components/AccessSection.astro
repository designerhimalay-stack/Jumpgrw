---
import GridRules from "@/components/GridRules.astro";
import SectionHead from "@/components/SectionHead.astro";
import TechLogo from "@/components/TechLogo.astro";
import Joints from "@/components/process/Joints.astro";
import type { SectionPhoto } from "@/types/page";

/* Accessible by default. The header splits around a photo of two designers
   checking a screen. Under it, columns 1–2: a small interface drawn in the
   page's colour pairs, with a switch above it for three previews (as
   designed, low vision, colour blind). Columns 3–4: each colour pair with
   its contrast ratio and its WCAG badges (AA, AAA). The ratios are worked
   out from the colours at build time, and again through a deuteranopia
   simulation for the colour-blind preview, so switching to it shows the
   real figures for that view. Every reading shares one grid cell, so
   nothing moves. The switch is three buttons with aria-pressed; without
   the script the design shows as made. See docs/sections.md. */

interface Pair {
  name: string;
  fg: string;
  bg: string;
  use: string;
}

interface Props {
  id: string;
  eyebrow: string;
  headline: string[];
  accent?: number;
  lede: string;
  media: SectionPhoto;
  modes: [string, string, string];
  modeLabel: string;
  pairs: Pair[];
  preview: { title: string; body: string; button: string; muted: string; link: string };
  tool: string;
}

const { id, eyebrow, headline, accent, lede, media, modes, modeLabel, pairs, preview, tool } = Astro.props;

/* WCAG 2 relative luminance and contrast. */
const lin = (c: number) => (c <= 0.04045 ? c / 12.92 : Math.pow((c + 0.055) / 1.055, 2.4));
const rgb = (hex: string) => [1, 3, 5].map((i) => parseInt(hex.slice(i, i + 2), 16) / 255);
const lum = ([r, g, b]: number[]) => 0.2126 * lin(r) + 0.7152 * lin(g) + 0.0722 * lin(b);
const ratio = (a: number, b: number) => (Math.max(a, b) + 0.05) / (Math.min(a, b) + 0.05);

/* Deuteranopia (Machado et al. 2009, severity 1), applied in linear RGB,
   the same matrix the preview's SVG filter uses. */
const DEUTAN = [
  [0.367322, 0.860646, -0.227968],
  [0.280085, 0.672501, 0.047413],
  [-0.01182, 0.04294, 0.968881],
];
const deutanLum = (hex: string) => {
  const l = rgb(hex).map(lin);
  const m = DEUTAN.map((row) => Math.min(1, Math.max(0, row[0] * l[0] + row[1] * l[1] + row[2] * l[2])));
  return 0.2126 * m[0] + 0.7152 * m[1] + 0.0722 * m[2];
};

const rows = pairs.map((p) => {
  const normal = ratio(lum(rgb(p.fg)), lum(rgb(p.bg)));
  const deutan = ratio(deutanLum(p.fg), deutanLum(p.bg));
  return { ...p, normal, deutan };
});
const grade = (r: number) => ({ aa: r >= 4.5, aaa: r >= 7 });
const fmt = (r: number) => `${r.toFixed(1)}:1`;
const matrix = DEUTAN.map((row) => `${row.join(" ")} 0 0`).join(" ") + " 0 0 0 1 0";
---

<section data-ac-sec="light" data-ac-a11y id={id} data-mode="0">
  <GridRules />

  <svg data-ac-a11y-defs aria-hidden="true" focusable="false">
    <filter id={`${id}-deutan`}>
      <feColorMatrix type="matrix" values={matrix} />
    </filter>
  </svg>

  <div data-ac-sec-container>
    <SectionHead eyebrow={eyebrow} headline={headline} accent={accent} lede={lede} media={media} />

    <div data-ac-a11y-grid>
      <div data-ac-a11y-left>
        <div data-ac-a11y-switch role="group" aria-label={modeLabel}>
          {modes.map((mode, i) => (
            <button type="button" data-ac-a11y-mode={i} aria-pressed={i === 0 ? "true" : "false"}>
              {mode}
            </button>
          ))}
        </div>

        <div data-ac-sec-frame data-ac-a11y-stage>
          <Joints />
          <div data-ac-a11y-ui style={`--ac-filter:url(#${id}-deutan)`} role="img" aria-label={`${preview.title}. ${preview.body}`}>
            <span data-ac-a11y-ui-bar aria-hidden="true"><i /><i /><i /></span>
            <span data-ac-a11y-ui-body aria-hidden="true">
              <b style={`color:${rows[0].fg}`}>{preview.title}</b>
              <span style={`color:${rows[0].fg}`}>{preview.body}</span>
              <span data-ac-a11y-ui-row>
                <span data-ac-a11y-ui-btn style={`color:${rows[1].fg};background:${rows[1].bg}`}>{preview.button}</span>
                <span data-ac-a11y-ui-muted style={`color:${rows[2].fg};background:${rows[2].bg}`}>{preview.muted}</span>
              </span>
            </span>
            <span data-ac-a11y-ui-foot style={`background:${rows[3].bg}`} aria-hidden="true">
              <span style={`color:${rows[3].fg}`}>{preview.link} →</span>
            </span>
          </div>
        </div>
      </div>

      <ul data-ac-a11y-pairs>
        {rows.map((row) => {
          const n = grade(row.normal);
          const d = grade(row.deutan);
          return (
            <li data-ac-a11y-pair>
              <span data-ac-a11y-chip style={`color:${row.fg};background:${row.bg}`} aria-hidden="true">Aa</span>
              <span data-ac-a11y-name>
                <span>{row.name}</span>
                <span class="mono-label-sm">{row.fg} on {row.bg} · {row.use}</span>
              </span>
              <span data-ac-a11y-read>
                <span data-ac-a11y-val data-view="plain" aria-hidden="false">
                  <b>{fmt(row.normal)}</b>
                  <span data-ac-a11y-badges>
                    <i data-pass={n.aa || undefined}>AA</i>
                    <i data-pass={n.aaa || undefined}>AAA</i>
                  </span>
                  <span class="sr-only">{n.aaa ? "Passes AA and AAA." : n.aa ? "Passes AA." : "Below AA."}</span>
                </span>
                <span data-ac-a11y-val data-view="deutan" aria-hidden="true">
                  <b>{fmt(row.deutan)}</b>
                  <span data-ac-a11y-badges>
                    <i data-pass={d.aa || undefined}>AA</i>
                    <i data-pass={d.aaa || undefined}>AAA</i>
                  </span>
                  <span class="sr-only">{d.aaa ? "Passes AA and AAA." : d.aa ? "Passes AA." : "Below AA."}</span>
                </span>
              </span>
            </li>
          );
        })}
        <li data-ac-a11y-tool>
          <TechLogo slug="lighthouse" size={22} />
          <span>{tool}</span>
        </li>
      </ul>
    </div>
  </div>
</section>

<script>
  import { toggleInView } from "@/lib/in-view";

  document.querySelectorAll<HTMLElement>("[data-ac-a11y]").forEach((section) => {
    toggleInView(section);

    const buttons = Array.from(section.querySelectorAll<HTMLButtonElement>("[data-ac-a11y-mode]"));
    const plain = Array.from(section.querySelectorAll<HTMLElement>('[data-view="plain"]'));
    const deutan = Array.from(section.querySelectorAll<HTMLElement>('[data-view="deutan"]'));
    buttons.forEach((button) =>
      button.addEventListener("click", () => {
        const mode = button.getAttribute("data-ac-a11y-mode") ?? "0";
        section.dataset.mode = mode;
        buttons.forEach((b) => b.setAttribute("aria-pressed", String(b === button)));
        /* The colour-blind figures are the ones read out in that view. */
        const cb = mode === "2";
        plain.forEach((el) => el.setAttribute("aria-hidden", String(cb)));
        deutan.forEach((el) => el.setAttribute("aria-hidden", String(!cb)));
      }),
    );
  });
</script>
