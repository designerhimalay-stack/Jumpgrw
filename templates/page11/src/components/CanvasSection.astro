---
import GridRules from "@/components/GridRules.astro";
import SectionHead from "@/components/SectionHead.astro";
import TechLogo from "@/components/TechLogo.astro";
import Joints from "@/components/process/Joints.astro";
import { TECH_LOGOS, type TechLogoSlug } from "@/lib/tech-logos";

/* The tool belt, as a design canvas, on the dark tone. A canvas window with
   a slim toolbar and a dot grid, and on it a spread of named frames, one
   per tool, each an artboard holding the tool's logo and what the
   designers use it for. Two named multiplayer cursors glide from frame to
   frame, selecting each as they land. The loop runs only while the section
   is on screen; under reduced motion the cursors rest on their first
   frames. Frames sit at fixed places (another set on phones) and cursors
   move by transform, so nothing moves the page. See docs/sections.md. */

interface Frame {
  slug: TechLogoSlug;
  note: string;
  /** Desktop place: left and top as % of the canvas, width %, height px. */
  at: [number, number, number, number];
}

interface Props {
  id: string;
  eyebrow: string;
  headline: string[];
  accent?: number;
  lede: string;
  page: string;
  frames: Frame[];
  cursors: [{ name: string; path: number[] }, { name: string; path: number[] }];
}

const { id, eyebrow, headline, accent, lede, page, frames, cursors } = Astro.props;
---

<section data-ac-sec="dark" data-ac-canvas id={id}>
  <GridRules />

  <div data-ac-sec-container>
    <SectionHead eyebrow={eyebrow} headline={headline} accent={accent} lede={lede} />

    <div data-ac-canvas-window>
      <Joints />
      <p data-ac-canvas-bar aria-hidden="true">
        <span data-ac-canvas-tools>
          <svg viewBox="0 0 24 24"><path d="M5 3l6 16 2.5-6.5L20 10z" /></svg>
          <svg viewBox="0 0 24 24"><path d="M8 3v18M16 3v18M3 8h18M3 16h18" /></svg>
          <svg viewBox="0 0 24 24"><path d="M4 20l4-1 10-10-3-3L5 16zM13 7l3 3" /></svg>
          <svg viewBox="0 0 24 24"><path d="M6 5h12M12 5v14" /></svg>
        </span>
        <span data-ac-canvas-page class="mono-label-sm">{page}</span>
        <span data-ac-canvas-people>
          {cursors.map((c, i) => <i data-c={i}>{c.name.charAt(0)}</i>)}
          <span class="mono-label-sm">100%</span>
        </span>
      </p>

      <div data-ac-canvas-field>
        <ul data-ac-canvas-frames>
          {frames.map((frame, i) => (
            <li
              data-ac-canvas-frame
              data-i={i}
              style={`--ac-x:${frame.at[0]}%;--ac-y:${frame.at[1]}%;--ac-w:${frame.at[2]}%;--ac-h:${frame.at[3]}px;--ac-i:${i}`}
            >
              <span data-ac-canvas-name class="mono-label-sm">
                <span aria-hidden="true">#</span>
                {TECH_LOGOS[frame.slug].title}
              </span>
              <span data-ac-canvas-board>
                <TechLogo slug={frame.slug} size={40} label />
                <span data-ac-canvas-note>{frame.note}</span>
              </span>
            </li>
          ))}
        </ul>

        {cursors.map((cursor, c) => (
          <span data-ac-canvas-cursor data-c={c} data-path={cursor.path.join(",")} aria-hidden="true">
            <svg viewBox="0 0 24 24"><path d="M4 2.5 20 11l-7 1.6L9.6 19.5z" /></svg>
            <span>{cursor.name}</span>
          </span>
        ))}
      </div>
    </div>
  </div>
</section>

<script>
  import { toggleInView } from "@/lib/in-view";

  document.querySelectorAll<HTMLElement>("[data-ac-canvas]").forEach((section) => {
    toggleInView(section);

    const field = section.querySelector<HTMLElement>("[data-ac-canvas-field]")!;
    const frames = Array.from(section.querySelectorAll<HTMLElement>("[data-ac-canvas-frame]"));
    const cursors = Array.from(section.querySelectorAll<HTMLElement>("[data-ac-canvas-cursor]")).map((el) => ({
      el,
      path: (el.dataset.path ?? "0").split(",").map(Number),
      step: 0,
    }));
    const reduced = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
    const STEP_MS = 2600;
    let timers: number[] = [];
    let running = false;

    /* A cursor lands on a point inside the frame's artboard, measured, so it
       works for either layout. */
    const place = (c: (typeof cursors)[number], index: number) => {
      const frame = frames[c.path[c.step % c.path.length]];
      const box = frame.querySelector<HTMLElement>("[data-ac-canvas-board]")!;
      const f = field.getBoundingClientRect();
      const b = box.getBoundingClientRect();
      const x = b.left - f.left + b.width * (index === 0 ? 0.72 : 0.3);
      const y = b.top - f.top + b.height * (index === 0 ? 0.66 : 0.34);
      /* Near the right edge the tag flips to the left of the arrow; the
         arrow's tip stays on the point either way. */
      const flip = x > f.width - 130;
      c.el.toggleAttribute("data-flip", flip);
      const shift = flip ? c.el.offsetWidth - 22 : 0;
      c.el.style.transform = `translate(${(x - shift).toFixed(1)}px, ${y.toFixed(1)}px)`;
      frames.forEach((fr) => {
        if (fr.dataset.sel === String(index)) delete fr.dataset.sel;
      });
      frame.dataset.sel = String(index);
    };

    const stop = () => {
      running = false;
      timers.forEach(clearTimeout);
      timers = [];
    };
    const tick = (index: number) => {
      if (!running) return;
      const c = cursors[index];
      c.step += 1;
      place(c, index);
      timers.push(window.setTimeout(() => tick(index), STEP_MS));
    };
    const start = () => {
      stop();
      cursors.forEach((c, i) => place(c, i));
      if (reduced) return;
      running = true;
      cursors.forEach((_, i) => timers.push(window.setTimeout(() => tick(i), 1200 + i * (STEP_MS / 2))));
    };

    /* Loop only while the canvas is on screen. */
    new IntersectionObserver(([entry]) => (entry.isIntersecting ? start() : stop()), { threshold: 0.15 }).observe(field);
    new ResizeObserver(() => cursors.forEach((c, i) => place(c, i))).observe(field);
  });
</script>
