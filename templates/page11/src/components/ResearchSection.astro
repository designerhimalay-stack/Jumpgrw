---
import { Image } from "astro:assets";
import GridRules from "@/components/GridRules.astro";
import SectionHead from "@/components/SectionHead.astro";
import Joints from "@/components/process/Joints.astro";
import type { SectionPhoto } from "@/types/page";

/* The research wall, affinity-mapped. Columns 1–3: a wall of sticky notes,
   one finding each, scattered where the interviews left them; as the
   section arrives they travel into three clusters, each under a theme
   label, the way a designer sorts a wall. They scatter again when the
   section leaves. Column 4: a photo of a designer working at a
   whiteboard, pinned beside the wall. Notes move by transform on a wall of
   fixed height, so nothing moves the page. Without the script, or under
   reduced motion, the sorted wall shows. See docs/sections.md. */

interface Theme {
  label: string;
  notes: string[];
}

interface Props {
  id: string;
  eyebrow: string;
  headline: string[];
  accent?: number;
  lede: string;
  media: SectionPhoto;
  /** Three themes of four notes each. */
  themes: Theme[];
  caption: string;
}

const { id, eyebrow, headline, accent, lede, media, themes, caption } = Astro.props;

/* A fixed scatter (no randomness at build, so it never changes): x and y as
   fractions of the free wall, and a tilt. */
const SCATTER = [
  [0.02, 0.1, -6], [0.3, 0.02, 4], [0.62, 0.12, -3], [0.88, 0.04, 7],
  [0.14, 0.46, 5], [0.46, 0.38, -8], [0.74, 0.5, 3], [0.97, 0.42, -5],
  [0.05, 0.9, -4], [0.36, 0.84, 6], [0.6, 0.94, -2], [0.86, 0.88, 5],
];
const TILT = [-2, 1.5, -1, 2];
---

<section data-ac-sec="light" data-ac-wall id={id}>
  <GridRules />

  <div data-ac-sec-container>
    <SectionHead eyebrow={eyebrow} headline={headline} accent={accent} lede={lede} />

    <div data-ac-wall-grid>
      <div data-ac-sec-frame data-ac-wall-board>
        <Joints />
        <div data-ac-wall-field>
          {themes.map((theme, t) => (
            <p data-ac-wall-theme style={`--ac-t:${t}`} aria-hidden="true">
              <span class="mono-label-sm">{String(t + 1).padStart(2, "0")}</span>
              {theme.label}
            </p>
          ))}
          <ul data-ac-wall-notes aria-hidden="true">
            {themes.flatMap((theme, t) =>
              theme.notes.map((note, j) => {
                const k = t * theme.notes.length + j;
                const [sx, sy, sr] = SCATTER[k % SCATTER.length];
                return (
                  <li
                    data-ac-wall-note
                    data-tone={(k * 7) % 3}
                    style={`--ac-t:${t};--ac-j:${j};--ac-cx:${j % 2};--ac-cy:${Math.floor(j / 2)};--ac-sx:${sx};--ac-sy:${sy};--ac-sr:${sr}deg;--ac-cr:${TILT[j % 4]}deg;--ac-k:${k}`}
                  >
                    {note}
                  </li>
                );
              }),
            )}
          </ul>
        </div>
        {/* The sorted wall, for screen readers. */}
        <div class="sr-only">
          {themes.map((theme) => (
            <Fragment>
              <p>{theme.label}</p>
              <ul>{theme.notes.map((note) => <li>{note}</li>)}</ul>
            </Fragment>
          ))}
        </div>
      </div>

      <figure data-ac-wall-photo>
        <Joints />
        <div data-ac-wall-image>
          <Image
            src={media.image}
            alt={media.alt}
            widths={[480, 800, 1200]}
            sizes="(max-width: 991px) 100vw, 24vw"
            quality={78}
            style={media.focus ? `object-position:${media.focus}` : undefined}
          />
        </div>
        <figcaption class="mono-label-sm">{caption}</figcaption>
      </figure>
    </div>
  </div>
</section>

<script>
  import { toggleInView } from "@/lib/in-view";

  document.querySelectorAll<HTMLElement>("[data-ac-wall]").forEach((section) => {
    /* The wall sorts once it is well on screen, so the scatter is seen. */
    section.setAttribute("data-ac-wall-js", "");
    toggleInView(section);
  });
</script>
