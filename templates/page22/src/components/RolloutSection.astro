---
import { Image } from "astro:assets";
import GridRules from "@/components/GridRules.astro";
import SectionHead from "@/components/SectionHead.astro";
import Joints from "@/components/process/Joints.astro";
import type { SectionPhoto } from "@/types/page";

/* A staged rollout, on the dark tone. A framed photo holds columns 1–2; a
   rollout control fills columns 3–4: the share of users on the new
   version, a five-stop track (1% to 100%) whose stops are buttons, and two
   gauges, crash-free users and ANR rate, each with its halt line. As the
   section arrives the release walks the track one stage at a time, the
   needles settling in the safe zone at every stop; choosing a stop takes
   over from the autoplay. Every figure sits in a fixed-width box, so
   nothing moves. Without the script the final stage shows. See
   docs/sections.md. */

interface Stage {
  /** Percentage of users. */
  share: number;
  /** Crash-free users, %. */
  crash: number;
  /** User-perceived ANR rate, %. */
  anr: number;
}

interface Props {
  id: string;
  eyebrow: string;
  headline: string[];
  accent?: number;
  lede: string;
  media: SectionPhoto;
  release: string;
  installs: number;
  stages: Stage[];
  crashLine: number;
  anrLine: number;
}

const { id, eyebrow, headline, accent, lede, media, release, installs, stages, crashLine, anrLine } = Astro.props;
const last = stages.length - 1;

/* Gauges: a half circle, 180° from left to right. */
const CRASH = { min: 99, max: 100 };
const ANR = { min: 0, max: 1 };
const angle = (v: number, r: { min: number; max: number }) =>
  -90 + (Math.min(Math.max(v, r.min), r.max) - r.min) / (r.max - r.min) * 180;
const arc = (from: number, to: number, rad = 80) => {
  const p = (a: number) => {
    const t = ((a - 90) * Math.PI) / 180;
    return `${(100 + rad * Math.cos(t)).toFixed(2)} ${(100 + rad * Math.sin(t)).toFixed(2)}`;
  };
  return `M${p(from)} A${rad} ${rad} 0 0 1 ${p(to)}`;
};
const devices = (share: number) => {
  const n = (installs * share) / 100;
  return n >= 1e6 ? `${(n / 1e6).toFixed(1)}M` : `${Math.round(n / 1000)}k`;
};
const data = stages.map((s) => ({
  ...s,
  devices: devices(s.share),
  crashAngle: angle(s.crash, CRASH),
  anrAngle: angle(s.anr, ANR),
}));
const final = data[last];
const crashHalt = angle(crashLine, CRASH);
const anrHalt = angle(anrLine, ANR);
---

<section data-ac-sec="dark" data-ac-roll id={id} data-stages={JSON.stringify(data)}>
  <GridRules />

  <div data-ac-sec-container>
    <SectionHead eyebrow={eyebrow} headline={headline} accent={accent} lede={lede} />

    <div data-ac-roll-grid>
      <div data-ac-roll-photo>
        <Joints />
        <div data-ac-roll-image>
          <Image
            src={media.image}
            alt={media.alt}
            widths={[480, 800, 1200, media.image.width]}
            sizes="(max-width: 991px) 100vw, 46vw"
            quality={78}
            style={media.focus ? `object-position:${media.focus}` : undefined}
          />
        </div>
      </div>

      <div data-ac-sec-frame data-ac-roll-panel>
        <Joints />
        <p data-ac-roll-release class="mono-label-sm">
          <i aria-hidden="true" />
          {release}
        </p>

        <p data-ac-roll-share aria-live="polite">
          <b data-ac-roll-pct>{final.share}%</b>
          <span>of users, <span data-ac-roll-devices>{final.devices}</span> devices</span>
        </p>

        <div data-ac-roll-track role="group" aria-label="Rollout stage" style={`--ac-n:${stages.length};--ac-at:${last}`}>
          <span data-ac-roll-rail aria-hidden="true"><i /></span>
          {data.map((s, i) => (
            <button type="button" data-ac-roll-stop data-i={i} aria-pressed={i === last ? "true" : "false"} data-done={i <= last || undefined}>
              <i aria-hidden="true" />
              <span>{s.share}%</span>
            </button>
          ))}
        </div>

        <div data-ac-roll-gauges>
          <figure data-ac-roll-gauge style={`--ac-a:${final.crashAngle}deg`}>
            <svg viewBox="0 0 200 110" aria-hidden="true">
              <path data-ac-roll-arc d={arc(-90, 90)} />
              <path data-ac-roll-bad d={arc(-90, crashHalt)} />
              <path data-ac-roll-safe d={arc(crashHalt, 90)} />
              <line data-ac-roll-halt x1="100" y1="100" x2="100" y2="12" style={`transform:rotate(${crashHalt}deg)`} />
              <g data-ac-roll-needle><line x1="100" y1="100" x2="100" y2="30" /><circle cx="100" cy="100" r="6" /></g>
            </svg>
            <figcaption>
              <b data-ac-roll-crash>{final.crash.toFixed(2)}%</b>
              <span>Crash-free users</span>
              <span data-ac-roll-line class="mono-label-sm">Halt below {crashLine}%</span>
            </figcaption>
          </figure>
          <figure data-ac-roll-gauge style={`--ac-a:${final.anrAngle}deg`}>
            <svg viewBox="0 0 200 110" aria-hidden="true">
              <path data-ac-roll-arc d={arc(-90, 90)} />
              <path data-ac-roll-safe d={arc(-90, anrHalt)} />
              <path data-ac-roll-bad d={arc(anrHalt, 90)} />
              <line data-ac-roll-halt x1="100" y1="100" x2="100" y2="12" style={`transform:rotate(${anrHalt}deg)`} />
              <g data-ac-roll-needle><line x1="100" y1="100" x2="100" y2="30" /><circle cx="100" cy="100" r="6" /></g>
            </svg>
            <figcaption>
              <b data-ac-roll-anr>{final.anr.toFixed(2)}%</b>
              <span>ANR rate</span>
              <span data-ac-roll-line class="mono-label-sm">Halt above {anrLine}%</span>
            </figcaption>
          </figure>
        </div>

        <p data-ac-roll-status>
          <i aria-hidden="true" />
          <span data-ac-roll-note>Healthy at every stage</span>
        </p>
      </div>
    </div>
  </div>
</section>

<script>
  interface Stage {
    share: number;
    crash: number;
    anr: number;
    devices: string;
    crashAngle: number;
    anrAngle: number;
  }

  document.querySelectorAll<HTMLElement>("[data-ac-roll]").forEach((section) => {
    const stages: Stage[] = JSON.parse(section.dataset.stages || "[]");
    const last = stages.length - 1;
    const track = section.querySelector<HTMLElement>("[data-ac-roll-track]")!;
    const stops = Array.from(section.querySelectorAll<HTMLButtonElement>("[data-ac-roll-stop]"));
    const [crashGauge, anrGauge] = Array.from(section.querySelectorAll<HTMLElement>("[data-ac-roll-gauge]"));
    const q = (sel: string) => section.querySelector<HTMLElement>(sel)!;
    const pct = q("[data-ac-roll-pct]");
    const devices = q("[data-ac-roll-devices]");
    const crash = q("[data-ac-roll-crash]");
    const anr = q("[data-ac-roll-anr]");
    const note = q("[data-ac-roll-note]");
    const reduced = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
    const STEP_MS = 1700;
    let timers: number[] = [];
    let taken = false;

    const set = (i: number) => {
      const s = stages[i];
      track.style.setProperty("--ac-at", String(i));
      stops.forEach((b, j) => {
        b.setAttribute("aria-pressed", String(j === i));
        b.toggleAttribute("data-done", j <= i);
      });
      pct.textContent = `${s.share}%`;
      devices.textContent = s.devices;
      crash.textContent = `${s.crash.toFixed(2)}%`;
      anr.textContent = `${s.anr.toFixed(2)}%`;
      crashGauge.style.setProperty("--ac-a", `${s.crashAngle}deg`);
      anrGauge.style.setProperty("--ac-a", `${s.anrAngle}deg`);
      note.textContent = i === last ? "Healthy at every stage" : `Healthy, promoting to ${stages[i + 1].share}%`;
    };

    const clear = () => {
      timers.forEach(clearTimeout);
      timers = [];
    };

    stops.forEach((b, i) =>
      b.addEventListener("click", () => {
        taken = true;
        clear();
        set(i);
      }),
    );

    new IntersectionObserver(
      ([entry]) => {
        section.toggleAttribute("data-ac-in", entry.isIntersecting);
        if (reduced || taken) return;
        clear();
        if (!entry.isIntersecting) return set(0);
        set(0);
        for (let i = 1; i <= last; i++) timers.push(window.setTimeout(() => set(i), 600 + i * STEP_MS));
      },
      { threshold: 0, rootMargin: "-10% 0px -10% 0px" },
    ).observe(section);
  });
</script>
