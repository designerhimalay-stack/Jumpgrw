---
import { Image } from "astro:assets";
import GridRules from "@/components/GridRules.astro";
import SectionHead from "@/components/SectionHead.astro";
import TechLogo from "@/components/TechLogo.astro";
import Joints from "@/components/process/Joints.astro";
import type { SectionPhoto } from "@/types/page";

/* A release, told by the lock screen, on the light tone. A framed photo of
   the team holds columns 1–3; a phone's lock screen stands over its right
   edge in column 4. As the section arrives, the release's notifications
   arrive one by one and stack upward from the foot of the screen, oldest
   at the bottom. Every banner has its own slot from the start (only its
   opacity and a small drop change), so nothing moves. Without the script,
   or under reduced motion, the full stack shows. See docs/sections.md. */

interface Note {
  app: string;
  title: string;
  body: string;
  when: string;
  icon: "xcode" | "appstore" | "plane";
}

interface Props {
  id: string;
  eyebrow: string;
  headline: string[];
  accent?: number;
  lede: string;
  media: SectionPhoto;
  time: string;
  date: string;
  caption: string;
  notes: Note[];
}

const { id, eyebrow, headline, accent, lede, media, time, date, caption, notes } = Astro.props;
/* Newest on top: the slots run in reverse arrival order. */
const stack = notes.map((n, i) => ({ ...n, i })).reverse();
---

<section data-ac-sec="light" data-ac-lock id={id}>
  <GridRules />

  <div data-ac-sec-container>
    <SectionHead eyebrow={eyebrow} headline={headline} accent={accent} lede={lede} />

    <div data-ac-lock-stage>
      <div data-ac-lock-photo>
        <Joints />
        <div data-ac-lock-image>
          <Image
            src={media.image}
            alt={media.alt}
            widths={[480, 800, 1200, media.image.width]}
            sizes="(max-width: 991px) 100vw, 70vw"
            quality={78}
            style={media.focus ? `object-position:${media.focus}` : undefined}
          />
        </div>
        <p data-ac-lock-caption class="mono-label-sm">{caption}</p>
      </div>

      <div data-ac-lock-phone>
        <div data-ac-lock-screen>
          <i data-ac-lock-island aria-hidden="true" />
          <p data-ac-lock-clock aria-hidden="true">
            <span>{date}</span>
            <b>{time}</b>
          </p>

          <ol data-ac-lock-stack aria-label={`Release notifications, in order: ${notes.map((n) => n.title).join(", ")}.`}>
            {stack.map((n) => (
              <li data-ac-lock-note data-i={n.i} style={`--ac-i:${n.i}`}>
                <span data-ac-lock-icon data-kind={n.icon} aria-hidden="true">
                  {n.icon === "plane" ? (
                    <svg viewBox="0 0 24 24"><path d="M21 3 3 10.5l7 2.5 2.5 7L21 3Zm-11 10 5-5" /></svg>
                  ) : (
                    <TechLogo slug={n.icon} size={18} tone="white" />
                  )}
                </span>
                <span data-ac-lock-text>
                  <span data-ac-lock-top>
                    <span data-ac-lock-app>{n.app}</span>
                    <span data-ac-lock-when>{n.when}</span>
                  </span>
                  <b>{n.title}</b>
                  <span data-ac-lock-body>{n.body}</span>
                </span>
              </li>
            ))}
          </ol>

          <p data-ac-lock-foot aria-hidden="true">
            <i><svg viewBox="0 0 24 24"><path d="M9 3h6l-1 6h-4zM10 9h4v11h-4z" /></svg></i>
            <i><svg viewBox="0 0 24 24"><path d="M4 8h3l2-3h6l2 3h3v11H4z" /><circle cx="12" cy="13" r="3.5" /></svg></i>
          </p>
          <i data-ac-lock-home aria-hidden="true" />
        </div>
      </div>
    </div>
  </div>
</section>

<script>
  document.querySelectorAll<HTMLElement>("[data-ac-lock]").forEach((section) => {
    const notes = Array.from(section.querySelectorAll<HTMLElement>("[data-ac-lock-note]"));
    const reduced = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
    const STEP_MS = 900;
    let timers: number[] = [];

    const set = (upTo: number) =>
      notes.forEach((n) => {
        const i = Number(n.dataset.i);
        n.toggleAttribute("data-shown", i <= upTo);
        n.toggleAttribute("data-new", i === upTo);
      });

    const reset = () => {
      timers.forEach(clearTimeout);
      timers = [];
      set(-1);
    };

    if (reduced) {
      set(notes.length - 1);
      notes.forEach((n) => n.removeAttribute("data-new"));
    } else {
      section.setAttribute("data-ac-lock-ready", "");
      reset();
    }

    new IntersectionObserver(
      ([entry]) => {
        section.toggleAttribute("data-ac-in", entry.isIntersecting);
        if (reduced) return;
        if (!entry.isIntersecting) return reset();
        reset();
        notes.forEach((_, i) => timers.push(window.setTimeout(() => set(i), 900 + i * STEP_MS)));
      },
      { threshold: 0, rootMargin: "-10% 0px -10% 0px" },
    ).observe(section);
  });
</script>
