---
import { Image } from "astro:assets";
import GridRules from "@/components/GridRules.astro";
import SectionHead from "@/components/SectionHead.astro";
import TechLogo from "@/components/TechLogo.astro";
import Joints from "@/components/process/Joints.astro";
import { TECH_LOGOS, type TechLogoSlug } from "@/lib/tech-logos";
import type { SectionPhoto } from "@/types/page";

/* The toolchain, laid out as a home screen, on the dark tone. A framed
   screen with a blue wallpaper holds a photo widget of the team, a figure
   widget, the tools as app icons (brand-colour marks on white tiles, each
   named) and the core four in a dock. As the section arrives the icons
   settle from a slight zoom, the way a phone wakes. See docs/sections.md. */

interface Props {
  id: string;
  eyebrow: string;
  headline: string[];
  accent?: number;
  lede: string;
  media: SectionPhoto;
  widget: { label: string; value: string; note: string };
  apps: { slug: TechLogoSlug; label: string }[];
  dock: TechLogoSlug[];
}

const { id, eyebrow, headline, accent, lede, media, widget, apps, dock } = Astro.props;
---

<section data-ac-sec="dark" data-ac-home id={id}>
  <GridRules />

  <div data-ac-sec-container>
    <SectionHead eyebrow={eyebrow} headline={headline} accent={accent} lede={lede} />

    <div data-ac-sec-frame data-ac-home-frame>
      <Joints />
      <div data-ac-home-screen>
        <div data-ac-home-grid>
          <figure data-ac-home-photo style="--ac-i:0">
            <Image
              src={media.image}
              alt={media.alt}
              widths={[400, 700, 1000]}
              sizes="(max-width: 991px) 50vw, 26vw"
              quality={78}
              style={media.focus ? `object-position:${media.focus}` : undefined}
            />
          </figure>

          <p data-ac-home-widget style="--ac-i:1">
            <span class="mono-label-sm">{widget.label}</span>
            <b>{widget.value}</b>
            <span>{widget.note}</span>
          </p>

          <ul data-ac-home-apps>
            {apps.map((app, i) => (
              <li style={`--ac-i:${i + 2}`}>
                <span data-ac-home-icon>
                  <TechLogo slug={app.slug} size={34} tone="brand" />
                </span>
                <span data-ac-home-label>{app.label}</span>
              </li>
            ))}
          </ul>
        </div>

        <p data-ac-home-dots aria-hidden="true"><i /><i /></p>

        <ul data-ac-home-dock>
          {dock.map((slug, i) => (
            <li style={`--ac-i:${i + apps.length + 2}`}>
              <span data-ac-home-icon>
                <TechLogo slug={slug} size={34} tone="brand" />
              </span>
              <span class="sr-only">{TECH_LOGOS[slug].title}</span>
            </li>
          ))}
        </ul>
      </div>
    </div>
  </div>
</section>

<script>
  import { toggleInView } from "@/lib/in-view";

  document.querySelectorAll<HTMLElement>("[data-ac-home]").forEach(toggleInView);
</script>
