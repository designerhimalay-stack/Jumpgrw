---
interface Props {
  class?: string;
}

const { class: className = "" } = Astro.props;
---

<svg
  width="11"
  height="11"
  viewBox="0 0 12 12"
  fill="none"
  aria-hidden="true"
  class={`shrink-0 opacity-50 ${className}`}
>
  <path
    d="M3 4.5L6 7.5L9 4.5"
    stroke="currentColor"
    stroke-width="1.5"
    stroke-linecap="round"
    stroke-linejoin="round"
  />
</svg>
