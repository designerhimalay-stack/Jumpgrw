---
import Layout from "@/layouts/Layout.astro";
import BlendSection from "@/components/BlendSection.astro";
import CtaSection from "@/components/CtaSection.astro";
import FaqSection from "@/components/FaqSection.astro";
import Footer from "@/components/Footer.astro";
import HubsSection from "@/components/HubsSection.astro";
import Navbar from "@/components/Navbar.astro";
import OvernightSection from "@/components/OvernightSection.astro";
import PageHero from "@/components/PageHero.astro";
import RolesSection from "@/components/RolesSection.astro";
import SmoothScroll from "@/components/SmoothScroll.astro";
import StackSection from "@/components/StackSection.astro";
import type { PageHeroContent } from "@/types/page";
import heroPhoto from "@/assets/pages/p33-hero.jpg";
import fullstackPhoto from "@/assets/pages/p33-fullstack.jpg";
import backendPhoto from "@/assets/pages/p33-backend.jpg";
import dataPhoto from "@/assets/pages/p33-data.jpg";
import qaPhoto from "@/assets/pages/p33-qa.jpg";
import leadPhoto from "@/assets/pages/p33-lead.jpg";
import stackPhoto from "@/assets/pages/p33-stack.jpg";
import faqPhoto from "@/assets/pages/p33-faq.jpg";
import { BRAND } from "@/lib/brand";

/* Offshore engineers, India. The company is led from Dallas; this page sells
   its offshore teams in India: work that moves overnight, senior leads, the
   hubs, and a blended cost. The night on the board, the hub pool sizes, the
   rates and the FAQ answers are illustrative drafts; have them checked
   before launch. See docs/sections.md. */

const HERO: PageHeroContent = {
  trail: ["X-Shore", "Offshore", "India"],
  headline: ["Offshore", "engineers."],
  accent: 1,
  lede: "Senior engineers in India who pick up your work as Dallas signs off, and hand it back, done, by morning.",
  ctas: [
    { label: "Plan my India team", href: "#contact", arrow: "diagonal" },
    { label: "See the night shift", href: "#overnight", arrow: "right" },
  ],
  image: heroPhoto,
  imageAlt: "A developer in headphones writes code on a laptop in Jaipur.",
  specs: [
    { label: "Where", value: "Five tech hubs" },
    { label: "Time gap", value: "10½ hours ahead" },
    { label: "Led by", value: "A senior lead per team" },
    { label: "Team size", value: "2 to 50+ engineers" },
  ],
};

const FAQS = [
  {
    q: "How do hand-offs work across the time gap?",
    a: "Your team leaves notes on each ticket before signing off. The India lead picks them up first thing and posts progress before your day starts.",
  },
  {
    q: "Do we get any overlap for meetings?",
    a: "Yes. India’s evening meets Dallas’s early morning, so most teams keep a short daily overlap for stand-up and questions.",
  },
  {
    q: "Who leads the team in India?",
    a: `A senior lead in India runs the day, reviews the code and reports to your lead, or to ${BRAND.name}’s in Dallas.`,
  },
  {
    q: "Is our code and data safe?",
    a: "The team works inside your repositories, cloud and access controls, on managed devices, under your security policies.",
  },
];
---

<Layout
  title={`Offshore engineers, India · ${BRAND.name}`}
  description="Senior engineers in India who move your work forward overnight, led by senior leads, at a blended cost that scales."
  navTone="field"
>
  <SmoothScroll />
  <Navbar />
  <main>
    <PageHero content={HERO} />
    <OvernightSection
      id="overnight"
      eyebrow="Overnight progress"
      headline={["Log off at six.", "Wake up to done."]}
      accent={1}
      lede="Your team hands work over in the evening. Engineers in India pick it up, and it’s waiting, reviewed, by morning."
      columns={["Handed off", "In progress · India", "Ready for you"]}
      offset={630}
      moments={[
        { label: "Hand-off", dallas: 18 * 60, dallasState: "Signing off", indiaState: "Before dawn", summary: "5 tasks handed off, with notes" },
        { label: "Pick-up", dallas: 22 * 60 + 30, dallasState: "Asleep", indiaState: "Picked up", summary: "3 tasks picked up in Bengaluru" },
        { label: "Review", dallas: 3 * 60, dallasState: "Asleep", indiaState: "In review", summary: "2 done, 3 in progress" },
        { label: "Morning", dallas: 8 * 60, dallasState: "Back online", indiaState: "Signed off", summary: "4 ready for you, 1 with a question" },
      ]}
      tasks={[
        { id: "PAY-214", title: "Retry failed payments", who: "AK", at: [[0, 0], [1, 0], [2, 0], [2, 0]] },
        { id: "WEB-88", title: "Catalog search filters", who: "RS", at: [[0, 1], [1, 1], [1, 0], [2, 1]] },
        { id: "DATA-31", title: "Fix the nightly sync", who: "PN", at: [[0, 2], [1, 2], [2, 1], [2, 2]] },
        { id: "PDF-12", title: "Invoice PDF export", who: "VM", at: [[0, 3], [0, 0], [1, 1], [2, 3]] },
        { id: "PERF-7", title: "Load test pricing", who: "SJ", at: [[0, 4], [0, 1], [1, 2], [1, 0]] },
      ]}
      note="Illustrative night · Dallas on CDT"
    />
    <RolesSection
      id="roles"
      eyebrow="Senior engineers"
      headline={["Seniors, by role.", "Ready for your repo."]}
      accent={1}
      lede="Pick the roles you’re short of. Each engineer works in your tools and your sprint, not ours."
      roles={[
        {
          title: "Full-stack engineer",
          short: "Full stack",
          body: "Features end to end, from React screens to the APIs behind them.",
          years: "6–10 years",
          tools: ["React", "Node.js", "TypeScript"],
          image: fullstackPhoto,
          alt: "An engineer works on a laptop at a coworking desk in Pune.",
          focus: "50% 38%",
        },
        {
          title: "Backend & platform engineer",
          short: "Backend",
          body: "Services, queues and cloud plumbing that stay up under load.",
          years: "8–12 years",
          tools: ["Spring Boot", "Go", "Kubernetes"],
          image: backendPhoto,
          alt: "A developer in headphones smiles at his desk in Jaipur.",
          focus: "45% 40%",
        },
        {
          title: "Data & AI engineer",
          short: "Data & AI",
          body: "Pipelines, models and LLM features, tested before they ship.",
          years: "5–9 years",
          tools: ["Python", "Spark", "PyTorch"],
          image: dataPhoto,
          alt: "A young engineer works on her laptop on a campus bench.",
          focus: "52% 40%",
        },
        {
          title: "QA automation engineer",
          short: "QA",
          body: "Suites that run every night, so your mornings start green.",
          years: "5–8 years",
          tools: ["Cypress", "Selenium", "CI"],
          image: qaPhoto,
          alt: "An engineer in a blue shirt stands in an office in Jalandhar.",
          focus: "50% 25%",
        },
      ]}
      note="Example roles · we confirm fit before you choose"
    />
    <HubsSection
      id="hubs"
      eyebrow="Talent hubs"
      headline={["Five cities.", "One bench."]}
      accent={1}
      lede="We hire where the depth is, and match each role to the city that’s strongest at it."
      hubs={[
        {
          key: "blr",
          city: "Bengaluru",
          lat: 12.97,
          lon: 77.59,
          pool: "~2M",
          poolLabel: "Tech workers, approx.",
          line: "The deepest bench for product, cloud and AI.",
          strengths: ["SaaS products", "AI & data", "Cloud platforms"],
        },
        {
          key: "hyd",
          city: "Hyderabad",
          lat: 17.39,
          lon: 78.49,
          pool: "~1M",
          poolLabel: "Tech workers, approx.",
          line: "Large enterprise campuses and strong cloud skills.",
          strengths: ["Enterprise cloud", "Data engineering", "QA at scale"],
        },
        {
          key: "pun",
          city: "Pune",
          lat: 18.52,
          lon: 73.86,
          pool: "~0.7M",
          poolLabel: "Tech workers, approx.",
          line: "Long-tenured teams, strong on Java, .NET and testing.",
          strengths: ["Java & .NET", "Embedded", "Testing"],
        },
        {
          key: "maa",
          city: "Chennai",
          lat: 13.08,
          lon: 80.27,
          pool: "~0.8M",
          poolLabel: "Tech workers, approx.",
          line: "Deep in fintech, banking and regulated systems.",
          strengths: ["Fintech", "Mobile", "Support engineering"],
        },
        {
          key: "ncr",
          city: "Delhi NCR",
          lat: 28.61,
          lon: 77.21,
          pool: "~1M",
          poolLabel: "Tech workers, approx.",
          line: "Delhi, Gurugram and Noida: product and data talent.",
          strengths: ["Product & design", "Analytics", "Mobile"],
        },
      ]}
      note="Rounded estimates, for planning"
    />
    <BlendSection
      id="blend"
      eyebrow="Blended cost"
      headline={["A lead in Dallas.", "The team in India."]}
      accent={1}
      lede="Keep a lead onshore if you want one. Every India team has its own senior lead."
      media={{ image: leadPhoto, alt: "A senior engineering lead in glasses and a blazer smiles in a dim office.", focus: "50% 30%" }}
      rates={{ onshore: 150, lead: 60, engineer: 45 }}
      hours={160}
      engineers={{ min: 2, max: 12, start: 6 }}
      onshoreLead={true}
      labels={{
        engineers: "Engineers in India",
        onshore: "Lead in Dallas",
        onshoreNote: "Optional",
        monthly: "Per month",
        allOnshore: "All onshore",
        blended: "Blended",
        saving: "less than the same team onshore",
        seats: ["Dallas lead", "India lead", "Engineers"],
      }}
      note="Planning figures: $150/hr onshore, $60/hr India lead, $45/hr engineer, 160 hours a month. Not a quote."
    />
    <StackSection
      id="stack"
      eyebrow="Bench depth"
      headline={["Deep benches,", "every layer."]}
      accent={1}
      lede="Engineers in India who ship in each technology today, across five hubs. Pick a layer to see how deep it runs."
      media={{ image: stackPhoto, alt: "Two engineers go over work on a laptop at a café table in Dharamshala.", focus: "50% 32%" }}
      filter="Show a layer"
      all={{ label: "All layers", noun: "engineers in India today", note: "Across five hubs" }}
      deepest="Deepest:"
      key={["One square, one engineer", "One square, two engineers"]}
      note="Illustrative. People count under each tool they use."
      layers={[
        {
          label: "Front end",
          people: 64,
          noun: "front-end engineers",
          techs: [
            { slug: "react", n: 28 },
            { slug: "nextdotjs", n: 16 },
            { slug: "typescript", n: 26 },
            { slug: "angular", n: 14 },
            { slug: "vuedotjs", n: 8 },
            { slug: "flutter", n: 10 },
          ],
        },
        {
          label: "Back end",
          people: 58,
          noun: "back-end engineers",
          techs: [
            { slug: "nodedotjs", n: 22 },
            { slug: "springboot", n: 18 },
            { slug: "dotnet", n: 12 },
            { slug: "go", n: 6 },
            { slug: "python", n: 24 },
            { slug: "graphql", n: 10 },
          ],
        },
        {
          label: "Data & AI",
          people: 32,
          noun: "data and AI engineers",
          techs: [
            { slug: "postgresql", n: 20 },
            { slug: "apachespark", n: 8 },
            { slug: "databricks", n: 6 },
            { slug: "snowflake", n: 6 },
            { slug: "pytorch", n: 10 },
            { slug: "huggingface", n: 6 },
          ],
        },
        {
          label: "Cloud & QA",
          people: 46,
          noun: "cloud and QA engineers",
          techs: [
            { slug: "docker", n: 22 },
            { slug: "kubernetes", n: 14 },
            { slug: "terraform", n: 10 },
            { slug: "googlecloud", n: 8 },
            { slug: "selenium", n: 12 },
            { slug: "cypress", n: 10 },
          ],
        },
      ]}
    />
    <FaqSection
      eyebrow="India questions"
      headline={["Asked before", "the first night."]}
      accent={1}
      cta="Talk to our Dallas team"
      faqs={FAQS}
      media={{ image: faqPhoto, alt: "A team works together around a table of laptops in a Hyderabad office.", focus: "50% 45%" }}
    />
    <CtaSection
      eyebrow="Ready when you are"
      headline={["Scale in India.", "Lead from Dallas."]}
      body="Tell us the roles you need. We’ll shape an India team with a senior lead and a hand-off that fits your day."
      cta="Plan my India team"
    />
  </main>
  <Footer />
</Layout>
