---
import GridRules from "@/components/GridRules.astro";
import SectionHead from "@/components/SectionHead.astro";
import Joints from "@/components/process/Joints.astro";

/* The night shift, as a board time-lapse. Two clocks head the frame,
   Dallas and Bengaluru, over a rail of four moments (hand-off, pick-up,
   review, morning). Under them a three-column board: as the section arrives
   the clocks run through the night and the cards cross the board, from
   "handed off" to "ready for you", the way the India team moves them while
   Dallas sleeps. Each moment is a button, so the night can be stepped
   through by keyboard. Every card keeps one size and moves by transform;
   the board's height is reserved, so nothing on the page moves. Without the
   script, or under reduced motion, the morning shows. See docs/sections.md. */

interface Moment {
  label: string;
  /** Minutes after midnight, Dallas time. */
  dallas: number;
  dallasState: string;
  indiaState: string;
  summary: string;
}

interface Task {
  id: string;
  title: string;
  who: string;
  /** Column (0–2) and row at each moment, in the moments' order. */
  at: [number, number][];
}

interface Props {
  id: string;
  eyebrow: string;
  headline: string[];
  accent?: number;
  lede: string;
  columns: [string, string, string];
  moments: Moment[];
  tasks: Task[];
  /** Minutes India is ahead of Dallas. */
  offset: number;
  note: string;
}

const { id, eyebrow, headline, accent, lede, columns, moments, tasks, offset, note } = Astro.props;
const last = moments.length - 1;
const rows = Math.max(...tasks.flatMap((t) => t.at.map(([, r]) => r))) + 1;
const clock = (m: number) => {
  const t = ((m % 1440) + 1440) % 1440;
  return `${String(Math.floor(t / 60)).padStart(2, "0")}:${String(t % 60).padStart(2, "0")}`;
};
const at = (task: Task, i: number) => task.at[i] ?? task.at[task.at.length - 1];
---

<section
  data-ac-sec="light"
  data-ac-night
  id={id}
  data-step={last}
  data-offset={offset}
  style={`--ac-rows:${rows}`}
>
  <GridRules />

  <div data-ac-sec-container>
    <SectionHead eyebrow={eyebrow} headline={headline} accent={accent} lede={lede} />

    <div data-ac-sec-frame data-ac-night-frame>
      <Joints />

      <header data-ac-night-head>
        <div data-ac-night-clock data-city="dallas">
          <span class="mono-label-sm">Dallas</span>
          <span data-ac-night-time data-clock="dallas">{clock(moments[last].dallas)}</span>
          <span data-ac-night-states>
            {moments.map((m, i) => <span data-at={i}>{m.dallasState}</span>)}
          </span>
        </div>

        <ol data-ac-night-rail aria-label="Moments in the night">
          <span data-ac-night-track aria-hidden="true"><i /></span>
          {moments.map((m, i) => (
            <li style={`--ac-i:${i}`}>
              <button type="button" data-ac-night-stop={i} aria-pressed={i === last ? "true" : "false"}>
                <span data-ac-night-dot aria-hidden="true" />
                <span data-ac-night-stop-label>
                  <span class="mono-label-sm">{clock(m.dallas)}</span>
                  <span>{m.label}</span>
                </span>
              </button>
            </li>
          ))}
        </ol>

        <div data-ac-night-clock data-city="india">
          <span class="mono-label-sm">Bengaluru</span>
          <span data-ac-night-time data-clock="india">{clock(moments[last].dallas + offset)}</span>
          <span data-ac-night-states>
            {moments.map((m, i) => <span data-at={i}>{m.indiaState}</span>)}
          </span>
        </div>
      </header>

      <div data-ac-night-board>
        <div data-ac-night-cols aria-hidden="true">
          {columns.map((col, c) => (
            <p data-ac-night-col={c}>
              <span class="mono-label-sm">{col}</span>
            </p>
          ))}
        </div>

        <ul data-ac-night-cards aria-label="Tasks on the board by morning">
          {tasks.map((task, t) => (
            <li
              data-ac-night-card
              style={[
                ...moments.map((_, i) => `--c${i}:${at(task, i)[0]};--r${i}:${at(task, i)[1]}`),
                `--ac-t:${t}`,
              ].join(";")}
            >
              <span data-ac-night-id class="mono-label-sm">{task.id}</span>
              <span data-ac-night-title>{task.title}</span>
              <span data-ac-night-who aria-hidden="true">{task.who}</span>
              <span class="sr-only">: {columns[at(task, last)[0]]}</span>
            </li>
          ))}
        </ul>
      </div>

      <footer data-ac-night-foot>
        <span data-ac-night-summary aria-live="polite">
          {moments.map((m, i) => <span data-at={i}>{m.summary}</span>)}
        </span>
        <span class="mono-label-sm" data-ac-night-note>{note}</span>
      </footer>
    </div>
  </div>
</section>

<script>
  import { toggleInView } from "@/lib/in-view";

  document.querySelectorAll<HTMLElement>("[data-ac-night]").forEach((section) => {
    toggleInView(section);

    const stops = Array.from(section.querySelectorAll<HTMLButtonElement>("[data-ac-night-stop]"));
    const last = stops.length - 1;
    const offset = Number(section.dataset.offset ?? 0);
    const dallas = section.querySelector<HTMLElement>('[data-clock="dallas"]')!;
    const india = section.querySelector<HTMLElement>('[data-clock="india"]')!;
    const minutes = stops.map((b) => {
      const [h, m] = (b.querySelector(".mono-label-sm")?.textContent ?? "0:0").split(":").map(Number);
      return h * 60 + m;
    });
    /* The night runs past midnight: count on from the first moment. */
    for (let i = 1; i < minutes.length; i++) while (minutes[i] < minutes[i - 1]) minutes[i] += 1440;

    const fmt = (m: number) => {
      const t = ((Math.round(m) % 1440) + 1440) % 1440;
      return `${String(Math.floor(t / 60)).padStart(2, "0")}:${String(t % 60).padStart(2, "0")}`;
    };
    const showTime = (m: number) => {
      dallas.textContent = fmt(m);
      india.textContent = fmt(m + offset);
    };

    const setStep = (i: number) => {
      section.dataset.step = String(i);
      stops.forEach((b, n) => b.setAttribute("aria-pressed", n === i ? "true" : "false"));
    };

    let raf = 0;
    let timer = 0;
    const stop = () => {
      cancelAnimationFrame(raf);
      window.clearTimeout(timer);
    };

    /* Run the clocks from one moment to the next, then move the cards. */
    const runTo = (from: number, to: number, done: () => void) => {
      const start = performance.now();
      const span = 1300;
      const a = minutes[from];
      const b = minutes[to];
      const frame = (now: number) => {
        const p = Math.min(1, (now - start) / span);
        const eased = p < 0.5 ? 2 * p * p : 1 - Math.pow(-2 * p + 2, 2) / 2;
        showTime(a + (b - a) * eased);
        if (p < 1) raf = requestAnimationFrame(frame);
        else done();
      };
      raf = requestAnimationFrame(frame);
    };

    const play = () => {
      stop();
      setStep(0);
      showTime(minutes[0]);
      let i = 0;
      const next = () => {
        if (i >= last) return;
        timer = window.setTimeout(() => {
          runTo(i, i + 1, () => {
            i += 1;
            setStep(i);
            next();
          });
        }, 900);
      };
      next();
    };

    stops.forEach((b, i) =>
      b.addEventListener("click", () => {
        stop();
        setStep(i);
        showTime(minutes[i]);
      }),
    );

    const reduced = window.matchMedia("(prefers-reduced-motion: reduce)");
    new IntersectionObserver(
      ([entry]) => {
        if (reduced.matches) return;
        if (entry.isIntersecting) play();
        else {
          stop();
          setStep(last);
          showTime(minutes[last]);
        }
      },
      { threshold: 0.35 },
    ).observe(section.querySelector("[data-ac-night-frame]")!);
  });
</script>
