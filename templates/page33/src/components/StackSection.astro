---
import GridRules from "@/components/GridRules.astro";
import SectionHead from "@/components/SectionHead.astro";
import TechLogo from "@/components/TechLogo.astro";
import Joints from "@/components/process/Joints.astro";
import { TECH_LOGOS, type TechLogoSlug } from "@/lib/tech-logos";
import type { SectionPhoto } from "@/types/page";

/* Bench depth: how many engineers in India ship in each technology, as a
   pictogram. The header splits around a photo of two engineers at work;
   under it one frame. Its bar holds the layer filter (a radio group, so it
   works by keyboard and without the script) and a readout, the headcount of
   the chosen layer or of the whole bench; every readout shares one grid
   cell. Under the bar, one column per technology in four groups of six:
   a stack of squares, one per engineer, rising off a baseline, its count on
   top and its logo and name under it. Picking a layer greys the other
   groups (CSS :has, nothing moves). The squares fill bottom up as the
   section arrives and empty again as it leaves; the groups sit on one
   baseline. Phones set the groups two by two, draw a square per two
   engineers (the key says so) and keep the names for screen readers only. See docs/sections.md. */

interface Tech {
  slug: TechLogoSlug;
  /** Engineers who ship in it. */
  n: number;
}

interface Layer {
  label: string;
  /** Engineers in this layer (people count once, however many tools). */
  people: number;
  /** The readout's line, e.g. "front-end engineers". */
  noun: string;
  techs: Tech[];
}

interface Props {
  id: string;
  eyebrow: string;
  headline: string[];
  accent?: number;
  lede: string;
  media: SectionPhoto;
  filter: string;
  all: { label: string; noun: string; note: string };
  deepest: string;
  /** The key: one square per engineer, and per two on phones. */
  key: [string, string];
  note: string;
  layers: Layer[];
}

const { id, eyebrow, headline, accent, lede, media, filter, all, deepest, key, note, layers } =
  Astro.props;

const total = layers.reduce((sum, l) => sum + l.people, 0);
/* Each group reserves the rows its deepest column needs, at one engineer a
   square and (phones) at two. */
const deep = (l: Layer) => Math.max(...l.techs.map((t) => t.n));
const rows = (l: Layer) => `--ac-rows:${Math.ceil(deep(l) / 2)};--ac-rows-sm:${Math.ceil(deep(l) / 4)}`;
const top = (l: Layer) => l.techs.reduce((a, b) => (b.n > a.n ? b : a));

const reads = [
  { n: total, noun: all.noun, note: all.note },
  ...layers.map((l) => ({
    n: l.people,
    noun: l.noun,
    note: `${deepest} ${TECH_LOGOS[top(l).slug].title}, ${top(l).n}`,
  })),
];

let col = 0;
---

<section data-ac-sec="light" data-ac-bench id={id}>
  <GridRules />

  <div data-ac-sec-container>
    <SectionHead eyebrow={eyebrow} headline={headline} accent={accent} lede={lede} media={media} />

    <div data-ac-sec-frame data-ac-bench-frame>
      <Joints />

      <div data-ac-bench-bar>
        <fieldset data-ac-bench-pick>
          <legend class="mono-label">{filter}</legend>
          <div data-ac-bench-chips>
            {[all.label, ...layers.map((l) => l.label)].map((label, k) => (
              <label data-ac-bench-chip>
                <input type="radio" name={`${id}-layer`} value={k} data-ac-bench-k={k} checked={k === 0} />
                <span>{label}</span>
              </label>
            ))}
          </div>
        </fieldset>

        <div data-ac-bench-reads>
          {reads.map((r, k) => (
            <p data-ac-bench-read={k}>
              <b>{r.n}</b>
              <span>{r.noun}</span>
              <span class="mono-label">{r.note}</span>
            </p>
          ))}
        </div>
      </div>

      <ol data-ac-bench-groups>
        {layers.map((layer, l) => (
          <li data-ac-bench-group data-ac-bench-l={l + 1} style={rows(layer)}>
            <ul aria-label={layer.label}>
              {layer.techs.map((tech) => (
                <li data-ac-bench-col style={`--ac-c:${col++}`}>
                  <span data-ac-bench-stack aria-hidden="true">
                    <span data-ac-bench-n>{tech.n}</span>
                    {Array.from({ length: tech.n }, (_, u) => (
                      <i style={`--ac-u:${tech.n - 1 - u}`}></i>
                    ))}
                  </span>
                  <TechLogo slug={tech.slug} size={24} />
                  <span data-ac-bench-name>
                    {TECH_LOGOS[tech.slug].title}
                    <span class="sr-only">: {tech.n}</span>
                  </span>
                </li>
              ))}
            </ul>
            <p data-ac-bench-layer class="mono-label" aria-hidden="true">{layer.label}</p>
          </li>
        ))}
      </ol>

      <p data-ac-bench-key>
        <span class="mono-label">
          <i aria-hidden="true"></i>
          <span data-ac-bench-unit="1">{key[0]}</span>
          <span data-ac-bench-unit="2">{key[1]}</span>
        </span>
        <span>{note}</span>
      </p>
    </div>
  </div>
</section>

<script>
  import { toggleInView } from "@/lib/in-view";

  document.querySelectorAll<HTMLElement>("[data-ac-bench]").forEach(toggleInView);
</script>
