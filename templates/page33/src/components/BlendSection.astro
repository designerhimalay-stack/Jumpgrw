---
import { Image } from "astro:assets";
import GridRules from "@/components/GridRules.astro";
import RevealText from "@/components/RevealText.astro";
import Joints from "@/components/process/Joints.astro";
import type { SectionPhoto } from "@/types/page";

/* A blended team, costed, on the dark tone. Columns 1–2: the claim, a photo
   of the India lead, and two controls: how many engineers in India, and
   whether a lead sits onshore in Dallas. Columns 3–4: the team drawn as
   seats (Dallas, the India lead, the engineers), a fixed row of fourteen so
   adding one only fills a seat; the monthly figure; and two bars, the same
   team all onshore against the blend. Bars grow by transform, the figures
   sit in fixed-width cells, so nothing on the page moves. Without the script
   the default team shows, worked out at build time. See docs/sections.md. */

interface Props {
  id: string;
  eyebrow: string;
  headline: string[];
  accent?: number;
  lede: string;
  media: SectionPhoto;
  /** Hourly rates, illustrative. */
  rates: { onshore: number; lead: number; engineer: number };
  hours: number;
  engineers: { min: number; max: number; start: number };
  onshoreLead: boolean;
  labels: {
    engineers: string;
    onshore: string;
    onshoreNote: string;
    monthly: string;
    allOnshore: string;
    blended: string;
    saving: string;
    seats: [string, string, string];
  };
  note: string;
}

const { id, eyebrow, headline, accent = headline.length - 1, lede, media, rates, hours, engineers, onshoreLead, labels, note } = Astro.props;
const offsets = headline.map((_, i) => headline.slice(0, i).reduce((n, line) => n + Array.from(line).length + 1, 0));

const cost = (n: number, lead: boolean) => {
  const blended = (lead ? rates.onshore : 0) * hours + rates.lead * hours + rates.engineer * hours * n;
  const onshore = rates.onshore * hours * ((lead ? 1 : 0) + 1 + n);
  return { blended, onshore, saving: Math.round((1 - blended / onshore) * 100) };
};
const money = (v: number) => `$${(v / 1000).toFixed(v >= 100000 ? 0 : 1).replace(/\.0$/, "")}k`;
const start = cost(engineers.start, onshoreLead);
const maxOnshore = cost(engineers.max, true).onshore;
const seats = 2 + engineers.max;
---

<section
  data-ac-sec="dark"
  data-ac-blend
  id={id}
  data-rates={JSON.stringify(rates)}
  data-hours={hours}
  data-max={maxOnshore}
  data-lead={onshoreLead ? "on" : "off"}
  style={`--ac-seats:${seats}`}
>
  <GridRules />

  <div data-ac-sec-container data-ac-blend-grid>
    <div data-ac-blend-copy>
      <p data-ac-sec-eyebrow class="mono-label">
        <span aria-hidden="true">+</span>
        {eyebrow}
      </p>
      <h2 data-ac-blend-headline aria-label={headline.join(" ")}>
        {headline.map((line, i) => (
          <Fragment>
            {i > 0 && <Fragment>{" "}<br aria-hidden="true" /></Fragment>}
            <span data-ac-sec-line data-accent={i === accent || undefined}>
              <RevealText text={line} offset={offsets[i]} />
            </span>
          </Fragment>
        ))}
      </h2>
      <p data-ac-blend-lede data-ac-sec-rise>{lede}</p>

      <div data-ac-blend-controls data-ac-sec-rise>
        <div data-ac-blend-stepper role="group" aria-labelledby={`${id}-eng-label`}>
          <span id={`${id}-eng-label`} class="mono-label-sm">{labels.engineers}</span>
          <div data-ac-blend-step>
            <button type="button" data-ac-blend-dec aria-label="One engineer fewer">−</button>
            <output data-ac-blend-count aria-live="polite" aria-labelledby={`${id}-eng-label`}>{engineers.start}</output>
            <button type="button" data-ac-blend-inc aria-label="One engineer more">+</button>
          </div>
        </div>
        <label data-ac-blend-switch>
          <input type="checkbox" role="switch" data-ac-blend-lead checked={onshoreLead} />
          <span data-ac-blend-track aria-hidden="true"><i /></span>
          <span data-ac-blend-switch-text>
            <span>{labels.onshore}</span>
            <span class="mono-label-sm">{labels.onshoreNote}</span>
          </span>
        </label>
      </div>

      <div data-ac-blend-photo>
        <Joints />
        <div data-ac-blend-image>
          <Image
            src={media.image}
            alt={media.alt}
            widths={[480, 800, 1200]}
            sizes="(max-width: 991px) 100vw, 46vw"
            quality={76}
            style={media.focus ? `object-position:${media.focus}` : undefined}
          />
        </div>
      </div>
    </div>

    <div data-ac-sec-frame data-ac-blend-sheet data-min={engineers.min} data-max-eng={engineers.max}>
      <Joints />
      <p data-ac-blend-sheet-label class="mono-label-sm">Your team</p>
      <ol data-ac-blend-seats aria-hidden="true">
        {Array.from({ length: seats }, (_, s) => {
          const kind = s === 0 ? "onshore" : s === 1 ? "lead" : "eng";
          const on = kind === "onshore" ? onshoreLead : kind === "lead" ? true : s - 2 < engineers.start;
          return (
            <li data-seat={kind} data-on={on ? "" : undefined} style={`--ac-s:${s}`}>
              <span>{kind === "onshore" ? "US" : kind === "lead" ? "Lead" : String(s - 1).padStart(2, "0")}</span>
            </li>
          );
        })}
      </ol>
      <ul data-ac-blend-key class="mono-label-sm" aria-hidden="true">
        <li data-seat="onshore">{labels.seats[0]}</li>
        <li data-seat="lead">{labels.seats[1]}</li>
        <li data-seat="eng">{labels.seats[2]}</li>
      </ul>

      <div data-ac-blend-figure>
        <p class="mono-label-sm">{labels.monthly}</p>
        <p data-ac-blend-total aria-live="polite">{money(start.blended)}</p>
        <p data-ac-blend-saving>
          <span data-ac-blend-pct>{start.saving}%</span>
          <span>{labels.saving}</span>
        </p>
      </div>

      <div data-ac-blend-bars>
        <div data-ac-blend-bar data-kind="onshore" style={`--ac-w:${(start.onshore / maxOnshore).toFixed(3)}`}>
          <span class="mono-label-sm">{labels.allOnshore}</span>
          <span data-ac-blend-bar-track><i /></span>
          <span data-ac-blend-bar-value>{money(start.onshore)}</span>
        </div>
        <div data-ac-blend-bar data-kind="blend" style={`--ac-w:${(start.blended / maxOnshore).toFixed(3)}`}>
          <span class="mono-label-sm">{labels.blended}</span>
          <span data-ac-blend-bar-track><i /></span>
          <span data-ac-blend-bar-value>{money(start.blended)}</span>
        </div>
      </div>

      <p data-ac-blend-note>{note}</p>
    </div>
  </div>
</section>

<script>
  import { toggleInView } from "@/lib/in-view";

  document.querySelectorAll<HTMLElement>("[data-ac-blend]").forEach((section) => {
    toggleInView(section);

    const rates = JSON.parse(section.dataset.rates ?? "{}") as { onshore: number; lead: number; engineer: number };
    const hours = Number(section.dataset.hours);
    const max = Number(section.dataset.max);
    const sheet = section.querySelector<HTMLElement>("[data-ac-blend-sheet]")!;
    const min = Number(sheet.dataset.min);
    const maxEng = Number(sheet.dataset.maxEng);
    const count = section.querySelector<HTMLOutputElement>("[data-ac-blend-count]")!;
    const dec = section.querySelector<HTMLButtonElement>("[data-ac-blend-dec]")!;
    const inc = section.querySelector<HTMLButtonElement>("[data-ac-blend-inc]")!;
    const lead = section.querySelector<HTMLInputElement>("[data-ac-blend-lead]")!;
    const seats = Array.from(section.querySelectorAll<HTMLElement>("[data-ac-blend-seats] li"));
    const total = section.querySelector<HTMLElement>("[data-ac-blend-total]")!;
    const pct = section.querySelector<HTMLElement>("[data-ac-blend-pct]")!;
    const bars = Array.from(section.querySelectorAll<HTMLElement>("[data-ac-blend-bar]"));

    const money = (v: number) => `$${(v / 1000).toFixed(v >= 100000 ? 0 : 1).replace(/\.0$/, "")}k`;

    let n = Number(count.value || count.textContent);

    const render = () => {
      const withLead = lead.checked;
      const blended = (withLead ? rates.onshore : 0) * hours + rates.lead * hours + rates.engineer * hours * n;
      const onshore = rates.onshore * hours * ((withLead ? 1 : 0) + 1 + n);
      count.value = String(n);
      count.textContent = String(n);
      dec.disabled = n <= min;
      inc.disabled = n >= maxEng;
      section.dataset.lead = withLead ? "on" : "off";
      seats.forEach((seat, s) => {
        const on = s === 0 ? withLead : s === 1 ? true : s - 2 < n;
        seat.toggleAttribute("data-on", on);
      });
      total.textContent = money(blended);
      pct.textContent = `${Math.round((1 - blended / onshore) * 100)}%`;
      const values = [onshore, blended];
      bars.forEach((bar, i) => {
        bar.style.setProperty("--ac-w", (values[i] / max).toFixed(3));
        bar.querySelector("[data-ac-blend-bar-value]")!.textContent = money(values[i]);
      });
    };

    dec.addEventListener("click", () => {
      n = Math.max(min, n - 1);
      render();
    });
    inc.addEventListener("click", () => {
      n = Math.min(maxEng, n + 1);
      render();
    });
    lead.addEventListener("change", render);
    render();
  });
</script>
