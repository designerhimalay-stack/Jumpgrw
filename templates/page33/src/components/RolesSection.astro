---
import { Image } from "astro:assets";
import GridRules from "@/components/GridRules.astro";
import SectionHead from "@/components/SectionHead.astro";
import Joints from "@/components/process/Joints.astro";
import type { ImageMetadata } from "astro";

/* The roles, as a row of photo panels on the dark tone. One panel stands
   open at a time: a photo of an engineer at work, the role, what they take
   on, their years and the tools they bring. The others stand as tall
   slivers of photo with the role's name turned up the side; pointing at one,
   or tabbing to it, opens it. The row keeps one height and the panels share
   its width, so opening one moves nothing else on the page. Phones get the
   roles as a two-column deck, every card open. See docs/sections.md. */

interface Role {
  title: string;
  short: string;
  body: string;
  years: string;
  tools: string[];
  image: ImageMetadata;
  alt: string;
  focus?: string;
}

interface Props {
  id: string;
  eyebrow: string;
  headline: string[];
  accent?: number;
  lede: string;
  roles: Role[];
  note: string;
}

const { id, eyebrow, headline, accent, lede, roles, note } = Astro.props;
const pad = (n: number) => String(n).padStart(2, "0");
---

<section data-ac-sec="dark" data-ac-roles id={id}>
  <GridRules />

  <div data-ac-sec-container>
    <SectionHead eyebrow={eyebrow} headline={headline} accent={accent} lede={lede} />

    <ul data-ac-roles-row style={`--ac-n:${roles.length}`}>
      {roles.map((role, i) => (
        <li data-ac-roles-panel data-open={i === 0 ? "" : undefined} style={`--ac-i:${i}`} tabindex="0">
          <Joints />
          <div data-ac-roles-photo>
            <Image
              src={role.image}
              alt={role.alt}
              widths={[360, 640, 960]}
              sizes="(max-width: 599px) 50vw, (max-width: 991px) 50vw, 40vw"
              quality={76}
              style={role.focus ? `object-position:${role.focus}` : undefined}
            />
          </div>
          <span data-ac-roles-spine aria-hidden="true">
            <span class="mono-label-sm">{pad(i + 1)}</span>
            <span>{role.short}</span>
          </span>
          <div data-ac-roles-card>
            <p data-ac-roles-years class="mono-label-sm">{role.years}</p>
            <h3 data-ac-roles-title>{role.title}</h3>
            <p data-ac-roles-body>{role.body}</p>
            <ul data-ac-roles-tools aria-label={`${role.title}: tools`}>
              {role.tools.map((tool) => <li class="mono-label-sm">{tool}</li>)}
            </ul>
          </div>
        </li>
      ))}
    </ul>
    <p data-ac-roles-note class="mono-label-sm">{note}</p>
  </div>
</section>

<script>
  import { toggleInView } from "@/lib/in-view";

  document.querySelectorAll<HTMLElement>("[data-ac-roles]").forEach((section) => {
    toggleInView(section);

    const panels = Array.from(section.querySelectorAll<HTMLElement>("[data-ac-roles-panel]"));
    const open = (panel: HTMLElement) => panels.forEach((p) => p.toggleAttribute("data-open", p === panel));
    panels.forEach((panel) => {
      panel.addEventListener("pointerenter", (e) => {
        if (e.pointerType === "mouse") open(panel);
      });
      panel.addEventListener("focus", () => open(panel));
      panel.addEventListener("click", () => open(panel));
    });
  });
</script>
