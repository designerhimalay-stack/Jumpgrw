---
import Layout from "@/layouts/Layout.astro";
import CitiesSection from "@/components/CitiesSection.astro";
import CtaSection from "@/components/CtaSection.astro";
import FaqSection from "@/components/FaqSection.astro";
import Footer from "@/components/Footer.astro";
import HandledSection from "@/components/HandledSection.astro";
import ModelSection from "@/components/ModelSection.astro";
import Navbar from "@/components/Navbar.astro";
import PageHero from "@/components/PageHero.astro";
import RampSection from "@/components/RampSection.astro";
import SmoothScroll from "@/components/SmoothScroll.astro";
import type { PageHeroContent } from "@/types/page";
import heroPhoto from "@/assets/pages/p34-hero.jpg";
import teamPhoto from "@/assets/pages/p34-team.jpg";
import directorPhoto from "@/assets/pages/p34-director.jpg";
import faqPhoto from "@/assets/pages/p34-faq.jpg";
import { BRAND } from "@/lib/brand";

/* GCC from India. The company sets up and runs a Global Capability Center
   in India for a client: the ramp to 150 people, the choice of city, the
   operating model, and the paperwork it handles. The ramp, the city
   figures and the FAQ answers are illustrative drafts; have them checked
   before launch. See docs/sections.md. */

const HERO: PageHeroContent = {
  trail: ["X-Shore", "Offshore", "GCC from India"],
  headline: ["Your own", "India GCC."],
  accent: 1,
  lede: "We set up and run your Global Capability Center in India: entity, office, people and pods, built to your plan and yours to keep.",
  ctas: [
    { label: "Plan my GCC", href: "#contact", arrow: "diagonal" },
    { label: "See the ramp", href: "#ramp", arrow: "right" },
  ],
  image: heroPhoto,
  imageAlt: "An engineer in headphones and glasses works at his desk in Jalandhar, India.",
  specs: [
    { label: "Ramp", value: "150 people in 18 months" },
    { label: "Cities", value: "Four to compare" },
    { label: "We run", value: "Entity to payroll" },
    { label: "Ownership", value: "Yours, when ready" },
  ],
};

const FAQS = [
  {
    q: "How is a GCC different from outsourcing?",
    a: "The team is yours: your roles, your leaders, your roadmap. We run the entity, payroll and office around it.",
  },
  {
    q: "When can we take it over?",
    a: "Whenever you’re ready, often after two or three years. The entity, people and contracts move to you on terms agreed up front.",
  },
  {
    q: "Who leads the center in India?",
    a: "A GCC head you choose, reporting to your leadership. We help hire them first, before the pods.",
  },
  {
    q: "What does it cost to start?",
    a: `A one-time set-up fee, then the team at cost plus a management fee. ${BRAND.name} models it with you before you commit.`,
  },
];
---

<Layout
  title={`GCC from India · ${BRAND.name}`}
  description="Set up and run your own Global Capability Center in India: the city, the entity, the office, the people and the pods, with an option to take it over."
  navTone="field"
>
  <SmoothScroll />
  <Navbar />
  <main>
    <PageHero content={HERO} />
    <RampSection
      id="ramp"
      eyebrow="Ramp to scale"
      headline={["Zero to 150.", "In 18 months."]}
      accent={1}
      lede="Entity first, then leaders, then pods. Every step is planned before the first hire."
      months={18}
      steps={[
        { m: 2, n: 4 },
        { m: 4, n: 10 },
        { m: 6, n: 25 },
        { m: 9, n: 50 },
        { m: 12, n: 80 },
        { m: 15, n: 115 },
        { m: 18, n: 150 },
      ]}
      ticks={[25, 80, 150]}
      milestones={[
        { m: 0, title: "Entity", note: "Company, bank, tax IDs" },
        { m: 2, title: "Leadership", note: "GCC head and 3 leads" },
        { m: 4, title: "Office", note: "Seats for the first 40" },
        { m: 6, title: "First pods", note: "25 people, 3 pods" },
        { m: 12, title: "Scale", note: "80 people, 7 pods" },
        { m: 18, title: "Transfer option", note: "150 people, yours to take" },
      ]}
      counterLabel="People in the center"
      monthLabel="Month"
      note="An example plan · each ramp is set with you"
    />
    <CitiesSection
      id="cities"
      eyebrow="Choose the city"
      headline={["Four cities.", "Pick on purpose."]}
      accent={1}
      lede="Each city is strong at something different. Compare them on what matters to your center."
      media={{ image: teamPhoto, alt: "A team meets around a table in a coworking office in Bengaluru.", focus: "50% 30%" }}
      cities={[
        {
          key: "blr",
          name: "Bengaluru",
          code: "BLR",
          line: "The deepest bench for product, cloud and AI, at a premium.",
          suits: ["Product engineering", "AI & data", "Fast-growing pods"],
        },
        {
          key: "hyd",
          name: "Hyderabad",
          code: "HYD",
          line: "Big campuses, good office supply and quick hiring.",
          suits: ["Large centers", "Cloud platforms", "Enterprise tech"],
        },
        {
          key: "pun",
          name: "Pune",
          code: "PNQ",
          line: "Steady teams with long tenure, strong on engineering and testing.",
          suits: ["Java & .NET", "Embedded", "Quality engineering"],
        },
        {
          key: "maa",
          name: "Chennai",
          code: "MAA",
          line: "Lower cost and attrition, deep in banking and regulated work.",
          suits: ["Banking & fintech", "Regulated systems", "Support engineering"],
        },
      ]}
      measures={[
        { label: "Tech talent pool", low: "Smaller", high: "Larger", min: 0, max: 2.2, values: [2, 1, 0.7, 0.8], format: ["~2M", "~1M", "~0.7M", "~0.8M"] },
        { label: "Engineer cost", low: "Lower", high: "Higher", min: 80, max: 104, values: [100, 93, 91, 88], format: ["100", "93", "91", "88"] },
        { label: "Office rent, ₹/sq ft/mo", low: "Lower", high: "Higher", min: 60, max: 104, values: [95, 75, 80, 70], format: ["₹95", "₹75", "₹80", "₹70"] },
        { label: "Weeks to hire a senior", low: "Faster", high: "Slower", min: 3, max: 9, values: [7, 5, 6, 5.4], format: ["7 wk", "5 wk", "6 wk", "5 wk"] },
      ]}
      note="Rounded planning figures · cost indexed to Bengaluru = 100 · we confirm them for your roles"
    />
    <ModelSection
      id="model"
      eyebrow="Operating model"
      headline={["Your leaders.", "Your center."]}
      accent={1}
      lede="The pods report to your leaders through a GCC head you choose. We run the site around them."
      leadership={{ tag: "Your HQ", title: "Your leadership", roles: ["CTO", "VP Engineering", "Product"] }}
      head={{ tag: "India", title: "GCC head", note: "Hired first, reports to you" }}
      ops={{ tag: `Run by ${BRAND.name}`, title: "Site operations", items: ["HR", "Payroll", "IT", "Facilities"] }}
      pods={[
        { name: "Product engineering", lead: "Engineering manager", size: "8–12 people", logos: ["react", "typescript", "nodedotjs"] },
        { name: "Data & AI", lead: "Data lead", size: "6–10 people", logos: ["python", "databricks", "snowflake"] },
        { name: "Platform", lead: "Platform lead", size: "5–8 people", logos: ["kubernetes", "terraform", "googlecloud"] },
        { name: "Quality", lead: "QA lead", size: "4–6 people", logos: ["cypress", "selenium", "githubactions"] },
      ]}
    />
    <HandledSection
      id="handled"
      eyebrow="What we handle"
      headline={["The paperwork.", "Done for you."]}
      accent={1}
      lede="Six things every center needs before it can ship. We take them off your desk."
      media={{ image: directorPhoto, alt: "A director sits at her desk with a laptop in a New Delhi office.", focus: "50% 40%" }}
      stamp="Handled"
      forms={[
        { code: "Entity", title: "Legal entity", line: "Company set-up, bank, tax IDs, registered office." },
        { code: "Payroll", title: "Payroll & benefits", line: "Monthly pay, provident fund, insurance.", logos: ["zoho", "razorpay"] },
        { code: "Compliance", title: "Compliance", line: "Labour law, GST, audits, annual filings." },
        { code: "Workspace", title: "Workspace", line: "Grade-A seats, fit-out, meeting rooms.", logos: ["zoom", "googlemeet"] },
        { code: "Hiring", title: "Hiring", line: "Sourcing, interviews, offers, onboarding.", logos: ["greenhouse"] },
        { code: "IT & security", title: "IT & security", line: "Laptops, identity, access, audits.", logos: ["okta", "1password", "tailscale"] },
      ]}
      keep={{ label: "You keep", items: ["Who you hire", "The budget", "The roadmap"] }}
    />
    <FaqSection
      eyebrow="GCC questions"
      headline={["Asked before", "we sign a lease."]}
      accent={1}
      cta="Talk to our Dallas team"
      faqs={FAQS}
      media={{ image: faqPhoto, alt: "An executive in a white blazer sits at her desk in a New Delhi office.", focus: "50% 35%" }}
    />
    <CtaSection
      eyebrow="Ready to build"
      headline={["Your center.", "Your terms."]}
      body="Tell us the roles and the timeline. We’ll come back with a city, a ramp and a cost to start."
      cta="Plan my GCC"
    />
  </main>
  <Footer />
</Layout>
