---
import GridRules from "@/components/GridRules.astro";
import SectionHead from "@/components/SectionHead.astro";
import TechLogo from "@/components/TechLogo.astro";
import Joints from "@/components/process/Joints.astro";
import { TECH_LOGOS, type TechLogoSlug } from "@/lib/tech-logos";

/* The operating model, as an org view that assembles. One frame on a
   drafting grid: your leadership at the top; under it, joined by a line,
   the GCC head in India (in the accent), with site operations (run by us,
   dashed) branching off to the side; then a bus line feeding the pods, each
   a card with its lead, its size and the logos of the stack it works in.
   As the frame arrives the tiers drop in from the top and the lines draw
   between them, one after another; leaving plays it back. Phones stack the
   tiers, set the pods two by two and drop the operations branch's line.
   See docs/sections.md. */

interface Pod {
  name: string;
  lead: string;
  size: string;
  logos: TechLogoSlug[];
}

interface Props {
  id: string;
  eyebrow: string;
  headline: string[];
  accent?: number;
  lede: string;
  leadership: { tag: string; title: string; roles: string[] };
  head: { tag: string; title: string; note: string };
  ops: { tag: string; title: string; items: string[] };
  pods: Pod[];
}

const { id, eyebrow, headline, accent, lede, leadership, head, ops, pods } = Astro.props;
---

<section data-ac-sec="light" data-ac-org id={id}>
  <GridRules />

  <div data-ac-sec-container>
    <SectionHead eyebrow={eyebrow} headline={headline} accent={accent} lede={lede} />

    <div data-ac-sec-frame data-ac-org-frame>
      <Joints />

      <div data-ac-org-top>
        <div data-ac-org-node data-tier="0">
          <p class="mono-label-sm" data-ac-org-tag>{leadership.tag}</p>
          <p data-ac-org-title>{leadership.title}</p>
          <ul data-ac-org-roles>
            {leadership.roles.map((r) => <li>{r}</li>)}
          </ul>
        </div>
      </div>

      <i data-ac-org-stem data-step="0" aria-hidden="true"></i>

      <div data-ac-org-mid>
        <div data-ac-org-node data-tier="1" data-head>
          <p class="mono-label-sm" data-ac-org-tag>{head.tag}</p>
          <p data-ac-org-title>{head.title}</p>
          <p data-ac-org-note>{head.note}</p>
        </div>
        <i data-ac-org-branch aria-hidden="true"></i>
        <div data-ac-org-node data-tier="1" data-ops>
          <p class="mono-label-sm" data-ac-org-tag>{ops.tag}</p>
          <p data-ac-org-title>{ops.title}</p>
          <ul data-ac-org-roles>
            {ops.items.map((r) => <li>{r}</li>)}
          </ul>
        </div>
      </div>

      <i data-ac-org-stem data-step="1" aria-hidden="true"></i>
      <i data-ac-org-bus aria-hidden="true"></i>

      <ul data-ac-org-pods style={`--ac-pods:${pods.length}`}>
        {pods.map((p, i) => (
          <li data-ac-org-node data-tier="2" style={`--ac-i:${i}`}>
            <i data-ac-org-drop aria-hidden="true"></i>
            <p data-ac-org-title>{p.name}</p>
            <p data-ac-org-lead>{p.lead}</p>
            <p class="mono-label-sm" data-ac-org-size>{p.size}</p>
            <ul data-ac-org-logos aria-label={`${p.name} stack`}>
              {p.logos.map((slug) => (
                <li>
                  <TechLogo slug={slug} size={22} />
                  <span>{TECH_LOGOS[slug].title}</span>
                </li>
              ))}
            </ul>
          </li>
        ))}
      </ul>
    </div>
  </div>
</section>

<script>
  import { toggleInView } from "@/lib/in-view";

  document.querySelectorAll<HTMLElement>("[data-ac-org]").forEach(toggleInView);
</script>
