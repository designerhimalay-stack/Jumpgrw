---
import GridRules from "@/components/GridRules.astro";
import SectionHead from "@/components/SectionHead.astro";
import Joints from "@/components/process/Joints.astro";
import type { SectionPhoto } from "@/types/page";

/* Choose the city, on the dark tone. The header splits around a photo of a
   team meeting in Bengaluru. Under it one frame: on the left the four
   cities as ARIA tabs (arrow keys, Home, End) and the chosen city's case
   (a line and what it suits); on the right a strip per measure (talent
   pool, cost, office rent, time to hire), each a scale carrying all four
   cities as dots. The chosen city's dots grow, take the accent and show
   their values; the other three stay small and grey, so every choice is
   read against the field. Every dot and value is drawn at build time and keeps
   its place: choosing changes colour and size only, and the panels share
   one grid cell. Without the script the first city shows. See
   docs/sections.md. */

interface City {
  key: string;
  name: string;
  code: string;
  line: string;
  suits: string[];
}

interface Measure {
  label: string;
  /** What low and high mean on this scale. */
  low: string;
  high: string;
  min: number;
  max: number;
  /** One value per city, in the cities' order, and how to print it. */
  values: number[];
  format: string[];
}

interface Props {
  id: string;
  eyebrow: string;
  headline: string[];
  accent?: number;
  lede: string;
  media: SectionPhoto;
  cities: City[];
  measures: Measure[];
  note: string;
}

const { id, eyebrow, headline, accent, lede, media, cities, measures, note } = Astro.props;
const pos = (m: Measure, v: number) => ((v - m.min) / (m.max - m.min)) * 100;
---

<section data-ac-sec="dark" data-ac-city id={id} data-city={cities[0].key}>
  <GridRules />

  <div data-ac-sec-container>
    <SectionHead eyebrow={eyebrow} headline={headline} accent={accent} lede={lede} media={media} />

    <div data-ac-sec-frame data-ac-city-frame>
      <Joints />

      <div data-ac-city-side>
        <div data-ac-city-tabs role="tablist" aria-label="Cities">
          {cities.map((c, i) => (
            <button
              type="button"
              role="tab"
              id={`${id}-tab-${c.key}`}
              aria-controls={`${id}-panel-${c.key}`}
              aria-selected={i === 0 ? "true" : "false"}
              tabindex={i === 0 ? 0 : -1}
              data-ac-city-tab={c.key}
            >
              <span class="mono-label-sm" aria-hidden="true">{c.code}</span>
              {c.name}
            </button>
          ))}
        </div>

        <div data-ac-city-panels>
          {cities.map((c, i) => (
            <div
              role="tabpanel"
              id={`${id}-panel-${c.key}`}
              aria-labelledby={`${id}-tab-${c.key}`}
              data-ac-city-panel={c.key}
              hidden={i !== 0}
            >
              <p data-ac-city-name>{c.name}</p>
              <p data-ac-city-line>{c.line}</p>
              <ul data-ac-city-suits aria-label={`${c.name} suits`}>
                {c.suits.map((s) => <li>{s}</li>)}
              </ul>
              <ul data-ac-city-sr>
                {measures.map((m) => (
                  <li>{m.label}: {m.format[i]}</li>
                ))}
              </ul>
            </div>
          ))}
        </div>
      </div>

      <div data-ac-city-strips aria-hidden="true">
        {measures.map((m, r) => (
          <div data-ac-city-strip style={`--ac-r:${r}`}>
            <p data-ac-city-measure>
              <span>{m.label}</span>
            </p>
            <div data-ac-city-scale>
              <i data-ac-city-track></i>
              {cities.map((c, i) => (
                <span data-ac-city-dot={c.key} data-on={i === 0 || undefined} style={`left:${pos(m, m.values[i]).toFixed(1)}%`}>
                  <b data-ac-city-val>{m.format[i]}</b>
                  <i></i>
                </span>
              ))}
            </div>
            <p data-ac-city-ends class="mono-label-sm">
              <span>{m.low}</span>
              <span>{m.high}</span>
            </p>
          </div>
        ))}
      </div>
    </div>
    <p data-ac-city-note class="mono-label-sm">{note}</p>
  </div>
</section>

<script>
  import { toggleInView } from "@/lib/in-view";

  document.querySelectorAll<HTMLElement>("[data-ac-city]").forEach((section) => {
    toggleInView(section);

    const tabs = Array.from(section.querySelectorAll<HTMLButtonElement>("[data-ac-city-tab]"));
    const panels = Array.from(section.querySelectorAll<HTMLElement>("[data-ac-city-panel]"));
    const dots = Array.from(section.querySelectorAll<HTMLElement>("[data-ac-city-dot]"));

    const select = (key: string, focus = false) => {
      section.dataset.city = key;
      tabs.forEach((tab) => {
        const on = tab.dataset.acCityTab === key;
        tab.setAttribute("aria-selected", on ? "true" : "false");
        tab.tabIndex = on ? 0 : -1;
        if (on && focus) tab.focus();
      });
      panels.forEach((panel) => {
        panel.hidden = panel.dataset.acCityPanel !== key;
      });
      dots.forEach((dot) => dot.toggleAttribute("data-on", dot.dataset.acCityDot === key));
    };

    tabs.forEach((tab, i) => {
      tab.addEventListener("click", () => select(tab.dataset.acCityTab!));
      tab.addEventListener("keydown", (e) => {
        const to =
          e.key === "ArrowRight" || e.key === "ArrowDown" ? (i + 1) % tabs.length
          : e.key === "ArrowLeft" || e.key === "ArrowUp" ? (i - 1 + tabs.length) % tabs.length
          : e.key === "Home" ? 0
          : e.key === "End" ? tabs.length - 1
          : -1;
        if (to < 0) return;
        e.preventDefault();
        select(tabs[to].dataset.acCityTab!, true);
      });
    });
  });
</script>
