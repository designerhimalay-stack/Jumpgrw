---
import GridRules from "@/components/GridRules.astro";
import RevealText from "@/components/RevealText.astro";
import { LINE_ICONS } from "@/lib/line-icons";
import type { Practice } from "@/types/page";

/* Built to scale, shown as a launch week, on the dark tone. Columns 1–2:
   the myth struck through, the claim, the practices and what the client
   keeps. Columns 3–4: a dashboard for the week after launch. The user count
   climbs to its target as the traffic curve draws in, latency holds flat
   under it, and three readouts settle. The numbers are illustrative and say
   so. See docs/sections.md. */

interface Props {
  id: string;
  eyebrow: string;
  headline: string[];
  accent?: number;
  myth: string;
  practices: Practice[];
  keepsTitle: string;
  keeps: string[];
  board: { title: string; target: number; unit: string; note: string };
  days: string[];
  /** Traffic per day, 0–1. */
  traffic: number[];
  readouts: { label: string; value: string }[];
}

const { id, eyebrow, headline, accent = headline.length - 1, myth, practices, keepsTitle, keeps, board, days, traffic, readouts } = Astro.props;
const offsets = headline.map((_, i) => headline.slice(0, i).reduce((n, line) => n + Array.from(line).length + 1, 0));

/* 600 × 220 chart box. A smooth curve through the day points. */
const W = 600;
const H = 220;
const pts = traffic.map((v, i) => [(i / (traffic.length - 1)) * W, H - 14 - v * (H - 34)]);
const smooth = pts.reduce((d, [x, y], i) => {
  if (i === 0) return `M${x} ${y}`;
  const [px, py] = pts[i - 1];
  const cx = (px + x) / 2;
  return `${d} C${cx} ${py} ${cx} ${y} ${x} ${y}`;
}, "");
const latency = `M0 ${H - 40} C150 ${H - 44} 300 ${H - 38} 450 ${H - 42} S600 ${H - 40} 600 ${H - 40}`;
---

<section data-ac-sec="dark" data-ac-load id={id}>
  <GridRules />

  <div data-ac-sec-container data-ac-load-grid>
    <div data-ac-load-copy>
      <p data-ac-sec-eyebrow class="mono-label">
        <span aria-hidden="true">+</span>
        {eyebrow}
      </p>
      <p data-ac-load-myth><span>{myth}</span></p>
      <h2 data-ac-load-headline aria-label={headline.join(" ")}>
        {headline.map((line, i) => (
          <Fragment>
            {i > 0 && <Fragment>{" "}<br aria-hidden="true" /></Fragment>}
            <span data-ac-sec-line data-accent={i === accent || undefined}>
              <RevealText text={line} offset={offsets[i]} />
            </span>
          </Fragment>
        ))}
      </h2>
      <ul data-ac-load-practices data-ac-sec-rise>
        {practices.map((practice) => (
          <li>
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" set:html={LINE_ICONS[practice.icon]} />
            {practice.label}
          </li>
        ))}
      </ul>
      <p data-ac-load-keeps-title class="mono-label">{keepsTitle}</p>
      <ul data-ac-load-keeps data-ac-sec-rise>
        {keeps.map((item) => (
          <li>
            <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M20 6 9 17l-5-5" /></svg>
            {item}
          </li>
        ))}
      </ul>
    </div>

    <figure data-ac-load-board>
      <figcaption data-ac-load-head>
        <span data-ac-load-live aria-hidden="true" />
        <span class="mono-label">{board.title}</span>
        <span data-ac-load-note class="mono-label-sm">{board.note}</span>
      </figcaption>

      <p data-ac-load-count>
        <span data-ac-load-value data-target={board.target}>{board.target.toLocaleString("en-US")}</span>
        <span data-ac-load-unit>{board.unit}</span>
      </p>

      <div data-ac-load-chart>
        <svg viewBox={`0 0 ${W} ${H}`} preserveAspectRatio="none" aria-hidden="true">
          {[0.25, 0.5, 0.75].map((f) => <line data-ac-load-grid x1="0" x2={W} y1={H * f} y2={H * f} />)}
          <path data-ac-load-area d={`${smooth} L${W} ${H} L0 ${H} Z`} />
          <path data-ac-load-line d={smooth} pathLength="1" />
          <path data-ac-load-latency d={latency} pathLength="1" />
        </svg>
        <span data-ac-load-legend class="mono-label-sm" aria-hidden="true">
          <span data-key="users">Users</span>
          <span data-key="latency">p95 latency</span>
        </span>
        <ol data-ac-load-days aria-hidden="true">
          {days.map((day) => <li class="mono-label-sm">{day}</li>)}
        </ol>
      </div>

      <dl data-ac-load-readouts>
        {readouts.map((r, i) => (
          <div style={`--ac-i:${i}`}>
            <dt class="mono-label-sm">{r.label}</dt>
            <dd>{r.value}</dd>
          </div>
        ))}
      </dl>
    </figure>
  </div>
</section>

<script>
  import { toggleInView } from "@/lib/in-view";

  document.querySelectorAll<HTMLElement>("[data-ac-load]").forEach((section) => {
    toggleInView(section);
    if (window.matchMedia("(prefers-reduced-motion: reduce)").matches) return;

    /* The user count climbs with the curve, and resets when the section
       leaves. Written as one text node with a fixed width, so it never
       moves anything. */
    const value = section.querySelector<HTMLElement>("[data-ac-load-value]")!;
    const target = Number(value.dataset.target);
    const ease = (t: number) => 1 - Math.pow(1 - t, 3);
    let frame = 0;
    const show = (t: number) => {
      value.textContent = Math.round(ease(t) * target).toLocaleString("en-US");
    };
    show(0);
    new IntersectionObserver(
      ([entry]) => {
        cancelAnimationFrame(frame);
        if (!entry.isIntersecting) return show(0);
        const start = performance.now() + 250;
        const step = (now: number) => {
          const t = Math.min(1, Math.max(0, (now - start) / 1900));
          show(t);
          if (t < 1) frame = requestAnimationFrame(step);
        };
        frame = requestAnimationFrame(step);
      },
      { threshold: 0, rootMargin: "-12% 0px -12% 0px" },
    ).observe(section);
  });
</script>
