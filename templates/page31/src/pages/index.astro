---
import Layout from "@/layouts/Layout.astro";
import CtaSection from "@/components/CtaSection.astro";
import DossierSection from "@/components/DossierSection.astro";
import EquationSection from "@/components/EquationSection.astro";
import FanSection from "@/components/FanSection.astro";
import FaqSection from "@/components/FaqSection.astro";
import Footer from "@/components/Footer.astro";
import Navbar from "@/components/Navbar.astro";
import PageHero from "@/components/PageHero.astro";
import RolesSection from "@/components/RolesSection.astro";
import SmoothScroll from "@/components/SmoothScroll.astro";
import SpinesSection from "@/components/SpinesSection.astro";
import StackSection from "@/components/StackSection.astro";
import type { PageHeroContent } from "@/types/page";
import heroPhoto from "@/assets/pages/p31-hero.jpg";
import teamPhoto from "@/assets/pages/p31-team.jpg";
import examplesPhoto from "@/assets/pages/p31-examples.jpg";
import faqPhoto from "@/assets/pages/p31-faq.jpg";
import { BRAND } from "@/lib/brand";

/* Nearshore AI/ML engineers, Mexico. The copy follows the owner's content
   outline for this page. The planning rate, the example results and the FAQ
   answers are the owner's figures or drafts: have them checked before
   launch. See docs/sections.md. */

const HERO: PageHeroContent = {
  trail: ["X-Shore", "Nearshore", "Mexico"],
  headline: ["AI engineers,", "in Mexico."],
  accent: 1,
  lede: "Senior AI, ML and data engineers who share your working day, join your sprints and ship inside your controls. Start with one; grow to a pod.",
  ctas: [
    { label: "Plan your AI hires", href: "#contact", arrow: "diagonal" },
    { label: "See the stack", href: "#stack", arrow: "right" },
  ],
  image: heroPhoto,
  imageAlt: "Two engineers in Playa del Carmen, Mexico, work through a problem on one laptop.",
  specs: [
    { label: "Time zone", value: "US workday overlap" },
    { label: "Team size", value: "One engineer to a pod" },
    { label: "Works in", value: "Your stack and controls" },
    { label: "Led from", value: "Dallas" },
  ],
};

const FAQS = [
  {
    q: "Is this staff augmentation or a managed team?",
    a: "Either. Add one engineer, a small squad, or a full pod with technical leadership.",
  },
  {
    q: "Can we interview engineers before we choose?",
    a: "Yes. You see pre-vetted profiles, interview the ones you like and decide.",
  },
  {
    q: "Can the team work inside our cloud and security controls?",
    a: "Yes. Engineers work in your repositories, cloud accounts and tools, under your access rules.",
  },
  {
    q: "Can we scale after the first engineer starts?",
    a: "Yes. Add engineers as the roadmap grows; most teams start with one or two.",
  },
];
---

<Layout
  title={`AI engineers in Mexico · ${BRAND.name}`}
  description="Senior nearshore AI, ML and data engineers in Mexico who share your working day and work inside your stack, from one engineer to a full pod."
  navTone="field"
>
  <SmoothScroll />
  <Navbar />
  <main>
    <PageHero content={HERO} />
    <StackSection
      id="stack"
      eyebrow="Tech we use"
      headline={["Engineers who", "fit your stack."]}
      accent={1}
      lede="They work with the models, frameworks and tools your teams already use."
      drawers={[
        {
          name: "Foundation models",
          tools: [
            { name: "OpenAI GPT", mark: "GPT" },
            { name: "Claude", slug: "claude" },
            { name: "Gemini", slug: "googlegemini" },
            { name: "Llama", slug: "meta" },
            { name: "Mistral", slug: "mistralai" },
            { name: "Hugging Face", slug: "huggingface" },
            { name: "Ollama", slug: "ollama" },
          ],
        },
        {
          name: "ML and data toolkit",
          tools: [
            { name: "TensorFlow", slug: "tensorflow" },
            { name: "PyTorch", slug: "pytorch" },
            { name: "scikit-learn", slug: "scikitlearn" },
            { name: "OpenCV", slug: "opencv" },
            { name: "pandas", slug: "pandas" },
            { name: "Airflow", slug: "apacheairflow" },
            { name: "Databricks", slug: "databricks" },
            { name: "Snowflake", slug: "snowflake" },
          ],
        },
        {
          name: "Agents and retrieval",
          tools: [
            { name: "LangChain", slug: "langchain" },
            { name: "LlamaIndex", mark: "LI" },
            { name: "Pinecone", mark: "PC" },
            { name: "pgvector", slug: "postgresql" },
            { name: "Redis", slug: "redis" },
          ],
        },
        {
          name: "MLOps and cloud",
          tools: [
            { name: "Docker", slug: "docker" },
            { name: "Kubernetes", slug: "kubernetes" },
            { name: "MLflow", slug: "mlflow" },
            { name: "Google Cloud", slug: "googlecloud" },
            { name: "AWS", mark: "AWS" },
            { name: "Azure", mark: "AZ" },
            { name: "GitHub Actions", slug: "githubactions" },
          ],
        },
        {
          name: "App and dev tools",
          tools: [
            { name: "Python", slug: "python" },
            { name: "FastAPI", slug: "fastapi" },
            { name: "React", slug: "react" },
            { name: "Next.js", slug: "nextdotjs" },
            { name: "Jupyter", slug: "jupyter" },
            { name: "Cursor", slug: "cursor" },
            { name: "Claude Code", slug: "claudecode" },
            { name: "GitHub Copilot", slug: "githubcopilot" },
          ],
        },
      ]}
      note="Named, not drawn. We pick tools for your product, data, security and deployment plan."
    />
    <FanSection
      id="ways"
      eyebrow="Ways to work together"
      headline={["Start with one.", "Build when ready."]}
      lede="Pick the shape that fits your team and your delivery plan. Change it as you go."
      media={{ image: teamPhoto, alt: "Two people in Cancún, Mexico, talk through a project at a laptop.", focus: "40% 50%" }}
      picker="Pick a way to work"
      models={[
        {
          kind: "Staff augmentation",
          title: "Add one AI/ML engineer",
          body: "One dedicated engineer in your team, codebase and sprints.",
          count: "1",
          unit: "engineer",
          chips: ["Python", "LLM apps", "Model evaluation"],
        },
        {
          kind: "Augmented squad",
          title: "Add a small AI team",
          body: "AI, data or full-stack engineers for a clear team gap.",
          count: "2–4",
          unit: "engineers",
          chips: ["Data pipelines", "MLOps", "Cloud"],
        },
        {
          kind: "Managed delivery pod",
          title: "Build an AI pod",
          body: "A connected team with its own technical lead.",
          count: "5–8",
          unit: "engineers",
          chips: ["GenAI products", "Architecture", "Delivery"],
        },
      ]}
      control="You stay in control: the engineers work in your codebase, tools and delivery process."
    />
    <EquationSection
      id="capacity"
      eyebrow="Team planning view"
      headline={["Size the capacity", "you need."]}
      accent={1}
      lede="Choose a team size to see the monthly investment for engineers in Mexico."
      rate={125}
      hours={160}
      max={12}
      start={3}
      note="Planning estimate at $125 an hour and 160 hours per engineer each month. Directional, not a quote."
      cta="Build my team plan"
    />
    <RolesSection
      id="roles"
      eyebrow="Find the right skill"
      headline={["Find the AI engineer", "you need."]}
      accent={1}
      lede="Pick a skill to see the kinds of engineers we match to your team."
      filters={[
        { key: "genai", label: "NLP & GenAI" },
        { key: "vision", label: "Computer vision" },
        { key: "data", label: "Data & ML" },
        { key: "ops", label: "MLOps & LLMOps" },
      ]}
      roles={[
        {
          title: "NLP & generative AI developer",
          body: "RAG, prompts, AI quality checks and app integration.",
          tools: ["Python", "LLM apps", "RAG", "Evaluation"],
          tags: ["genai"],
          logos: ["claude", "huggingface", "langchain", "python"],
        },
        {
          title: "Computer vision ML engineer",
          body: "Image and video models, training and inference.",
          tools: ["PyTorch", "OpenCV", "Training", "Inference"],
          tags: ["vision"],
          logos: ["pytorch", "opencv", "jupyter", "python"],
        },
        {
          title: "Predictive ML engineer",
          body: "Forecasting, classification and feature engineering.",
          tools: ["TensorFlow", "Forecasting", "Feature stores", "SQL"],
          tags: ["data"],
          logos: ["tensorflow", "scikitlearn", "pandas", "snowflake"],
        },
        {
          title: "MLOps & LLMOps engineer",
          body: "Deployment, monitoring, model checks and cloud reliability.",
          tools: ["Kubeflow", "MLflow", "CI/CD", "Cloud"],
          tags: ["ops"],
          logos: ["mlflow", "kubernetes", "docker", "githubactions"],
        },
        {
          title: "AI full-stack developer",
          body: "AI app screens, back ends, agent flows and human review.",
          tools: ["React", "FastAPI", "Agents", "APIs"],
          tags: ["genai", "ops"],
          logos: ["react", "nextdotjs", "fastapi", "nodedotjs"],
        },
        {
          title: "AI data engineer",
          body: "Pipelines, data quality, vector data and analytics.",
          tools: ["Pipelines", "dbt", "Vector data", "Analytics"],
          tags: ["data"],
          logos: ["apacheairflow", "databricks", "postgresql", "redis"],
        },
      ]}
      cta="Discuss this hire"
      footnote={`Example roles. ${BRAND.name} confirms availability and fit before you decide.`}
    />
    <SpinesSection
      id="how"
      eyebrow="How it works"
      headline={["Five steps to add", "AI engineers."]}
      accent={1}
      lede="From the first call to a working engineer in your sprint."
      steps={[
        {
          title: "Discovery call",
          body: "Tell us your roadmap, your team gap and the work that needs support.",
          points: ["Your goals", "Team gap", "Tech context"],
        },
        {
          title: "Pick the model",
          body: "One engineer, a squad or a managed pod: we shape it with you.",
          points: ["Engagement model", "Team size", "Start date"],
        },
        {
          title: "Pre-vetted options",
          body: "You receive profiles matched to your stack and your hours.",
          points: ["Skills", "Experience", "Overlap"],
        },
        {
          title: "Interview & select",
          body: "Meet the engineers, test the fit and choose who joins.",
          points: ["Technical interview", "Culture fit", "Your call"],
        },
        {
          title: "Onboard & kick off",
          body: "Access, rituals and a first task, so the work starts in week one.",
          points: ["Access", "Rituals", "First sprint"],
        },
      ]}
      fitLabel="A good fit when you"
      fit={[
        "Need more engineers to meet delivery goals.",
        "Need AI or ML skills your team lacks today.",
        "Need your security and release process followed.",
        "Want engineers who overlap your US workday.",
      ]}
    />
    <DossierSection
      id="examples"
      eyebrow="How teams use us"
      headline={["AI teams,", "in action."]}
      accent={1}
      lede="Three examples: the roles we added and what the teams achieved."
      media={{ image: examplesPhoto, alt: "A developer in Playa del Carmen, Mexico, works at a laptop." }}
      stamp="Example"
      files={[
        {
          sector: "US industrial engineering company",
          team: "Production quality vision team",
          body: "Models that check production imagery and designs for quality issues.",
          roles: ["Computer vision ML", "Data engineer", "QA automation"],
          results: [
            { value: "Automated", label: "imagery quality checks" },
            { value: "Consistent", label: "design review workflows" },
          ],
        },
        {
          sector: "US fintech lending platform",
          team: "Lending risk-model team",
          body: "ML and data specialists improving scoring and eligibility checks.",
          roles: ["ML engineer", "Data scientist", "MLOps engineer"],
          results: [
            { value: "87%", label: "better approval accuracy" },
            { value: "61%", label: "better fraud detection" },
          ],
        },
        {
          sector: "US industrial equipment supplier",
          team: "Predictive maintenance team",
          body: "Sensor data turned into useful maintenance alerts.",
          roles: ["ML engineer", "Data engineer", "AI integration"],
          results: [
            { value: "6×", label: "less machine downtime" },
            { value: "43%", label: "maintenance cost savings" },
          ],
        },
      ]}
      footnote="Client details are kept private. Results are examples, not guarantees."
    />
    <FaqSection
      eyebrow="Common questions"
      headline={["Before you add", "AI engineers."]}
      accent={1}
      cta="Talk to our team"
      faqs={FAQS}
      media={{ image: faqPhoto, alt: "A developer in Tijuana, Mexico, works at a laptop.", focus: "30% 40%" }}
    />
    <CtaSection
      eyebrow="Tell us what you need"
      headline={["Your next engineer,", "one time zone away."]}
      body="Tell us the role or skill gap, and we’ll help you choose the right engineer or team in Mexico."
      cta="Plan my AI team"
    />
  </main>
  <Footer />
</Layout>
