---
import Arrow from "@/components/icons/Arrow.astro";
import GridRules from "@/components/GridRules.astro";
import SectionHead from "@/components/SectionHead.astro";
import TechLogo from "@/components/TechLogo.astro";
import type { TechLogoSlug } from "@/lib/tech-logos";

/* The roles, as a wall of engineer cards, on the dark tone. A row of skill
   filters under the header; each card is a bench of the role's main tools
   (four real logos on white tiles) beside the role, what it is for and its
   skills. Choosing a filter keeps
   the matching cards lit and lets the rest fall back to grey: no card is
   ever removed, so the wall never changes height. Without the script every
   card stays lit. See docs/sections.md. */

interface Role {
  title: string;
  body: string;
  tools: string[];
  /** Filter keys this role belongs to. */
  tags: string[];
  /** The role's four main tools, drawn as logos. */
  logos: TechLogoSlug[];
}

interface Props {
  id: string;
  eyebrow: string;
  headline: string[];
  accent?: number;
  lede: string;
  filters: { key: string; label: string }[];
  roles: Role[];
  cta: string;
  footnote: string;
}

const { id, eyebrow, headline, accent, lede, filters, roles, cta, footnote } = Astro.props;
---

<section data-ac-sec="dark" data-ac-roles id={id}>
  <GridRules />

  <div data-ac-sec-container>
    <SectionHead eyebrow={eyebrow} headline={headline} accent={accent} lede={lede} />

    <div data-ac-roles-filters role="group" aria-label="Filter roles by skill" data-ac-sec-rise>
      <button type="button" data-ac-roles-filter="all" aria-pressed="true">All AI/ML</button>
      {filters.map((f) => (
        <button type="button" data-ac-roles-filter={f.key} aria-pressed="false">{f.label}</button>
      ))}
      <span data-ac-roles-count class="mono-label-sm" aria-live="polite">{roles.length} of {roles.length} roles</span>
    </div>

    <ul data-ac-roles-wall>
      {roles.map((role, i) => (
        <li data-ac-roles-card data-tags={role.tags.join(" ")} style={`--ac-i:${i}`}>
          <ul data-ac-roles-bench aria-label={`${role.title}: main tools`}>
            {role.logos.map((slug) => (
              <li data-ac-roles-tile>
                <TechLogo slug={slug} size={30} label />
              </li>
            ))}
          </ul>
          <div data-ac-roles-copy>
            <p data-ac-roles-kind class="mono-label-sm">Senior specialty role</p>
            <h3 data-ac-roles-title>{role.title}</h3>
            <p data-ac-roles-body>{role.body}</p>
            <ul data-ac-roles-tools>
              {role.tools.map((tool) => <li>{tool}</li>)}
            </ul>
            <a href="#contact" data-ac-roles-link>
              {cta}
              <Arrow direction="right" />
            </a>
          </div>
        </li>
      ))}
    </ul>

    <p data-ac-roles-foot class="mono-label-sm">{footnote}</p>
  </div>
</section>

<script>
  import { toggleInView } from "@/lib/in-view";

  document.querySelectorAll<HTMLElement>("[data-ac-roles]").forEach((section) => {
    toggleInView(section);

    const buttons = Array.from(section.querySelectorAll<HTMLButtonElement>("[data-ac-roles-filter]"));
    const cards = Array.from(section.querySelectorAll<HTMLElement>("[data-ac-roles-card]"));
    const count = section.querySelector<HTMLElement>("[data-ac-roles-count]")!;

    const pick = (key: string) => {
      buttons.forEach((b) => b.setAttribute("aria-pressed", String(b.dataset.acRolesFilter === key)));
      let lit = 0;
      cards.forEach((card) => {
        const on = key === "all" || (card.dataset.tags ?? "").split(" ").includes(key);
        card.toggleAttribute("data-off", !on);
        if (on) lit += 1;
      });
      count.textContent = `${lit} of ${cards.length} roles`;
    };

    buttons.forEach((b) => b.addEventListener("click", () => pick(b.dataset.acRolesFilter ?? "all")));
  });
</script>
