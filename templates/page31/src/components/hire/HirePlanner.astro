---
import Arrow from "@/components/icons/Arrow.astro";
import GridRules from "@/components/GridRules.astro";
import SectionHead from "@/components/SectionHead.astro";
import Joints from "@/components/process/Joints.astro";
import type { HireHead, HireLink } from "@/components/hire/types";

/* Team planning view, or a savings calculator. A team-size slider (a native
   range input: labelled, arrow keys and Home/End work) in columns 1–2, and
   the cost panel on the ink in columns 3–4. The script rewrites only the
   numbers, each in a box with a reserved width and tabular figures, so the
   layout never moves. Without the script the page shows the starting size
   and its true totals.

   Two modes, chosen by props:
   - Planning (no `compare`): one engineer's month, the selected team's
     month, and the capacity at that size on the accent.
   - Savings (`compare` set): the team's month at the `compare` rate (e.g.
     US onshore) beside its month at `rate` (e.g. offshore), then the monthly
     saving and how much lower it is, on the accent.

   Cost = rate × hours × team size; at $125 × 160 one engineer is $20,000. */

interface Props extends HireHead {
  /** Hourly rate in US dollars. In savings mode, the lower (offshore) rate. */
  rate: number;
  /** Hours per engineer per month. */
  hours: number;
  min?: number;
  max: number;
  start: number;
  /** Over the panel, e.g. "Monthly team cost". */
  panelLabel: string;
  /** Beside the panel label; "{n}" is the size, "{people}" engineer/engineers. */
  tagLabel?: string;
  /** Planning mode: caption of the one-engineer figure, e.g. "One engineer in Mexico at $125/hr". */
  oneLabel?: string;
  /** Caption of the team figure at `rate`; "{n}" is replaced by the size.
      In savings mode, e.g. "Offshore at $32/hr". */
  teamLabel: string;
  /** Planning mode: the capacity line; "{n}" is the size, "{people}" engineer/engineers. */
  capacity?: string;
  /** Savings mode: the rate to compare with, and its caption, e.g.
      { rate: 90, label: "US onshore at $90/hr" }. */
  compare?: { rate: number; label: string };
  /** Savings mode: over the saving, e.g. "Estimated monthly savings". */
  saveLabel?: string;
  /** Savings mode: beside the saving; "{pct}" is how much lower, in percent. */
  saveNote?: string;
  /** Slider label, e.g. "Your team size". */
  sizeLabel: string;
  /** Singular and plural for the unit, e.g. ["engineer", "engineers"]. */
  unit: [string, string];
  cta: HireLink;
  /** Under the button, e.g. "Planning figures are directional, not a quote." */
  disclaimer: string;
  /** Under the slider: how the estimate is made. */
  note: string;
  /** "tint" is a light section on a pale blue ground. */
  tone?: "light" | "tint" | "dark";
}

const {
  id,
  eyebrow,
  headline,
  accent,
  lede,
  rate,
  hours,
  min = 1,
  max,
  start,
  panelLabel,
  tagLabel = "{n} {people}",
  oneLabel = "",
  teamLabel,
  capacity = "",
  compare,
  saveLabel = "Estimated monthly savings",
  saveNote = "About {pct}% lower.",
  sizeLabel,
  unit,
  cta,
  disclaimer,
  note,
  tone = "light",
} = Astro.props;

const money = (n: number) => `$${n.toLocaleString("en-US")}`;
const people = (n: number) => (n === 1 ? unit[0] : unit[1]);
const fill = (text: string, n: number) => text.replace("{n}", String(n)).replace("{people}", people(n));
const mid = Math.round((min + max) / 2);
const pct = compare ? Math.round((1 - rate / compare.rate) * 100) : 0;
---

<section
  data-ac-sec={tone === "tint" ? "light" : tone}
  data-ac-hire-tint={tone === "tint" || undefined}
  data-ac-hire="plan"
  data-ac-hire-savings={compare ? "" : undefined}
  id={id}
  data-rate={rate}
  data-hours={hours}
  data-compare={compare?.rate}
  data-unit-one={unit[0]}
  data-unit-many={unit[1]}
  data-tag-label={tagLabel}
  data-team-label={teamLabel}
  data-capacity={capacity}
>
  <GridRules />
  <div data-ac-sec-container>
    <SectionHead eyebrow={eyebrow} headline={headline} accent={accent ?? headline.length - 1} lede={lede} />

    <div data-ac-hire-plan data-ac-sec-rise>
      <div data-ac-sec-frame data-ac-hire-plan-control>
        <Joints />
        <div data-ac-hire-plan-size>
          <label for={`${id}-size`} class="mono-label">{sizeLabel}</label>
          <output for={`${id}-size`} data-ac-hire-plan-out>
            <span data-ac-hire-plan-n>{start}</span> <span data-ac-hire-plan-unit>{people(start)}</span>
          </output>
        </div>
        <input
          id={`${id}-size`}
          type="range"
          min={min}
          max={max}
          step="1"
          value={start}
          data-ac-hire-plan-input
          style={`--fill:${((start - min) / (max - min)) * 100}%`}
        />
        <div data-ac-hire-plan-ticks class="mono-label" aria-hidden="true">
          <span>{min} {people(min)}</span>
          <span>{mid} {people(mid)}</span>
          <span>{max} {people(max)}</span>
        </div>
        <p data-ac-hire-plan-note>{note}</p>
      </div>

      <div data-ac-hire-plan-panel>
        <p data-ac-hire-plan-head class="mono-label">
          <span>{panelLabel}</span>
          <span data-ac-hire-plan-team-tag>{fill(tagLabel, start)}</span>
        </p>
        <dl data-ac-hire-plan-sums>
          {
            compare ? (
              <div>
                <dt>{compare.label}</dt>
                <dd>
                  <span data-ac-hire-plan-money data-ac-hire-plan-compare>{money(compare.rate * hours * start)}</span>
                  <small>per month</small>
                </dd>
              </div>
            ) : (
              <div>
                <dt>{oneLabel}</dt>
                <dd><span data-ac-hire-plan-money>{money(rate * hours)}</span><small>per month</small></dd>
              </div>
            )
          }
          <div>
            <dt data-ac-hire-plan-team-label>{fill(teamLabel, start)}</dt>
            <dd><span data-ac-hire-plan-money data-ac-hire-plan-total>{money(rate * hours * start)}</span><small>per month</small></dd>
          </div>
        </dl>
        {
          compare ? (
            <p data-ac-hire-plan-save>
              <span data-ac-hire-plan-save-label class="mono-label">{saveLabel}</span>
              <span data-ac-hire-plan-saving>{money((compare.rate - rate) * hours * start)}</span>
              <span data-ac-hire-plan-save-note>{saveNote.replace("{pct}", String(pct))}</span>
            </p>
          ) : (
            <p data-ac-hire-plan-capacity>
              <span data-ac-hire-plan-big data-ac-hire-plan-n>{start}</span>
              <span data-ac-hire-plan-cap-text>{fill(capacity, start)}</span>
            </p>
          )
        }
        <a data-ac-hire-button data-variant="block" class="mono-label" href={cta.href}>
          {cta.label}
          <Arrow direction="right" />
        </a>
        <p data-ac-hire-plan-disclaimer>{disclaimer}</p>
      </div>
    </div>
  </div>
</section>

<script>
  import { toggleInView } from "@/lib/in-view";

  document.querySelectorAll<HTMLElement>('[data-ac-hire="plan"]').forEach((section) => {
    toggleInView(section);

    const {
      rate,
      hours,
      compare,
      unitOne = "",
      unitMany = "",
      tagLabel = "",
      teamLabel = "",
      capacity = "",
    } = section.dataset;
    const input = section.querySelector<HTMLInputElement>("[data-ac-hire-plan-input]")!;
    const min = Number(input.min);
    const max = Number(input.max);
    const people = (n: number) => (n === 1 ? unitOne : unitMany);
    const fill = (text: string, n: number) => text.replace("{n}", String(n)).replace("{people}", people(n));
    const money = (n: number) => `$${n.toLocaleString("en-US")}`;
    const set = (selector: string, text: string) =>
      section.querySelectorAll<HTMLElement>(selector).forEach((el) => (el.textContent = text));

    const update = () => {
      const n = Number(input.value);
      const month = Number(hours) * n;
      input.style.setProperty("--fill", `${((n - min) / (max - min)) * 100}%`);
      set("[data-ac-hire-plan-n]", String(n));
      set("[data-ac-hire-plan-unit]", people(n));
      set("[data-ac-hire-plan-team-tag]", fill(tagLabel, n));
      set("[data-ac-hire-plan-team-label]", fill(teamLabel, n));
      set("[data-ac-hire-plan-cap-text]", fill(capacity, n));
      set("[data-ac-hire-plan-total]", money(Number(rate) * month));
      if (compare) {
        set("[data-ac-hire-plan-compare]", money(Number(compare) * month));
        set("[data-ac-hire-plan-saving]", money((Number(compare) - Number(rate)) * month));
      }
    };

    input.addEventListener("input", update);
    update();
  });
</script>
