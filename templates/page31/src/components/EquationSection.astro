---
import Arrow from "@/components/icons/Arrow.astro";
import GridRules from "@/components/GridRules.astro";
import SectionHead from "@/components/SectionHead.astro";
import Joints from "@/components/process/Joints.astro";

/* Capacity, as an equation. The planning figure is written out as the sum
   it is: rate × hours × engineers = the month. Under it, a rail of team
   sizes (native radios, so arrow keys work and the page reads sensibly
   without the script): choosing a size fills the rail up to it and rewrites
   the engineers and the total. Every figure keeps a fixed width, so nothing
   moves as they change. Directional, not a quote, and it says so. See
   docs/sections.md. */

interface Props {
  id: string;
  eyebrow: string;
  headline: string[];
  accent?: number;
  lede: string;
  rate: number;
  hours: number;
  max: number;
  start: number;
  note: string;
  cta: string;
}

const { id, eyebrow, headline, accent, lede, rate, hours, max, start, note, cta } = Astro.props;
const usd = (n: number) => `$${n.toLocaleString("en-US")}`;
const sizes = Array.from({ length: max }, (_, i) => i + 1);
---

<section
  data-ac-sec="light"
  data-ac-eq
  id={id}
  data-rate={rate}
  data-hours={hours}
>
  <GridRules />

  <div data-ac-sec-container>
    <SectionHead eyebrow={eyebrow} headline={headline} accent={accent} lede={lede} />

    <div data-ac-sec-frame data-ac-eq-frame>
      <Joints />

      <p data-ac-eq-sum>
        <span data-ac-eq-term>
          <span class="mono-label-sm">Rate</span>
          <b>{usd(rate)}</b>
          <span data-ac-eq-unit>per hour</span>
        </span>
        <span data-ac-eq-op aria-hidden="true">×</span>
        <span data-ac-eq-term>
          <span class="mono-label-sm">Hours</span>
          <b>{hours}</b>
          <span data-ac-eq-unit>per engineer, monthly</span>
        </span>
        <span data-ac-eq-op aria-hidden="true">×</span>
        <span data-ac-eq-term data-live>
          <span class="mono-label-sm">Team</span>
          <b data-ac-eq-count>{start}</b>
          <span data-ac-eq-unit data-ac-eq-people>{start === 1 ? "engineer" : "engineers"}</span>
        </span>
        <span data-ac-eq-op data-equals aria-hidden="true">=</span>
        <span data-ac-eq-term data-total>
          <span class="mono-label-sm">Per month</span>
          <b data-ac-eq-total aria-live="polite">{usd(rate * hours * start)}</b>
          <span data-ac-eq-unit><span data-ac-eq-hours>{(hours * start).toLocaleString("en-US")}</span> engineer-hours</span>
        </span>
      </p>

      <fieldset data-ac-eq-rail>
        <legend class="mono-label-sm">Choose a team size</legend>
        <div data-ac-eq-stops>
          {sizes.map((n) => (
            <Fragment>
              <input
                type="radio"
                name={`${id}-size`}
                id={`${id}-size-${n}`}
                value={n}
                checked={n === start}
                class="sr-only"
                data-ac-eq-input
              />
              <label for={`${id}-size-${n}`} data-ac-eq-stop>
                <span aria-hidden="true">{n}</span>
                <span class="sr-only">{n === 1 ? "1 engineer" : `${n} engineers`}</span>
              </label>
            </Fragment>
          ))}
        </div>
        <p data-ac-eq-scale class="mono-label-sm" aria-hidden="true">
          <span>One engineer</span>
          <span>A full pod</span>
          <span>{max} engineers</span>
        </p>
      </fieldset>

      <footer data-ac-eq-foot>
        <p data-ac-eq-note>{note}</p>
        <a href="#contact" data-ac-eq-cta>
          {cta}
          <Arrow direction="right" />
        </a>
      </footer>
    </div>
  </div>
</section>

<script>
  import { toggleInView } from "@/lib/in-view";

  document.querySelectorAll<HTMLElement>("[data-ac-eq]").forEach((section) => {
    toggleInView(section);

    const rate = Number(section.dataset.rate);
    const hours = Number(section.dataset.hours);
    const count = section.querySelector<HTMLElement>("[data-ac-eq-count]")!;
    const people = section.querySelector<HTMLElement>("[data-ac-eq-people]")!;
    const total = section.querySelector<HTMLElement>("[data-ac-eq-total]")!;
    const teamHours = section.querySelector<HTMLElement>("[data-ac-eq-hours]")!;

    section.querySelectorAll<HTMLInputElement>("[data-ac-eq-input]").forEach((input) => {
      input.addEventListener("change", () => {
        const n = Number(input.value);
        count.textContent = String(n);
        people.textContent = n === 1 ? "engineer" : "engineers";
        total.textContent = `$${(rate * hours * n).toLocaleString("en-US")}`;
        teamHours.textContent = (hours * n).toLocaleString("en-US");
      });
    });
  });
</script>
