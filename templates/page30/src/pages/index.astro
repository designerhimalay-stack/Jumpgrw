---
import Layout from "@/layouts/Layout.astro";
import CtaSection from "@/components/CtaSection.astro";
import FaqSection from "@/components/FaqSection.astro";
import Footer from "@/components/Footer.astro";
import LocksSection from "@/components/LocksSection.astro";
import Navbar from "@/components/Navbar.astro";
import NestSection from "@/components/NestSection.astro";
import PageHero from "@/components/PageHero.astro";
import PortraitsSection from "@/components/PortraitsSection.astro";
import SmoothScroll from "@/components/SmoothScroll.astro";
import WhenSection from "@/components/WhenSection.astro";
import ZonesSection from "@/components/ZonesSection.astro";
import type { PageHeroContent } from "@/types/page";
import heroPhoto from "@/assets/pages/p30-hero.jpg";
import zonesPhoto from "@/assets/pages/p30-zones.jpg";
import rolePhoto1 from "@/assets/pages/p30-role-1.jpg";
import rolePhoto2 from "@/assets/pages/p30-role-2.jpg";
import rolePhoto3 from "@/assets/pages/p30-role-3.jpg";
import rolePhoto4 from "@/assets/pages/p30-role-4.jpg";
import locksPhoto from "@/assets/pages/p30-locks.jpg";
import faqPhoto from "@/assets/pages/p30-faq.jpg";
import { BRAND } from "@/lib/brand";
import { pageHref } from "@/lib/paths";

/* Onshore engineers, United States. The same kinds of content as the
   Mexico page, turned to what onshore is for: your time zones, on site
   when needed, compliance-sensitive work, leadership in Dallas. The hubs,
   the controls and the FAQ answers are drafts: have them checked before
   launch. See docs/sections.md. */

const HERO: PageHeroContent = {
  trail: ["X-Shore", "Onshore", "United States"],
  headline: ["Onshore,", "US teams."],
  accent: 1,
  lede: "Senior engineers in your time zones, on site when it matters, and cleared for regulated work. Led from Dallas.",
  ctas: [
    { label: "Plan an onshore team", href: "#contact", arrow: "diagonal" },
    { label: "See the time zones", href: "#zones", arrow: "right" },
  ],
  image: heroPhoto,
  imageAlt: "A software engineer in New York works at a laptop beside a bright window.",
  specs: [
    { label: "Time zones", value: "ET, CT, MT, PT" },
    { label: "On site", value: "When you need it" },
    { label: "Built for", value: "Regulated work" },
    { label: "Led from", value: "Dallas, Texas" },
  ],
};

const FAQS = [
  {
    q: "When should we choose onshore over nearshore?",
    a: "When the work touches regulated data, needs people on site, or must share your exact hours.",
  },
  {
    q: "Can engineers come to our office?",
    a: "Yes. For kickoffs, workshops or regular on-site days, agreed up front.",
  },
  {
    q: "Do you work under HIPAA, SOC 2 or PCI controls?",
    a: "Yes. The team works in your accounts, under your policies, with access you grant and can revoke.",
  },
  {
    q: "Can we mix onshore and nearshore engineers?",
    a: "Yes. Many teams keep leads and regulated work onshore and grow capacity nearshore.",
  },
];
---

<Layout
  title={`Onshore engineers, United States · ${BRAND.name}`}
  description="Senior US-based engineers in your time zones, on site when needed and ready for compliance-sensitive work, led from Dallas."
  navTone="field"
>
  <SmoothScroll />
  <Navbar />
  <main>
    <PageHero content={HERO} />
    <ZonesSection
      id="zones"
      eyebrow="Same time zones"
      headline={["Your hours.", "Our hours."]}
      accent={1}
      lede="Engineers across all four US time zones, so stand-ups, reviews and incidents happen in the same working day."
      media={{ image: zonesPhoto, alt: "Engineers in Austin, Texas, work on laptops in a brick-walled office.", focus: "50% 55%" }}
      hqLabel="HQ"
      zones={[
        {
          code: "PT",
          name: "Pacific",
          tz: "America/Los_Angeles",
          hubs: [
            { city: "Seattle", x: 0.18, y: 0.12 },
            { city: "San Francisco", x: 0.1, y: 0.5 },
            { city: "Los Angeles", x: 0.3, y: 0.82 },
          ],
        },
        {
          code: "MT",
          name: "Mountain",
          tz: "America/Denver",
          hubs: [
            { city: "Denver", x: 0.4, y: 0.38 },
            { city: "Phoenix", x: 0.12, y: 0.78 },
          ],
        },
        {
          code: "CT",
          name: "Central",
          tz: "America/Chicago",
          hubs: [
            { city: "Chicago", x: 0.52, y: 0.2 },
            { city: "Dallas", x: 0.2, y: 0.64, hq: true },
            { city: "Austin", x: 0.12, y: 0.9 },
          ],
        },
        {
          code: "ET",
          name: "Eastern",
          tz: "America/New_York",
          hubs: [
            { city: "New York", x: 0.44, y: 0.18 },
            { city: "Atlanta", x: 0.14, y: 0.66 },
          ],
        },
      ]}
      foot="Hub positions are approximate. Clocks show the local time now."
    />
    <WhenSection
      id="when"
      eyebrow="When onshore is the right call"
      headline={["Onshore, or", "further out?"]}
      accent={1}
      lede="Three questions. One yes is usually enough to keep the work in the US."
      questions={[
        {
          q: "Does the work touch regulated data?",
          note: "Health, payments, financial or government records.",
          yes: true,
        },
        {
          q: "Do you need people on site?",
          note: "Workshops, hardware, secure rooms or client meetings.",
          yes: false,
        },
        {
          q: "Must the team share your exact hours?",
          note: "Live support, trading hours or on-call rotas.",
          yes: false,
        },
      ]}
      onshore={{
        label: "Our read",
        title: "Onshore is the right call.",
        body: "Keep this work with US-based engineers, under your controls and in your hours.",
        cta: "Plan an onshore team",
        href: "#contact",
      }}
      elsewhere={{
        label: "Our read",
        title: "Nearshore may fit better.",
        body: "Same-day overlap at a lower cost, with engineers in Mexico or Canada.",
        cta: "See nearshore in Mexico",
        href: pageHref("page31"),
      }}
    />
    <PortraitsSection
      id="roles"
      eyebrow="Onshore roles"
      headline={["Senior people,", "in your hours."]}
      accent={1}
      lede="The roles teams most often keep onshore. Point at one to see its tools."
      roles={[
        {
          title: "Engineering lead",
          line: "Owns architecture and sits with your leaders.",
          tools: ["Architecture", "Reviews", "Roadmaps"],
          media: { image: rolePhoto1, alt: "An engineer in New York works on a laptop in a quiet lounge.", focus: "28% 40%" },
        },
        {
          title: "Full-stack engineer",
          line: "Ships features end to end in your codebase.",
          tools: ["React", "Node.js", "Python", "APIs"],
          media: { image: rolePhoto2, alt: "A developer in New York works through a screen on a laptop.", focus: "45% 40%" },
        },
        {
          title: "Cloud & security engineer",
          line: "Runs infrastructure inside your controls.",
          tools: ["Terraform", "IAM", "Audit logs"],
          media: { image: rolePhoto3, alt: "An engineer in New York takes notes beside a laptop.", focus: "34% 45%" },
        },
        {
          title: "Data & AI engineer",
          line: "Builds pipelines and models on sensitive data.",
          tools: ["Pipelines", "ML models", "Governance"],
          media: { image: rolePhoto4, alt: "A data engineer in New York talks a colleague through results on a laptop.", focus: "24% 50%" },
        },
      ]}
      footnote={`Example roles. ${BRAND.name} confirms availability and fit before you decide.`}
    />
    <NestSection
      id="models"
      eyebrow="Ways to work together"
      headline={["One engineer,", "or a whole pod."]}
      accent={1}
      lede="Each model sits inside the next, so you can start small and grow without starting over."
      models={[
        {
          kind: "Staff augmentation",
          title: "One senior engineer",
          body: "Joins your team, your sprints and your tools.",
          size: "1 engineer",
          onsite: "On site for kickoff",
        },
        {
          kind: "Augmented squad",
          title: "A small team",
          body: "Fills a clear gap: a feature, a platform, a migration.",
          size: "2–4 engineers",
          onsite: "On site for key workshops",
        },
        {
          kind: "Managed pod",
          title: "A pod with its own lead",
          body: "Owns outcomes, reports to you, run from Dallas.",
          size: "5–8 engineers",
          onsite: "Regular on-site days",
        },
      ]}
    />
    <LocksSection
      id="controls"
      eyebrow="Compliance-sensitive work"
      headline={["Your controls.", "Locked in."]}
      accent={1}
      lede="US-based engineers work inside your accounts and policies, with access you grant and can revoke."
      media={{ image: locksPhoto, alt: "Engineers in New York work through a release at a shared table.", focus: "50% 45%" }}
      frameworks={["HIPAA", "SOC 2", "PCI DSS"]}
      frameworksNote="Frameworks our teams work under"
      controls={[
        { title: "Single sign-on and MFA", note: "Every account through your identity provider.", tools: ["okta", "auth0"] },
        { title: "Code stays in your repos", note: "Reviewed, signed and never copied out.", tools: ["github", "gitlab"] },
        { title: "Secrets in your vault", note: "No keys in code, chat or laptops.", tools: ["vault", "1password"] },
        { title: "Every change on record", note: "Tickets, pipelines and an audit trail.", tools: ["jira", "githubactions"] },
        { title: "Watched in production", note: "Errors and access, monitored.", tools: ["sentry", "datadog"] },
      ]}
    />
    <FaqSection
      eyebrow="Common questions"
      headline={["Onshore,", "answered."]}
      accent={1}
      cta="Talk to our Dallas team"
      faqs={FAQS}
      media={{ image: faqPhoto, alt: "An engineer in Austin, Texas, walks the team through a plan.", focus: "45% 40%" }}
    />
    <CtaSection
      eyebrow="Built in the US"
      headline={["Close to home.", "Close to the work."]}
      body="Tell us what must stay onshore, and we’ll shape a US team around it."
      cta="Plan my onshore team"
    />
  </main>
  <Footer />
</Layout>
