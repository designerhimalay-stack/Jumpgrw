---
import Arrow from "@/components/icons/Arrow.astro";
import GridRules from "@/components/GridRules.astro";
import SectionHead from "@/components/SectionHead.astro";
import Joints from "@/components/process/Joints.astro";

/* When onshore is the right call, as a switchyard. Each question sits in
   columns 1–2 with a yes / no switch (native radios); a wire runs from it
   to the verdict in columns 3–4. A "yes" lights its wire and routes to
   onshore; with every answer "no", the lower wire lights and the verdict
   turns to nearshore or offshore. Pure CSS (:has), so it works without a
   script; both verdicts share one grid cell, so nothing moves. See
   docs/sections.md. */

interface Question {
  q: string;
  note: string;
  /** Whether the question starts answered "yes". */
  yes: boolean;
}

interface Verdict {
  label: string;
  title: string;
  body: string;
  cta: string;
  href: string;
}

interface Props {
  id: string;
  eyebrow: string;
  headline: string[];
  accent?: number;
  lede: string;
  questions: Question[];
  onshore: Verdict;
  elsewhere: Verdict;
}

const { id, eyebrow, headline, accent, lede, questions, onshore, elsewhere } = Astro.props;
---

<section data-ac-sec="light" data-ac-when id={id}>
  <GridRules />

  <div data-ac-sec-container>
    <SectionHead eyebrow={eyebrow} headline={headline} accent={accent} lede={lede} />

    <div data-ac-sec-frame data-ac-when-yard>
      <Joints />
      <ol data-ac-when-questions>
        {questions.map((question, i) => (
          <li data-ac-when-q style={`--ac-i:${i}`}>
            <fieldset>
              <legend>
                <span class="mono-label-sm">{String(i + 1).padStart(2, "0")}</span>
                {question.q}
              </legend>
              <p data-ac-when-note>{question.note}</p>
              <div data-ac-when-switch>
                <label>
                  <input type="radio" name={`${id}-q${i}`} value="yes" checked={question.yes} />
                  <span>Yes</span>
                </label>
                <label>
                  <input type="radio" name={`${id}-q${i}`} value="no" checked={!question.yes} />
                  <span>No</span>
                </label>
              </div>
            </fieldset>
            <span data-ac-when-wire aria-hidden="true"><i /></span>
          </li>
        ))}
        <li data-ac-when-q data-else aria-hidden="true">
          <span data-ac-when-else class="mono-label-sm">Every answer no</span>
          <span data-ac-when-wire><i /></span>
        </li>
      </ol>

      <div data-ac-when-verdicts aria-live="polite">
        {[
          { v: onshore, key: "on" },
          { v: elsewhere, key: "off" },
        ].map(({ v, key }) => (
          <div data-ac-when-verdict={key}>
            <p class="mono-label">{v.label}</p>
            <p data-ac-when-title>{v.title}</p>
            <p data-ac-when-body>{v.body}</p>
            <a href={v.href} data-ac-when-cta>
              {v.cta}
              <Arrow direction="right" />
            </a>
          </div>
        ))}
      </div>
    </div>
  </div>
</section>

<script>
  import { toggleInView } from "@/lib/in-view";

  document.querySelectorAll<HTMLElement>("[data-ac-when]").forEach(toggleInView);
</script>
