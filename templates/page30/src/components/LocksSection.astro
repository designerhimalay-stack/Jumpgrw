---
import { Image } from "astro:assets";
import GridRules from "@/components/GridRules.astro";
import RevealText from "@/components/RevealText.astro";
import TechLogo from "@/components/TechLogo.astro";
import Joints from "@/components/process/Joints.astro";
import type { TechLogoSlug } from "@/lib/tech-logos";
import type { SectionPhoto } from "@/types/page";

/* Compliance-sensitive work, as a row of locks, on the dark tone. Columns
   1–2: the claim, the frameworks the team works under set as stamps, and a
   photo of the team. Columns 3–4: the controls, one per row, each with a
   padlock whose shackle closes as the section arrives, one after another,
   and the logos of the tools that enforce it, in your accounts. See
   docs/sections.md. */

interface Control {
  title: string;
  note: string;
  tools: TechLogoSlug[];
}

interface Props {
  id: string;
  eyebrow: string;
  headline: string[];
  accent?: number;
  lede: string;
  media: SectionPhoto;
  frameworks: string[];
  frameworksNote: string;
  controls: Control[];
}

const { id, eyebrow, headline, accent = headline.length - 1, lede, media, frameworks, frameworksNote, controls } = Astro.props;
const offsets = headline.map((_, i) => headline.slice(0, i).reduce((n, line) => n + Array.from(line).length + 1, 0));
---

<section data-ac-sec="dark" data-ac-locks id={id}>
  <GridRules />

  <div data-ac-sec-container data-ac-locks-grid>
    <div data-ac-locks-copy>
      <p data-ac-sec-eyebrow class="mono-label">
        <span aria-hidden="true">+</span>
        {eyebrow}
      </p>
      <h2 data-ac-locks-headline aria-label={headline.join(" ")}>
        {headline.map((line, i) => (
          <Fragment>
            {i > 0 && <Fragment>{" "}<br aria-hidden="true" /></Fragment>}
            <span data-ac-sec-line data-accent={i === accent || undefined}>
              <RevealText text={line} offset={offsets[i]} />
            </span>
          </Fragment>
        ))}
      </h2>
      <p data-ac-locks-lede data-ac-sec-rise>{lede}</p>

      <ul data-ac-locks-stamps aria-label={frameworksNote}>
        {frameworks.map((f, i) => <li style={`--ac-i:${i}`}>{f}</li>)}
      </ul>
      <p data-ac-locks-stamps-note class="mono-label-sm">{frameworksNote}</p>

      <div data-ac-locks-photo>
        <Joints />
        <div data-ac-locks-image>
          <Image
            src={media.image}
            alt={media.alt}
            widths={[480, 800, 1200]}
            sizes="(max-width: 991px) 100vw, 46vw"
            quality={78}
            style={media.focus ? `object-position:${media.focus}` : undefined}
          />
        </div>
      </div>
    </div>

    <ol data-ac-locks-list>
      {controls.map((control, i) => (
        <li data-ac-locks-row style={`--ac-i:${i}`}>
          <span data-ac-locks-lock aria-hidden="true">
            <svg viewBox="0 0 32 32">
              <path data-ac-locks-shackle d="M10 15v-5a6 6 0 0 1 12 0v5" />
              <rect x="6.5" y="14.5" width="19" height="14" rx="2.5" />
              <path d="M16 20v3" />
            </svg>
          </span>
          <div data-ac-locks-text>
            <h3 data-ac-locks-title>{control.title}</h3>
            <p data-ac-locks-note>{control.note}</p>
          </div>
          <span data-ac-locks-tools>
            {control.tools.map((slug) => (
              <span data-ac-locks-tile>
                <TechLogo slug={slug} size={22} label />
              </span>
            ))}
          </span>
        </li>
      ))}
    </ol>
  </div>
</section>

<script>
  import { toggleInView } from "@/lib/in-view";

  document.querySelectorAll<HTMLElement>("[data-ac-locks]").forEach(toggleInView);
</script>
