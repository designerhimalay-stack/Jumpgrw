---
import Layout from "@/layouts/Layout.astro";
import CtaSection from "@/components/CtaSection.astro";
import FaqSection from "@/components/FaqSection.astro";
import Footer from "@/components/Footer.astro";
import Navbar from "@/components/Navbar.astro";
import PageHero from "@/components/PageHero.astro";
import SmoothScroll from "@/components/SmoothScroll.astro";
import RewriteSection from "@/components/RewriteSection.astro";
import PrismSection from "@/components/PrismSection.astro";
import CoroutinesSection from "@/components/CoroutinesSection.astro";
import CompletionSection from "@/components/CompletionSection.astro";
import type { PageHeroContent } from "@/types/page";
import heroPhoto from "@/assets/pages/p23-hero.jpg";
import pairingPhoto from "@/assets/pages/p23-pairing.jpg";
import toolchainPhoto from "@/assets/pages/p23-toolchain.jpg";
import faqPhoto from "@/assets/pages/p23-faq.jpg";
import { BRAND } from "@/lib/brand";

/* Kotlin developers. The code, the line counts, the trace's timings, the
   coordinates and the FAQ answers are illustrative drafts; have them
   checked before launch. See docs/sections.md. */

const HERO: PageHeroContent = {
  trail: ["Technologies", "Mobile", "Kotlin"],
  headline: ["Say it once.", "In Kotlin."],
  accent: 1,
  lede: "Kotlin engineers who write less code that does more: Android apps, shared multiplatform modules and server code, built inside your team.",
  ctas: [
    { label: "Add Kotlin developers", href: "#contact", arrow: "diagonal" },
    { label: "See the rewrite", href: "#rewrite", arrow: "right" },
  ],
  image: heroPhoto,
  imageAlt: "A developer in headphones writes code at a standing desk with two monitors and a laptop.",
  specs: [
    { label: "Language", value: "Kotlin, with Java" },
    { label: "Targets", value: "Android, iOS, server" },
    { label: "Concurrency", value: "Coroutines & Flow" },
    { label: "Starts", value: "Within two weeks" },
  ],
};

const FAQS = [
  {
    q: "Can they move our Java code to Kotlin?",
    a: "Yes, a file at a time. Java and Kotlin live in the same module, so the app keeps shipping during the move.",
  },
  {
    q: "Is Kotlin Multiplatform ready for production?",
    a: "For shared logic, yes. They share models, networking and storage, and keep each platform’s interface native.",
  },
  {
    q: "Do they write server code too?",
    a: "Yes: Ktor or Spring Boot services in Kotlin, sharing models with the apps where that helps.",
  },
  {
    q: "How do they keep coroutines predictable?",
    a: "Structured concurrency with clear scopes, and tests that control virtual time, so async code behaves the same every run.",
  },
];
---

<Layout
  title={`Kotlin developers · ${BRAND.name}`}
  description="Kotlin engineers who write less code that does more: Android apps, multiplatform modules and server code, inside your team."
  navTone="field"
>
  <SmoothScroll />
  <Navbar />
  <main>
    <PageHero content={HERO} />
    <RewriteSection
      id="rewrite"
      eyebrow="Java to Kotlin"
      headline={["Thirty-four lines.", "Now five."]}
      accent={1}
      lede="Our engineers turn verbose Java into Kotlin that says the same thing once, a file at a time, with the app shipping throughout."
      javaFile="User.java"
      kotlinFile="User.kt"
      java={[
        { code: "public final class User {" },
        { code: "\tprivate final long id;", move: 0 },
        { code: "\tprivate final String name;", move: 0 },
        { code: "\tprivate final String email;", move: 0 },
        { code: "" },
        { code: "\tpublic User(long id, String name, String email) {", move: 1 },
        { code: "\t\tthis.id = id;", move: 1 },
        { code: "\t\tthis.name = name;", move: 1 },
        { code: "\t\tthis.email = email;", move: 1 },
        { code: "\t}", move: 1 },
        { code: "" },
        { code: "\tpublic long getId() { return id; }", move: 0 },
        { code: "\tpublic String getName() { return name; }", move: 0 },
        { code: "\tpublic String getEmail() { return email; }", move: 0 },
        { code: "" },
        { code: "\t@Override", move: 2 },
        { code: "\tpublic boolean equals(Object o) {", move: 2 },
        { code: "\t\tif (this == o) return true;", move: 2 },
        { code: "\t\tif (!(o instanceof User)) return false;", move: 2 },
        { code: "\t\tUser u = (User) o;", move: 2 },
        { code: "\t\treturn id == u.id && name.equals(u.name)", move: 2 },
        { code: "\t\t\t&& Objects.equals(email, u.email);", move: 2 },
        { code: "\t}", move: 2 },
        { code: "" },
        { code: "\t@Override", move: 2 },
        { code: "\tpublic int hashCode() {", move: 2 },
        { code: "\t\treturn Objects.hash(id, name, email);", move: 2 },
        { code: "\t}", move: 2 },
        { code: "" },
        { code: "\t@Override", move: 2 },
        { code: "\tpublic String toString() {", move: 2 },
        { code: "\t\treturn \"User(id=\" + id + \", name=\" + name + \")\";", move: 2 },
        { code: "\t}", move: 2 },
        { code: "}" },
      ]}
      kotlin={[
        { parts: [{ code: "data ", move: 2 }, { code: "class User(", move: 1 }] },
        { parts: [{ code: "\tval id: Long,", move: 0 }] },
        { parts: [{ code: "\tval name: String,", move: 0 }] },
        { parts: [{ code: "\tval email: String?,", move: 0 }] },
        { parts: [{ code: ")", move: 1 }] },
      ]}
      moves={[
        { label: "Fields and getters", token: "val" },
        { label: "The constructor", token: "class User(…)" },
        { label: "equals, hashCode, toString", token: "data" },
      ]}
    />
    <PrismSection
      id="multiplatform"
      eyebrow="Kotlin Multiplatform"
      headline={["One codebase.", "Four targets."]}
      accent={1}
      lede="Shared Kotlin holds the logic once; each platform keeps its own native interface. Fewer bugs to fix twice, fewer features built twice."
      media={{ image: pairingPhoto, alt: "Two engineers review Kotlin code together on a laptop.", focus: "62% 50%" }}
      shared={{
        name: "commonMain",
        note: "Written once, tested once",
        items: ["Models", "Networking", "Storage", "Business rules"],
      }}
      targets={[
        { slug: "android", name: "Android", set: "androidMain", native: "Jetpack Compose" },
        { slug: "ios", name: "iOS", set: "iosMain", native: "SwiftUI" },
        { slug: "webassembly", name: "Web", set: "wasmJsMain", native: "Compose for Web" },
        { slug: "openjdk", name: "Server", set: "jvmMain", native: "Ktor" },
      ]}
    />
    <CoroutinesSection
      id="coroutines"
      eyebrow="Coroutines"
      headline={["Wait less.", "Block nothing."]}
      accent={1}
      lede="Coroutines let one screen make three network calls at once and suspend while it waits, so the user sees it sooner."
      span={1000}
      calls={[
        { name: "profile()", wait: 260, work: 40 },
        { name: "orders()", wait: 340, work: 60 },
        { name: "offers()", wait: 210, work: 40 },
      ]}
      render={{ name: "render()", work: 50 }}
      code={{
        sequential: [
          "suspend fun loadHome() {",
          "  val profile = api.profile()",
          "  val orders = api.orders()",
          "  val offers = api.offers()",
          "  render(profile, orders, offers)",
          "}",
        ],
        concurrent: [
          "suspend fun loadHome() = coroutineScope {",
          "  val profile = async { api.profile() }",
          "  val orders = async { api.orders() }",
          "  val offers = async { api.offers() }",
          "  render(",
          "    profile.await(),",
          "    orders.await(),",
          "    offers.await(),",
          "  )",
          "}",
        ],
      }}
    />
    <CompletionSection
      id="toolchain"
      eyebrow="The toolchain"
      headline={["Start typing.", "They know the rest."]}
      accent={1}
      lede="The libraries and tools the team reaches for daily, from the build file to the server."
      media={{ image: toolchainPhoto, alt: "An engineer writes code at a desktop monitor in an open office.", focus: "60% 72%" }}
      scope="Toolchain"
      tools={[
        { slug: "kotlin", name: "Coroutines", coordinate: "org.jetbrains.kotlinx:kotlinx-coroutines-core", role: "Concurrency" },
        { slug: "jetpackcompose", name: "Jetpack Compose", coordinate: "androidx.compose.ui:ui", role: "Android UI" },
        { slug: "ktor", name: "Ktor", coordinate: "io.ktor:ktor-server-core", role: "Server" },
        { slug: "springboot", name: "Spring Boot", coordinate: "org.springframework.boot:spring-boot-starter-web", role: "Server" },
        { slug: "junit5", name: "JUnit 5", coordinate: "org.junit.jupiter:junit-jupiter", role: "Tests" },
        { slug: "gradle", name: "Gradle", coordinate: "Kotlin DSL build scripts", role: "Build" },
        { slug: "intellijidea", name: "IntelliJ IDEA", coordinate: "Refactoring and inspections", role: "IDE" },
        { slug: "androidstudio", name: "Android Studio", coordinate: "Compose previews, profilers", role: "IDE" },
        { slug: "docker", name: "Docker", coordinate: "Containers for Ktor services", role: "Ship" },
      ]}
    />
    <FaqSection
      eyebrow="Kotlin questions"
      headline={["Questions,", "concisely."]}
      accent={1}
      cta="Talk to a Kotlin lead"
      faqs={FAQS}
      media={{ image: faqPhoto, alt: "A developer works through code in an editor on a laptop.", focus: "50% 50%" }}
    />
    <CtaSection
      eyebrow="Less boilerplate"
      headline={["Fewer lines.", "More shipped."]}
      body="Tell us about your codebase and the platforms you ship to, and we’ll match Kotlin engineers who fit your team."
      cta="Find Kotlin developers"
    />
  </main>
  <Footer />
</Layout>
