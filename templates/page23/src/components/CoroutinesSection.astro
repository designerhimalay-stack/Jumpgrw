---
import GridRules from "@/components/GridRules.astro";
import SectionHead from "@/components/SectionHead.astro";
import Joints from "@/components/process/Joints.astro";

/* Coroutines, on the dark tone. A trace view, the way a profiler shows
   time: a millisecond ruler, one lane per network call and a lane for the
   render. Each call launches (a dot), waits suspended (a thin line, the
   thread free for other work) and resumes to finish (a block). A two-way
   switch picks sequential or concurrent; the code beside the trace swaps
   with it, the calls slide to their start times and the total changes.
   While the section is in view a playhead sweeps the trace, revealing it,
   and the switch alternates on its own until someone uses it. Every
   piece keeps its box; calls move by transform only, so nothing shifts.
   Without the script the concurrent trace shows; the switch still works
   (CSS reads the checked radio). See docs/sections.md. */

interface Call {
  name: string;
  /** Milliseconds waiting on the network, then working after resuming. */
  wait: number;
  work: number;
}

interface Props {
  id: string;
  eyebrow: string;
  headline: string[];
  accent?: number;
  lede: string;
  calls: Call[];
  render: { name: string; work: number };
  /** The ruler's length in milliseconds. */
  span: number;
  code: { sequential: string[]; concurrent: string[] };
}

const { id, eyebrow, headline, accent, lede, calls, render, span, code } = Astro.props;

/* Start times in each mode: one after another, or all at zero. */
let t = 0;
const seq = calls.map((c) => {
  const start = t;
  t += c.wait + c.work;
  return start;
});
const seqRender = t;
const conRender = Math.max(...calls.map((c) => c.wait + c.work));
const totals = { sequential: seqRender + render.work, concurrent: conRender + render.work };

const f = (ms: number) => (ms / span).toFixed(4);
const ticks = Array.from({ length: 5 }, (_, i) => (span / 4) * i);
const fmt = (ms: number) => ms.toLocaleString("en-US");

const ENTITIES: Record<string, string> = { "&": "&amp;", "<": "&lt;", ">": "&gt;" };
const escape = (s: string) => Array.from(s, (c) => ENTITIES[c] ?? c).join("");
const TOKEN = /\b(suspend|fun|val|async|await|coroutineScope)\b|(\.\w+)(?=\()/g;
const highlight = (line: string) =>
  escape(line).replace(TOKEN, (m, kw, call) => (kw ? `<span data-t="kw">${m}</span>` : call ? `<span data-t="fn">${m}</span>` : m));
---

<section
  data-ac-sec="dark"
  data-ac-co
  id={id}
  data-totals={JSON.stringify(totals)}
  data-span={span}
>
  <GridRules />

  <div data-ac-sec-container>
    <SectionHead eyebrow={eyebrow} headline={headline} accent={accent} lede={lede} />

    <div data-ac-sec-frame data-ac-co-frame data-ac-sec-rise>
      <Joints />

      <div data-ac-co-side>
        <fieldset data-ac-co-switch>
          <legend class="mono-label-sm">Run the calls</legend>
          <label>
            <input type="radio" name={`${id}-mode`} value="sequential" />
            <span>One by one</span>
          </label>
          <label>
            <input type="radio" name={`${id}-mode`} value="concurrent" checked />
            <span>Concurrently</span>
          </label>
        </fieldset>

        <div data-ac-co-code>
          {(["sequential", "concurrent"] as const).map((mode) => (
            <pre data-mode={mode} aria-label={`The ${mode} version of the code`}><code set:html={code[mode].map(highlight).join("\n")} /></pre>
          ))}
        </div>

        <dl data-ac-co-totals>
          <div data-mode="sequential">
            <dt class="mono-label-sm">One by one</dt>
            <dd>{fmt(totals.sequential)} ms</dd>
          </div>
          <div data-mode="concurrent">
            <dt class="mono-label-sm">Concurrently</dt>
            <dd>{fmt(totals.concurrent)} ms</dd>
          </div>
        </dl>
      </div>

      <div data-ac-co-trace role="img" aria-label={`A trace of ${calls.length} network calls: ${fmt(totals.sequential)} ms one by one, ${fmt(totals.concurrent)} ms concurrently.`}>
        <p data-ac-co-clock aria-hidden="true">
          <b data-ac-co-ms>{fmt(totals.concurrent)}</b>
          <span class="mono-label-sm">ms elapsed</span>
        </p>

        <div data-ac-co-body>
        <div data-ac-co-ruler aria-hidden="true">
          {ticks.map((ms, i) => (
            <span style={`--x:${f(ms)}`} data-last={i === ticks.length - 1 ? "" : undefined}>{ms}</span>
          ))}
        </div>

        <ol data-ac-co-lanes aria-hidden="true">
          {calls.map((c, i) => (
            <li style={`--s0:${f(seq[i])};--s1:0`}>
              <span data-ac-co-name><code>{c.name}</code></span>
              <span data-ac-co-track>
                <span data-ac-co-run>
                  <i data-ac-co-launch />
                  <i data-ac-co-wait style={`width:${(c.wait / span) * 100}%`} />
                  <i data-ac-co-work style={`left:${(c.wait / span) * 100}%;width:${(c.work / span) * 100}%`} />
                </span>
              </span>
            </li>
          ))}
          <li data-ac-co-main style={`--s0:${f(seqRender)};--s1:${f(conRender)}`}>
            <span data-ac-co-name><code>{render.name}</code></span>
            <span data-ac-co-track>
              <span data-ac-co-run>
                <i data-ac-co-work style={`width:${(render.work / span) * 100}%`} />
              </span>
            </span>
          </li>
        </ol>

        <span data-ac-co-sweep aria-hidden="true"><i /></span>
        </div>

        <p data-ac-co-key class="mono-label-sm" aria-hidden="true">
          <span><i data-ac-co-launch /> launch</span>
          <span><i data-ac-co-wait /> suspended</span>
          <span><i data-ac-co-work /> resumed</span>
        </p>
      </div>
    </div>
  </div>
</section>

<script>
  document.querySelectorAll<HTMLElement>("[data-ac-co]").forEach((section) => {
    const totals: Record<string, number> = JSON.parse(section.dataset.totals ?? "{}");
    const span = Number(section.dataset.span);
    const radios = Array.from(section.querySelectorAll<HTMLInputElement>('input[type="radio"]'));
    const ms = section.querySelector<HTMLElement>("[data-ac-co-ms]");
    const reduced = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
    const SWEEP_MS_PER_MS = 2.6;
    let timers: number[] = [];
    let frame = 0;
    let auto = true;

    const mode = () => radios.find((r) => r.checked)?.value ?? "concurrent";

    const stop = () => {
      timers.forEach(clearTimeout);
      timers = [];
      cancelAnimationFrame(frame);
    };

    /* The playhead runs from zero to the mode's total, uncovering the trace
       and counting the clock. */
    const sweep = (done?: () => void) => {
      const total = totals[mode()];
      if (reduced) {
        section.style.setProperty("--t", String(total / span));
        if (ms) ms.textContent = total.toLocaleString("en-US");
        return;
      }
      const length = total * SWEEP_MS_PER_MS;
      const t0 = performance.now();
      const tick = (now: number) => {
        const p = Math.min(1, (now - t0) / length);
        section.style.setProperty("--t", String((p * total) / span));
        if (ms) ms.textContent = Math.round(p * total).toLocaleString("en-US");
        if (p < 1) frame = requestAnimationFrame(tick);
        else if (done) timers.push(window.setTimeout(done, 1600));
      };
      cancelAnimationFrame(frame);
      frame = requestAnimationFrame(tick);
    };

    /* Back to zero: the trace covered, the clock reset. */
    const clear = () => {
      section.style.setProperty("--t", "0");
      if (ms) ms.textContent = "0";
    };

    /* Autoplay: alternate the two modes until the reader picks one. */
    const loop = () => {
      sweep(() => {
        if (!auto) return;
        const next = radios.find((r) => !r.checked);
        if (next) next.checked = true;
        clear();
        timers.push(window.setTimeout(loop, 900));
      });
    };

    radios.forEach((r) =>
      r.addEventListener("change", () => {
        auto = false;
        stop();
        sweep();
      }),
    );

    section.setAttribute("data-ac-co-ready", "");
    if (reduced) sweep();

    new IntersectionObserver(
      ([entry]) => {
        section.toggleAttribute("data-ac-in", entry.isIntersecting);
        if (reduced) return;
        stop();
        clear();
        if (!entry.isIntersecting) return;
        if (auto) {
          const first = radios.find((r) => r.value === "sequential");
          if (first) first.checked = true;
          timers.push(window.setTimeout(loop, 900));
        } else {
          sweep();
        }
      },
      { threshold: 0, rootMargin: "-10% 0px -10% 0px" },
    ).observe(section);
  });
</script>
