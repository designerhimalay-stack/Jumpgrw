---
import GridRules from "@/components/GridRules.astro";
import SectionHead from "@/components/SectionHead.astro";
import TechLogo from "@/components/TechLogo.astro";
import Joints from "@/components/process/Joints.astro";

/* Java to Kotlin, on the dark tone. One frame, two files: a verbose Java
   class on the left, the Kotlin data class it becomes on the right, with a
   line counter and the three moves that get it there. As the section
   arrives the moves play in turn: each lights its Java lines, then strikes
   them through, while the matching Kotlin piece appears and the counter
   drops. Every line and piece holds its place from the start (only colour
   and opacity change), so nothing moves. Without the script, or under
   reduced motion, the finished state shows. See docs/sections.md. */

interface Line {
  /** Tabs for indentation; the editor sets their width. */
  code: string;
  /** The move that removes this line, by index into `moves`. */
  move?: number;
}

interface KotlinLine {
  /** Each part is a run of code; `move` makes it appear with that move. */
  parts: { code: string; move?: number }[];
}

interface Props {
  id: string;
  eyebrow: string;
  headline: string[];
  accent?: number;
  lede: string;
  javaFile: string;
  kotlinFile: string;
  java: Line[];
  kotlin: KotlinLine[];
  moves: { label: string; token: string }[];
}

const { id, eyebrow, headline, accent, lede, javaFile, kotlinFile, java, kotlin, moves } = Astro.props;

/* The counter after each move: Java's lines less those the moves so far
   have removed; the last move lands on the Kotlin file's length. */
const counts = moves.map((_, m) =>
  m === moves.length - 1 ? kotlin.length : java.length - java.filter((l) => l.move !== undefined && l.move <= m).length,
);

/* A small highlighter for Java and Kotlin: enough colour to read as code. */
const ENTITIES: Record<string, string> = { "&": "&amp;", "<": "&lt;", ">": "&gt;" };
const escape = (s: string) => Array.from(s, (c) => ENTITIES[c] ?? c).join("");
const TOKEN = new RegExp(
  [
    String.raw`("[^"]*")`,
    String.raw`(@\w+)`,
    String.raw`\b(public|private|final|class|data|val|var|return|if|new|this|instanceof|true|false|long|int|boolean)\b`,
    String.raw`\b([A-Z]\w*)\b`,
  ].join("|"),
  "g",
);
const highlight = (code: string) =>
  escape(code).replace(TOKEN, (m, str, attr, kw, type) => {
    const kind = str ? "str" : attr ? "attr" : kw ? "kw" : type ? "type" : "";
    return kind ? `<span data-t="${kind}">${m}</span>` : m;
  });
---

<section data-ac-sec="dark" data-ac-j2k id={id} data-counts={JSON.stringify(counts)} data-total={java.length}>
  <GridRules />

  <div data-ac-sec-container>
    <SectionHead eyebrow={eyebrow} headline={headline} accent={accent} lede={lede} />

    <div data-ac-sec-frame data-ac-j2k-frame data-ac-sec-rise>
      <Joints />

      <div data-ac-j2k-pane data-lang="java">
        <p data-ac-j2k-tab>
          <TechLogo slug="openjdk" size={16} tone="white" />
          {javaFile}
          <span class="mono-label-sm">{java.length} lines</span>
        </p>
        <ol data-ac-j2k-code aria-label={`${javaFile}, ${java.length} lines of Java`}>
          {java.map((line, i) => (
            <li data-move={line.move} data-blank={line.code === "" ? "" : undefined}>
              <span data-ac-j2k-num aria-hidden="true">{i + 1}</span>
              <code set:html={highlight(line.code) || " "} />
            </li>
          ))}
        </ol>
      </div>

      <div data-ac-j2k-side>
        <div data-ac-j2k-pane data-lang="kotlin">
          <p data-ac-j2k-tab>
            <TechLogo slug="kotlin" size={16} tone="white" />
            {kotlinFile}
            <span class="mono-label-sm">{kotlin.length} lines</span>
          </p>
          <ol data-ac-j2k-code aria-label={`${kotlinFile}, ${kotlin.length} lines of Kotlin`}>
            {kotlin.map((line, i) => (
              <li>
                <span data-ac-j2k-num aria-hidden="true">{i + 1}</span>
                <code>
                  {line.parts.map((p) => (
                    <span data-ac-j2k-part data-move={p.move} set:html={highlight(p.code)} />
                  ))}
                </code>
              </li>
            ))}
          </ol>
        </div>

        <div data-ac-j2k-meter aria-hidden="true">
          <p data-ac-j2k-count>
            <b data-ac-j2k-n>{kotlin.length}</b>
            <span class="mono-label-sm">lines to maintain</span>
          </p>
          <span data-ac-j2k-bar><i style={`--n:${kotlin.length / java.length}`} /></span>
        </div>

        <ol data-ac-j2k-moves>
          {moves.map((m, i) => (
            <li data-move={i}>
              <span data-ac-j2k-idx class="mono-label-sm">{String(i + 1).padStart(2, "0")}</span>
              <span data-ac-j2k-label>{m.label}</span>
              <code data-ac-j2k-token>{m.token}</code>
            </li>
          ))}
        </ol>
      </div>
    </div>
  </div>
</section>

<script>
  document.querySelectorAll<HTMLElement>("[data-ac-j2k]").forEach((section) => {
    const counts: number[] = JSON.parse(section.dataset.counts ?? "[]");
    const total = Number(section.dataset.total);
    const last = counts.length - 1;
    const marked = Array.from(section.querySelectorAll<HTMLElement>("[data-move]"));
    const n = section.querySelector<HTMLElement>("[data-ac-j2k-n]");
    const bar = section.querySelector<HTMLElement>("[data-ac-j2k-bar] i");
    const reduced = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
    const STEP_MS = 1500;
    let timers: number[] = [];

    /* `done` moves are finished; `live` is the one playing now (-1: none). */
    const set = (done: number, live: number) => {
      marked.forEach((el) => {
        const m = Number(el.dataset.move);
        el.toggleAttribute("data-done", m <= done);
        el.toggleAttribute("data-live", m === live);
      });
      const value = done < 0 ? total : counts[done];
      if (n) n.textContent = String(value);
      if (bar) bar.style.setProperty("--n", String(value / total));
    };

    const reset = () => {
      timers.forEach(clearTimeout);
      timers = [];
      set(-1, -1);
    };

    if (reduced) {
      set(last, -1);
    } else {
      section.setAttribute("data-ac-j2k-ready", "");
      reset();
    }

    new IntersectionObserver(
      ([entry]) => {
        section.toggleAttribute("data-ac-in", entry.isIntersecting);
        if (reduced) return;
        reset();
        if (!entry.isIntersecting) return;
        for (let i = 0; i <= last; i++) {
          timers.push(window.setTimeout(() => set(i - 1, i), 900 + i * STEP_MS));
          timers.push(window.setTimeout(() => set(i, -1), 900 + i * STEP_MS + 900));
        }
      },
      { threshold: 0, rootMargin: "-10% 0px -10% 0px" },
    ).observe(section);
  });
</script>
