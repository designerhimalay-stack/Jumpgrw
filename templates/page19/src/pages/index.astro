---
import Layout from "@/layouts/Layout.astro";
import CtaSection from "@/components/CtaSection.astro";
import EcosystemSection from "@/components/EcosystemSection.astro";
import FaqSection from "@/components/FaqSection.astro";
import Footer from "@/components/Footer.astro";
import HeapSection from "@/components/HeapSection.astro";
import Navbar from "@/components/Navbar.astro";
import PageHero from "@/components/PageHero.astro";
import SmoothScroll from "@/components/SmoothScroll.astro";
import StreamsSection from "@/components/StreamsSection.astro";
import type { PageHeroContent } from "@/types/page";
import heroPhoto from "@/assets/pages/p19-hero.jpg";
import streamsPhoto from "@/assets/pages/p19-streams.jpg";
import ecosystemPhoto from "@/assets/pages/p19-ecosystem.jpg";
import faqPhoto from "@/assets/pages/p19-faq.jpg";
import { BRAND } from "@/lib/brand";

/* Java developers. The heap and the Kafka cluster are simulations, the
   service names are an example, and the FAQ answers are drafts; have them
   checked before launch. See docs/sections.md. */

const HERO: PageHeroContent = {
  trail: ["Technologies", "Backend", "Java"],
  headline: ["Java", "developers."],
  accent: 1,
  lede: "Engineers who build Spring Boot services, tune the JVM and run event-driven systems on Kafka, from first commit to production.",
  ctas: [
    { label: "Hire Java developers", href: "#contact", arrow: "diagonal" },
    { label: "Watch the heap", href: "#heap", arrow: "right" },
  ],
  image: heroPhoto,
  imageAlt: "Two developers review code together at a desk with monitors.",
  specs: [
    { label: "Builds", value: "Spring Boot services" },
    { label: "Runs on", value: "Java 17 and 21" },
    { label: "Streams", value: "Kafka, at scale" },
    { label: "Starts", value: "Within two weeks" },
  ],
};

const FAQS = [
  {
    q: "Which Java versions do you work with?",
    a: "Current LTS releases by default. On older estates we plan the upgrade in steps, with tests in place first.",
  },
  {
    q: "Spring only, or other frameworks too?",
    a: "Mostly Spring Boot, plus Quarkus or Micronaut where startup time and memory matter most.",
  },
  {
    q: "Can you help with performance problems?",
    a: "Yes. We profile under production-like load, then tune the heap, the collector and the code that allocates most.",
  },
  {
    q: "Will they work with our Kafka setup?",
    a: "Yes, self-hosted or managed: topics, schemas, consumer groups and the monitoring around them.",
  },
];
---

<Layout
  title={`Java developers · ${BRAND.name}`}
  description="Java engineers for Spring Boot services, JVM tuning and event-driven systems on Kafka."
  navTone="field"
>
  <SmoothScroll />
  <Navbar />
  <main>
    <PageHero content={HERO} />
    <HeapSection
      id="heap"
      eyebrow="JVM performance"
      headline={["Most objects die young.", "We tune for the rest."]}
      accent={1}
      lede="Heap sizes, collector and pause targets, set from your production profile rather than guesswork."
      label="orders-service · G1 · 2 GB heap"
      regions={[
        { key: "eden", name: "Eden", tag: "young", cols: 16 },
        { key: "s0", name: "S0", tag: "surv.", cols: 3 },
        { key: "s1", name: "S1", tag: "surv.", cols: 3 },
        { key: "old", name: "Old", tag: "tenured", cols: 16 },
      ]}
      notes={[
        { state: "n", title: "Eden", body: "New objects land here. Most are gone by the next sweep." },
        { state: "s", title: "Survivor", body: "Objects that outlive a sweep, copied between two spaces." },
        { state: "o", title: "Old", body: "Long-lived objects, promoted and collected rarely." },
        { state: "t", title: "Our part", body: "Heap sizes, G1 or ZGC, and pause targets from real profiles." },
      ]}
      readout={{ minor: "Minor GCs", major: "Mixed GCs", pause: "Last pause", old: "Old gen" }}
      status={{ run: "Allocating", gc: "GC pause" }}
    />
    <StreamsSection
      id="streams"
      eyebrow="Event-driven systems"
      headline={["Every event lands.", "Even under load."]}
      accent={1}
      lede="Kafka-backed services that keep up with traffic, and scale out when a consumer falls behind."
      media={{ image: streamsPhoto, alt: "An engineer writes code at a monitor in a busy office.", focus: "50% 40%" }}
      title="Kafka cluster"
      meta="3 topics · 9 partitions"
      lanes={[
        { producer: "orders-service", topic: "orders.placed", partitions: "3 partitions", consumer: "shipping-service" },
        { producer: "payments-service", topic: "payments.settled", partitions: "3 partitions", consumer: "ledger-service" },
        { producer: "inventory-service", topic: "stock.changed", partitions: "3 partitions", consumer: "analytics-service", lags: true },
      ]}
      states={["In sync", "Falling behind", "Catching up"]}
      unit="instances"
      footnote="Lag is watched; past a threshold the consumer group scales out. Simulated."
    />
    <EcosystemSection
      id="ecosystem"
      eyebrow="The Spring ecosystem"
      headline={["One build file.", "The full stack."]}
      accent={1}
      lede="Spring Boot at the centre, with the libraries and tools a Java team leans on every day."
      media={{ image: ecosystemPhoto, alt: "A developer in glasses types on a laptop at his desk.", focus: "55% 40%" }}
      file="build.gradle.kts · dependencies resolved"
      root={{ name: "orders-service", note: "Spring Boot 3 · Java 21", logos: ["springboot", "openjdk"] }}
      deps={[
        {
          logo: "spring",
          name: "Spring Web",
          artifact: "starter-web",
          role: "REST endpoints",
          version: "resolved",
          child: { logo: "springsecurity", name: "Spring Security", note: "Auth and access" },
        },
        {
          logo: "hibernate",
          name: "Hibernate",
          artifact: "starter-data-jpa",
          role: "Persistence",
          version: "resolved",
          child: { logo: "postgresql", name: "PostgreSQL", note: "JDBC driver" },
        },
        {
          logo: "apachekafka",
          name: "Apache Kafka",
          artifact: "spring-kafka",
          role: "Events in and out",
          version: "resolved",
          child: { logo: "apacheavro", name: "Apache Avro", note: "Message schemas" },
        },
        {
          logo: "elasticsearch",
          name: "Elasticsearch",
          artifact: "data-elasticsearch",
          role: "Search",
          version: "resolved",
          child: { logo: "kibana", name: "Kibana", note: "Search dashboards" },
        },
      ]}
      tools={[
        { label: "Build", logos: ["gradle", "apachemaven"], note: "Reproducible builds" },
        { label: "Test", logos: ["junit5"], note: "Unit, slice and container tests" },
        { label: "Run", logos: ["docker", "kubernetes", "quarkus"], note: "Containers, native where it pays" },
        { label: "Write", logos: ["intellijidea"], note: "Shared inspections and style" },
      ]}
    />
    <FaqSection
      eyebrow="Java questions"
      headline={["Questions?", "Throw them."]}
      accent={1}
      cta="Talk to a Java lead"
      faqs={FAQS}
      media={{ image: faqPhoto, alt: "Two developers laugh while talking through work at their desks.", focus: "50% 40%" }}
    />
    <CtaSection
      eyebrow="Ready to build"
      headline={["Write once.", "Run your team."]}
      body="Tell us what runs on the JVM today and where it strains. We will shape the team to carry it."
      cta="Plan my Java team"
    />
  </main>
  <Footer />
</Layout>
