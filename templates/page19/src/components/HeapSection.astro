---
import GridRules from "@/components/GridRules.astro";
import SectionHead from "@/components/SectionHead.astro";
import Joints from "@/components/process/Joints.astro";

/* The JVM heap, live. A framed memory map across all four columns: Eden,
   the two Survivor spaces and the Old generation, each a fixed grid of
   12px-style cells. New objects fill Eden in order (bump the pointer); when
   it is full a sweep runs across it, the few live objects are copied to a
   Survivor space, survivors that keep living are promoted to Old, and Old is
   collected now and then in a larger sweep. A readout counts collections and
   pauses. Under the map, one cell per region says what lives there.

   Every cell is always present and only changes colour, so nothing moves.
   The page renders a mid-cycle snapshot, which is what readers without
   JavaScript, or with reduced motion, see. The loop runs only while the
   section is on screen and the tab is visible. See docs/sections.md. */

interface Region {
  key: "eden" | "s0" | "s1" | "old";
  name: string;
  /** Small mono tag, e.g. "young". */
  tag: string;
  cols: number;
}

interface Note {
  /** The cell state the swatch shows. */
  state: "n" | "s" | "o" | "t";
  title: string;
  body: string;
}

interface Props {
  id: string;
  eyebrow: string;
  headline: string[];
  accent?: number;
  lede: string;
  /** e.g. "orders-service · G1 · -Xmx2g". */
  label: string;
  regions: Region[];
  notes: Note[];
  /** Readout labels. */
  readout: { minor: string; major: string; pause: string; old: string };
  status: { run: string; gc: string };
}

const { id, eyebrow, headline, accent, lede, label, regions, notes, readout, status } = Astro.props;
const ROWS = 8;

/* A deterministic snapshot for the first paint: Eden two-thirds full in
   order, a few survivors in S0, Old about a third full, scattered. */
let seed = 7;
const rand = () => ((seed = (seed * 16807) % 2147483647) / 2147483647);
const snapshot = (key: Region["key"], n: number): string[] => {
  if (key === "eden") return Array.from({ length: n }, (_, i) => (i < Math.round(n * 0.62) ? "n" : ""));
  if (key === "s0") return Array.from({ length: n }, (_, i) => (i < 7 ? "s" : ""));
  if (key === "old") return Array.from({ length: n }, () => (rand() < 0.34 ? "o" : ""));
  return Array.from({ length: n }, () => "");
};
const oldShare = (() => {
  const r = regions.find((x) => x.key === "old");
  if (!r) return 0;
  const cells = snapshot("old", r.cols * ROWS);
  return Math.round((cells.filter(Boolean).length / cells.length) * 100);
})();
seed = 7;
---

<section data-ac-sec="light" data-ac-heap id={id}>
  <GridRules />

  <div data-ac-sec-container>
    <SectionHead eyebrow={eyebrow} headline={headline} accent={accent} lede={lede} />

    <figure data-ac-heap-frame data-ac-sec-rise aria-label={`${label}: a simulated heap filling and being collected`}>
      <Joints />
      <figcaption data-ac-heap-bar>
        <span data-ac-heap-label class="mono-label-sm">{label}</span>
        <span data-ac-heap-status class="mono-label-sm" aria-hidden="true">
          <i />
          <span data-ac-heap-status-run>{status.run}</span>
          <span data-ac-heap-status-gc>{status.gc}</span>
        </span>
      </figcaption>

      <div data-ac-heap-map aria-hidden="true">
        {regions.map((region) => (
          <div data-ac-heap-region={region.key} style={`--ac-cols:${region.cols}`}>
            <p data-ac-heap-rname>
              <span>{region.name}</span>
              <span class="mono-label-sm">{region.tag}</span>
            </p>
            <div data-ac-heap-cells>
              {snapshot(region.key, region.cols * ROWS).map((s) => (
                <i data-s={s || undefined} />
              ))}
              <b data-ac-heap-sweep />
            </div>
          </div>
        ))}
      </div>

      <dl data-ac-heap-readout aria-hidden="true">
        <div><dt class="mono-label-sm">{readout.minor}</dt><dd data-ac-heap-minor>14</dd></div>
        <div><dt class="mono-label-sm">{readout.major}</dt><dd data-ac-heap-major>1</dd></div>
        <div><dt class="mono-label-sm">{readout.pause}</dt><dd><span data-ac-heap-pause>4</span> ms</dd></div>
        <div><dt class="mono-label-sm">{readout.old}</dt><dd><span data-ac-heap-old>{oldShare}</span>%</dd></div>
      </dl>
    </figure>

    <ul data-ac-heap-notes>
      {notes.map((note, i) => (
        <li data-ac-sec-rise style={`--ac-in-delay:${320 + i * 90}ms`}>
          <i data-ac-heap-swatch data-s={note.state} aria-hidden="true" />
          <h3>{note.title}</h3>
          <p>{note.body}</p>
        </li>
      ))}
    </ul>
  </div>
</section>

<script>
  import { toggleInView } from "@/lib/in-view";

  const reduced = window.matchMedia("(prefers-reduced-motion: reduce)");

  document.querySelectorAll<HTMLElement>("[data-ac-heap]").forEach((section) => {
    toggleInView(section);

    const frame = section.querySelector<HTMLElement>("[data-ac-heap-frame]");
    if (!frame) return;
    const region = (key: string) => {
      const el = frame.querySelector<HTMLElement>(`[data-ac-heap-region="${key}"]`);
      return {
        cells: el ? Array.from(el.querySelectorAll<HTMLElement>("[data-ac-heap-cells] > i")) : [],
        sweep: el?.querySelector<HTMLElement>("[data-ac-heap-sweep]") ?? null,
      };
    };
    const eden = region("eden");
    const surv = [region("s0"), region("s1")];
    const old = region("old");
    const out = (sel: string) => frame.querySelector<HTMLElement>(sel);
    const minorEl = out("[data-ac-heap-minor]");
    const majorEl = out("[data-ac-heap-major]");
    const pauseEl = out("[data-ac-heap-pause]");
    const oldEl = out("[data-ac-heap-old]");

    /* State mirrors the snapshot the page rendered. Ages count the
       collections a survivor has lived through. */
    const set = (el: HTMLElement, s: string) => (s ? el.setAttribute("data-s", s) : el.removeAttribute("data-s"));
    const live = (cells: HTMLElement[]) => cells.filter((c) => c.hasAttribute("data-s") && c.dataset.s !== "x");
    let ptr = live(eden.cells).length;
    let from = 0;
    const age = new Map<HTMLElement, number>();
    surv[0].cells.forEach((c) => c.hasAttribute("data-s") && age.set(c, 1));
    let minor = Number(minorEl?.textContent) || 0;
    let major = Number(majorEl?.textContent) || 0;
    let busy = false;

    const sweep = (el: HTMLElement | null, ms: number) =>
      el?.animate([{ transform: "translateX(-100%)" }, { transform: "translateX(100%)" }], {
        duration: ms,
        easing: "cubic-bezier(0.45, 0, 0.55, 1)",
      });

    const collect = (cells: HTMLElement[]) => {
      cells.forEach((c) => c.hasAttribute("data-s") && set(c, "x"));
      window.setTimeout(() => cells.forEach((c) => c.dataset.s === "x" && set(c, "")), 320);
    };

    const place = (cells: HTMLElement[], s: string) => {
      const free = cells.find((c) => !c.hasAttribute("data-s"));
      if (free) set(free, s);
      return free ?? null;
    };

    const promote = () => {
      const free = old.cells.filter((c) => !c.hasAttribute("data-s"));
      const pick = free[Math.floor(Math.random() * free.length)];
      if (pick) set(pick, "o");
    };

    const oldShare = () => Math.round((live(old.cells).length / old.cells.length) * 100);

    const minorGc = () => {
      busy = true;
      frame.setAttribute("data-gc", "");
      sweep(eden.sweep, 620);
      sweep(surv[from].sweep, 620);
      const to = 1 - from;
      window.setTimeout(() => {
        /* Survivors of the from-space: half live on; old enough, promoted. */
        live(surv[from].cells).forEach((c) => {
          const a = (age.get(c) ?? 1) + 1;
          age.delete(c);
          if (Math.random() < 0.5) {
            if (a >= 3) promote();
            else {
              const moved = place(surv[to].cells, "s");
              if (moved) age.set(moved, a);
              else promote();
            }
          }
        });
        /* Eden: most objects die young; a few are copied out. */
        live(eden.cells).forEach(() => {
          if (Math.random() < 0.1) {
            const moved = place(surv[to].cells, "s");
            if (moved) age.set(moved, 1);
            else promote();
          }
        });
        collect(eden.cells);
        collect(surv[from].cells);
        from = to;
        ptr = 0;
        minor += 1;
        if (minorEl) minorEl.textContent = String(minor);
        if (pauseEl) pauseEl.textContent = String(2 + Math.floor(Math.random() * 5));
        if (oldEl) oldEl.textContent = String(oldShare());
      }, 420);
      window.setTimeout(() => {
        frame.removeAttribute("data-gc");
        if (oldShare() >= 78) majorGc();
        else busy = false;
      }, 760);
    };

    const majorGc = () => {
      frame.setAttribute("data-gc", "");
      sweep(old.sweep, 900);
      window.setTimeout(() => {
        const doomed = live(old.cells).filter(() => Math.random() < 0.6);
        collect(doomed);
        major += 1;
        if (majorEl) majorEl.textContent = String(major);
        if (pauseEl) pauseEl.textContent = String(6 + Math.floor(Math.random() * 4));
        window.setTimeout(() => oldEl && (oldEl.textContent = String(oldShare())), 340);
      }, 600);
      window.setTimeout(() => {
        frame.removeAttribute("data-gc");
        busy = false;
      }, 1000);
    };

    const tick = () => {
      if (busy) return;
      for (let k = 0; k < 2; k += 1) {
        if (ptr >= eden.cells.length) {
          minorGc();
          return;
        }
        set(eden.cells[ptr], "n");
        ptr += 1;
      }
    };

    let timer = 0;
    let onScreen = false;
    const sync = () => {
      const run = onScreen && !document.hidden && !reduced.matches;
      if (run && !timer) timer = window.setInterval(tick, 70);
      if (!run && timer) {
        window.clearInterval(timer);
        timer = 0;
      }
    };
    new IntersectionObserver(([entry]) => {
      onScreen = entry.isIntersecting;
      sync();
    }).observe(frame);
    document.addEventListener("visibilitychange", sync);
    reduced.addEventListener("change", sync);
  });
</script>
