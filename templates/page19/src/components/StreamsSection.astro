---
import GridRules from "@/components/GridRules.astro";
import SectionHead from "@/components/SectionHead.astro";
import TechLogo from "@/components/TechLogo.astro";
import Joints from "@/components/process/Joints.astro";
import type { SectionPhoto } from "@/types/page";

/* Event streams, on the dark tone. The header splits around a photo; under
   it, a framed Kafka cluster: one row per topic, a producing service on the
   left, the topic as a lane of flowing messages across the middle, the
   consuming service on the right with its lag. One consumer (the row marked
   `lags`) falls behind on a cycle: its lag climbs and messages queue at the
   end of its lane, it scales out, and it catches up.

   Messages ride a full-width carrier that only translates, the queue's
   chips are always in place and only fade, and the consumer's three states
   share one grid cell, so nothing moves. The flow pauses off screen; under
   reduced motion the lanes hold still and the lagging row shows its caught-up
   state. See docs/sections.md. */

interface Lane {
  producer: string;
  topic: string;
  /** e.g. "3 partitions". */
  partitions: string;
  consumer: string;
  /** This row's consumer falls behind and catches up. */
  lags?: boolean;
}

interface Props {
  id: string;
  eyebrow: string;
  headline: string[];
  accent?: number;
  lede: string;
  media: SectionPhoto;
  title: string;
  meta: string;
  lanes: Lane[];
  /** The consumer's state words: in sync, falling behind, catching up. */
  states: [string, string, string];
  /** e.g. "instances". */
  unit: string;
  footnote: string;
}

const { id, eyebrow, headline, accent, lede, media, title, meta, lanes, states, unit, footnote } = Astro.props;
const MSGS = 6;
const QUEUE = 7;
---

<section data-ac-sec="dark" data-ac-strm id={id}>
  <GridRules />

  <div data-ac-sec-container>
    <SectionHead eyebrow={eyebrow} headline={headline} accent={accent} lede={lede} media={media} />

    <figure data-ac-strm-frame data-ac-sec-rise>
      <Joints />
      <figcaption data-ac-strm-bar>
        <span data-ac-strm-title>
          <span data-ac-strm-badge><TechLogo slug="apachekafka" size={18} tone="ink" /></span>
          {title}
        </span>
        <span class="mono-label-sm" data-ac-strm-meta>{meta}</span>
      </figcaption>

      <ol data-ac-strm-lanes>
        {lanes.map((lane, l) => (
          <li data-ac-strm-lane data-lags={lane.lags || undefined} data-phase="sync" style={`--ac-l:${l}`}>
            <div data-ac-strm-node data-role="producer">
              <span data-ac-strm-tile><TechLogo slug="springboot" size={16} /></span>
              <span data-ac-strm-name>{lane.producer}</span>
            </div>

            <div data-ac-strm-topic>
              <p data-ac-strm-topicname>
                <span>{lane.topic}</span>
                <span class="mono-label-sm">{lane.partitions}</span>
              </p>
              <div data-ac-strm-track aria-hidden="true">
                {Array.from({ length: MSGS }, (_, m) => (
                  <span data-ac-strm-carrier style={`--ac-m:${m}`}>
                    <i />
                  </span>
                ))}
                {lane.lags && (
                  <span data-ac-strm-queue>
                    {Array.from({ length: QUEUE }, () => <i />)}
                  </span>
                )}
              </div>
            </div>

            <div data-ac-strm-node data-role="consumer">
              <span data-ac-strm-tile><TechLogo slug="springboot" size={16} /></span>
              <span data-ac-strm-name>{lane.consumer}</span>
              <span data-ac-strm-state class="mono-label-sm">
                <span data-on="sync">{states[0]}</span>
                {lane.lags && <span data-on="behind">{states[1]}</span>}
                {lane.lags && <span data-on="catch">{states[2]}</span>}
              </span>
              <span data-ac-strm-lag>
                <span data-ac-strm-meter aria-hidden="true"><i /></span>
                <span class="mono-label-sm">lag <b data-ac-strm-lagn>{lane.lags ? 0 : 2}</b></span>
                {lane.lags && (
                  <span class="mono-label-sm" data-ac-strm-inst>
                    <b data-ac-strm-instn>2</b> {unit}
                  </span>
                )}
              </span>
            </div>
          </li>
        ))}
      </ol>

      <p data-ac-strm-foot class="mono-label-sm">{footnote}</p>
    </figure>
  </div>
</section>

<script>
  import { toggleInView } from "@/lib/in-view";

  const reduced = window.matchMedia("(prefers-reduced-motion: reduce)");

  document.querySelectorAll<HTMLElement>("[data-ac-strm]").forEach((section) => {
    toggleInView(section);

    const lane = section.querySelector<HTMLElement>("[data-ac-strm-lane][data-lags]");
    if (!lane) return;
    const lagEl = lane.querySelector<HTMLElement>("[data-ac-strm-lagn]");
    const instEl = lane.querySelector<HTMLElement>("[data-ac-strm-instn]");
    const queue = Array.from(lane.querySelectorAll<HTMLElement>("[data-ac-strm-queue] i"));
    const MAX = 1840;

    /* One cycle, in ticks of 100ms: in sync, then falling behind (lag
       climbs, the queue builds), then scaled out and catching up. */
    const CYCLE = 120;
    let t = 0;
    let timer = 0;

    const render = () => {
      let phase = "sync";
      let lag = 0;
      let inst = 2;
      if (t >= 30 && t < 75) {
        phase = "behind";
        lag = Math.round(MAX * ((t - 30) / 45) ** 1.3);
      } else if (t >= 75 && t < 105) {
        phase = "catch";
        inst = 4;
        lag = Math.round(MAX * (1 - (t - 75) / 30) ** 1.6);
      } else {
        lag = t % 7 === 0 ? 1 : 0;
      }
      lane.dataset.phase = phase;
      lane.style.setProperty("--ac-lag", String(Math.min(1, lag / MAX)));
      if (lagEl) lagEl.textContent = lag.toLocaleString("en-US");
      if (instEl) instEl.textContent = String(inst);
      const shown = Math.ceil((lag / MAX) * queue.length);
      queue.forEach((chip, i) => chip.toggleAttribute("data-on", i < shown));
    };

    const tick = () => {
      t = (t + 1) % CYCLE;
      render();
    };

    let onScreen = false;
    const sync = () => {
      const run = onScreen && !document.hidden && !reduced.matches;
      if (run && !timer) timer = window.setInterval(tick, 100);
      if (!run && timer) {
        window.clearInterval(timer);
        timer = 0;
      }
    };
    new IntersectionObserver(([entry]) => {
      onScreen = entry.isIntersecting;
      sync();
    }).observe(lane);
    document.addEventListener("visibilitychange", sync);
    reduced.addEventListener("change", sync);
  });
</script>
