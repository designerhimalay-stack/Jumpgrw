---
import GridRules from "@/components/GridRules.astro";
import SectionHead from "@/components/SectionHead.astro";
import TechLogo from "@/components/TechLogo.astro";
import Joints from "@/components/process/Joints.astro";
import { TECH_LOGOS, type TechLogoSlug } from "@/lib/tech-logos";
import type { SectionPhoto } from "@/types/page";

/* The Spring ecosystem as a resolved dependency graph. The header splits
   around a photo; under it, a framed graph: the service at the root, a bus
   dropping to four direct dependencies (one per column, each with its logo,
   its artifact and what it brings, and a transitive child where it has
   one), then a toolchain band along the foot: build, test, run and write.

   On arrival the connectors draw and each node resolves in turn, a tick
   appearing beside its version. Only transforms and opacity change, so
   nothing moves. See docs/sections.md. */

interface Dep {
  logo: TechLogoSlug;
  name: string;
  artifact: string;
  role: string;
  version: string;
  child?: { logo: TechLogoSlug; name: string; note: string };
}

interface Tool {
  label: string;
  logos: TechLogoSlug[];
  note: string;
}

interface Props {
  id: string;
  eyebrow: string;
  headline: string[];
  accent?: number;
  lede: string;
  media: SectionPhoto;
  file: string;
  root: { name: string; note: string; logos: TechLogoSlug[] };
  deps: Dep[];
  tools: Tool[];
}

const { id, eyebrow, headline, accent, lede, media, file, root, deps, tools } = Astro.props;

/* A brand colour too pale to read on a white tile draws in ink instead. */
const tone = (slug: TechLogoSlug) => {
  const hex = TECH_LOGOS[slug].hex.slice(1);
  const [r, g, b] = [0, 2, 4].map((i) => parseInt(hex.slice(i, i + 2), 16) / 255);
  return 0.2126 * r + 0.7152 * g + 0.0722 * b > 0.72 ? "ink" : "brand";
};
---

<section data-ac-sec="light" data-ac-eco id={id}>
  <GridRules />

  <div data-ac-sec-container>
    <SectionHead eyebrow={eyebrow} headline={headline} accent={accent} lede={lede} media={media} />

    <div data-ac-eco-frame>
      <Joints />
      <p data-ac-eco-file class="mono-label-sm">
        <span aria-hidden="true">▸</span>
        {file}
      </p>

      <div data-ac-eco-root>
        <span data-ac-eco-rootlogos>
          {root.logos.map((slug) => (
            <span data-ac-eco-tile data-size="lg"><TechLogo slug={slug} size={30} tone={tone(slug)} label /></span>
          ))}
        </span>
        <span>
          <strong>{root.name}</strong>
          <span data-ac-eco-note>{root.note}</span>
        </span>
      </div>

      <div data-ac-eco-bus aria-hidden="true"><i data-ac-eco-stem /><i data-ac-eco-rail /></div>

      <ul data-ac-eco-deps aria-label="Direct dependencies">
        {deps.map((dep, i) => (
          <li data-ac-eco-dep style={`--ac-i:${i}`}>
            <i data-ac-eco-drop aria-hidden="true" />
            <div data-ac-eco-node>
              <span data-ac-eco-tile><TechLogo slug={dep.logo} size={26} tone={tone(dep.logo)} /></span>
              <span data-ac-eco-depname>{dep.name}</span>
              <code data-ac-eco-artifact>{dep.artifact}</code>
              <span data-ac-eco-role>{dep.role}</span>
              <span data-ac-eco-ver class="mono-label-sm">
                {dep.version}
                <span data-ac-eco-tick aria-hidden="true">✓</span>
              </span>
            </div>
            {dep.child && (
              <div data-ac-eco-child>
                <i data-ac-eco-twig aria-hidden="true" />
                <span data-ac-eco-tile data-size="sm"><TechLogo slug={dep.child.logo} size={16} tone={tone(dep.child.logo)} /></span>
                <span>
                  <span data-ac-eco-childname>{dep.child.name}</span>
                  <span data-ac-eco-note>{dep.child.note}</span>
                </span>
              </div>
            )}
          </li>
        ))}
      </ul>

      <ul data-ac-eco-tools aria-label="Around the build">
        {tools.map((tool, i) => (
          <li data-ac-eco-tool style={`--ac-i:${i}`}>
            <span class="mono-label-sm">{tool.label}</span>
            <span data-ac-eco-toollogos>
              {tool.logos.map((slug) => (
                <span data-ac-eco-toollogo>
                  <TechLogo slug={slug} size={22} tone={tone(slug)} />
                  <span>{TECH_LOGOS[slug].title}</span>
                </span>
              ))}
            </span>
            <span data-ac-eco-note>{tool.note}</span>
          </li>
        ))}
      </ul>
    </div>
  </div>
</section>

<script>
  import { toggleInView } from "@/lib/in-view";

  document.querySelectorAll<HTMLElement>("[data-ac-eco]").forEach(toggleInView);
</script>
