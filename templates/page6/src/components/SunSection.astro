---
import { Image } from "astro:assets";
import GridRules from "@/components/GridRules.astro";
import RevealText from "@/components/RevealText.astro";
import Joints from "@/components/process/Joints.astro";
import type { SectionPhoto } from "@/types/page";

/* Follow the sun, on the dark tone. A 24-hour dial in columns 1–2: each
   region's working day drawn as an arc round it, so together they close
   the ring, and a hand pointing at the real time now, in UTC, turning with
   the day. Columns 3–4: the claim, a photo of the team, and each region's
   local time, live. The arcs draw themselves in as the section arrives.
   See docs/sections.md. */

interface Region {
  name: string;
  city: string;
  zone: string;
  /** Working hours in UTC, start and end (0–24; end may pass 24). */
  from: number;
  to: number;
}

interface Props {
  id: string;
  eyebrow: string;
  headline: string[];
  accent?: number;
  lede: string;
  media: SectionPhoto;
  regions: Region[];
}

const { id, eyebrow, headline, accent = headline.length - 1, lede, media, regions } = Astro.props;
const offsets = headline.map((_, i) => headline.slice(0, i).reduce((n, line) => n + Array.from(line).length + 1, 0));

/* Arcs on a 200 × 200 dial; 0 UTC at the top, clockwise. Each region gets
   its own ring, from the outside in. */
const arc = (from: number, to: number, r: number) => {
  const a0 = (from / 24) * Math.PI * 2 - Math.PI / 2;
  const a1 = (to / 24) * Math.PI * 2 - Math.PI / 2;
  const large = to - from > 12 ? 1 : 0;
  const p = (a: number) => `${(100 + Math.cos(a) * r).toFixed(2)} ${(100 + Math.sin(a) * r).toFixed(2)}`;
  return `M${p(a0)} A${r} ${r} 0 ${large} 1 ${p(a1)}`;
};
const radius = (i: number) => 86 - i * 11;
const hours = [0, 3, 6, 9, 12, 15, 18, 21];
---

<section data-ac-sec="dark" data-ac-sun id={id}>
  <GridRules />

  <div data-ac-sec-container data-ac-sun-grid>
    <div data-ac-sun-dial>
      <svg viewBox="0 0 200 200" aria-hidden="true">
        <circle data-ac-sun-face cx="100" cy="100" r="96" />
        {regions.map((_, i) => <circle data-ac-sun-track cx="100" cy="100" r={radius(i)} />)}
        {regions.map((region, i) => (
          <path data-ac-sun-arc d={arc(region.from, region.to, radius(i))} pathLength="1" style={`--ac-i:${i}`} />
        ))}
        {hours.map((h) => {
          const a = (h / 24) * Math.PI * 2 - Math.PI / 2;
          return (
            <text data-ac-sun-hour x={100 + Math.cos(a) * 99} y={100 + Math.sin(a) * 99 + 1.6}>
              {String(h).padStart(2, "0")}
            </text>
          );
        })}
      </svg>
      <span data-ac-sun-hand aria-hidden="true"><i /></span>
      <p data-ac-sun-centre>
        <span data-ac-sun-utc>00:00</span>
        <span class="mono-label-sm">UTC now</span>
      </p>
    </div>

    <div data-ac-sun-copy>
      <p data-ac-sec-eyebrow class="mono-label">
        <span aria-hidden="true">+</span>
        {eyebrow}
      </p>
      <h2 data-ac-sun-headline aria-label={headline.join(" ")}>
        {headline.map((line, i) => (
          <Fragment>
            {i > 0 && <Fragment>{" "}<br aria-hidden="true" /></Fragment>}
            <span data-ac-sec-line data-accent={i === accent || undefined}>
              <RevealText text={line} offset={offsets[i]} />
            </span>
          </Fragment>
        ))}
      </h2>
      <p data-ac-sun-lede data-ac-sec-rise>{lede}</p>

      <ul data-ac-sun-regions>
        {regions.map((region, i) => (
          <li style={`--ac-i:${i}`}>
            <span data-ac-sun-swatch aria-hidden="true" />
            <span data-ac-sun-region>
              <span>{region.city}</span>
              <span class="mono-label-sm">{region.name}</span>
            </span>
            <span data-ac-sun-local data-zone={region.zone}>--:--</span>
          </li>
        ))}
      </ul>

      <div data-ac-sun-photo>
        <Joints />
        <div data-ac-sun-image>
          <Image
            src={media.image}
            alt={media.alt}
            widths={[480, 800, 1200]}
            sizes="(max-width: 991px) 100vw, 46vw"
            quality={78}
            style={media.focus ? `object-position:${media.focus}` : undefined}
          />
        </div>
      </div>
    </div>
  </div>
</section>

<script>
  import { toggleInView } from "@/lib/in-view";

  document.querySelectorAll<HTMLElement>("[data-ac-sun]").forEach((section) => {
    toggleInView(section);

    const hand = section.querySelector<HTMLElement>("[data-ac-sun-hand]")!;
    const utc = section.querySelector<HTMLElement>("[data-ac-sun-utc]")!;
    const locals = Array.from(section.querySelectorAll<HTMLElement>("[data-ac-sun-local]"));
    const time = (zone: string) =>
      new Intl.DateTimeFormat("en-GB", { hour: "2-digit", minute: "2-digit", timeZone: zone }).format(new Date());

    /* The real time, once a minute: the hand's angle and every clock. */
    const tick = () => {
      const now = new Date();
      const hours = now.getUTCHours() + now.getUTCMinutes() / 60;
      hand.style.setProperty("--ac-turn", `${hours / 24}turn`);
      utc.textContent = time("UTC");
      locals.forEach((el) => {
        el.textContent = time(el.dataset.zone ?? "UTC");
      });
    };
    tick();
    window.setInterval(tick, 30_000);
  });
</script>
