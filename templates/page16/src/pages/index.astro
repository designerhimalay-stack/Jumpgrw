---
import Layout from "@/layouts/Layout.astro";
import CtaSection from "@/components/CtaSection.astro";
import EventLoopSection from "@/components/EventLoopSection.astro";
import FaqSection from "@/components/FaqSection.astro";
import Footer from "@/components/Footer.astro";
import Navbar from "@/components/Navbar.astro";
import PackagesSection from "@/components/PackagesSection.astro";
import PageHero from "@/components/PageHero.astro";
import SmoothScroll from "@/components/SmoothScroll.astro";
import UnderLoadSection from "@/components/UnderLoadSection.astro";
import type { PageHeroContent } from "@/types/page";
import heroPhoto from "@/assets/pages/p16-team.jpg";
import terminalPhoto from "@/assets/pages/p16-terminal.jpg";
import loadPhoto from "@/assets/pages/p16-load.jpg";
import faqPhoto from "@/assets/pages/p16-faq.jpg";
import { BRAND } from "@/lib/brand";

/* Node.js developers. The event loop is a teaching example; the package
   versions, install times and load-test figures are illustrative, not
   measurements. The FAQ answers are drafts. Have them checked before
   launch. See docs/sections.md. */

const HERO: PageHeroContent = {
  trail: ["Technologies", "Backend", "Node.js"],
  headline: ["Node.js", "developers."],
  lede: "Backend engineers who keep Node.js fast under load: non-blocking code, lean dependencies and APIs that hold their latency at peak.",
  ctas: [
    { label: "Hire Node.js developers", href: "#contact", arrow: "diagonal" },
    { label: "Watch the event loop", href: "#event-loop", arrow: "right" },
  ],
  image: heroPhoto,
  imageAlt: "A developer points out a line of code on a laptop to a colleague at his desk.",
  specs: [
    { label: "Runtime", value: "Node.js LTS" },
    { label: "Frameworks", value: "Express, NestJS, Fastify" },
    { label: "Typed", value: "TypeScript first" },
    { label: "Starts", value: "Within two weeks" },
  ],
};

const FAQS = [
  {
    q: "Express, NestJS or Fastify?",
    a: "Whichever fits the service. NestJS for large teams that want structure, Fastify where raw speed matters, Express where it already runs.",
  },
  {
    q: "Can they fix a slow API?",
    a: "Usually. We profile first: blocking work on the event loop, slow queries and chatty calls are the common causes, and each has a known fix.",
  },
  {
    q: "Do they work in TypeScript?",
    a: "By default. Strict types on new code, and a gradual path for JavaScript services you already run.",
  },
  {
    q: "What about serverless?",
    a: "Yes. They build functions as readily as long-running services, and will tell you when a container is the better fit.",
  },
];
---

<Layout
  title={`Node.js developers · ${BRAND.name}`}
  description="Node.js engineers who keep APIs fast under load: non-blocking code, lean dependencies and services that hold their latency at peak."
  navTone="field"
>
  <SmoothScroll />
  <Navbar />
  <main>
    <PageHero content={HERO} />
    <EventLoopSection
      id="event-loop"
      eyebrow="The event loop"
      headline={["One thread.", "Never blocked."]}
      accent={1}
      lede="Four lines, printed out of order. Our developers know why, and write code that keeps the loop free."
      labels={{
        source: "Source",
        console: "Console",
        stack: "Call stack",
        micro: "Microtasks",
        timers: "Timers",
        loop: "The loop",
      }}
      source={[
        `console.log("A");`,
        `setTimeout(() => console.log("D"), 0);`,
        `queueMicrotask(() => console.log("C"));`,
        `console.log("B");`,
      ]}
      output={["A", "B", "C", "D"]}
      frames={{
        main: "main()",
        logA: "log(\"A\")",
        timeout: "setTimeout()",
        queue: "queueMicrotask()",
        logB: "log(\"B\")",
        cbC: "() => log(\"C\")",
        cbD: "() => log(\"D\")",
      }}
      phases={["Run the script", "Drain microtasks", "Take the next callback"]}
      still={4}
      steps={[
        { line: 0, stack: ["main", "logA"], micro: [], timers: [], out: 1, phase: 0, note: "Synchronous code runs first, on the stack." },
        { line: 1, stack: ["main", "timeout"], micro: [], timers: ["cbD"], out: 1, phase: 0, note: "setTimeout hands its callback to the timers." },
        { line: 2, stack: ["main", "queue"], micro: ["cbC"], timers: ["cbD"], out: 1, phase: 0, note: "queueMicrotask files C as a microtask." },
        { line: 3, stack: ["main", "logB"], micro: ["cbC"], timers: ["cbD"], out: 2, phase: 0, note: "The script runs on: B prints before C." },
        { stack: [], micro: ["cbC"], timers: ["cbD"], out: 2, phase: 1, note: "Stack empty: microtasks go first." },
        { stack: ["cbC"], micro: [], timers: ["cbD"], out: 3, phase: 1, note: "C runs from the microtask queue." },
        { stack: ["cbD"], micro: [], timers: [], out: 4, phase: 2, note: "Then the timer's callback: D." },
        { stack: [], micro: [], timers: [], out: 4, phase: 2, note: "D ran last, though its delay was 0 ms." },
      ]}
    />
    <PackagesSection
      id="packages"
      eyebrow="package.json"
      headline={["Every dependency,", "chosen on purpose."]}
      accent={1}
      lede="The packages our Node.js developers know inside out. Each one earns its line, and none ships without a reason."
      media={{ image: terminalPhoto, alt: "A developer with headphones works in a terminal across two monitors.", focus: "18% 50%" }}
      file="package.json"
      project="orders-api"
      engine={{ name: "node", version: ">=22", logo: "nodedotjs", role: "Runtime" }}
      dependencies={[
        { name: "express", version: "^5.1.0", logo: "express", role: "HTTP server", time: "+0.4 s" },
        { name: "@nestjs/core", version: "^11.0.0", logo: "nestjs", role: "Structure", time: "+0.9 s" },
        { name: "fastify", version: "^5.2.0", logo: "fastify", role: "Fast routes", time: "+0.3 s" },
        { name: "@prisma/client", version: "^6.5.0", logo: "prisma", role: "SQL access", time: "+1.1 s" },
        { name: "mongodb", version: "^6.15.0", logo: "mongodb", role: "Documents", time: "+0.5 s" },
        { name: "ioredis", version: "^5.6.0", logo: "redis", role: "Cache, queues", time: "+0.2 s" },
        { name: "socket.io", version: "^4.8.0", logo: "socketdotio", role: "Realtime", time: "+0.4 s" },
        { name: "graphql", version: "^16.10.0", logo: "graphql", role: "API schema", time: "+0.3 s" },
      ]}
      devDependencies={[{ name: "typescript", version: "^5.8.0", logo: "typescript", role: "Types", time: "+0.6 s" }]}
      manager={{ name: "pnpm", version: "10.6.0", logo: "pnpm", role: "Installs" }}
      run={{
        command: "pnpm install",
        alt: { command: "npm ci", logo: "npm" },
        running: "Installing",
        done: "9 packages · done in 3.8 s",
      }}
    />
    <UnderLoadSection
      id="under-load"
      eyebrow="Under load"
      headline={["Peak traffic.", "Flat latency."]}
      accent={1}
      lede="Every service is load-tested before launch. Here, an API at peak: throughput up, latency well inside its target."
      media={{ image: loadPhoto, alt: "Two engineers watch a load test on a monitor in a dim room.", focus: "50% 40%" }}
      test="Load test · 2,000 virtual users"
      live="Live"
      rps={{ value: 12400, label: "requests per second", max: 15000 }}
      p95={{ value: 48, target: 100, label: "p95 latency", targetLabel: "Target 100 ms", max: 150 }}
      stats={[
        { label: "Error rate", value: "0.02%" },
        { label: "Event-loop lag", value: "4 ms" },
        { label: "Workers", value: "6" },
      ]}
      tools={[
        { slug: "k6", role: "Load" },
        { slug: "grafana", role: "Dashboards" },
        { slug: "prometheus", role: "Metrics" },
        { slug: "pm2", role: "Cluster" },
        { slug: "docker", role: "Containers" },
      ]}
    />
    <FaqSection
      eyebrow="Node.js questions"
      headline={["Async questions,", "sync answers."]}
      accent={1}
      cta="Talk to a Node.js lead"
      faqs={FAQS}
      media={{ image: faqPhoto, alt: "A team gathers around a laptop to review a service together.", focus: "50% 35%" }}
    />
    <CtaSection
      eyebrow="Keep the loop free"
      headline={["Non-blocking,", "by default."]}
      body="Tell us what your Node.js services handle today and where they slow down. We’ll put forward engineers who keep them fast."
      cta="Meet Node.js developers"
    />
  </main>
  <Footer />
</Layout>
