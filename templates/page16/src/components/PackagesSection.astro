---
import { Image } from "astro:assets";
import GridRules from "@/components/GridRules.astro";
import SectionHead from "@/components/SectionHead.astro";
import TechLogo from "@/components/TechLogo.astro";
import Joints from "@/components/process/Joints.astro";
import type { TechLogoSlug } from "@/lib/tech-logos";
import type { SectionPhoto } from "@/types/page";

/* package.json, installing, on the dark tone. A frame on the columns: a
   photo of a developer at a terminal in column 1, and in columns 2–4 an
   editor open on package.json. Every dependency line carries its logo and,
   on the right, the job it does. On arrival the install runs: line by line
   each package's dot fills, its logo lights and its time appears, while a
   rail down the gutter grows from the first package to the one installing
   and the footer counts packages; the rail ends exactly on the last
   package's dot. Every line has one height and a fixed place, so nothing
   moves. Replays on each arrival; without the script, and under reduced
   motion, the finished install shows. See docs/sections.md. */

interface Dep {
  name: string;
  version: string;
  logo: TechLogoSlug;
  role: string;
  time: string;
}

interface Props {
  id: string;
  eyebrow: string;
  headline: string[];
  accent?: number;
  lede: string;
  media: SectionPhoto;
  file: string;
  project: string;
  engine: { name: string; version: string; logo: TechLogoSlug; role: string };
  dependencies: Dep[];
  devDependencies: Dep[];
  manager: { name: string; version: string; logo: TechLogoSlug; role: string };
  run: { command: string; alt: { command: string; logo: TechLogoSlug }; running: string; done: string };
}

const { id, eyebrow, headline, accent, lede, media, file, project, engine, dependencies, devDependencies, manager, run } =
  Astro.props;

/* The file, line by line. Packages carry an index for the install order. */
type Line =
  | { kind: "text"; text: string; indent: number; hideOnPhone?: boolean }
  | { kind: "meta"; key: string; value: string; logo: TechLogoSlug; role: string; indent: number; hideOnPhone?: boolean }
  | { kind: "dep"; dep: Dep; n: number; last: boolean };

const total = dependencies.length + devDependencies.length;
const lines: Line[] = [
  { kind: "text", text: "{", indent: 0 },
  { kind: "text", text: `"name": "${project}",`, indent: 1, hideOnPhone: true },
  { kind: "meta", key: `"engines": { "${engine.name}"`, value: `"${engine.version}" },`, logo: engine.logo, role: engine.role, indent: 1 },
  { kind: "text", text: `"dependencies": {`, indent: 1 },
  ...dependencies.map((dep, i) => ({ kind: "dep" as const, dep, n: i, last: i === total - 1 })),
  { kind: "text", text: "},", indent: 1 },
  { kind: "text", text: `"devDependencies": {`, indent: 1 },
  ...devDependencies.map((dep, i) => ({
    kind: "dep" as const,
    dep,
    n: dependencies.length + i,
    last: dependencies.length + i === total - 1,
  })),
  { kind: "text", text: "},", indent: 1 },
  {
    kind: "meta",
    key: `"packageManager"`,
    value: `"${manager.name}@${manager.version}"`,
    logo: manager.logo,
    role: manager.role,
    indent: 1,
    hideOnPhone: true,
  },
  { kind: "text", text: "}", indent: 0 },
];

/* Where the rail starts and ends, in lines from the top (phones hide some
   lines, so those count separately). */
const at = (pred: (l: Line) => boolean, phone: boolean) => {
  const shown = lines.filter((l) => !(phone && "hideOnPhone" in l && l.hideOnPhone));
  return shown.findIndex(pred);
};
const firstDep = (l: Line) => l.kind === "dep" && l.n === 0;
const lastDep = (l: Line) => l.kind === "dep" && l.last;
const rail = `--ac-r0:${at(firstDep, false)};--ac-r1:${at(lastDep, false)};--ac-r0p:${at(firstDep, true)};--ac-r1p:${at(lastDep, true)}`;
---

<section data-ac-sec="dark" data-ac-pkg id={id}>
  <GridRules />

  <div data-ac-sec-container>
    <SectionHead eyebrow={eyebrow} headline={headline} accent={accent} lede={lede} />

    <div data-ac-sec-frame data-ac-pkg-frame>
      <Joints />

      <div data-ac-pkg-photo>
        <Image
          src={media.image}
          alt={media.alt}
          widths={[400, 700, 1000]}
          sizes="(max-width: 991px) 100vw, 24vw"
          quality={78}
          style={media.focus ? `object-position:${media.focus}` : undefined}
        />
      </div>

      <div data-ac-pkg-editor>
        <p data-ac-pkg-tab>
          <TechLogo slug={engine.logo} size={16} />
          <span>{file}</span>
        </p>

        <div data-ac-pkg-file style={rail}>
          <span data-ac-pkg-rail aria-hidden="true"><i /></span>
          <ol>
            {lines.map((l) => {
              if (l.kind === "text")
                return (
                  <li data-ac-pkg-line data-phone-hide={l.hideOnPhone || undefined} style={`--ac-indent:${l.indent}`}>
                    <code>{l.text}</code>
                  </li>
                );
              if (l.kind === "meta")
                return (
                  <li data-ac-pkg-line data-ac-pkg-meta data-phone-hide={l.hideOnPhone || undefined} style={`--ac-indent:${l.indent}`}>
                    <span data-ac-pkg-logo><TechLogo slug={l.logo} size={16} /></span>
                    <code>
                      <span data-k="key">{l.key}</span>: <span data-k="val">{l.value}</span>
                    </code>
                    <span data-ac-pkg-role class="mono-label-sm">{l.role}</span>
                  </li>
                );
              return (
                <li data-ac-pkg-line data-ac-pkg-dep={l.n} style={`--ac-indent:2;--ac-i:${l.n}`}>
                  <span data-ac-pkg-dot aria-hidden="true" />
                  <span data-ac-pkg-logo><TechLogo slug={l.dep.logo} size={16} /></span>
                  <code>
                    <span data-k="key">"{l.dep.name}"</span>: <span data-k="val">"{l.dep.version}"</span>{l.last ? "" : ","}
                  </code>
                  <span data-ac-pkg-role class="mono-label-sm">{l.dep.role}</span>
                  <span data-ac-pkg-time aria-hidden="true">{l.dep.time}</span>
                </li>
              );
            })}
          </ol>
        </div>

        <p data-ac-pkg-run>
          <span data-ac-pkg-cmd>
            <TechLogo slug={manager.logo} size={16} />
            <code>$ {run.command}</code>
          </span>
          <span data-ac-pkg-progress data-total={total}>
            <span data-ac-pkg-running>{run.running} <b data-ac-pkg-count>{total}</b>/{total}</span>
            <span data-ac-pkg-done>{run.done}</span>
          </span>
          <span data-ac-pkg-alt>
            <TechLogo slug={run.alt.logo} size={16} />
            <code>{run.alt.command}</code>
          </span>
        </p>
      </div>
    </div>
  </div>
</section>

<script>
  document.querySelectorAll<HTMLElement>("[data-ac-pkg]").forEach((section) => {
    const file = section.querySelector<HTMLElement>("[data-ac-pkg-file]")!;
    const deps = Array.from(section.querySelectorAll<HTMLElement>("[data-ac-pkg-dep]"));
    const count = section.querySelector<HTMLElement>("[data-ac-pkg-count]")!;
    const reduced = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
    const STEP = 260;
    let timer = 0;

    /* Installs to package n (−1: none yet). The rail fills to its dot. */
    const set = (n: number) => {
      deps.forEach((d, i) => d.toggleAttribute("data-done", i <= n));
      file.style.setProperty("--ac-p", String(Math.max(0, n) / (deps.length - 1)));
      file.toggleAttribute("data-started", n >= 0);
      section.toggleAttribute("data-installed", n >= deps.length - 1);
      count.textContent = String(n + 1);
    };

    if (reduced) {
      set(deps.length - 1);
      return;
    }

    section.setAttribute("data-ac-armed", "");
    set(-1);

    const runInstall = () => {
      let n = -1;
      window.clearTimeout(timer);
      const next = () => {
        n += 1;
        set(n);
        if (n < deps.length - 1) timer = window.setTimeout(next, STEP);
      };
      timer = window.setTimeout(next, 500);
    };

    new IntersectionObserver(
      ([entry]) => {
        section.toggleAttribute("data-ac-in", entry.isIntersecting);
        if (entry.isIntersecting) runInstall();
        else {
          window.clearTimeout(timer);
          set(-1);
        }
      },
      { threshold: 0, rootMargin: "-10% 0px -10% 0px" },
    ).observe(section);
  });
</script>
