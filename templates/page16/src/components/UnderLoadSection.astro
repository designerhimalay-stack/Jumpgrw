---
import { Image } from "astro:assets";
import GridRules from "@/components/GridRules.astro";
import SectionHead from "@/components/SectionHead.astro";
import TechLogo from "@/components/TechLogo.astro";
import Joints from "@/components/process/Joints.astro";
import type { TechLogoSlug } from "@/lib/tech-logos";
import type { SectionPhoto } from "@/types/page";

/* Under load. A frame on the columns: a photo of engineers watching a load
   test in columns 1–2, and the test's readout in columns 3–4: requests per
   second as one large figure that counts up as the section arrives, a
   sparkline of the ramp and the plateau that keeps drawing live while the
   section is on screen, the p95 latency against its target, three Node.js
   health figures, and the tools behind the test along the foot. The figure,
   the line and the chip change in place (fixed widths, one SVG), so nothing
   moves; the live part stops off screen. Without the script, and under
   reduced motion, the plateau shows still. See docs/sections.md. */

interface Props {
  id: string;
  eyebrow: string;
  headline: string[];
  accent?: number;
  lede: string;
  media: SectionPhoto;
  test: string;
  live: string;
  rps: { value: number; label: string; max: number };
  p95: { value: number; target: number; label: string; targetLabel: string; max: number };
  stats: { label: string; value: string }[];
  tools: { slug: TechLogoSlug; role: string }[];
}

const { id, eyebrow, headline, accent, lede, media, test, live, rps, p95, stats, tools } = Astro.props;

/* The starting series: a ramp, then a plateau with a little jitter, from a
   fixed seed so the server and the script start from the same line. */
const N = 40;
const RAMP = 12;
let seed = 7;
const rand = () => {
  seed = (seed * 9301 + 49297) % 233280;
  return seed / 233280;
};
const series = Array.from({ length: N }, (_, i) =>
  i < RAMP ? (rps.value * (i / RAMP)) * (0.96 + rand() * 0.08) : rps.value * (0.97 + rand() * 0.06),
);
const W = 600;
const H = 160;
const pt = (v: number, i: number) => `${((i / (N - 1)) * W).toFixed(1)},${(H - (v / rps.max) * H).toFixed(1)}`;
const line = `M${series.map(pt).join(" L")}`;
const area = `${line} L${W},${H} L0,${H} Z`;
const fmt = (n: number) => Math.round(n).toLocaleString("en-US");
---

<section data-ac-sec="light" data-ac-load id={id}>
  <GridRules />

  <div data-ac-sec-container>
    <SectionHead eyebrow={eyebrow} headline={headline} accent={accent} lede={lede} />

    <div data-ac-sec-frame data-ac-load-frame>
      <Joints />

      <div data-ac-load-photo>
        <Image
          src={media.image}
          alt={media.alt}
          widths={[600, 1000, 1400]}
          sizes="(max-width: 991px) 100vw, 46vw"
          quality={78}
          style={media.focus ? `object-position:${media.focus}` : undefined}
        />
      </div>

      <div
        data-ac-load-panel
        data-series={JSON.stringify(series.map(Math.round))}
        data-max={rps.max}
        data-target={rps.value}
        data-p95={p95.value}
      >
        <p data-ac-load-top class="mono-label-sm">
          <span>{test}</span>
          <span data-ac-load-live><i aria-hidden="true" />{live}</span>
        </p>

        <p data-ac-load-figure>
          <b data-ac-load-rps>{fmt(rps.value)}</b>
          <span>{rps.label}</span>
        </p>

        <svg data-ac-load-spark viewBox={`0 0 ${W} ${H}`} preserveAspectRatio="none" aria-hidden="true">
          <line x1="0" x2={W} y1={H - (rps.value / rps.max) * H} y2={H - (rps.value / rps.max) * H} data-ac-load-guide />
          <path d={area} data-ac-load-area />
          <path d={line} data-ac-load-line />
        </svg>

        <div data-ac-load-p95 style={`--ac-v:${(p95.value / p95.max) * 100}%;--ac-t:${(p95.target / p95.max) * 100}%`}>
          <p>
            <span class="mono-label-sm">{p95.label}</span>
            <b><span data-ac-load-p95-num>{p95.value}</span> ms</b>
          </p>
          <span data-ac-load-bar aria-hidden="true">
            <i data-ac-load-fill />
            <i data-ac-load-target><span class="mono-label-sm">{p95.targetLabel}</span></i>
          </span>
        </div>

        <dl data-ac-load-stats>
          {stats.map((s) => (
            <div>
              <dt class="mono-label-sm">{s.label}</dt>
              <dd>{s.value}</dd>
            </div>
          ))}
        </dl>

        <ul data-ac-load-tools>
          {tools.map((t) => (
            <li>
              <span data-ac-load-tile><TechLogo slug={t.slug} size={18} label /></span>
              <span class="mono-label-sm">{t.role}</span>
            </li>
          ))}
        </ul>
      </div>
    </div>
  </div>
</section>

<script>
  document.querySelectorAll<HTMLElement>("[data-ac-load]").forEach((section) => {
    const panel = section.querySelector<HTMLElement>("[data-ac-load-panel]")!;
    const num = section.querySelector<HTMLElement>("[data-ac-load-rps]")!;
    const p95 = section.querySelector<HTMLElement>("[data-ac-load-p95-num]")!;
    const lineEl = section.querySelector<SVGPathElement>("[data-ac-load-line]")!;
    const areaEl = section.querySelector<SVGPathElement>("[data-ac-load-area]")!;
    const reduced = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
    if (reduced) return;

    const series = JSON.parse(panel.dataset.series ?? "[]") as number[];
    const start = series.slice();
    const max = Number(panel.dataset.max);
    const target = Number(panel.dataset.target);
    const base95 = Number(panel.dataset.p95);
    const W = 600;
    const H = 160;
    const fmt = (n: number) => Math.round(n).toLocaleString("en-US");

    const draw = () => {
      const pts = series.map((v, i) => `${((i / (series.length - 1)) * W).toFixed(1)},${(H - (v / max) * H).toFixed(1)}`);
      const d = `M${pts.join(" L")}`;
      lineEl.setAttribute("d", d);
      areaEl.setAttribute("d", `${d} L${W},${H} L0,${H} Z`);
    };

    let raf = 0;
    let live = 0;

    /* The figure counts up with the line drawing in, then both go live. */
    const arrive = () => {
      cancelAnimationFrame(raf);
      window.clearInterval(live);
      series.splice(0, series.length, ...start);
      draw();
      const t0 = performance.now() + 300;
      const DUR = 1600;
      const step = (now: number) => {
        const t = Math.min(1, Math.max(0, (now - t0) / DUR));
        num.textContent = fmt(target * (1 - Math.pow(1 - t, 3)));
        if (t < 1) raf = requestAnimationFrame(step);
      };
      raf = requestAnimationFrame(step);
      live = window.setInterval(() => {
        const v = target * (0.97 + Math.random() * 0.06);
        series.push(v);
        series.shift();
        draw();
        num.textContent = fmt(v);
        p95.textContent = String(Math.round(base95 * (0.92 + Math.random() * 0.16)));
      }, 1000);
    };

    section.setAttribute("data-ac-armed", "");

    new IntersectionObserver(
      ([entry]) => {
        section.toggleAttribute("data-ac-in", entry.isIntersecting);
        if (entry.isIntersecting) arrive();
        else {
          cancelAnimationFrame(raf);
          window.clearInterval(live);
          num.textContent = "0";
          p95.textContent = String(base95);
        }
      },
      { threshold: 0, rootMargin: "-10% 0px -10% 0px" },
    ).observe(section);
  });
</script>
