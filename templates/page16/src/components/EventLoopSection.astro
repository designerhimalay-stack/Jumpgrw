---
import GridRules from "@/components/GridRules.astro";
import SectionHead from "@/components/SectionHead.astro";
import Joints from "@/components/process/Joints.astro";

/* The event loop, run step by step. A frame on the columns: along the top,
   four lines of source (columns 1–2) and the console they print to
   (columns 3–4); under them the runtime, one lane per column: the call
   stack, the microtask queue, the timer queue and the loop's own rule
   (run the script, drain microtasks, take the next callback). While the
   section is on screen a script steps through the program: the running
   line lights, frames push onto the stack and pop off, callbacks wait in
   their queues and move to the stack when the loop takes them, and the
   console fills A, B, C, D, with a one-line note for each step. It pauses
   off screen and loops. Every piece has a fixed place (stack slots, queue
   cells, console lines), so nothing moves the page. Without the script, and
   under reduced motion, one telling step shows as a still, labelled
   diagram. See docs/sections.md. */

interface Step {
  line?: number;
  stack: string[];
  micro: string[];
  timers: string[];
  out: number;
  phase: 0 | 1 | 2;
  note: string;
}

interface Props {
  id: string;
  eyebrow: string;
  headline: string[];
  accent?: number;
  lede: string;
  labels: { source: string; console: string; stack: string; micro: string; timers: string; loop: string };
  source: string[];
  output: string[];
  /** Stack frames and queued callbacks, by key. */
  frames: Record<string, string>;
  phases: [string, string, string];
  steps: Step[];
  /** The step shown without the script and under reduced motion. */
  still: number;
}

const { id, eyebrow, headline, accent, lede, labels, source, output, frames, phases, steps, still } = Astro.props;

/* A light colouring for the source, as tokens (no HTML strings). */
const tokens = (line: string) =>
  line
    .split(/("[^"]*"|\b(?:setTimeout|queueMicrotask|console)\b|=>|\d+)/)
    .filter(Boolean)
    .map((t) => ({
      t,
      k: t.startsWith('"') ? "str" : /^\d+$/.test(t) ? "num" : t === "=>" ? "op" : /^[A-Za-z]/.test(t) && /^(setTimeout|queueMicrotask|console)$/.test(t) ? "fn" : undefined,
    }));

const s0 = steps[still];
const keys = Object.keys(frames);
const json = JSON.stringify(steps);
---

<section data-ac-sec="light" data-ac-loop id={id}>
  <GridRules />

  <div data-ac-sec-container>
    <SectionHead eyebrow={eyebrow} headline={headline} accent={accent} lede={lede} />

    <div data-ac-sec-frame data-ac-loop-frame data-steps={json} data-still={still}>
      <Joints />

      <div data-ac-loop-source>
        <p data-ac-loop-cap class="mono-label-sm"><b>01</b>{labels.source}</p>
        <ol>
          {source.map((line, i) => (
            <li data-ac-loop-line={i} data-on={s0.line === i || undefined}>
              <span data-ac-loop-ln aria-hidden="true">{i + 1}</span>
              <code>{tokens(line).map((p) => (p.k ? <span data-k={p.k}>{p.t}</span> : p.t))}</code>
            </li>
          ))}
        </ol>
      </div>

      <div data-ac-loop-console>
        <p data-ac-loop-cap class="mono-label-sm"><b>02</b>{labels.console}</p>
        <ol aria-label={labels.console}>
          {output.map((o, i) => (
            <li data-ac-loop-out={i} data-on={i < s0.out || undefined}>
              <span aria-hidden="true">&gt;</span>
              {o}
            </li>
          ))}
        </ol>
      </div>

      <div data-ac-loop-lane="stack">
        <p data-ac-loop-cap class="mono-label-sm"><b>03</b>{labels.stack}</p>
        <div data-ac-loop-stack>
          {keys.map((k) => {
            const slot = s0.stack.indexOf(k);
            return (
              <span data-ac-loop-frame-item={k} data-slot={slot >= 0 ? slot : undefined}>
                {frames[k]}
              </span>
            );
          })}
        </div>
      </div>

      <div data-ac-loop-lane="micro">
        <p data-ac-loop-cap class="mono-label-sm"><b>04</b>{labels.micro}</p>
        <div data-ac-loop-queue>
          {keys.filter((k) => steps.some((s) => s.micro.includes(k))).map((k) => (
            <span data-ac-loop-chip={k} data-on={s0.micro.includes(k) || undefined}>{frames[k]}</span>
          ))}
        </div>
      </div>

      <div data-ac-loop-lane="timers">
        <p data-ac-loop-cap class="mono-label-sm"><b>05</b>{labels.timers}</p>
        <div data-ac-loop-queue>
          {keys.filter((k) => steps.some((s) => s.timers.includes(k))).map((k) => (
            <span data-ac-loop-chip={k} data-on={s0.timers.includes(k) || undefined}>{frames[k]}</span>
          ))}
        </div>
      </div>

      <div data-ac-loop-lane="loop">
        <p data-ac-loop-cap class="mono-label-sm"><b>06</b>{labels.loop}</p>
        <ol data-ac-loop-phases>
          {phases.map((p, i) => (
            <li data-ac-loop-phase={i} data-on={s0.phase === i || undefined}>
              <i aria-hidden="true">{i + 1}</i>
              {p}
            </li>
          ))}
        </ol>
        <div data-ac-loop-notes>
          {steps.map((s, i) => (
            <p data-ac-loop-note={i} data-on={i === still || undefined}>{s.note}</p>
          ))}
        </div>
      </div>
    </div>
  </div>
</section>

<script>
  interface Step {
    line?: number;
    stack: string[];
    micro: string[];
    timers: string[];
    out: number;
    phase: number;
  }

  document.querySelectorAll<HTMLElement>("[data-ac-loop]").forEach((section) => {
    const frame = section.querySelector<HTMLElement>("[data-ac-loop-frame]")!;
    const steps = JSON.parse(frame.dataset.steps ?? "[]") as Step[];
    const still = Number(frame.dataset.still ?? 0);
    const all = (sel: string) => Array.from(section.querySelectorAll<HTMLElement>(sel));
    const lines = all("[data-ac-loop-line]");
    const outs = all("[data-ac-loop-out]");
    const items = all("[data-ac-loop-frame-item]");
    const micro = all("[data-ac-loop-lane='micro'] [data-ac-loop-chip]");
    const timers = all("[data-ac-loop-lane='timers'] [data-ac-loop-chip]");
    const phases = all("[data-ac-loop-phase]");
    const notes = all("[data-ac-loop-note]");
    const reduced = window.matchMedia("(prefers-reduced-motion: reduce)");

    const on = (el: HTMLElement, v: boolean) => el.toggleAttribute("data-on", v);

    const apply = (n: number) => {
      const s = steps[n];
      lines.forEach((el, i) => on(el, s.line === i));
      outs.forEach((el, i) => on(el, i < s.out));
      items.forEach((el) => {
        const slot = s.stack.indexOf(el.dataset.acLoopFrameItem ?? "");
        if (slot >= 0) el.dataset.slot = String(slot);
        else delete el.dataset.slot;
      });
      micro.forEach((el) => on(el, s.micro.includes(el.dataset.acLoopChip ?? "")));
      timers.forEach((el) => on(el, s.timers.includes(el.dataset.acLoopChip ?? "")));
      phases.forEach((el, i) => on(el, s.phase === i));
      notes.forEach((el, i) => on(el, i === n));
    };

    /* Steps on a timer while on screen; the last step holds a little
       longer before the program runs again. */
    let n = 0;
    let timer = 0;
    let visible = false;
    const tick = () => {
      apply(n);
      const hold = n === steps.length - 1 ? 2600 : 1300;
      n = (n + 1) % steps.length;
      timer = window.setTimeout(tick, hold);
    };
    const start = () => {
      window.clearTimeout(timer);
      if (!visible || reduced.matches) {
        apply(still);
        return;
      }
      n = 0;
      tick();
    };

    new IntersectionObserver(
      ([entry]) => {
        section.toggleAttribute("data-ac-in", entry.isIntersecting);
        visible = entry.isIntersecting;
        if (visible) start();
        else window.clearTimeout(timer);
      },
      { threshold: 0, rootMargin: "-10% 0px -10% 0px" },
    ).observe(section);
    reduced.addEventListener("change", start);
  });
</script>
