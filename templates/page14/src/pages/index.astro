---
import Layout from "@/layouts/Layout.astro";
import CtaSection from "@/components/CtaSection.astro";
import FaqSection from "@/components/FaqSection.astro";
import Footer from "@/components/Footer.astro";
import MonorepoSection from "@/components/MonorepoSection.astro";
import Navbar from "@/components/Navbar.astro";
import PageHero from "@/components/PageHero.astro";
import SignalsSection from "@/components/SignalsSection.astro";
import SmoothScroll from "@/components/SmoothScroll.astro";
import StaircaseSection from "@/components/StaircaseSection.astro";
import ToolchainSection from "@/components/ToolchainSection.astro";
import type { PageHeroContent } from "@/types/page";
import heroPhoto from "@/assets/pages/p14-hero.jpg";
import teamPhoto from "@/assets/pages/p14-team.jpg";
import reviewPhoto from "@/assets/pages/p14-review.jpg";
import faqPhoto from "@/assets/pages/p14-faq.jpg";
import { BRAND } from "@/lib/brand";

/* Angular developers. The signals graph, the workspace and the prices in
   it are illustrative; the version notes are summaries of each release's
   headline changes. The FAQ answers are drafts. Have them checked before
   launch. See docs/sections.md. */

const HERO: PageHeroContent = {
  trail: ["Technologies", "Frontend", "Angular"],
  headline: ["Angular", "developers."],
  lede: "Enterprise Angular engineers who modernise large apps without a rewrite: signals, standalone components and monorepos that scale with your teams.",
  ctas: [
    { label: "Hire Angular developers", href: "#contact", arrow: "diagonal" },
    { label: "See signals at work", href: "#signals", arrow: "right" },
  ],
  image: heroPhoto,
  imageAlt: "An engineer with headphones works at a pair of monitors in a busy open-plan office.",
  specs: [
    { label: "Versions", value: "AngularJS to latest" },
    { label: "State", value: "Signals and NgRx" },
    { label: "Workspaces", value: "Nx monorepos" },
    { label: "Teams", value: "Enterprise scale" },
  ],
};

const FAQS = [
  {
    q: "Can you upgrade us without a rewrite?",
    a: "Usually, yes. We move one major version at a time, run old and new side by side where needed, and keep releasing throughout.",
  },
  {
    q: "We still run AngularJS. Where do we start?",
    a: "With a hybrid app: the new framework boots alongside the old, and screens move across one route at a time.",
  },
  {
    q: "Signals or NgRx?",
    a: "Signals for local and derived state; NgRx where many features share state and you want its tooling. Many apps use both.",
  },
  {
    q: "Do you work in our monorepo?",
    a: "Yes. We follow your module boundaries and CI, and use affected builds so each change tests only what it touches.",
  },
];
---

<Layout
  title={`Angular developers · ${BRAND.name}`}
  description="Enterprise Angular engineers who modernise large apps without a rewrite: signals, standalone components and monorepos that scale."
  navTone="field"
>
  <SmoothScroll />
  <Navbar />
  <main>
    <PageHero content={HERO} />
    <SignalsSection
      id="signals"
      eyebrow="Signals"
      headline={["Change one value.", "Only its readers move."]}
      accent={1}
      lede="Move the slider. Angular’s signals recompute what depends on seats, and nothing else, so large screens stay fast."
      nodes={[
        { key: "seats", kind: "signal", name: "seats", layer: 0, reads: [] },
        { key: "currency", kind: "signal", name: "currency", layer: 0, reads: [] },
        { key: "subtotal", kind: "computed", name: "subtotal", expr: "seats × 49", layer: 1, reads: ["seats"] },
        { key: "discount", kind: "computed", name: "discount", expr: "seats ≥ 20 ? 10%", layer: 1, reads: ["seats"] },
        { key: "label", kind: "computed", name: "label", expr: "“in ” + currency", layer: 1, reads: ["currency"] },
        { key: "total", kind: "computed", name: "total", expr: "sub × (1 − disc)", layer: 2, reads: ["subtotal", "discount"] },
        { key: "perSeat", kind: "computed", name: "perSeat", expr: "total ÷ seats", layer: 2, reads: ["total", "seats"] },
        { key: "view", kind: "effect", name: "template", expr: "{{ total }}", layer: 3, reads: ["total", "perSeat", "label"] },
      ]}
      seats={{ start: 12, min: 1, max: 40, price: 49, bulkFrom: 20, bulkOff: 0.1 }}
      currency="USD"
      labels={{ updated: "Recomputed", untouched: "Untouched", view: "Updated" }}
    />
    <StaircaseSection
      id="upgrades"
      eyebrow="Upgrades"
      headline={["One step", "at a time."]}
      lede="We climb one major version at a time, with the app shipping between steps. No big-bang rewrite, no frozen roadmap."
      media={{ image: teamPhoto, alt: "An engineering team reviews a plan together around a meeting table with laptops.", focus: "50% 40%" }}
      steps={[
        { version: "AngularJS", year: "1.x", note: "Hybrid boot with ngUpgrade; screens move route by route." },
        { version: "Angular 8", year: "2019", note: "Lazy routes via import(); Ivy tried behind a flag." },
        { version: "Angular 14", year: "2022", note: "Typed forms; first standalone components." },
        { version: "Angular 17", year: "2023", note: "Built-in control flow, deferred views, esbuild." },
        { version: "Latest", year: "Now", note: "Signals throughout; zoneless change detection." },
      ]}
    />
    <MonorepoSection
      id="workspace"
      eyebrow="Monorepos"
      headline={["Pick a library.", "See its reach."]}
      accent={1}
      lede="Clear boundaries keep large workspaces sane. Pick any library to see which projects a change would reach."
      media={{ image: reviewPhoto, alt: "A developer talks a colleague through a design on her monitor as the team works around them.", focus: "50% 45%" }}
      command="nx affected -t test --base="
      labels={{ projects: "projects affected", apps: "apps to retest", pick: "Pick a library to see its blast radius." }}
      start="shared-ui"
      domains={[
        {
          name: "Storefront",
          projects: [
            { key: "shop", name: "shop", kind: "app", deps: ["shop-cart", "shop-catalog", "shared-auth"] },
            { key: "shop-cart", name: "cart", kind: "lib", deps: ["shop-data", "shared-ui"] },
            { key: "shop-catalog", name: "catalog", kind: "lib", deps: ["shop-data", "shared-ui"] },
            { key: "shop-data", name: "shop-data", kind: "lib", deps: ["shared-http"] },
          ],
        },
        {
          name: "Back office",
          projects: [
            { key: "admin", name: "admin", kind: "app", deps: ["admin-orders", "admin-reports", "shared-auth"] },
            { key: "admin-orders", name: "orders", kind: "lib", deps: ["admin-data", "shared-ui"] },
            { key: "admin-reports", name: "reports", kind: "lib", deps: ["admin-data", "shared-ui"] },
            { key: "admin-data", name: "admin-data", kind: "lib", deps: ["shared-http"] },
          ],
        },
        {
          name: "Shared",
          projects: [
            { key: "shared-ui", name: "ui", kind: "lib", deps: [] },
            { key: "shared-auth", name: "auth", kind: "lib", deps: ["shared-http"] },
            { key: "shared-http", name: "http", kind: "lib", deps: [] },
            { key: "shared-format", name: "format", kind: "lib", deps: [] },
          ],
        },
      ]}
    />
    <ToolchainSection
      id="toolchain"
      eyebrow="Toolchain"
      headline={["The elements", "of a good build."]}
      lede="The tools our Angular developers reach for, grouped by the job they do."
      families={["Core", "Reactive", "UI", "Tooling", "Testing"]}
      elements={[
        { slug: "angular", symbol: "Ng", role: "Framework", family: 0 },
        { slug: "typescript", symbol: "Ts", role: "Types", family: 0 },
        { slug: "nx", symbol: "Nx", role: "Monorepo", family: 3 },
        { slug: "reactivex", symbol: "Rx", role: "Streams", family: 1, name: "RxJS" },
        { slug: "ngrx", symbol: "Nr", role: "Store", family: 1 },
        { slug: "materialdesign", symbol: "Md", role: "Components", family: 2, name: "Material" },
        { slug: "ionic", symbol: "Io", role: "Mobile", family: 2 },
        { slug: "esbuild", symbol: "Eb", role: "Bundler", family: 3 },
        { slug: "eslint", symbol: "Es", role: "Linting", family: 3 },
        { slug: "jasmine", symbol: "Ja", role: "Unit", family: 4 },
        { slug: "jest", symbol: "Je", role: "Unit", family: 4 },
        { slug: "cypress", symbol: "Cy", role: "End to end", family: 4 },
        { slug: "storybook", symbol: "Sb", role: "Workshop", family: 2 },
      ]}
    />
    <FaqSection
      eyebrow="Angular questions"
      headline={["Asked, and", "answered."]}
      accent={1}
      cta="Talk to an Angular lead"
      faqs={FAQS}
      media={{ image: faqPhoto, alt: "An engineer sketches an architecture on a whiteboard for a colleague.", focus: "60% 40%" }}
    />
    <CtaSection
      eyebrow="Next version"
      headline={["Your next upgrade,", "without the drama."]}
      body="Tell us your Angular version and your roadmap. We’ll plan the climb and staff it."
      cta="Plan my upgrade"
    />
  </main>
  <Footer />
</Layout>
