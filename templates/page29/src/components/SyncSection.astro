---
import GridRules from "@/components/GridRules.astro";
import SectionHead from "@/components/SectionHead.astro";
import Joints from "@/components/process/Joints.astro";

/* Script and browser in sync, on the light tone. One frame: columns 1–2 an
   editor with an automated checkout test, columns 3–4 a browser running it.
   While the frame is on screen the test plays step by step: each step's
   line lights up in the editor, a cursor glides to its target in the
   browser and acts (a click, a field typing itself), the line ticks green,
   and the last line's assertion lands on the confirmation screen. Then the
   run's summary shows, it holds, and it starts again. Cursor positions are
   measured from the targets, so they work at any size. The browser's three
   screens share one grid cell, so nothing moves. Without the script, or
   under reduced motion, the finished run shows. See docs/sections.md. */

interface Line {
  code: string;
  /** The browser step this line drives, from 0. */
  step?: number;
}

interface Props {
  id: string;
  eyebrow: string;
  headline: string[];
  accent?: number;
  lede: string;
  file: string;
  lines: Line[];
  summary: { passed: string; time: string };
  browser: {
    url: string;
    shop: string;
    cart: string;
    checkout: string;
    product: { name: string; note: string; price: string; add: string };
    form: { title: string; email: string; emailValue: string; card: string; cardValue: string; pay: string };
    done: { title: string; note: string };
  };
}

const { id, eyebrow, headline, accent = headline.length - 1, lede, file, lines, summary, browser } = Astro.props;

/* A light highlighter: strings, then keywords, then everything else. */
const KEYWORDS = new Set(["await", "async", "test", "expect", "const"]);
const tokens = (code: string) =>
  code.split(/("[^"]*")/).flatMap((part) =>
    part.startsWith('"')
      ? [{ t: "str", v: part }]
      : part.split(/(\b[a-zA-Z]+\b)/).map((v) => ({ t: KEYWORDS.has(v) ? "kw" : /^(page|getByRole|click|fill|goto|getByLabel|getByText|toBeVisible)$/.test(v) ? "fn" : "", v })),
  );
const steps = lines.filter((l) => l.step !== undefined).length;
---

<section data-ac-sec="light" data-ac-sync id={id} data-step={steps} data-done>
  <GridRules />

  <div data-ac-sec-container>
    <SectionHead eyebrow={eyebrow} headline={headline} accent={accent} lede={lede} />

    <div data-ac-sec-frame data-ac-sync-frame>
      <Joints />

      <figure data-ac-sync-editor aria-label={`${file}: the test`}>
        <figcaption data-ac-sync-tab>
          <span data-ac-sync-dots aria-hidden="true"><i /><i /><i /></span>
          <span class="mono-label-sm">{file}</span>
        </figcaption>
        <ol data-ac-sync-code>
          {lines.map((line, i) => (
            <li data-ac-sync-line={line.step} data-state={line.step !== undefined ? "pass" : undefined}>
              <span data-ac-sync-gutter aria-hidden="true">
                <span data-ac-sync-num>{i + 1}</span>
                <i data-ac-sync-mark />
              </span>
              <code>
                {tokens(line.code).map((tk) => (tk.t ? <span data-tk={tk.t}>{tk.v}</span> : tk.v))}
              </code>
            </li>
          ))}
        </ol>
        <p data-ac-sync-summary>
          <span data-ac-sync-pass>✓ {summary.passed}</span>
          <span class="mono-label-sm">{summary.time}</span>
        </p>
      </figure>

      <div data-ac-sync-browser data-screen="done" data-carted aria-hidden="true">
        <div data-ac-sync-chrome>
          <span data-ac-sync-dots><i /><i /><i /></span>
          <span data-ac-sync-url>{browser.url}</span>
        </div>
        <div data-ac-sync-view>
          <header data-ac-sync-shop>
            <b>{browser.shop}</b>
            <span>{browser.cart} <i data-ac-sync-badge>1</i></span>
            <span data-ac-sync-target="2">{browser.checkout}</span>
          </header>

          <div data-ac-sync-screens>
            <div data-ac-sync-screen="product">
              <div data-ac-sync-art><i /></div>
              <div data-ac-sync-info>
                <b>{browser.product.name}</b>
                <span>{browser.product.note}</span>
                <span data-ac-sync-price>{browser.product.price}</span>
                <span data-ac-sync-btn data-ac-sync-target="1">{browser.product.add}</span>
              </div>
            </div>

            <div data-ac-sync-screen="form">
              <b>{browser.form.title}</b>
              <span data-ac-sync-field data-ac-sync-target="3" data-filled>
                <small>{browser.form.email}</small>
                <span data-ac-sync-type style={`--ac-len:${browser.form.emailValue.length}`}>{browser.form.emailValue}</span>
              </span>
              <span data-ac-sync-field data-ac-sync-target="4" data-filled>
                <small>{browser.form.card}</small>
                <span data-ac-sync-type style={`--ac-len:${browser.form.cardValue.length}`}>{browser.form.cardValue}</span>
              </span>
              <span data-ac-sync-btn data-ac-sync-target="5">{browser.form.pay}</span>
            </div>

            <div data-ac-sync-screen="done">
              <i data-ac-sync-check>
                <svg viewBox="0 0 24 24" width="28" height="28"><path d="m5 12.5 4.5 4.5L19 7.5" fill="none" stroke="currentColor" stroke-width="2.4" /></svg>
              </i>
              <b>{browser.done.title}</b>
              <span>{browser.done.note}</span>
            </div>
          </div>

          <span data-ac-sync-cursor>
            <svg viewBox="0 0 20 20" width="20" height="20"><path d="M3 2v14.5l4.1-3.9 2.6 5.9 2.6-1.1-2.6-5.8H15L3 2Z" fill="#0a1022" stroke="#ffffff" stroke-width="1.3" stroke-linejoin="round" /></svg>
          </span>
        </div>
      </div>
    </div>
  </div>
</section>

<script>
  import { toggleInView } from "@/lib/in-view";

  const reduced = window.matchMedia("(prefers-reduced-motion: reduce)").matches;

  document.querySelectorAll<HTMLElement>("[data-ac-sync]").forEach((section) => {
    toggleInView(section);
    if (reduced) return;

    const frame = section.querySelector<HTMLElement>("[data-ac-sync-frame]")!;
    const browser = section.querySelector<HTMLElement>("[data-ac-sync-browser]")!;
    const view = section.querySelector<HTMLElement>("[data-ac-sync-view]")!;
    const cursor = section.querySelector<HTMLElement>("[data-ac-sync-cursor]")!;
    const lines = Array.from(section.querySelectorAll<HTMLElement>("[data-ac-sync-line]"));
    const steps = lines.length;
    let timer = 0;
    let visible = false;

    /* Which screen each step shows, and what it does. */
    const SCREEN = ["product", "product", "form", "form", "form", "form", "done"];
    const TYPES = new Set([3, 4]);

    const moveTo = (step: number) => {
      const target = view.querySelector<HTMLElement>(`[data-ac-sync-target="${step}"]`);
      if (!target) return;
      const v = view.getBoundingClientRect();
      const t = target.getBoundingClientRect();
      const x = t.left - v.left + Math.min(t.width * 0.5, 60);
      const y = t.top - v.top + t.height * 0.55;
      cursor.style.setProperty("--cx", `${x.toFixed(1)}px`);
      cursor.style.setProperty("--cy", `${y.toFixed(1)}px`);
    };

    const reset = () => {
      section.dataset.step = "-1";
      section.removeAttribute("data-done");
      browser.dataset.screen = "product";
      lines.forEach((l) => l.removeAttribute("data-state"));
      browser.querySelectorAll("[data-filled]").forEach((el) => el.removeAttribute("data-filled"));
      browser.removeAttribute("data-carted");
      cursor.style.setProperty("--cx", "70%");
      cursor.style.setProperty("--cy", "88%");
    };

    const play = (step: number) => {
      if (!visible) return;
      if (step >= steps) {
        section.setAttribute("data-done", "");
        timer = window.setTimeout(() => {
          reset();
          timer = window.setTimeout(() => play(0), 700);
        }, 2600);
        return;
      }
      section.dataset.step = String(step);
      lines.forEach((l, i) => {
        if (i < step) l.dataset.state = "pass";
        else if (i === step) l.dataset.state = "run";
        else l.removeAttribute("data-state");
      });
      moveTo(step);
      /* The action lands once the cursor arrives. */
      timer = window.setTimeout(() => {
        browser.dataset.screen = SCREEN[step];
        if (step === 1) browser.setAttribute("data-carted", "");
        if (TYPES.has(step)) view.querySelector(`[data-ac-sync-target="${step}"]`)?.setAttribute("data-filled", "");
        if (step === 6) browser.dataset.screen = "done";
        timer = window.setTimeout(() => {
          lines[step].dataset.state = "pass";
          timer = window.setTimeout(() => play(step + 1), 260);
        }, TYPES.has(step) ? 900 : 420);
      }, step === 0 ? 300 : 650);
    };

    new IntersectionObserver(
      ([entry]) => {
        visible = entry.isIntersecting;
        clearTimeout(timer);
        if (visible) {
          reset();
          timer = window.setTimeout(() => play(0), 500);
        }
      },
      { threshold: 0.3 },
    ).observe(frame);
  });
</script>
