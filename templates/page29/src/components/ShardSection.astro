---
import GridRules from "@/components/GridRules.astro";
import SectionHead from "@/components/SectionHead.astro";
import Joints from "@/components/process/Joints.astro";
import type { SectionPhoto } from "@/types/page";

/* Shard it, on the dark tone. The header splits around a photo of engineers
   reading a pipeline. Under it, one frame on a minute scale: the suite as a
   single bar on one runner, its eight chunks end to end. As the section
   arrives a run sweeps along that bar and its timer counts to the full time;
   then the eight chunks drop out of the bar into eight parallel lanes, all
   starting at zero, and the second timer stops when the longest lane is
   done, where a marker lands. The bar keeps a dashed outline of the old
   run for comparison. It runs back when the section leaves. Chunks move by
   transform in container units on a track of fixed height, so nothing
   moves. Without the script, or under reduced motion, the split run shows.
   See docs/sections.md. */

interface Props {
  id: string;
  eyebrow: string;
  headline: string[];
  accent?: number;
  lede: string;
  media: SectionPhoto;
  /** Minutes per chunk; their sum is the single runner's time. */
  chunks: number[];
  before: { label: string; note: string };
  after: { label: string; note: string };
  doneLabel: string;
  unit: string;
  stats: { value: string; label: string }[];
}

const { id, eyebrow, headline, accent = headline.length - 1, lede, media, chunks, before, after, doneLabel, unit, stats } = Astro.props;

const total = chunks.reduce((a, b) => a + b, 0);
const longest = Math.max(...chunks);
const clock = (min: number) => `${Math.floor(min)}:${String(Math.round((min % 1) * 60)).padStart(2, "0")}`;
let cum = 0;
const placed = chunks.map((d, i) => {
  const at = cum;
  cum += d;
  return { d, at, i };
});
const ticks = Array.from({ length: Math.floor(total / 10) + 1 }, (_, i) => i * 10);
---

<section data-ac-sec="dark" data-ac-shard id={id} style={`--ac-total:${total};--ac-n:${chunks.length}`}>
  <GridRules />

  <div data-ac-sec-container>
    <SectionHead eyebrow={eyebrow} headline={headline} accent={accent} lede={lede} media={media} />

    <div data-ac-sec-frame data-ac-shard-frame>
      <Joints />

      <div data-ac-shard-legend>
        <div data-ac-shard-clock="before">
          <span class="mono-label-sm">{before.label}</span>
          <b data-ac-shard-time data-value={total}>{clock(total)}</b>
          <span>{before.note}</span>
        </div>
        <div data-ac-shard-clock="after">
          <span class="mono-label-sm">{after.label}</span>
          <b data-ac-shard-time data-value={longest}>{clock(longest)}</b>
          <span>{after.note}</span>
        </div>
      </div>

      <figure
        data-ac-shard-track
        role="img"
        aria-label={`${before.label}: ${clock(total)}. ${after.label}: ${clock(longest)}, the longest of ${chunks.length} lanes.`}
      >
        <div data-ac-shard-ghost>
          {placed.slice(1).map((c) => (
            <i style={`--at:${c.at}`} />
          ))}
          <span data-ac-shard-sweep />
        </div>
        {placed.map((c) => (
          <span data-ac-shard-chunk style={`--d:${c.d};--at:${c.at};--i:${c.i}`}>
            <span>{c.i + 1}</span>
          </span>
        ))}
        <span data-ac-shard-done style={`--at:${longest}`}>
          <span class="mono-label-sm">{doneLabel}</span>
        </span>
        <div data-ac-shard-axis aria-hidden="true">
          {ticks.map((t) => (
            <span style={`--at:${t}`}>{t}{t === ticks[ticks.length - 1] ? ` ${unit}` : ""}</span>
          ))}
        </div>
      </figure>

      <dl data-ac-shard-stats>
        {stats.map((s) => (
          <div>
            <dt class="mono-label-sm">{s.label}</dt>
            <dd>{s.value}</dd>
          </div>
        ))}
      </dl>
    </div>
  </div>
</section>

<script>
  const reduced = window.matchMedia("(prefers-reduced-motion: reduce)").matches;

  document.querySelectorAll<HTMLElement>("[data-ac-shard]").forEach((section) => {
    const times = Array.from(section.querySelectorAll<HTMLElement>("[data-ac-shard-time]"));
    const fmt = (min: number) => `${Math.floor(min)}:${String(Math.floor((min % 1) * 60)).padStart(2, "0")}`;
    const finals = times.map((t) => t.textContent ?? "");
    let frame = 0;
    if (!reduced) section.setAttribute("data-ac-armed", "");

    /* The one-runner clock counts during the sweep; the shard clock
       counts while the lanes run. Matches the CSS timings. */
    const SPANS = [
      [250, 1500],
      [2100, 900],
    ];
    const count = () => {
      cancelAnimationFrame(frame);
      const t0 = performance.now();
      const tick = (now: number) => {
        let running = false;
        times.forEach((el, i) => {
          const [delay, dur] = SPANS[i];
          const t = Math.min(1, Math.max(0, (now - t0 - delay) / dur));
          if (t < 1) running = true;
          el.textContent = t >= 1 ? finals[i] : fmt(Number(el.dataset.value) * t);
        });
        if (running) frame = requestAnimationFrame(tick);
      };
      frame = requestAnimationFrame(tick);
    };

    new IntersectionObserver(
      ([entry]) => {
        section.toggleAttribute("data-ac-in", entry.isIntersecting);
        if (reduced) return;
        if (entry.isIntersecting) count();
        else {
          cancelAnimationFrame(frame);
          times.forEach((el) => (el.textContent = "0:00"));
        }
      },
      { threshold: 0, rootMargin: "-10% 0px -10% 0px" },
    ).observe(section);
  });
</script>
