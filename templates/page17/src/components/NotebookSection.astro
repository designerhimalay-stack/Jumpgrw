---
import { Image } from "astro:assets";
import GridRules from "@/components/GridRules.astro";
import SectionHead from "@/components/SectionHead.astro";
import TechLogo from "@/components/TechLogo.astro";
import Joints from "@/components/process/Joints.astro";
import type { SectionPhoto } from "@/types/page";

/* A notebook, run. The header spans the top. Under it, a portrait photo of
   an engineer holds column 1 and a notebook fills columns 2–4: its cells
   execute in turn as the section arrives (In [ ] → In [*] → In [1]), the
   kernel dot going busy and idle, and each output appears in space kept for
   it: a line of text, a small table, then a tiny bar chart. "Run all"
   replays it. Every output is in the markup from the start and holds its
   size while hidden, so nothing moves. Without the script, or under reduced
   motion, the finished run shows. See docs/sections.md. */

type Output =
  | { kind: "text"; text: string }
  | { kind: "table"; head: [string, string]; rows: [string, string][] }
  | { kind: "chart"; bars: { label: string; value: number }[] };

interface Cell {
  code: string[];
  out?: Output;
}

interface Props {
  id: string;
  eyebrow: string;
  headline: string[];
  accent?: number;
  lede: string;
  media: SectionPhoto;
  file: string;
  kernel: string;
  cells: Cell[];
  /** What the finished run shows, for screen readers. */
  summary: string;
}

const { id, eyebrow, headline, accent, lede, media, file, kernel, cells, summary } = Astro.props;

/* A small Python highlighter: enough for four short cells. */
const KEYWORDS = new Set(["import", "as", "from", "def", "return", "for", "in", "if", "else", "with", "lambda"]);
type Token = { t: string; k?: "kw" | "str" | "num" | "fn" | "com" };
const tokens = (line: string): Token[] => {
  const out: Token[] = [];
  const re = /(#.*$)|("[^"]*"|'[^']*')|(\b\d[\d_.e]*\b)|([A-Za-z_]\w*)(?=\()|([A-Za-z_]\w*)|([^A-Za-z_\d"'#]+)/g;
  for (const m of line.matchAll(re)) {
    if (m[1]) out.push({ t: m[1], k: "com" });
    else if (m[2]) out.push({ t: m[2], k: "str" });
    else if (m[3]) out.push({ t: m[3], k: "num" });
    else if (m[4]) out.push({ t: m[4], k: "fn" });
    else if (m[5]) out.push({ t: m[5], k: KEYWORDS.has(m[5]) ? "kw" : undefined });
    else out.push({ t: m[0] });
  }
  return out;
};

/* Each chart's bars as a share of its tallest. */
const heights = (out?: Output) =>
  out?.kind === "chart" ? out.bars.map((b) => (b.value / Math.max(...out.bars.map((x) => x.value))) * 100) : [];
---

<section data-ac-sec="light" data-ac-nb id={id}>
  <GridRules />

  <div data-ac-sec-container>
    <SectionHead eyebrow={eyebrow} headline={headline} accent={accent} lede={lede} />

    <div data-ac-nb-grid>
      <div data-ac-nb-photo>
        <Joints />
        <div data-ac-nb-image>
          <Image
            src={media.image}
            alt={media.alt}
            widths={[480, 800, 1200]}
            sizes="(max-width: 991px) 100vw, 24vw"
            quality={78}
            style={media.focus ? `object-position:${media.focus}` : undefined}
          />
        </div>
      </div>

      <div data-ac-sec-frame data-ac-nb-book>
        <Joints />
        <div data-ac-nb-bar>
          <span data-ac-nb-file><TechLogo slug="python" size={16} />{file}</span>
          <span data-ac-nb-kernel class="mono-label-sm">
            <i aria-hidden="true" />
            <span data-ac-nb-kname>{kernel}</span>
            <span data-ac-nb-kstate aria-hidden="true">
              <span data-k="idle">idle</span>
              <span data-k="busy">busy</span>
            </span>
          </span>
          <button type="button" data-ac-nb-run class="mono-label-sm" aria-label="Run all cells again">
            <svg viewBox="0 0 12 12" aria-hidden="true"><path d="M3 2v8l7-4z" /></svg>
            Run all
          </button>
        </div>

        <ol data-ac-nb-cells role="img" aria-label={summary}>
          {cells.map((cell, i) => (
            <li data-ac-nb-cell data-state="done" aria-hidden="true">
              <span data-ac-nb-prompt>
                <span data-p="idle">In&nbsp;[&nbsp;]:</span>
                <span data-p="run">In&nbsp;[*]:</span>
                <span data-p="done">In&nbsp;[{i + 1}]:</span>
              </span>
              <pre data-ac-nb-code>{cell.code.map((line) => (
                <code>{tokens(line).map((tk) => (tk.k ? <span data-t={tk.k}>{tk.t}</span> : tk.t))}</code>
              ))}</pre>

              {cell.out && (
                <Fragment>
                  <span data-ac-nb-prompt data-out>{cell.out.kind === "chart" ? "" : `Out[${i + 1}]:`}</span>
                  <div data-ac-nb-out data-kind={cell.out.kind}>
                    {cell.out.kind === "text" && <samp>{cell.out.text}</samp>}
                    {cell.out.kind === "table" && (
                      <table>
                        <thead>
                          <tr>
                            <th>{cell.out.head[0]}</th>
                            <th>{cell.out.head[1]}</th>
                          </tr>
                        </thead>
                        <tbody>
                          {cell.out.rows.map((row) => (
                            <tr>
                              <th>{row[0]}</th>
                              <td>{row[1]}</td>
                            </tr>
                          ))}
                        </tbody>
                      </table>
                    )}
                    {cell.out.kind === "chart" && (
                      <div data-ac-nb-chart>
                        {cell.out.bars.map((bar, b) => (
                          <span data-ac-nb-barcol style={`--ac-h:${heights(cell.out)[b].toFixed(1)}%;--ac-b:${b}`}>
                            <i />
                            <span>{bar.label}</span>
                          </span>
                        ))}
                      </div>
                    )}
                  </div>
                </Fragment>
              )}
            </li>
          ))}
        </ol>
      </div>
    </div>
  </div>
</section>

<script>
  document.querySelectorAll<HTMLElement>("[data-ac-nb]").forEach((section) => {
    const cells = Array.from(section.querySelectorAll<HTMLElement>("[data-ac-nb-cell]"));
    const book = section.querySelector<HTMLElement>("[data-ac-nb-book]")!;
    const run = section.querySelector<HTMLButtonElement>("[data-ac-nb-run]")!;
    const reduced = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
    const RUN_MS = 620;
    const GAP_MS = 260;
    let timers: number[] = [];

    const set = (state: string) => cells.forEach((c) => (c.dataset.state = state));
    const stop = () => {
      timers.forEach(clearTimeout);
      timers = [];
      book.removeAttribute("data-busy");
    };
    const reset = () => {
      stop();
      set("idle");
    };

    const play = () => {
      reset();
      let t = 450;
      cells.forEach((cell) => {
        timers.push(
          window.setTimeout(() => {
            cell.dataset.state = "run";
            book.setAttribute("data-busy", "");
          }, t),
        );
        t += RUN_MS;
        timers.push(window.setTimeout(() => (cell.dataset.state = "done"), t));
        t += GAP_MS;
      });
      timers.push(window.setTimeout(() => book.removeAttribute("data-busy"), t));
    };

    book.setAttribute("data-ready", "");
    run.addEventListener("click", () => {
      if (reduced) return;
      play();
    });

    /* Reversible like every entrance on the page: runs on arrival, clears
       when it leaves. */
    new IntersectionObserver(
      ([entry]) => {
        section.toggleAttribute("data-ac-in", entry.isIntersecting);
        if (reduced) return;
        if (entry.isIntersecting) play();
        else reset();
      },
      { threshold: 0, rootMargin: "-10% 0px -10% 0px" },
    ).observe(section);
  });
</script>
