---
import { Image } from "astro:assets";
import GridRules from "@/components/GridRules.astro";
import RevealText from "@/components/RevealText.astro";
import TechLogo from "@/components/TechLogo.astro";
import Joints from "@/components/process/Joints.astro";
import { TECH_LOGOS, type TechLogoSlug } from "@/lib/tech-logos";
import type { SectionPhoto } from "@/types/page";

/* The wider toolkit, on the dark tone, led by a photo. Columns 1–2: a tall
   photo of an engineer at work. Columns 3–4: the header, then the toolkit
   set as a Python dict, typeset rather than boxed: each key a group, each
   value a list of the tools' logos on light tiles, with an indent guide down
   the body. The lines write themselves in, one after another, as the
   section arrives, and clear when it leaves. Nothing about their size
   changes, so nothing moves. See docs/sections.md. */

interface Group {
  key: string;
  tools: TechLogoSlug[];
}

interface Props {
  id: string;
  eyebrow: string;
  headline: string[];
  accent?: number;
  lede: string;
  media: SectionPhoto;
  /** The dict's name, e.g. "toolkit". */
  name: string;
  comment: string;
  groups: Group[];
}

const { id, eyebrow, headline, accent = headline.length - 1, lede, media, name, comment, groups } = Astro.props;
const offsets = headline.map((_, i) => headline.slice(0, i).reduce((n, line) => n + Array.from(line).length + 1, 0));
const pad = Math.max(...groups.map((g) => g.key.length)) + 5;

/* A brand colour too pale to read on the white tile draws in ink instead. */
const pale = (slug: TechLogoSlug) => {
  const hex = TECH_LOGOS[slug].hex.slice(1);
  const [r, g, b] = [0, 2, 4].map((i) => parseInt(hex.slice(i, i + 2), 16) / 255);
  return 0.2126 * r + 0.7152 * g + 0.0722 * b > 0.72;
};
---

<section data-ac-sec="dark" data-ac-kit id={id}>
  <GridRules />

  <div data-ac-sec-container data-ac-kit-grid>
    <div data-ac-kit-photo>
      <Joints />
      <div data-ac-kit-image>
        <Image
          src={media.image}
          alt={media.alt}
          widths={[480, 800, 1200, media.image.width]}
          sizes="(max-width: 991px) 100vw, 48vw"
          quality={78}
          style={media.focus ? `object-position:${media.focus}` : undefined}
        />
      </div>
    </div>

    <div data-ac-kit-copy>
      <p data-ac-sec-eyebrow class="mono-label">
        <span aria-hidden="true">+</span>
        {eyebrow}
      </p>
      <h2 data-ac-kit-headline aria-label={headline.join(" ")}>
        {headline.map((line, i) => (
          <Fragment>
            {i > 0 && <Fragment>{" "}<br aria-hidden="true" /></Fragment>}
            <span data-ac-sec-line data-accent={i === accent || undefined}>
              <RevealText text={line} offset={offsets[i]} />
            </span>
          </Fragment>
        ))}
      </h2>
      <p data-ac-kit-lede data-ac-sec-rise>{lede}</p>

      <div data-ac-kit-dict style={`--ac-key:${pad}ch`}>
        <p data-ac-kit-line data-kind="comment" style="--ac-i:0" aria-hidden="true"># {comment}</p>
        <p data-ac-kit-line style="--ac-i:1" aria-hidden="true">
          <span data-t="name">{name}</span> <span data-t="op">=</span> <span data-t="brace">{"{"}</span>
        </p>
        <ul data-ac-kit-body aria-label="The toolkit, by group">
          {groups.map((group, g) => (
            <li data-ac-kit-line data-kind="entry" style={`--ac-i:${g + 2}`}>
              <span data-ac-kit-key>
                <span data-t="str">"{group.key}"</span><span data-t="op">:</span>
              </span>
              <span data-ac-kit-list>
                <span data-t="brace" aria-hidden="true">[</span>
                {group.tools.map((slug, t) => (
                  <span data-ac-kit-tool>
                    <span data-ac-kit-chip>
                      <span data-ac-kit-tile>
                        <TechLogo slug={slug} size={18} tone={pale(slug) ? "ink" : "brand"} />
                      </span>
                      <span data-ac-kit-name>{TECH_LOGOS[slug].title}</span>
                    </span>
                    {t < group.tools.length - 1 && <span data-t="op" aria-hidden="true">,</span>}
                  </span>
                ))}
                <span data-t="brace" aria-hidden="true">],</span>
              </span>
            </li>
          ))}
        </ul>
        <p data-ac-kit-line style={`--ac-i:${groups.length + 2}`} aria-hidden="true">
          <span data-t="brace">{"}"}</span>
        </p>
      </div>
    </div>
  </div>
</section>

<script>
  import { toggleInView } from "@/lib/in-view";

  document.querySelectorAll<HTMLElement>("[data-ac-kit]").forEach(toggleInView);
</script>
