---
import GridRules from "@/components/GridRules.astro";
import RevealText from "@/components/RevealText.astro";

/* Why testing early pays, as a chart, on the dark tone. The cost of fixing
   a bug climbs steeply the later it is found; the curve draws itself left
   to right across the page's columns as the section arrives, and the band
   where a QA pod catches bugs lights under it. Relative, not measured: the
   axis says "cost to fix", with no figures. See docs/sections.md. */

interface Props {
  id: string;
  eyebrow: string;
  headline: string[];
  accent?: number;
  lede: string;
  stages: string[];
  /** Index of the first and last stage the pod covers. */
  catchFrom: number;
  catchTo: number;
  catchLabel: string;
  axis: string;
}

const { id, eyebrow, headline, accent = headline.length - 1, lede, stages, catchFrom, catchTo, catchLabel, axis } = Astro.props;
const offsets = headline.map((_, i) => headline.slice(0, i).reduce((n, line) => n + Array.from(line).length + 1, 0));

/* 1000 × 400 box; stages at the centre of equal columns. */
const W = 1000;
const H = 400;
const col = W / stages.length;
const x = (i: number) => col * i + col / 2;
const y = (i: number) => H - 30 - Math.pow(i / (stages.length - 1), 2.6) * (H - 70);
/* A smooth curve through the points. */
const smooth = (() => {
  const pts = stages.map((_, i) => [x(i), y(i)]);
  let d = `M${pts[0][0]} ${pts[0][1]}`;
  for (let i = 1; i < pts.length; i++) {
    const [x0, y0] = pts[i - 1];
    const [x1, y1] = pts[i];
    const cx = (x0 + x1) / 2;
    d += ` C${cx} ${y0} ${cx} ${y1} ${x1} ${y1}`;
  }
  return d;
})();
const bandX = col * catchFrom;
const bandW = col * (catchTo - catchFrom + 1);
---

<section data-ac-sec="dark" data-ac-cost id={id}>
  <GridRules />

  <div data-ac-sec-container>
    <div data-ac-cost-head>
      <div>
        <p data-ac-sec-eyebrow class="mono-label">
          <span aria-hidden="true">+</span>
          {eyebrow}
        </p>
        <h2 data-ac-cost-headline aria-label={headline.join(" ")}>
          {headline.map((line, i) => (
            <Fragment>
              {i > 0 && <Fragment>{" "}<br aria-hidden="true" /></Fragment>}
              <span data-ac-sec-line data-accent={i === accent || undefined}>
                <RevealText text={line} offset={offsets[i]} />
              </span>
            </Fragment>
          ))}
        </h2>
      </div>
      <p data-ac-cost-lede data-ac-sec-rise>{lede}</p>
    </div>

    <figure data-ac-cost-chart>
      <svg viewBox={`0 0 ${W} ${H}`} preserveAspectRatio="none" role="img" aria-label={`${axis} rises steeply from ${stages[0]} to ${stages[stages.length - 1]}. ${catchLabel}: ${stages.slice(catchFrom, catchTo + 1).join(" and ")}.`}>
        <rect data-ac-cost-band x={bandX} y="0" width={bandW} height={H} />
        {stages.map((_, i) => i > 0 && <line data-ac-cost-grid x1={col * i} y1="0" x2={col * i} y2={H} />)}
        <path data-ac-cost-fill d={`${smooth} L${x(stages.length - 1)} ${H} L${x(0)} ${H} Z`} />
        <path data-ac-cost-line d={smooth} pathLength="1" />
      </svg>
      {/* The points sit over the chart as HTML, so they stay round however
          the chart stretches. */}
      <span data-ac-cost-points aria-hidden="true">
        {stages.map((_, i) => (
          <i
            data-ac-cost-point
            data-caught={(i >= catchFrom && i <= catchTo) || undefined}
            style={`--ac-i:${i};left:${(x(i) / W) * 100}%;top:${(y(i) / H) * 100}%`}
          />
        ))}
      </span>
      <span data-ac-cost-axis class="mono-label-sm" aria-hidden="true">{axis} ↑</span>
      <span data-ac-cost-catch class="mono-label" style={`--ac-from:${catchFrom};--ac-span:${catchTo - catchFrom + 1};--ac-n:${stages.length}`} aria-hidden="true">
        {catchLabel}
      </span>
      <ol data-ac-cost-stages style={`--ac-n:${stages.length}`} aria-hidden="true">
        {stages.map((stage, i) => (
          <li data-caught={(i >= catchFrom && i <= catchTo) || undefined}>{stage}</li>
        ))}
      </ol>
    </figure>
  </div>
</section>

<script>
  import { toggleInView } from "@/lib/in-view";

  document.querySelectorAll<HTMLElement>("[data-ac-cost]").forEach(toggleInView);
</script>
