---
import GridRules from "@/components/GridRules.astro";
import SectionHead from "@/components/SectionHead.astro";
import TechLogo from "@/components/TechLogo.astro";
import Joints from "@/components/process/Joints.astro";
import type { TechLogoSlug } from "@/lib/tech-logos";

/* The ecosystem as a transit map, on the light tone (React Native's
   bundler is called Metro). Three lines on a 1200 × 520 plan (the top 50 units are cropped): the app
   line runs from TypeScript through React to release and forks into two
   termini, the iOS and Android apps; the data line crosses it at React;
   the ops line at the release station. Each station is a logo tile set
   on its line with its name and its job beside it. The lines draw in as
   the section arrives, the stations follow along them, and two trains run
   the app line to each terminus while the map is in view. Phones and
   tablets get the strip diagram instead: each line as a vertical strip of
   its stations, two strips side by side. See docs/sections.md. */

type Place = "below" | "above" | "right" | "ne" | "nw";

interface Station {
  slug: TechLogoSlug;
  name: string;
  role: string;
  /** Position on the 1200 × 520 plan. */
  x: number;
  y: number;
  label?: Place;
  terminus?: boolean;
  /** Drawn on another line already: shown in this line's strip only. */
  echo?: boolean;
}

interface Line {
  key: "app" | "data" | "ops";
  name: string;
  note: string;
  stations: Station[];
}

interface Props {
  id: string;
  eyebrow: string;
  headline: string[];
  accent?: number;
  lede: string;
  lines: Line[];
}

const { id, eyebrow, headline, accent, lede, lines } = Astro.props;

/* The track, per line, on the same plan. */
const TRACK: Record<Line["key"], string[]> = {
  app: ["M80 260 H960", "M960 260 L1080 140 H1120", "M960 260 L1080 380 H1120"],
  data: ["M240 96 V320 L320 400 H700"],
  ops: ["M880 96 V424"],
};
const TRAINS = ["M80 260 H960 L1080 140 H1120", "M80 260 H960 L1080 380 H1120"];

/* Each station's order along the map, for the stagger. */
const order = (s: Station) => Math.round(s.x / 120 + (s.y > 300 ? 2 : 0));
---

<section data-ac-sec="light" data-ac-metro id={id}>
  <GridRules />

  <div data-ac-sec-container>
    <SectionHead eyebrow={eyebrow} headline={headline} accent={accent} lede={lede} />

    <div data-ac-sec-frame data-ac-metro-frame>
      <Joints />

      <div data-ac-metro-map>
        <svg data-ac-metro-plan viewBox="0 50 1200 470" preserveAspectRatio="none" aria-hidden="true">
          {lines.map((line, l) =>
            TRACK[line.key].map((d) => (
              <path data-ac-metro-track data-line={line.key} d={d} pathLength="1" style={`--ac-i:${l}`} />
            )),
          )}
          {TRAINS.map((d, i) => (
            <circle data-ac-metro-train r="7">
              <animateMotion dur="7s" begin={`${i * 3.5}s`} repeatCount="indefinite" path={d} calcMode="spline" keyTimes="0;1" keySplines="0.45 0 0.55 1" />
            </circle>
          ))}
        </svg>

        <ul data-ac-metro-legend>
          {lines.map((line) => (
            <li data-line={line.key}>
              <i aria-hidden="true" />
              <span>{line.name}</span>
            </li>
          ))}
        </ul>
      </div>

      <div data-ac-metro-strips>
        {lines.map((line) => (
          <div data-ac-metro-line data-line={line.key}>
            <p data-ac-metro-line-head>
              <i aria-hidden="true" />
              <span>{line.name}</span>
              <span data-ac-metro-line-note>{line.note}</span>
            </p>
            <ul>
              {line.stations.map((s) => (
                <li
                  data-ac-metro-stop
                  data-label={s.label ?? "below"}
                  data-terminus={s.terminus || undefined}
                  data-echo={s.echo || undefined}
                  style={`--x:${((s.x / 1200) * 100).toFixed(2)}%;--y:${(((s.y - 50) / 470) * 100).toFixed(2)}%;--ac-i:${order(s)}`}
                >
                  <span data-ac-metro-tile>
                    <TechLogo slug={s.slug} size={s.terminus ? 30 : 24} />
                  </span>
                  <span data-ac-metro-copy>
                    <span data-ac-metro-name>{s.name}</span>
                    <span data-ac-metro-role>{s.role}</span>
                  </span>
                </li>
              ))}
            </ul>
          </div>
        ))}
      </div>
    </div>
  </div>
</section>

<script>
  import { toggleInView } from "@/lib/in-view";

  document.querySelectorAll<HTMLElement>("[data-ac-metro]").forEach((section) => {
    toggleInView(section);

    /* The trains run only while the map is on screen. */
    const plan = section.querySelector<SVGSVGElement>("[data-ac-metro-plan]")!;
    const reduced = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
    plan.pauseAnimations();
    if (reduced) return;
    new IntersectionObserver(([entry]) => (entry.isIntersecting ? plan.unpauseAnimations() : plan.pauseAnimations()), {
      threshold: 0,
    }).observe(plan);
  });
</script>
