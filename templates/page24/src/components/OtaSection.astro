---
import { Image } from "astro:assets";
import GridRules from "@/components/GridRules.astro";
import RevealText from "@/components/RevealText.astro";
import Joints from "@/components/process/Joints.astro";
import type { SectionPhoto } from "@/types/page";

/* Over the air, on the dark tone. The headline spans the top; under it a
   photo of the team holds columns 1–2 and a release panel fills columns
   3–4. The panel's version badge rolls from the old version to the new
   one, then a fleet of phones takes it as their owners next open the app:
   most in the first hours, a few later, a handful not at all within the
   day. A clock runs to 24 hours along a rail that ends on its last mark,
   and the share on the new version counts up. Under the fleet, the store
   route and the over-the-air route side by side. Every phone holds its
   place from the start (only its colour changes), so nothing moves.
   Without the script, or under reduced motion, the finished day shows.
   The fleet is illustrative. See docs/sections.md. */

interface Route {
  label: string;
  value: string;
  note: string;
  featured?: boolean;
}

interface Props {
  id: string;
  eyebrow: string;
  headline: string[];
  accent?: number;
  lede: string;
  media: SectionPhoto;
  channel: string;
  from: string;
  to: string;
  devices: number;
  /** How many of the devices are still on the old version after a day. */
  holdouts: number;
  shareLabel: string;
  routes: [Route, Route];
}

const { id, eyebrow, headline, accent = headline.length - 1, lede, media, channel, from, to, devices, holdouts, shareLabel, routes } =
  Astro.props;
const offsets = headline.map((_, i) => headline.slice(0, i).reduce((n, line) => n + Array.from(line).length + 1, 0));

/* When each phone opens the app, as a share of the day: a fixed
   pseudo-random scatter, squared so most land early. The `holdouts`
   phones with the highest second draw stay on the old version. */
const draw = (n: number, k: number) => {
  const x = Math.sin(n * k) * 43758.5453;
  return x - Math.floor(x);
};
const never = new Set(
  Array.from({ length: devices }, (_, i) => i)
    .sort((a, b) => draw(b + 1, 78.233) - draw(a + 1, 78.233))
    .slice(0, holdouts),
);
const fleet = Array.from({ length: devices }, (_, i) => {
  const u = draw(i + 1, 12.9898);
  return { at: never.has(i) ? 2 : Math.max(0.02, u * u), never: never.has(i) };
});
const updated = fleet.filter((d) => !d.never).length;
const share = Math.round((updated / devices) * 100);
---

<section data-ac-sec="dark" data-ac-ota id={id}>
  <GridRules />

  <div data-ac-sec-container data-ac-ota-grid>
    <div data-ac-ota-head>
      <p data-ac-sec-eyebrow class="mono-label">
        <span aria-hidden="true">+</span>
        {eyebrow}
      </p>
      <h2 data-ac-ota-headline aria-label={headline.join(" ")}>
        {headline.map((line, i) => (
          <Fragment>
            {i > 0 && <Fragment>{" "}<br aria-hidden="true" /></Fragment>}
            <span data-ac-sec-line data-accent={i === accent || undefined}>
              <RevealText text={line} offset={offsets[i]} />
            </span>
          </Fragment>
        ))}
      </h2>
    </div>
    <p data-ac-ota-lede data-ac-sec-rise>{lede}</p>

    <div data-ac-ota-photo>
      <Joints />
      <div data-ac-ota-image>
        <Image
          src={media.image}
          alt={media.alt}
          widths={[480, 800, 1200]}
          sizes="(max-width: 991px) 100vw, 46vw"
          quality={78}
          style={media.focus ? `object-position:${media.focus}` : undefined}
        />
      </div>
    </div>

    <div
      data-ac-ota-panel
      data-published
      role="img"
      aria-label={`An over-the-air update from ${from} to ${to}: ${share}% of ${devices} phones run it within a day, with no store review.`}
    >
      <header data-ac-ota-top aria-hidden="true">
        <span data-ac-ota-channel>
          <i />
          <span class="mono-label-sm">{channel}</span>
        </span>
        <span data-ac-ota-badge>
          <span data-ac-ota-ver data-v="from">v{from}</span>
          <span data-ac-ota-ver data-v="to">v{to}</span>
        </span>
      </header>

      <ol data-ac-ota-fleet aria-hidden="true">
        {fleet.map((d) => (
          <li data-ac-ota-phone data-at={d.at.toFixed(3)} data-new={d.never ? undefined : ""} />
        ))}
      </ol>

      <div data-ac-ota-clock aria-hidden="true">
        <p data-ac-ota-share>
          <b data-ac-ota-pct>{share}</b><span>%</span>
          <span data-ac-ota-share-label class="mono-label-sm">{shareLabel}</span>
        </p>
        <div data-ac-ota-rail>
          <span data-ac-ota-track><i data-ac-ota-fill /></span>
          <span data-ac-ota-marks class="mono-label-sm">
            <span>0 h</span>
            <span>6 h</span>
            <span>12 h</span>
            <span>18 h</span>
            <span>24 h</span>
          </span>
        </div>
      </div>

      <dl data-ac-ota-routes aria-hidden="true">
        {routes.map((r) => (
          <div data-featured={r.featured || undefined}>
            <dt class="mono-label-sm">{r.label}</dt>
            <dd>
              <span>{r.value}</span>
              <span>{r.note}</span>
            </dd>
          </div>
        ))}
      </dl>
    </div>
  </div>
</section>

<script>
  document.querySelectorAll<HTMLElement>("[data-ac-ota]").forEach((section) => {
    const panel = section.querySelector<HTMLElement>("[data-ac-ota-panel]")!;
    const phones = Array.from(section.querySelectorAll<HTMLElement>("[data-ac-ota-phone]"));
    const pct = section.querySelector<HTMLElement>("[data-ac-ota-pct]")!;
    const fill = section.querySelector<HTMLElement>("[data-ac-ota-fill]")!;
    const reduced = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
    const at = phones.map((p) => Number(p.dataset.at));
    const DAY_MS = 4200;
    let raf = 0;
    let wait = 0;

    const paint = (t: number) => {
      let n = 0;
      phones.forEach((p, i) => {
        const on = at[i] <= t;
        p.toggleAttribute("data-new", on);
        if (on) n += 1;
      });
      pct.textContent = String(Math.round((n / phones.length) * 100));
      fill.style.transform = `scaleX(${t})`;
    };

    const reset = () => {
      cancelAnimationFrame(raf);
      clearTimeout(wait);
      panel.removeAttribute("data-published");
      paint(0);
    };

    const play = () => {
      reset();
      wait = window.setTimeout(() => {
        panel.setAttribute("data-published", "");
        const t0 = performance.now() + 500;
        const frame = (now: number) => {
          const t = Math.min(1, Math.max(0, (now - t0) / DAY_MS));
          paint(t);
          if (t < 1) raf = requestAnimationFrame(frame);
        };
        raf = requestAnimationFrame(frame);
      }, 700);
    };

    /* Reversible like every entrance on the page: plays on arrival, resets
       when it leaves. */
    new IntersectionObserver(
      ([entry]) => {
        section.toggleAttribute("data-ac-in", entry.isIntersecting);
        if (reduced) return;
        if (entry.isIntersecting) play();
        else reset();
      },
      { threshold: 0, rootMargin: "-10% 0px -10% 0px" },
    ).observe(section);
  });
</script>
