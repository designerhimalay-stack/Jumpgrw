---
import GridRules from "@/components/GridRules.astro";
import SectionHead from "@/components/SectionHead.astro";
import Joints from "@/components/process/Joints.astro";

/* Design against production, on one screen. Columns 1–3: the same screen
   twice, stacked: the design, drawn as a Figma frame with its measurements
   marked, and the finished build. A handle splits them; drag it (or use the
   arrow keys) to compare. On arrival the handle sweeps across once. Column
   4: how close the build is, as readouts. Drawn in CSS: no images. See
   docs/sections.md. */

interface Props {
  id: string;
  eyebrow: string;
  headline: string[];
  accent?: number;
  lede: string;
  readoutsTitle: string;
  readouts: { label: string; value: string; note: string }[];
}

const { id, eyebrow, headline, accent, lede, readoutsTitle, readouts } = Astro.props;

/* The screen, written once and drawn twice. */
const bars = [0.42, 0.68, 0.55, 0.86, 0.62, 0.94, 0.78];
---

<section data-ac-sec="light" data-ac-fidelity id={id}>
  <GridRules />

  <div data-ac-sec-container>
    <SectionHead eyebrow={eyebrow} headline={headline} accent={accent} lede={lede} />

    <div data-ac-sec-frame data-ac-fid-frame>
      <Joints />
      <div data-ac-fid-stage style="--ac-split:50%">
        {["design", "build"].map((layer) => (
          <div data-ac-fid-layer={layer} aria-hidden="true">
            <div data-ac-fid-screen>
              <span data-ac-fid-top>
                <i data-avatar />
                <span><i data-l="name" /><i data-l="role" /></span>
                <i data-pill>Live</i>
              </span>
              <span data-ac-fid-kpis>
                <span><i data-l="k" /><b>98.2%</b></span>
                <span><i data-l="k" /><b>42 ms</b></span>
                <span><i data-l="k" /><b>1.2k</b></span>
              </span>
              <span data-ac-fid-chart>
                {bars.map((h) => <i style={`--h:${h}`} />)}
              </span>
              <span data-ac-fid-actions><i data-btn>Deploy</i><i data-btn="ghost">Details</i></span>
            </div>
            {layer === "design" && (
              <Fragment>
                <span data-ac-fid-mark="pad-l">24</span>
                <span data-ac-fid-mark="gap">16</span>
                <span data-ac-fid-mark="h">56</span>
              </Fragment>
            )}
          </div>
        ))}
        <span data-ac-fid-tag="design" class="mono-label-sm" aria-hidden="true">Figma</span>
        <span data-ac-fid-tag="build" class="mono-label-sm" aria-hidden="true">Production</span>
        <span data-ac-fid-handle aria-hidden="true"><i /></span>
        <input
          type="range"
          min="0"
          max="100"
          value="50"
          aria-label="Compare the design with the build"
          data-ac-fid-input
        />
      </div>

      <div data-ac-fid-readouts>
        <p class="mono-label">{readoutsTitle}</p>
        <dl>
          {readouts.map((r, i) => (
            <div style={`--ac-i:${i}`}>
              <dt>{r.label}</dt>
              <dd>
                <b>{r.value}</b>
                <span>{r.note}</span>
              </dd>
            </div>
          ))}
        </dl>
      </div>
    </div>
  </div>
</section>

<script>
  import { toggleInView } from "@/lib/in-view";

  document.querySelectorAll<HTMLElement>("[data-ac-fidelity]").forEach((section) => {
    toggleInView(section);

    const stage = section.querySelector<HTMLElement>("[data-ac-fid-stage]")!;
    const input = section.querySelector<HTMLInputElement>("[data-ac-fid-input]")!;
    const set = (v: number) => {
      stage.style.setProperty("--ac-split", `${v}%`);
      input.value = String(Math.round(v));
    };
    input.addEventListener("input", () => {
      touched = true;
      cancelAnimationFrame(frame);
      set(Number(input.value));
    });

    /* On arrival the handle sweeps across once, so the comparison is seen
       before anyone touches it; a touch takes over at once. */
    let touched = false;
    let frame = 0;
    if (window.matchMedia("(prefers-reduced-motion: reduce)").matches) return;
    new IntersectionObserver(
      ([entry]) => {
        if (!entry.isIntersecting || touched) return;
        const start = performance.now() + 400;
        const path = (t: number) => (t < 0.5 ? 50 + 36 * Math.sin(t * 2 * Math.PI) : 50 - 30 * Math.sin((t - 0.5) * 2 * Math.PI));
        const step = (now: number) => {
          if (touched) return;
          const t = Math.min(1, Math.max(0, (now - start) / 3200));
          set(path(t));
          if (t < 1) frame = requestAnimationFrame(step);
        };
        cancelAnimationFrame(frame);
        frame = requestAnimationFrame(step);
      },
      { threshold: 0.4 },
    ).observe(section);
  });
</script>
