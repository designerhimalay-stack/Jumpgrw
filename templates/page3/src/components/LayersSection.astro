---
import { Image } from "astro:assets";
import GridRules from "@/components/GridRules.astro";
import RevealText from "@/components/RevealText.astro";
import Joints from "@/components/process/Joints.astro";
import type { Outcome, SectionPhoto } from "@/types/page";

/* What sits under a design, on the dark tone. Columns 1–2: the claim, then
   the layers engineering adds, drawn as slabs stacked one on another, each
   stepping in from the last and sliding into place in turn as the section
   arrives. Columns 3–4: a photo of developers at work, the full height of
   the section. See docs/sections.md. */

interface Props {
  id: string;
  eyebrow: string;
  headline: string[];
  accent?: number;
  lede: string;
  media: SectionPhoto;
  layersLabel: string;
  layers: Outcome[];
}

const { id, eyebrow, headline, accent = headline.length - 1, lede, media, layersLabel, layers } = Astro.props;
const pad = (n: number) => String(n).padStart(2, "0");
const offsets = headline.map((_, i) => headline.slice(0, i).reduce((n, line) => n + Array.from(line).length + 1, 0));
---

<section data-ac-sec="dark" data-ac-layers id={id}>
  <GridRules />

  <div data-ac-sec-container data-ac-layers-grid>
    <div data-ac-layers-copy>
      <p data-ac-sec-eyebrow class="mono-label">
        <span aria-hidden="true">+</span>
        {eyebrow}
      </p>
      <h2 data-ac-layers-headline aria-label={headline.join(" ")}>
        {headline.map((line, i) => (
          <Fragment>
            {i > 0 && <Fragment>{" "}<br aria-hidden="true" /></Fragment>}
            <span data-ac-sec-line data-accent={i === accent || undefined}>
              <RevealText text={line} offset={offsets[i]} />
            </span>
          </Fragment>
        ))}
      </h2>
      <p data-ac-layers-lede data-ac-sec-rise>{lede}</p>

      <p data-ac-layers-label class="mono-label">{layersLabel}</p>
      <ol data-ac-layers-stack>
        {layers.map((layer, i) => (
          <li style={`--ac-i:${i}`}>
            <span data-ac-layers-index class="mono-label">L{pad(i + 1)}</span>
            <span data-ac-layers-title>{layer.title}</span>
            <span data-ac-layers-note>{layer.note}</span>
          </li>
        ))}
      </ol>
    </div>

    <div data-ac-layers-photo>
      <Joints />
      <div data-ac-layers-image>
        <Image
          src={media.image}
          alt={media.alt}
          widths={[480, 800, 1200, media.image.width]}
          sizes="(max-width: 991px) 100vw, 46vw"
          quality={78}
          style={media.focus ? `object-position:${media.focus}` : undefined}
        />
      </div>
    </div>
  </div>
</section>

<script>
  import { toggleInView } from "@/lib/in-view";

  document.querySelectorAll<HTMLElement>("[data-ac-layers]").forEach(toggleInView);
</script>
