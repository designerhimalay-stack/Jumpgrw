---
import Layout from "@/layouts/Layout.astro";
import FaqSection from "@/components/FaqSection.astro";
import CtaSection from "@/components/CtaSection.astro";
import FidelitySection from "@/components/FidelitySection.astro";
import Footer from "@/components/Footer.astro";
import LayersSection from "@/components/LayersSection.astro";
import Navbar from "@/components/Navbar.astro";
import PageHero from "@/components/PageHero.astro";
import PipelineSection from "@/components/PipelineSection.astro";
import SmoothScroll from "@/components/SmoothScroll.astro";
import StackSection from "@/components/StackSection.astro";
import StatesSection from "@/components/StatesSection.astro";
import type { PageHeroContent } from "@/types/page";
import prototypePhoto from "@/assets/pages/prototype.jpg";
import realPhoto from "@/assets/pages/p3-real.jpg";
import executionPhoto from "@/assets/pages/p3-execution.jpg";
import faqPhoto from "@/assets/pages/p3-faq.jpg";
import { BRAND } from "@/lib/brand";

/* Prototype to launch. The copy is the brief's, cut down to what a reader
   needs; what each requirement adds to each layer, the layer notes and the
   FAQ answers are drafts. Have them checked before launch. Photos
   alternate with the sections that carry an interaction or a drawing. See
   docs/sections.md. */

const HERO: PageHeroContent = {
  trail: ["Launch phase", "Prototype to launch"],
  headline: ["Prototype", "to launch."],
  lede: "A rapid path from interactive prototype to production. We take your approved designs and engineer a robust, scalable application.",
  ctas: [
    { label: "Start the build", href: "#contact", arrow: "diagonal" },
    { label: "Map your stack", href: "#architecture", arrow: "right" },
  ],
  image: prototypePhoto,
  imageAlt: "Two engineers review a prototype on a phone at a desk covered in printed screen designs.",
  specs: [
    { label: "Starts from", value: "Approved designs" },
    { label: "Builds", value: "A production system" },
    { label: "Team", value: "A senior build squad" },
    { label: "Ends with", value: "A complete handoff" },
  ],
};

const FAQS = [
  {
    q: "My prototype is only halfway done. Can we start?",
    a: "Yes. We build what is signed off while design finishes, and fold in new screens each sprint.",
  },
  {
    q: "Do you use code exported from Figma?",
    a: "No. We rebuild it as a clean component library your team can maintain.",
  },
  {
    q: "What if I don’t know which stack to use?",
    a: "Use the architecture mapper above; our architects confirm it with you.",
  },
];
---

<Layout
  title={`Prototype to launch · ${BRAND.name}`}
  description="Turn approved designs into a robust, scalable production application, with state, APIs and security engineered in."
  navTone="field"
>
  <SmoothScroll />
  <Navbar />
  <main>
    <PageHero content={HERO} />
    <LayersSection
      id="make-it-real"
      eyebrow="From design to deployment"
      headline={["Make it", "real."]}
      lede="You have the Figma files. Now comes the hard part: a product that handles real users, real data and peak loads."
      media={{ image: realPhoto, alt: "Two developers work through code together on a laptop in a busy studio.", focus: "60% 45%" }}
      layersLabel="What we engineer under the design"
      layers={[
        { title: "State", note: "Data through every screen." },
        { title: "APIs", note: "Secure, fast services." },
        { title: "Security", note: "Auth and data protection." },
      ]}
    />
    <StackSection
      id="architecture"
      eyebrow="Architecture mapper"
      headline={["Tech stack follows", "functionality."]}
      accent={1}
      lede="Switch on what your prototype demands, and see what it adds to each layer."
      label="Advanced requirements"
      requirements={[
        { label: "Real-time collaboration", icon: "sync" },
        { label: "HIPAA / SOC 2 compliance", icon: "shield" },
        { label: "Offline & mobile-first", icon: "mobile" },
      ]}
      layers={[
        { title: "Frontend", base: "React / Next.js with Tailwind CSS.", additions: ["Live presence", "Session controls", "Offline cache"] },
        { title: "Backend & API", base: "Node.js or Python, REST or GraphQL.", additions: ["WebSocket gateway", "Access control", "Sync API"] },
        { title: "Data & infrastructure", base: "PostgreSQL on AWS.", additions: ["Redis pub/sub", "Encrypted storage", "Local-first store"] },
      ]}
    />
    <PipelineSection
      id="execution"
      eyebrow="The execution"
      headline={["Engineering", "the vision."]}
      accent={1}
      lede="Four stages from a static file to a live product, one senior squad throughout."
      media={{ image: executionPhoto, alt: "Engineers work at their laptops and monitors in a bright, open office.", focus: "50% 50%" }}
      stages={[
        { title: "Component architecture", body: "Your Figma file as a modular React library." },
        { title: "Backend systems", body: "Secure databases, fast APIs, scalable infrastructure." },
        { title: "State management", body: "Live data through every screen." },
        { title: "UAT & go-live", body: "Every edge case tested before real users." },
      ]}
      stats={[
        { value: 100, suffix: "%", label: "Design fidelity" },
        { value: "Built-in", label: "Quality, security and release foundations", featured: true },
        { value: "24/7", label: "Monitoring and support after launch" },
      ]}
    />
    <FidelitySection
      id="fidelity"
      eyebrow="Design fidelity"
      headline={["Built exactly", "as designed."]}
      accent={1}
      lede="Drag across the screen to compare the Figma frame with the build. Every spacing, colour and type style carries over."
      readoutsTitle="Design to build"
      readouts={[
        { label: "Spacing", value: "0 px", note: "Off the spec, on every screen" },
        { label: "Colour", value: "Tokens", note: "One source for design and code" },
        { label: "Type", value: "1 : 1", note: "Styles mapped to components" },
        { label: "Responsive", value: "4 sizes", note: "Checked from phone to desktop" },
      ]}
    />
    <StatesSection
      id="invisible-gaps"
      eyebrow="Production engineering"
      headline={["Filling in the", "invisible gaps."]}
      accent={1}
      lede="Production requires pessimism. We build the states designers rarely draw."
      prototype={{ label: "The prototype", note: "Shows the happy path: data loads instantly and nothing fails.", tag: "Happy path only" }}
      states={[
        { label: "Loading states", note: "Skeletons while slow APIs answer." },
        { label: "Errors & validation", note: "Clear messages, safe boundaries." },
        { label: "Authentication", note: "OAuth, MFA, session expiry." },
        { label: "Every screen size", note: "Fallbacks for edge-case devices." },
      ]}
      handoffLabel="Our handoff protocol"
      handoff={[
        { title: "Code repositories", note: "Clean, documented, tested." },
        { title: "Infrastructure keys", note: "Cloud accounts, domains, CI/CD." },
        { title: "Runbooks", note: "Deploy, scale and monitor." },
      ]}
    />
    <FaqSection
      eyebrow="Build questions"
      headline={["Before", "the build."]}
      cta="Talk to an architect"
      faqs={FAQS}
      media={{ image: faqPhoto, alt: "A development team works at laptops in a warm, open studio office.", focus: "50% 50%" }}
    />
    <CtaSection
      eyebrow="Ready to build"
      headline={["Your prototype is ready.", "Let’s make it real."]}
      body="Share your Figma files. We’ll come back with a technical blueprint and a timeline to launch."
      cta="Start the build conversation"
    />
  </main>
  <Footer />
</Layout>
