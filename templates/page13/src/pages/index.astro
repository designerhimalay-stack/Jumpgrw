---
import Layout from "@/layouts/Layout.astro";
import CtaSection from "@/components/CtaSection.astro";
import EcosystemSection from "@/components/EcosystemSection.astro";
import FaqSection from "@/components/FaqSection.astro";
import Footer from "@/components/Footer.astro";
import Navbar from "@/components/Navbar.astro";
import PageHero from "@/components/PageHero.astro";
import RenderTreeSection from "@/components/RenderTreeSection.astro";
import ScorecardSection from "@/components/ScorecardSection.astro";
import SmoothScroll from "@/components/SmoothScroll.astro";
import type { PageHeroContent } from "@/types/page";
import heroPhoto from "@/assets/pages/p13-hero.jpg";
import deskPhoto from "@/assets/pages/p13-desk.jpg";
import pairingPhoto from "@/assets/pages/p13-pairing.jpg";
import faqPhoto from "@/assets/pages/p13-faq.jpg";
import { BRAND } from "@/lib/brand";

/* React developers. The component tree, the ecosystem and the scorecard are
   illustrative: the render counts follow from the tree as drawn, and the
   scores and Web Vitals are plausible targets, not measurements. The FAQ
   answers are drafts. Have them checked before launch. See
   docs/sections.md. */

const HERO: PageHeroContent = {
  trail: ["Technologies", "Frontend", "React"],
  headline: ["React", "developers."],
  lede: "Senior React engineers who build fast, accessible interfaces: lean component trees, typed state and Core Web Vitals in the green.",
  ctas: [
    { label: "Hire React developers", href: "#contact", arrow: "diagonal" },
    { label: "See the render path", href: "#render-path", arrow: "right" },
  ],
  image: heroPhoto,
  imageAlt: "A frontend developer writes code across two large monitors at her desk.",
  specs: [
    { label: "Core", value: "React and Next.js" },
    { label: "Typed", value: "TypeScript first" },
    { label: "Tested", value: "Jest and RTL" },
    { label: "Starts", value: "Within two weeks" },
  ],
};

const FAQS = [
  {
    q: "Do your developers work in Next.js too?",
    a: "Yes. Most of our React work ships on Next.js, from the App Router and server components to static export.",
  },
  {
    q: "Can they take over an existing codebase?",
    a: "Yes. The first week is a read-through: the component tree, state, tests and bundle, then a short list of fixes by impact.",
  },
  {
    q: "How do you keep the app fast as it grows?",
    a: "Budgets in CI. Bundle size and Lighthouse run on every pull request, so a slow change is caught before it merges.",
  },
  {
    q: "Which state library do you use?",
    a: "The lightest one that fits: local state first, React Query for server data, and Redux only where shared state earns it.",
  },
];
---

<Layout
  title={`React developers · ${BRAND.name}`}
  description="Senior React engineers who build fast, accessible interfaces with lean component trees, typed state and strong Core Web Vitals."
  navTone="field"
>
  <SmoothScroll />
  <Navbar />
  <main>
    <PageHero content={HERO} />
    <RenderTreeSection
      id="render-path"
      eyebrow="Render path"
      headline={["One state change.", "Fewer re-renders."]}
      accent={1}
      lede="Add an item and watch what re-renders. Our engineers keep state close to where it’s used, so updates touch only what they must."
      nodes={[
        { name: "App", x: 0.5, row: 0, path: true },
        { name: "Layout", parent: 0, x: 0.5, row: 1, path: true },
        { name: "Header", parent: 1, x: 0.1667, row: 2, path: true },
        { name: "Nav", parent: 2, x: 0.0833, row: 3, memo: true },
        { name: "CartBadge", parent: 2, x: 0.25, row: 3, path: true },
        { name: "ProductList", parent: 1, x: 0.5833, row: 2, memo: true },
        { name: "ProductCard", parent: 5, x: 0.4167, row: 3 },
        { name: "ProductCard", parent: 5, x: 0.5833, row: 3 },
        { name: "ProductCard", parent: 5, x: 0.75, row: 3 },
        { name: "Footer", parent: 1, x: 0.9167, row: 2, memo: true },
      ]}
      action={{ label: "Add to cart", code: "setCart(items + 1)" }}
      memoLabel="Wrap in React.memo"
      counts={{ rendered: "Re-rendered", skipped: "Skipped" }}
    />
    <EcosystemSection
      id="ecosystem"
      eyebrow="The ecosystem"
      headline={["React at the core.", "The rest in orbit."]}
      lede="React is the nucleus. Around it, the libraries our developers ship with every week, each chosen for one job."
      media={{ image: deskPhoto, alt: "A developer studies a component layout on his monitor at a home-office desk.", focus: "62% 30%" }}
      core="React"
      orbits={[
        {
          name: "Build",
          libs: [
            { slug: "nextdotjs", role: "Framework" },
            { slug: "vite", role: "Bundler" },
            { slug: "tailwindcss", role: "Styling" },
          ],
        },
        {
          name: "Code",
          libs: [
            { slug: "typescript", role: "Types" },
            { slug: "redux", role: "State" },
            { slug: "reactquery", role: "Fetching" },
          ],
        },
        {
          name: "Quality",
          libs: [
            { slug: "jest", role: "Tests" },
            { slug: "testinglibrary", role: "Behaviour" },
            { slug: "storybook", role: "Workshop" },
          ],
        },
      ]}
    />
    <ScorecardSection
      id="scorecard"
      eyebrow="Performance"
      headline={["Fast to load.", "Fast to use."]}
      accent={1}
      lede="Every release is audited before it ships. These are the scores we aim for on a real product page, on a mid-range phone."
      media={{ image: pairingPhoto, alt: "Two developers pair on code across a laptop and a pair of monitors.", focus: "50% 45%" }}
      tool={{ slug: "lighthouse", label: "Lab audit · Lighthouse" }}
      scores={[
        { label: "Performance", value: 96 },
        { label: "Accessibility", value: 100 },
        { label: "Best practices", value: 100 },
        { label: "SEO", value: 98 },
      ]}
      vitalsTitle="Core Web Vitals · field, 75th percentile"
      vitals={[
        { abbr: "LCP", name: "Largest Contentful Paint", value: 1.8, unit: "s", good: 2.5, poor: 4, max: 5 },
        { abbr: "INP", name: "Interaction to Next Paint", value: 120, unit: "ms", good: 200, poor: 500, max: 600 },
        { abbr: "CLS", name: "Cumulative Layout Shift", value: 0.04, unit: "", good: 0.1, poor: 0.25, max: 0.3 },
      ]}
      zones={["Good", "Needs work", "Poor"]}
    />
    <FaqSection
      eyebrow="React questions"
      headline={["Props, state,", "and answers."]}
      accent={1}
      cta="Talk to a React lead"
      faqs={FAQS}
      media={{ image: faqPhoto, alt: "A senior developer points out a change on a colleague’s monitor.", focus: "50% 40%" }}
    />
    <CtaSection
      eyebrow="Ready to render"
      headline={["Fewer re-renders.", "More releases."]}
      body="Tell us about your React app and your roadmap. We’ll put forward developers who fit your stack."
      cta="Meet React developers"
    />
  </main>
  <Footer />
</Layout>
