---
import { Image } from "astro:assets";
import GridRules from "@/components/GridRules.astro";
import SectionHead from "@/components/SectionHead.astro";
import TechLogo from "@/components/TechLogo.astro";
import Joints from "@/components/process/Joints.astro";
import type { TechLogoSlug } from "@/lib/tech-logos";
import type { SectionPhoto } from "@/types/page";

/* A performance scorecard, as an audit report. One frame on the columns:
   along the top, four circular gauges, one per column, each ring drawing
   round to its score while the number counts up, with a tick at 90 where a
   score turns good. Under them, a photo of the team in columns 1–2 and the
   Core Web Vitals in columns 3–4: each a bar on a scale split at its
   thresholds (good, needs work, poor), filling to its measured value.
   Replays on each arrival; reduced motion shows the finished report. See
   docs/sections.md. */

interface Vital {
  abbr: string;
  name: string;
  value: number;
  unit: string;
  /** Good up to `good`, poor from `poor`; the bar runs to `max`. */
  good: number;
  poor: number;
  max: number;
}

interface Props {
  id: string;
  eyebrow: string;
  headline: string[];
  accent?: number;
  lede: string;
  media: SectionPhoto;
  tool: { slug: TechLogoSlug; label: string };
  scores: { label: string; value: number }[];
  vitalsTitle: string;
  vitals: Vital[];
  zones: [string, string, string];
}

const { id, eyebrow, headline, accent, lede, media, tool, scores, vitalsTitle, vitals, zones } = Astro.props;
const pct = (v: number, max: number) => +((v / max) * 100).toFixed(2);
const fmt = (v: Vital, n: number) => (v.unit === "" ? n.toFixed(2) : `${n}${v.unit}`);
---

<section data-ac-sec="light" data-ac-score id={id}>
  <GridRules />

  <div data-ac-sec-container>
    <SectionHead eyebrow={eyebrow} headline={headline} accent={accent} lede={lede} />

    <div data-ac-sec-frame data-ac-score-frame>
      <Joints />
      <p data-ac-score-tool class="mono-label-sm">
        <TechLogo slug={tool.slug} size={14} />
        {tool.label}
      </p>

      <ul data-ac-score-gauges>
        {scores.map((score, i) => (
          <li data-ac-score-gauge style={`--ac-i:${i};--ac-v:${score.value}`}>
            <span data-ac-score-dial>
              <svg viewBox="0 0 120 120" aria-hidden="true">
                <circle data-ac-score-track cx="60" cy="60" r="52" />
                <circle data-ac-score-arc cx="60" cy="60" r="52" pathLength="100" transform="rotate(-90 60 60)" />
                <line data-ac-score-tick x1="60" y1="2" x2="60" y2="14" transform="rotate(324 60 60)" />
              </svg>
              <b data-ac-score-num data-to={score.value}>{score.value}</b>
            </span>
            <span data-ac-score-label>{score.label}</span>
            <span class="sr-only">: {score.value} out of 100</span>
          </li>
        ))}
      </ul>

      <div data-ac-score-foot>
        <div data-ac-score-photo>
          <Image
            src={media.image}
            alt={media.alt}
            widths={[480, 800, 1200]}
            sizes="(max-width: 991px) 100vw, 46vw"
            quality={78}
            style={media.focus ? `object-position:${media.focus}` : undefined}
          />
        </div>

        <div data-ac-score-vitals>
          <p data-ac-score-vitals-title class="mono-label">{vitalsTitle}</p>
          <ul>
            {vitals.map((v, i) => (
              <li data-ac-score-vital style={`--ac-i:${i};--ac-good:${pct(v.good, v.max)}%;--ac-poor:${pct(v.poor, v.max)}%;--ac-val:${pct(v.value, v.max)}%`}>
                <p data-ac-score-vital-head>
                  <span data-ac-score-abbr>{v.abbr}</span>
                  <span data-ac-score-name>{v.name}</span>
                  <b data-ac-score-value>{fmt(v, v.value)}</b>
                </p>
                <span data-ac-score-bar aria-hidden="true">
                  <i data-ac-score-fill />
                  <i data-ac-score-mark />
                </span>
                <span data-ac-score-scale aria-hidden="true">
                  <span style="left:0">0</span>
                  <span style={`left:${pct(v.good, v.max)}%`}>{fmt(v, v.good)}</span>
                  <span style={`left:${pct(v.poor, v.max)}%`}>{fmt(v, v.poor)}</span>
                </span>
                <span class="sr-only">
                  {v.name}: {fmt(v, v.value)}. Good is under {fmt(v, v.good)}.
                </span>
              </li>
            ))}
          </ul>
          <p data-ac-score-legend aria-hidden="true">
            <span data-zone="good">{zones[0]}</span>
            <span data-zone="mid">{zones[1]}</span>
            <span data-zone="poor">{zones[2]}</span>
          </p>
        </div>
      </div>
    </div>
  </div>
</section>

<script>
  document.querySelectorAll<HTMLElement>("[data-ac-score]").forEach((section) => {
    const nums = Array.from(section.querySelectorAll<HTMLElement>("[data-ac-score-num]"));
    const reduced = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
    let raf = 0;

    const set = (p: number) =>
      nums.forEach((n) => {
        n.textContent = String(Math.round(Number(n.dataset.to) * p));
      });

    /* The numbers count up with the rings: same duration, same ease. */
    const count = () => {
      cancelAnimationFrame(raf);
      const start = performance.now() + 250;
      const DUR = 1400;
      const step = (now: number) => {
        const t = Math.min(1, Math.max(0, (now - start) / DUR));
        set(1 - Math.pow(1 - t, 3));
        if (t < 1) raf = requestAnimationFrame(step);
      };
      raf = requestAnimationFrame(step);
    };

    new IntersectionObserver(
      ([entry]) => {
        section.toggleAttribute("data-ac-in", entry.isIntersecting);
        if (reduced) return;
        if (entry.isIntersecting) count();
        else {
          cancelAnimationFrame(raf);
          set(0);
        }
      },
      { threshold: 0, rootMargin: "-10% 0px -10% 0px" },
    ).observe(section);
  });
</script>
