---
import { Image } from "astro:assets";
import GridRules from "@/components/GridRules.astro";
import RevealText from "@/components/RevealText.astro";
import TechLogo from "@/components/TechLogo.astro";
import Joints from "@/components/process/Joints.astro";
import { TECH_LOGOS, type TechLogoSlug } from "@/lib/tech-logos";
import type { SectionPhoto } from "@/types/page";

/* The atom and its ecosystem, on the dark tone. The headline spans the top.
   Under it, three bands on the columns: a photo of the team in column 1,
   the atom in columns 2–3 and its key in column 4. The atom is React's mark
   drawn large: the logo at the nucleus and three elliptical orbits in fine
   line, one per kind of work (build, code, quality). Each library sits on
   its orbit as a 12px tile with a one-word role, and the tiles travel their
   orbits slowly while the section is on screen, spaced so they never meet.
   Pointing at or focusing an orbit in the key lights that orbit and its
   tiles. Reduced motion, or no script, holds the tiles still. See
   docs/sections.md. */

interface Orbit {
  name: string;
  libs: { slug: TechLogoSlug; role: string }[];
}

interface Props {
  id: string;
  eyebrow: string;
  headline: string[];
  accent?: number;
  lede: string;
  media: SectionPhoto;
  core: string;
  /** Three orbits of three libraries each. */
  orbits: Orbit[];
}

const { id, eyebrow, headline, accent = headline.length - 1, lede, media, core, orbits } = Astro.props;
const offsets = headline.map((_, i) => headline.slice(0, i).reduce((n, line) => n + Array.from(line).length + 1, 0));

/* A 600-unit square, the nucleus at its centre. The three orbits are
   ellipses turned 0°, 60° and 120°, as in the mark. Tiles start 120° apart
   on their orbit, each orbit phased so no two tiles come closer than about a
   sixth of the square as they travel. */
const A = 250;
const B = 92;
const PHASES = [0, 50, 115];
const tiles = orbits.flatMap((orbit, k) =>
  orbit.libs.map((lib, j) => {
    const rot = (k * 60 * Math.PI) / 180;
    const t = ((PHASES[k] + j * 120) * Math.PI) / 180;
    const ex = A * Math.cos(t);
    const ey = B * Math.sin(t);
    return {
      ...lib,
      orbit: k,
      t0: PHASES[k] + j * 120,
      x: +(ex * Math.cos(rot) - ey * Math.sin(rot)).toFixed(1),
      y: +(ex * Math.sin(rot) + ey * Math.cos(rot)).toFixed(1),
    };
  }),
);
---

<section data-ac-sec="dark" data-ac-atom id={id}>
  <GridRules />

  <div data-ac-sec-container data-ac-atom-grid>
    <div data-ac-atom-head>
      <p data-ac-sec-eyebrow class="mono-label">
        <span aria-hidden="true">+</span>
        {eyebrow}
      </p>
      <h2 data-ac-atom-headline aria-label={headline.join(" ")}>
        {headline.map((line, i) => (
          <Fragment>
            {i > 0 && <Fragment>{" "}<br aria-hidden="true" /></Fragment>}
            <span data-ac-sec-line data-accent={i === accent || undefined}>
              <RevealText text={line} offset={offsets[i]} />
            </span>
          </Fragment>
        ))}
      </h2>
    </div>
    <p data-ac-atom-lede data-ac-sec-rise>{lede}</p>

    <div data-ac-atom-photo>
      <Joints />
      <div data-ac-atom-image>
        <Image
          src={media.image}
          alt={media.alt}
          widths={[480, 800, 1200]}
          sizes="(max-width: 991px) 100vw, 24vw"
          quality={78}
          style={media.focus ? `object-position:${media.focus}` : undefined}
        />
      </div>
    </div>

    <div data-ac-atom-stage>
      <div data-ac-atom-field role="img" aria-label={`${core} at the centre, with ${orbits.flatMap((o) => o.libs).length} libraries on three orbits.`}>
        <svg viewBox="0 0 600 600" aria-hidden="true">
          <circle data-ac-atom-ring cx="300" cy="300" r="290" />
          <circle data-ac-atom-ring cx="300" cy="300" r="142" />
          <line data-ac-atom-axis x1="0" y1="300" x2="600" y2="300" />
          <line data-ac-atom-axis x1="300" y1="0" x2="300" y2="600" />
          {orbits.map((_, k) => (
            <ellipse
              data-ac-atom-orbit
              data-orbit={k}
              cx="300"
              cy="300"
              rx={A}
              ry={B}
              transform={`rotate(${k * 60} 300 300)`}
              pathLength="1"
              style={`--ac-i:${k}`}
            />
          ))}
          <circle data-ac-atom-halo cx="300" cy="300" r="62" />
        </svg>

        <span data-ac-atom-core>
          <TechLogo slug="react" size={88} />
        </span>

        {tiles.map((tile, i) => (
          <span
            data-ac-atom-tile
            data-orbit={tile.orbit}
            data-t0={tile.t0}
            style={`--x:${tile.x};--y:${tile.y};--ac-i:${i}`}
          >
            <span data-ac-atom-chip><TechLogo slug={tile.slug} size={26} /></span>
            <span data-ac-atom-role class="mono-label-sm">{tile.role}</span>
          </span>
        ))}
      </div>
    </div>

    <ol data-ac-atom-key>
      {orbits.map((orbit, k) => (
        <li data-ac-atom-group data-orbit={k} tabindex="0" style={`--ac-i:${k}`}>
          <p data-ac-atom-group-name>
            <span class="mono-label-sm">Orbit {String(k + 1).padStart(2, "0")}</span>
            <span>{orbit.name}</span>
          </p>
          <ul>
            {orbit.libs.map((lib) => (
              <li>
                <span data-ac-atom-mini><TechLogo slug={lib.slug} size={18} /></span>
                <span data-ac-atom-lib>{TECH_LOGOS[lib.slug].title}</span>
                <span data-ac-atom-librole class="mono-label-sm">{lib.role}</span>
              </li>
            ))}
          </ul>
        </li>
      ))}
    </ol>
  </div>
</section>

<script>
  import { toggleInView } from "@/lib/in-view";

  document.querySelectorAll<HTMLElement>("[data-ac-atom]").forEach((section) => {
    toggleInView(section);

    /* The key lights its orbit. */
    const groups = Array.from(section.querySelectorAll<HTMLElement>("[data-ac-atom-group]"));
    const light = (k: string | null) => {
      if (k === null) section.removeAttribute("data-orbit-lit");
      else section.setAttribute("data-orbit-lit", k);
      section.querySelectorAll<Element>("[data-orbit]").forEach((el) => {
        el.toggleAttribute("data-lit", k !== null && el.getAttribute("data-orbit") === k);
      });
    };
    groups.forEach((g) => {
      g.addEventListener("pointerenter", () => light(g.dataset.orbit ?? null));
      g.addEventListener("pointerleave", () => light(null));
      g.addEventListener("focus", () => light(g.dataset.orbit ?? null));
      g.addEventListener("blur", () => light(null));
    });

    /* The tiles travel their orbits: one turn every 96 seconds, only while
       the section is on screen. Only custom properties change, which feed a
       transform, so nothing is laid out again. */
    if (window.matchMedia("(prefers-reduced-motion: reduce)").matches) return;
    const tiles = Array.from(section.querySelectorAll<HTMLElement>("[data-ac-atom-tile]"));
    const A = 250;
    const B = 92;
    const PERIOD = 96_000;
    let raf = 0;
    let last = 0;
    let offset = 0;

    const frame = (now: number) => {
      if (last) offset += ((now - last) / PERIOD) * 360;
      last = now;
      tiles.forEach((tile) => {
        const rot = (Number(tile.dataset.orbit) * 60 * Math.PI) / 180;
        const t = ((Number(tile.dataset.t0) + offset) * Math.PI) / 180;
        const ex = A * Math.cos(t);
        const ey = B * Math.sin(t);
        tile.style.setProperty("--x", (ex * Math.cos(rot) - ey * Math.sin(rot)).toFixed(2));
        tile.style.setProperty("--y", (ex * Math.sin(rot) + ey * Math.cos(rot)).toFixed(2));
      });
      raf = requestAnimationFrame(frame);
    };

    new IntersectionObserver(([entry]) => {
      cancelAnimationFrame(raf);
      last = 0;
      if (entry.isIntersecting) raf = requestAnimationFrame(frame);
    }).observe(section);
  });
</script>
