---
import GridRules from "@/components/GridRules.astro";
import SectionHead from "@/components/SectionHead.astro";
import TechLogo from "@/components/TechLogo.astro";
import Joints from "@/components/process/Joints.astro";

/* The version climb, on the light tone. Under the header, one frame: the
   key in column 1 (what is measured, the baseline, a note that the figures
   are illustrative), then a staircase across columns 2–4, one step per PHP
   version, each as tall as its relative throughput, its figure on top. A
   stepped line runs along the tops and draws in as the bars rise. Under
   each step: its support status and what that upgrade brings.

   Bars rise with scaleY from their floor and the line reveals with a
   clip-path, so nothing moves. See docs/sections.md. */

interface Step {
  version: string;
  /** Relative throughput; the first step is the baseline. */
  value: number;
  figure: string;
  status: string;
  /** Still supported, drawn solid. */
  current?: boolean;
  brings: string[];
}

interface Props {
  id: string;
  eyebrow: string;
  headline: string[];
  accent?: number;
  lede: string;
  measure: string;
  baseline: string;
  note: string;
  bringsLabel: string;
  /** Key entries for the two bar fills: end of life, supported. */
  legend: [string, string];
  steps: Step[];
}

const { id, eyebrow, headline, accent, lede, measure, baseline, note, bringsLabel, legend, steps } = Astro.props;
const max = Math.max(...steps.map((s) => s.value));
const h = (v: number) => +(v / max).toFixed(3);
/* The stepped line along the bar tops, in a 100-unit-per-step box (y down). Bars
   fill 82% of the plot's height at most. */
const top = (v: number) => +(100 - h(v) * 82).toFixed(2);
const W = steps.length * 100;
const path =
  `M0 ${top(steps[0].value)} H100` +
  steps
    .slice(1)
    .map((s, i) => ` V${top(s.value)} H${(i + 2) * 100}`)
    .join("");
---

<section data-ac-sec="light" data-ac-climb id={id}>
  <GridRules />

  <div data-ac-sec-container>
    <SectionHead eyebrow={eyebrow} headline={headline} accent={accent} lede={lede} />

    <figure data-ac-climb-frame data-ac-sec-rise>
      <Joints />
      <figcaption data-ac-climb-key>
        <span data-ac-climb-badge><TechLogo slug="php" size={30} /></span>
        <span data-ac-climb-measure>{measure}</span>
        <span class="mono-label-sm" data-ac-climb-base>{baseline}</span>
        <span data-ac-climb-legend>
          <span><i data-kind="eol" aria-hidden="true" />{legend[0]}</span>
          <span><i data-kind="current" aria-hidden="true" />{legend[1]}</span>
        </span>
        <span class="mono-label-sm" data-ac-climb-note>{note}</span>
      </figcaption>

      <div data-ac-climb-chart>
        <div data-ac-climb-plot aria-hidden="true">
          <i data-ac-climb-gridline style={`--ac-y:${h(1) * 0.82}`} />
          <i data-ac-climb-gridline style={`--ac-y:${h(2) * 0.82}`} />
          {steps.map((step, i) => (
            <div data-ac-climb-col style={`--ac-i:${i}`}>
              <div data-ac-climb-bar data-current={step.current || undefined} style={`--ac-h:${h(step.value) * 0.82}`} />
              <span data-ac-climb-fig style={`--ac-h:${h(step.value) * 0.82}`}>{step.figure}</span>
            </div>
          ))}
          <svg data-ac-climb-line viewBox={`0 0 ${W} 100`} preserveAspectRatio="none">
            <path d={path} vector-effect="non-scaling-stroke" />
          </svg>
        </div>

        <ol data-ac-climb-steps>
          {steps.map((step, i) => (
            <li data-ac-climb-step style={`--ac-i:${i}`}>
              <p data-ac-climb-ver>
                <span>{step.version}</span>
                <span class="mono-label-sm" data-current={step.current || undefined}>{step.status}</span>
              </p>
              <p data-ac-climb-figtext class="sr-only">{step.figure}</p>
              <p class="mono-label-sm" data-ac-climb-brings>{bringsLabel}</p>
              <ul>
                {step.brings.map((item) => <li>{item}</li>)}
              </ul>
            </li>
          ))}
        </ol>
      </div>
    </figure>
  </div>
</section>

<script>
  import { toggleInView } from "@/lib/in-view";

  document.querySelectorAll<HTMLElement>("[data-ac-climb]").forEach(toggleInView);
</script>
