---
import "@pg/page30/styles/globals.css";
import "@/styles/globals.css";
import Layout from "@pg/page30/layouts/Layout.astro";
import Navbar from "@/components/Navbar.astro";
import Footer from "@/components/Footer.astro";
import ContactForm from "@/components/ContactForm.astro";
import PageHero from "@pg/page30/components/PageHero.astro";
import SmoothScroll from "@pg/page30/components/SmoothScroll.astro";
import HireWhy from "@pg/page30/components/hire/HireWhy.astro";
import HirePod from "@pg/page30/components/hire/HirePod.astro";
import HireColumns from "@pg/page30/components/hire/HireColumns.astro";
import type { PageHeroContent } from "@pg/page30/types/page";
import heroPhoto from "@/assets/why/people.jpg";

/* About JumpGrowth. Built from the same section kit as every other subpage;
   the words are the company's own (jumpgrowth.com/about): Our Story, why we
   are different, the leadership team and our locations. Leadership and
   Locations are sections of this page, as on the company site. */

const HERO: PageHeroContent = {
  trail: ["Company", "About"],
  audience: "A digital studio by OTS Solutions",
  headline: ["A digital studio", "built to ship."],
  size: "long",
  lede: "JumpGrowth helps startups and businesses build scalable web and mobile apps, with agile delivery and emerging tech like AI, AR/VR and IoT.",
  ctas: [
    { label: "Build your team", href: "#contact", arrow: "diagonal" },
    { label: "Meet the leadership", href: "#leadership", arrow: "right" },
  ],
  assurances: [
    { icon: "users", label: "200+ engineers under one roof" },
    { icon: "globe", label: "Four delivery countries" },
    { icon: "shield", label: "Part of OTS Solutions" },
  ],
  image: heroPhoto,
  imageAlt: "Two engineers review code together on a laptop in a busy studio.",
  card: {
    status: "Since 2018 / Active",
    place: "Dallas headquartered",
    note: "300+ clients served across four delivery countries.",
    kicker: "Our story.",
    statement: "Scalable web and mobile products, from idea to release.",
    foot: { label: "Established", value: "2018, as a separate brand of OTS Solutions" },
  },
  specs: [
    { label: "Years of experience", value: "20+" },
    { label: "Clients served", value: "300+" },
    { label: "Engineers under one roof", value: "200+" },
    { label: "Global delivery locations", value: "4+" },
  ],
  base: { title: "Dallas headquartered", line: "Delivery across the USA, India, Canada and Mexico" },
};
---

<Layout
  title="About · JumpGrowth"
  description="JumpGrowth is a digital studio by OTS Solutions: 300+ clients since 2018, building scalable web, mobile and AI products across four delivery countries."
  navTone="field"
>
  <SmoothScroll />
  <Navbar />
  <main>
    <PageHero content={HERO} />

    <HireWhy
      id="why"
      eyebrow="Why we are different"
      headline={["Why teams", "choose JumpGrowth."]}
      lede="A customer-centric studio pairing senior engineering with a delivery model shaped around each client."
      reasons={[
        {
          title: "20 years of proven processes",
          body: "With a customer-centric approach and a deep understanding of industry needs, JumpGrowth has consistently delivered innovative, tailored solutions through a proven process refined over two decades.",
          points: ["Customer-centric approach", "Deep industry understanding", "Two decades of delivery"],
        },
        {
          title: "Cutting-edge tech expertise",
          body: "We have stayed at the forefront of technology. Highly skilled professionals, with a commitment to quality and timely delivery, build long-term relationships with clients across diverse industries.",
          points: ["Highly skilled professionals", "Quality and timely delivery", "Long-term client relationships"],
        },
        {
          title: "X-Shore delivery model",
          body: "Our delivery is directed towards efficient project execution for clients across the globe, from multiple delivery locations chosen around each client's needs.",
          points: ["Onshore, nearshore and offshore", "Locations you choose", "Efficient project execution"],
        },
      ]}
      figures={[
        { value: "20+", label: "Years of experience" },
        { value: "300+", label: "Clients served" },
        { value: "200+", label: "Engineers under one roof" },
      ]}
      cta={{ label: "Talk to our team", href: "#contact" }}
    />

    <HirePod
      id="leadership"
      tone="dark"
      eyebrow="Leadership"
      headline={["The people", "leading JumpGrowth."]}
      lede="JumpGrowth was established in 2018 as a separate brand of OTS Solutions, focused on high-quality digital development for mid-sized businesses and enterprises."
      points={[
        { lead: "300+ clients", rest: " served since 2018." },
        { lead: "Agile delivery", rest: " with intuitive design and senior engineering." },
        { lead: "Emerging tech", rest: " across AI, AR/VR and IoT." },
      ]}
      rosterLabel="Leadership team / 03"
      status="Dallas HQ"
      members={[
        { initials: "HM", role: "Hemant Madaan", layer: "CEO" },
        { initials: "NM", role: "Naval Madaan", layer: "Chief Operating Officer" },
        { initials: "JJ", role: "Jignesh Jayaswal", layer: "Financial Controller" },
      ]}
      terms={[
        { label: "Founded", value: "2018" },
        { label: "Part of", value: "OTS Solutions" },
        { label: "Headquarters", value: "Dallas, TX" },
      ]}
      cta={{ label: "Talk to our team", href: "#contact" }}
    />

    <HireColumns
      id="locations"
      eyebrow="Our global presence"
      headline={["One team,", "three talent regions."]}
      lede="Dallas-headquartered, with delivery teams across the US, India, Canada and Mexico."
      columns={[
        {
          label: "Onshore",
          title: "United States",
          body: "Headquarters: 801 E Campbell Rd, Ste 365, Richardson, TX 75081.",
          tags: ["Dallas, TX", "Headquarters"],
        },
        {
          label: "Nearshore",
          title: "Mexico + Canada",
          body: "Delivery teams in Toronto and Mexico City, with strong working-hour overlap with US teams.",
          tags: ["Toronto", "Mexico City"],
        },
        {
          label: "Offshore",
          title: "India",
          body: "Engineering centres in Delhi NCR (Platinum Tower, Gurugram) and Pune (Almonte IT Park, Kharadi).",
          tags: ["Delhi NCR", "Pune"],
        },
      ]}
    />

    <ContactForm />
  </main>
  <Footer />
</Layout>
