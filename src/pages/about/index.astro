---
import "@pg/page30/styles/globals.css";
import "@/styles/globals.css";
import Layout from "@/layouts/Layout.astro";
import Navbar from "@/components/Navbar.astro";
import Footer from "@/components/Footer.astro";
import ContactForm from "@/components/ContactForm.astro";
import PageHero from "@pg/page30/components/PageHero.astro";
import SmoothScroll from "@pg/page30/components/SmoothScroll.astro";
import HireWhy from "@pg/page30/components/hire/HireWhy.astro";
import LeadershipSection from "@/components/about/LeadershipSection.astro";
import RecognitionSection from "@/components/about/RecognitionSection.astro";
import InsightsSection from "@/components/about/InsightsSection.astro";
import LocationsSection from "@/components/about/LocationsSection.astro";
import type { PageHeroContent } from "@pg/page30/types/page";
import heroPhoto from "@/assets/why/people.jpg";
import hemant from "@/assets/about/leader-hemant-madaan.jpg";
import naval from "@/assets/about/leader-naval-madaan.jpg";
import jignesh from "@/assets/about/leader-jignesh-jayaswal.jpg";
import awardFinance from "@/assets/about/award-clutch-app-dev-financial-texas.png";
import awardAi from "@/assets/about/award-clutch-ai-texas-2025.webp";
import awardMedical from "@/assets/about/award-clutch-software-medical-texas-2025.png";
import partnerMicrosoft from "@/assets/about/partner-microsoft.webp";
import partnerNetsuite from "@/assets/about/partner-netsuite.webp";
import partnerAws from "@/assets/about/partner-aws.webp";

/* About JumpGrowth: everything on the company's own About page
   (jumpgrowth.com/about) in this site's design — Our Story and the figures
   (hero), why we are different, the leadership team, achievements and
   partners, white papers / blogs / events, and every office. Leadership and
   Locations are sections of this page, as on the company site. */

const HERO: PageHeroContent = {
  trail: ["Company", "About"],
  audience: "A digital studio by OTS Solutions",
  headline: ["A digital studio", "built to ship."],
  size: "long",
  lede: "JumpGrowth helps startups and businesses build scalable web and mobile apps, with agile delivery and emerging tech like AI, AR/VR and IoT.",
  ctas: [
    { label: "Build your team", href: "#contact", arrow: "diagonal" },
    { label: "Meet the leadership", href: "#leadership", arrow: "right" },
  ],
  assurances: [
    { icon: "users", label: "200+ engineers under one roof" },
    { icon: "globe", label: "Four delivery countries" },
    { icon: "shield", label: "Part of OTS Solutions" },
  ],
  image: heroPhoto,
  imageAlt: "Two engineers review code together on a laptop in a busy studio.",
  card: {
    status: "Since 2018 / Active",
    place: "Dallas headquartered",
    note: "300+ clients served across four delivery countries.",
    kicker: "Our story.",
    statement: "Scalable web and mobile products, from idea to release.",
    foot: { label: "Established", value: "2018, as a separate brand of OTS Solutions" },
  },
  specs: [
    { label: "Years of experience", value: "20+" },
    { label: "Clients served", value: "300+" },
    { label: "Engineers under one roof", value: "200+" },
    { label: "Global delivery locations", value: "4+" },
  ],
  base: { title: "Dallas headquartered", line: "Delivery across the USA, India, Canada and Mexico" },
};
---

<Layout
  title="About · JumpGrowth"
  description="JumpGrowth is a digital studio by OTS Solutions: 300+ clients since 2018, building scalable web, mobile and AI products across four delivery countries."
  navTone="field"
>
  <SmoothScroll />
  <Navbar />
  <main>
    <PageHero content={HERO} />

    <HireWhy
      id="why"
      eyebrow="Why we are different"
      headline={["Why teams", "choose JumpGrowth."]}
      lede="A customer-centric studio pairing senior engineering with a delivery model shaped around each client."
      reasons={[
        {
          title: "20 years of proven processes",
          body: "With a customer-centric approach and a deep understanding of industry needs, JumpGrowth has consistently delivered innovative, tailored solutions through a proven process refined over two decades.",
          points: ["Customer-centric approach", "Deep industry understanding", "Two decades of delivery"],
        },
        {
          title: "Cutting-edge tech expertise",
          body: "We have stayed at the forefront of technology. Highly skilled professionals, with a commitment to quality and timely delivery, build long-term relationships with clients across diverse industries.",
          points: ["Highly skilled professionals", "Quality and timely delivery", "Long-term client relationships"],
        },
        {
          title: "X-Shore delivery model",
          body: "Our delivery is directed towards efficient project execution for clients across the globe, from multiple delivery locations chosen around each client's needs.",
          points: ["Onshore, nearshore and offshore", "Locations you choose", "Efficient project execution"],
        },
      ]}
      figures={[
        { value: "20+", label: "Years of experience" },
        { value: "300+", label: "Clients served" },
        { value: "200+", label: "Engineers under one roof" },
      ]}
      cta={{ label: "Talk to our team", href: "#contact" }}
    />

    <LeadershipSection
      eyebrow="Leadership"
      headline={["Meet our", "leadership team."]}
      lede="JumpGrowth was established in 2018 as a separate brand of OTS Solutions, and is led by a team with more than two decades of building software and the teams behind it."
      leaders={[
        { name: "Hemant Madaan", role: "CEO", photo: hemant, linkedin: "https://www.linkedin.com/in/hemantmadaan/" },
        { name: "Naval Madaan", role: "Chief Operating Officer", photo: naval, linkedin: "https://www.linkedin.com/in/navalmadaan/" },
        { name: "Jignesh Jayaswal", role: "Financial Controller", photo: jignesh, linkedin: "https://www.linkedin.com/in/jignesh-jayaswal-078a5854/" },
        { name: "Ketki Naidu", role: "HR Manager" },
      ]}
    />

    <RecognitionSection
      eyebrow="Achievements & partners"
      headline={["Recognised for the work.", "Partnered for scale."]}
      lede="Named among Texas's top development companies on Clutch, and partnering with leading tech providers to deliver smart, scalable, and impactful solutions."
      awards={[
        { badge: awardFinance, source: "Clutch", title: "Top App Development Company — Financial Services, Texas" },
        { badge: awardAi, source: "Clutch · 2025", title: "Top Artificial Intelligence Company — Texas" },
        { badge: awardMedical, source: "Clutch · 2025", title: "Top Software Developers — Medical, Texas" },
      ]}
      partnersLabel="Our partners"
      partnersLine="Partnering with leading tech providers to deliver smart, scalable, and impactful solutions."
      partners={[
        { logo: partnerMicrosoft, name: "Microsoft", height: 34 },
        { logo: partnerNetsuite, name: "Oracle NetSuite", height: 20 },
        { logo: partnerAws, name: "Amazon Web Services", height: 40 },
      ]}
    />

    <InsightsSection />

    <LocationsSection
      eyebrow="Our global presence"
      headline={["Teams across", "the globe."]}
      lede="With teams across the US, India, and beyond, we deliver seamless collaboration and round-the-clock support—no matter where you are."
    />

    <ContactForm />
  </main>
  <Footer />
</Layout>
