---
import "@pg/page30/styles/globals.css";
import "@/styles/globals.css";
import Layout from "@/layouts/Layout.astro";
import Navbar from "@/components/Navbar.astro";
import Footer from "@/components/Footer.astro";
import ContactForm from "@/components/ContactForm.astro";
import DetailHero from "@/components/DetailHero.astro";
import PaperDetail from "@/components/insights/PaperDetail.astro";
import RelatedPosts from "@/components/insights/RelatedPosts.astro";
import SmoothScroll from "@pg/page30/components/SmoothScroll.astro";
import { BLOG_POSTS, WHITE_PAPERS } from "@/lib/insights";
import { getPaperExtras } from "@/lib/papers";
import { withBase } from "@/lib/paths";

/* One white paper, in the site's own layout: its hero, what it covers, the
   other papers and a form to request it. The title, summary, topic and cover
   come from src/lib/insights.ts; the introduction and highlights, where the
   paper has them, from src/data/papers/<slug>.json. */

export function getStaticPaths() {
  return WHITE_PAPERS.map((paper) => ({ params: { slug: paper.slug }, props: { paper } }));
}

const { paper } = Astro.props;
const extras = getPaperExtras(paper.slug);
const others = WHITE_PAPERS.filter((other) => other.slug !== paper.slug);

/* Articles on the paper's subject: AI papers take the AI articles, the mobile
   paper takes the app and MVP ones. */
const onTopic =
  paper.topic === "Artificial Intelligence"
    ? (title: string) => /\bAI\b/.test(title)
    : (title: string) => /\bapp\b|MVP/i.test(title);
const reading = BLOG_POSTS.filter((post) => onTopic(post.title)).slice(0, 3);
---

<Layout
  title={paper.title}
  description={paper.summary.length > 160 ? `${paper.summary.slice(0, 157).replace(/\s+\S*$/, "")}…` : paper.summary}
  navTone="field"
  image={paper.cover}
  imageAlt={`Cover of the white paper “${paper.title}”`}
  breadcrumbs={[
    { name: "White Papers", path: "/whitepaper/" },
    { name: paper.title, path: `/whitepaper/${paper.slug}/` },
  ]}
>
  <SmoothScroll />
  <Navbar contactHref={withBase("/contact/")} />
  <main>
    <DetailHero
      trail={["Insights", "White Papers", paper.topic]}
      title={paper.title}
      chips={[paper.topic, "White paper"]}
      lede={paper.summary.length > 220 ? undefined : paper.summary}
      facts={[
        { label: "Topic", value: paper.topic },
        { label: "Published by", value: "JumpGrowth" },
      ]}
      actions={[
        { label: "Get the white paper", href: "#request", arrow: "right" },
        { label: "All white papers", href: withBase("/whitepaper/#papers"), arrow: "diagonal" },
      ]}
      image={paper.cover}
      imageAlt={`Cover of the white paper “${paper.title}”`}
      fit="contain"
    />
    <PaperDetail paper={paper} extras={extras} others={others} />
    {reading.length > 0 && (
      <RelatedPosts posts={reading} tone="light" eyebrow="Related reading" headline={["Articles on", `${paper.topic.toLowerCase()}.`]} />
    )}
    <ContactForm id="request" variant="paper" paper={paper.title} />
  </main>
  <Footer />
</Layout>
