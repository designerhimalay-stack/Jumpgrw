---
import "@pg/page33/styles/globals.css";
import "@/styles/globals.css";
import Layout from "@pg/page33/layouts/Layout.astro";
import FaqSection from "@pg/page33/components/FaqSection.astro";
import Footer from "@/components/Footer.astro";
import Navbar from "@/components/Navbar.astro";
import PageHero from "@pg/page33/components/PageHero.astro";
import SmoothScroll from "@pg/page33/components/SmoothScroll.astro";
import HireStack from "@pg/page33/components/hire/HireStack.astro";
import HireServices from "@pg/page33/components/hire/HireServices.astro";
import HireWhy from "@pg/page33/components/hire/HireWhy.astro";
import HireWays from "@pg/page33/components/hire/HireWays.astro";
import HirePlanner from "@pg/page33/components/hire/HirePlanner.astro";
import HireEngineers from "@pg/page33/components/hire/HireEngineers.astro";
import HireColumns from "@pg/page33/components/hire/HireColumns.astro";
import HireSteps from "@pg/page33/components/hire/HireSteps.astro";
import HireCases from "@pg/page33/components/hire/HireCases.astro";
import HirePod from "@pg/page33/components/hire/HirePod.astro";
import HireFit from "@pg/page33/components/hire/HireFit.astro";
import HireProcess from "@pg/page33/components/hire/HireProcess.astro";
import ContactForm from "@/components/ContactForm.astro";
import type { PageHeroContent } from "@pg/page33/types/page";
import { BRAND } from "@pg/page33/lib/brand";

import heroPhoto from "@pg/page33/assets/pages/p33-hero.jpg";
import faqPhoto from "@pg/page33/assets/pages/p33-stack.jpg";
import waysSolo from "@pg/page33/assets/pages/p33-ways-solo.jpg";
import waysSquad from "@pg/page33/assets/pages/p33-ways-squad.jpg";
import waysPod from "@pg/page33/assets/pages/p33-faq.jpg";
import engFullstack from "@pg/page33/assets/pages/p33-fullstack.jpg";
import engMobile from "@pg/page33/assets/pages/p33-eng-mobile.jpg";
import engBackend from "@pg/page33/assets/pages/p33-backend.jpg";
import engData from "@pg/page33/assets/pages/p33-data.jpg";
import engMl from "@pg/page33/assets/pages/p33-eng-ml.jpg";
import engQa from "@pg/page33/assets/pages/p33-qa.jpg";
import engDevops from "@pg/page33/assets/pages/p33-eng-devops.jpg";
import engLead from "@pg/page33/assets/pages/p33-lead.jpg";
import stepCall from "@pg/page33/assets/pages/p33-step-call.jpg";
import stepTeam from "@pg/page33/assets/pages/p33-step-team.jpg";

/* Offshore engineers, India. The page sells India-based engineers and teams
   across the stack (web and app, mobile, back end, data, AI/ML, QA, DevOps
   and cloud) with planned overlap with the US workday, built from the shared
   hire kit in src/components/hire/. The cost section is the kit's savings
   calculator. Every word on the page lives here. Figures, rates, example
   results and FAQ answers are the owner's figures or drafts: have them
   checked before launch (see docs/sections.md, "Copy to check before
   launch"). */

const HERO: PageHeroContent = {
  trail: ["X-Shore", "Offshore", "India"],
  audience: "For leaders scaling engineering teams",
  headline: ["Hire India-based", "engineers at scale,", "on US-aligned hours."],
  accent: 2,
  size: "long",
  lede: "Add experienced India-based web, mobile, data, AI or full-stack engineers to your product team, with planned US-hour overlap and a delivery model built around your roadmap.",
  ctas: [
    { label: "Plan your engineering hires", href: "#contact", arrow: "diagonal" },
    { label: "Explore team options", href: "#ways", arrow: "right" },
  ],
  assurances: [
    { icon: "shield", label: "Senior engineering oversight" },
    { icon: "clock", label: "US workday overlap" },
    { icon: "lock", label: "Your stack and controls" },
  ],
  image: heroPhoto,
  imageAlt: "A smiling developer in glasses sits at his desk in front of two monitors in an open office.",
  card: {
    status: "Build context / Active",
    place: "India-based, US-aligned",
    note: "One engineer this sprint. A full team by the quarter.",
    kicker: "Offshore capacity, inside your org.",
    statement: "Senior engineers who join your sprints and ship inside your review gates.",
    foot: { label: "Built for roadmaps that outgrow hiring", value: "One senior engineer to a managed delivery pod" },
  },
  specs: [
    { label: "Years engineering software", value: "20+" },
    { label: "Engineers under one roof", value: "200+" },
    { label: "Clients served", value: "300+" },
    { label: "Global delivery locations", value: "4+" },
  ],
  base: { title: "Dallas headquartered", line: "Delivery across the USA, India, Canada and Mexico" },
};

const FAQS = [
  {
    q: "Is this staff augmentation or a managed delivery team?",
    a: "Either. Add one engineer, a small squad, or a full pod with its own technical lead.",
  },
  {
    q: "Can we start with one engineer?",
    a: "Yes. Many teams start with one India-based engineer and add more once the way of working is settled.",
  },
  {
    q: "Can we interview engineers before we choose?",
    a: "Yes. You get pre-vetted profiles, interview the people you like and make the final call.",
  },
  {
    q: "What skills can we hire for?",
    a: "Web and app, mobile, back end, data, AI and ML, QA and DevOps and cloud, from one specialist to a full team.",
  },
  {
    q: "How do you match engineers to our team?",
    a: "We start from your stack, the work and the overlap hours you need, then send profiles that fit all three.",
  },
  {
    q: `How do ${BRAND.name} engineers collaborate with US teams?`,
    a: "They keep planned overlap with your day for stand-ups and reviews, and leave written handoffs so work keeps moving between working days.",
  },
  {
    q: "Can the team work inside our cloud, tools and security controls?",
    a: "Yes. Engineers work in your repositories, cloud accounts and tools, under your access rules and release process.",
  },
  {
    q: "Can we scale the team after the first engineer starts?",
    a: "Yes. Add engineers as the roadmap grows, or move to a managed pod with its own lead.",
  },
  {
    q: "What happens after we select an engineer?",
    a: "We set up access, overlap hours, rituals and a first task, so the work starts in the first week.",
  },
];
---

<Layout
  title={`Offshore engineers, India · ${BRAND.name}`}
  description="Hire India-based engineers and teams: web and app, mobile, back end, data, AI/ML, QA and DevOps, with planned US-hour overlap and inside your delivery process."
  navTone="field"
>
  <SmoothScroll />
  <Navbar />
  <main>
    <PageHero content={HERO} />

    <HireStack
      id="stack"
      tone="tint"
      eyebrow="Tech we use"
      headline={["Engineers who", "fit your stack."]}
      lede="They work with the languages, frameworks, models and clouds your teams already use."
      groups={[
        { name: "Web and app", logos: ["react", "nextdotjs", "angular", "vuedotjs", "typescript", "nodedotjs"] },
        { name: "Mobile", logos: ["swift", "kotlin", "flutter", "android"], named: ["iOS", "React Native"] },
        { name: "Back end", logos: ["python", "fastapi", "django", "go", "openjdk", "dotnet", "postgresql", "mongodb"] },
        { name: "Data", logos: ["snowflake", "databricks", "apacheairflow", "apachekafka", "pandas"], named: ["dbt"] },
        { name: "AI and ML", logos: ["pytorch", "tensorflow", "scikitlearn", "huggingface", "langchain", "claude", "googlegemini", "mlflow"], named: ["OpenAI", "Llama", "Mistral"] },
        { name: "QA and testing", logos: ["selenium", "cypress", "jest", "postman"], named: ["Playwright"] },
        { name: "DevOps and cloud", logos: ["docker", "kubernetes", "terraform", "githubactions", "googlecloud"], named: ["AWS", "Azure"] },
      ]}
      note="We choose tools based on your product, data, security needs and deployment plan."
    />

    <HireServices
      id="help"
      tone="tint"
      eyebrow="More ways we can help"
      headline={["Choose the work", "your team needs."]}
      lede="Explore the work our India-based engineers take on, and the tools they use every day."
      services={[
        {
          name: "Web and app development",
          body: "Build product screens, portals and internal tools with engineers who work in your repository and ship on your release train.",
          work: ["Product features", "Customer portals", "Internal tools"],
          tools: ["React", "Next.js", "Angular", "TypeScript"],
        },
        {
          name: "Mobile apps",
          body: "Ship and maintain iOS and Android apps, native or cross-platform, with testing and store releases handled.",
          work: ["New apps", "Feature releases", "App performance"],
          tools: ["Swift", "Kotlin", "Flutter", "React Native"],
        },
        {
          name: "Back end and APIs",
          body: "Build the services, APIs and integrations your product runs on, with performance and security in mind from the start.",
          work: ["REST and GraphQL APIs", "Integrations", "Service upgrades"],
          tools: ["Python", "FastAPI", "Java", ".NET", "Go"],
        },
        {
          name: "Data engineering",
          body: "Move, clean and model your data, so reports, products and AI features run on numbers your teams trust.",
          work: ["Data pipelines", "Warehouses", "Data quality"],
          tools: ["Snowflake", "Databricks", "Airflow", "dbt", "Kafka"],
        },
        {
          name: "AI and machine learning",
          body: "Build AI into your product: assistants, search, predictions and agents, evaluated before anything reaches your users.",
          work: ["LLM features", "RAG and search", "Predictive models"],
          tools: ["PyTorch", "scikit-learn", "LangChain", "Hugging Face"],
        },
        {
          name: "QA and test automation",
          body: "Put test plans, automated suites and release checks around your product, so fewer defects reach your customers.",
          work: ["Test automation", "Regression suites", "API testing"],
          tools: ["Playwright", "Cypress", "Selenium", "Postman"],
        },
        {
          name: "DevOps and cloud",
          body: "Automate builds, deployments and infrastructure, and keep production monitored, secure and quick to recover.",
          work: ["CI/CD pipelines", "Infrastructure as code", "Monitoring"],
          tools: ["Docker", "Kubernetes", "Terraform", "AWS", "GitHub Actions"],
        },
        {
          name: "Maintenance and support",
          body: "Keep live products healthy with fixes, upgrades and small improvements, while your core team builds what comes next.",
          work: ["Bug fixing", "Version upgrades", "Support rotations"],
          tools: ["Jira", "GitHub", "Sentry", "Datadog"],
        },
      ]}
    />

    <HireWhy
      id="why"
      eyebrow={`Why ${BRAND.name}`}
      headline={["Why teams", `choose ${BRAND.name}.`]}
      lede="Senior India-based engineers with US client alignment, planned overlap hours and a delivery process built around your team."
      reasons={[
        {
          title: "Senior engineers, matched to your work",
          body: "Start with the skill you need, from web and mobile to data, AI, QA or cloud. You review the profiles and validate the fit before you choose.",
          points: ["Web to AI specialists", "Profiles you review", "Direct client validation"],
        },
        {
          title: "A delivery model built around your team",
          body: "Engineers join your sprints, tools and code reviews, and senior engineering oversight keeps quality steady as the team grows.",
          points: ["Your sprints and tools", "Senior oversight", "Scale up or down"],
        },
        {
          title: "US alignment, India delivery",
          body: "Client leadership in the US and planned overlap with your workday, with written handoffs so work moves on between working days.",
          points: ["Planned US-hour overlap", "Written handoffs", "Progress overnight"],
        },
      ]}
      figures={[
        { value: "20+", label: "Years building software" },
        { value: "200+", label: "Engineers in one team" },
        { value: "300+", label: "Clients served" },
      ]}
      cta={{ label: "Talk to our team", href: "#contact" }}
    />

    <HireWays
      id="ways"
      eyebrow="Ways to work together"
      headline={["Start with one engineer.", "Build a team", "when you need it."]}
      accent={2}
      lede="Choose the setup that fits your team and your delivery plan."
      models={[
        {
          kind: "Staff augmentation",
          size: "1 engineer",
          title: "Add one engineer",
          body: "A dedicated India-based engineer in your team, codebase and sprint cycle.",
          skills: ["Web or mobile", "Back end", "Data or AI"],
          photo: { image: waysSolo, alt: "A developer in a checked shirt works on a laptop at a bright desk.", focus: "68% 40%" },
        },
        {
          kind: "Augmented squad",
          size: "2–4 engineers",
          title: "Add a small team",
          body: "Web, data, AI or QA engineers to close a clear gap in your team.",
          skills: ["Product features", "Data pipelines", "QA and cloud"],
          photo: { image: waysSquad, alt: "Developers work side by side at desktop computers in a long, bright office.", focus: "65% 50%" },
        },
        {
          kind: "Managed delivery pod",
          size: "5–8 engineers",
          title: "Build a delivery pod",
          body: "A connected team with its own technical lead, for a product or a stream of work.",
          skills: ["Architecture", "Delivery", "AI products"],
          photo: { image: waysPod, alt: "A team talks through its work around a table of laptops in a coworking space.", focus: "55% 50%" },
        },
      ]}
      cta={{ label: "Plan this team shape", href: "#plan" }}
      control={{ lead: "You stay in control.", rest: `${BRAND.name} engineers work in your codebase, tools and delivery process.` }}
    />

    <HirePlanner
      id="plan"
      tone="tint"
      eyebrow="Cost savings calculator"
      headline={["Estimate your", "monthly savings."]}
      lede="Move the slider to compare a senior US engineering team with an India-based team of the same size."
      rate={32}
      compare={{ rate: 90, label: "US onshore at $90/hr" }}
      hours={160}
      max={12}
      start={3}
      panelLabel="Monthly team cost"
      tagLabel="{n} senior {people}"
      teamLabel="Offshore at $32/hr"
      saveLabel="Estimated monthly savings"
      saveNote="About {pct}% lower than the US onshore planning estimate."
      sizeLabel="Your team size"
      unit={["engineer", "engineers"]}
      cta={{ label: "Build my team plan", href: "#contact" }}
      disclaimer="Get a tailored cost view based on your roles, skills and stack."
      note={`Planning estimate at $90 an hour US onshore and $32 an hour offshore, with 160 hours per engineer each month. This is not a ${BRAND.name} quote.`}
    />

    <HireEngineers
      id="engineers"
      eyebrow="Find the right skill"
      headline={["Find the engineer", "you need."]}
      lede={`Pick a skill to see the types of engineers ${BRAND.name} can match to your team.`}
      allLabel="All engineers"
      filters={[
        { key: "web", label: "Web & mobile" },
        { key: "backend", label: "Back end" },
        { key: "data", label: "Data & AI" },
        { key: "qa", label: "QA" },
        { key: "cloud", label: "DevOps & cloud" },
      ]}
      engineers={[
        {
          level: "Senior specialty role",
          role: "Full-stack web developer",
          for: "For product features end to end, from the database and API to the screen.",
          years: "8+ years",
          skills: ["React", "Node.js", "TypeScript", "PostgreSQL"],
          tags: ["web", "backend"],
          photo: { image: engFullstack, alt: "A developer in a white polo shirt works on a laptop at a white desk.", focus: "45% 30%" },
        },
        {
          level: "Senior specialty role",
          role: "Mobile app developer",
          for: "For iOS and Android apps, store releases and app performance.",
          years: "6+ years",
          skills: ["Swift", "Kotlin", "Flutter", "React Native"],
          tags: ["web"],
          photo: { image: engMobile, alt: "A developer types on a sticker-covered laptop at a desk in a quiet office.", focus: "70% 30%" },
        },
        {
          level: "Senior specialty role",
          role: "Back-end engineer",
          for: "For APIs, services, integrations and the data behind them.",
          years: "9+ years",
          skills: ["Python", "FastAPI", "Java", "Microservices"],
          tags: ["backend"],
          photo: { image: engBackend, alt: "A smiling engineer in a headset sits at a white desk.", focus: "45% 30%" },
        },
        {
          level: "Senior specialty role",
          role: "Data engineer",
          for: "For pipelines, warehouses, data quality and analytics.",
          years: "7+ years",
          skills: ["Snowflake", "Airflow", "dbt", "SQL"],
          tags: ["data"],
          photo: { image: engData, alt: "A data engineer works on a laptop on a bench outdoors.", focus: "38% 35%" },
        },
        {
          level: "Senior specialty role",
          role: "AI/ML engineer",
          for: "For predictive models, LLM features, RAG search and evaluation.",
          years: "7+ years",
          skills: ["PyTorch", "scikit-learn", "LangChain", "MLflow"],
          tags: ["data"],
          photo: { image: engMl, alt: "An engineer in glasses concentrates on his screen in an office.", focus: "55% 35%" },
        },
        {
          level: "Senior specialty role",
          role: "QA automation engineer",
          for: "For test plans, automated suites, API tests and release checks.",
          years: "6+ years",
          skills: ["Playwright", "Cypress", "Selenium", "Postman"],
          tags: ["qa"],
          photo: { image: engQa, alt: "A QA engineer in a blue shirt stands in an office.", focus: "50% 22%" },
        },
        {
          level: "Senior specialty role",
          role: "DevOps and cloud engineer",
          for: "For CI/CD, infrastructure as code, monitoring and uptime.",
          years: "8+ years",
          skills: ["Kubernetes", "Terraform", "AWS", "GitHub Actions"],
          tags: ["cloud"],
          photo: { image: engDevops, alt: "An engineer looks up from his desk of screens in a bright office.", focus: "62% 40%" },
        },
        {
          level: "Senior specialty role",
          role: "Technical lead",
          for: "For architecture, code reviews and leading a pod inside your process.",
          years: "12+ years",
          skills: ["System design", "Code review", "Cloud architecture", "Mentoring"],
          tags: ["backend", "cloud"],
          photo: { image: engLead, alt: "A technical lead in glasses and a blazer smiles in an office.", focus: "50% 25%" },
        },
      ]}
      cta={{ label: "Discuss this engineering hire", href: "#contact" }}
      footnote={`These are example roles. ${BRAND.name} confirms availability and fit before you decide.`}
    />

    <HireColumns
      id="do"
      eyebrow="What our engineers do"
      headline={["Get help across", "your whole stack."]}
      lede="Add the skills you need across apps, data, AI and operations."
      columns={[
        {
          label: "Build",
          title: "Build product features",
          body: "Engineers who build web and mobile features, APIs and the experiences your users rely on.",
          tags: ["Web apps", "Mobile apps", "APIs", "Integrations"],
        },
        {
          label: "Data and AI",
          title: "Build data and AI systems",
          body: "Specialists who build pipelines, train and test models, and ship AI features that hold up.",
          tags: ["Data pipelines", "Predictive ML", "GenAI apps", "RAG"],
        },
        {
          label: "Platform",
          title: "Run it in production",
          body: "Engineers for test automation, releases, cloud and the monitoring that keeps it up.",
          tags: ["QA automation", "CI/CD", "Cloud platforms", "MLOps"],
        },
      ]}
    />

    <HireSteps
      id="how"
      eyebrow="How they help"
      headline={["Build, ship and", "improve your product."]}
      lede={`Hire one specialist or a full team. ${BRAND.name} covers the work from product to production.`}
      steps={[
        {
          title: "Build inside your product",
          body: "Features, applications, APIs and workflows that fit your existing architecture.",
          focus: "Features, APIs and interfaces",
        },
        {
          title: "Develop the data and model layer",
          body: "Prepare the data, choose and train the models, and tie them to goals you can measure.",
          focus: "Data, models and evaluation",
        },
        {
          title: "Integrate and release",
          body: "Work inside your services, quality gates, cloud and release process, so it ships.",
          focus: "Integration, testing and release",
        },
        {
          title: "Operate and improve",
          body: "Keep it reliable with monitoring, upkeep and disciplined follow-through.",
          focus: "Observability, stability and evolution",
        },
      ]}
      close={{
        text: `Need help with one part of your stack? ${BRAND.name} can help.`,
        cta: { label: "Find the right role", href: "#engineers" },
      }}
    />

    <HireCases
      id="cases"
      eyebrow="How teams use us"
      headline={["Real examples of", "teams in action."]}
      lede={`The roles ${BRAND.name} brought in, and what the teams achieved.`}
      cases={[
        {
          sector: "US industrial engineering company",
          team: "Computer vision and data pod",
          title: "Production quality vision team",
          body: "We provided computer vision, data and QA automation engineers to build models that check production imagery and designs for quality issues.",
          roles: ["Computer vision ML engineer", "Data engineer", "QA automation engineer"],
          tools: ["OpenCV", "PyTorch", "Image classification"],
          results: [
            { value: "Automated", label: "imagery quality checks" },
            { value: "Consistent", label: "design review workflows" },
          ],
        },
        {
          sector: "US fintech lending platform",
          team: "Dedicated ML and data specialists",
          title: "Lending risk-model team",
          body: "We added ML and data specialists to improve scoring, eligibility checks and the model platform.",
          roles: ["ML engineer", "Data scientist", "MLOps engineer"],
          tools: ["H2O.ai", "Kubeflow", "ML scoring"],
          results: [
            { value: "87%", label: "improved approval accuracy" },
            { value: "61%", label: "improved fraud detection" },
          ],
        },
        {
          sector: "US industrial equipment supplier",
          team: "AI, data and integration team",
          title: "Predictive maintenance team",
          body: "We added AI, data and integration engineers to turn sensor data into useful maintenance alerts.",
          roles: ["ML engineer", "Data engineer", "Integration developer"],
          tools: ["Deep learning", "IoT sensors", "Predictive analytics"],
          results: [
            { value: "6×", label: "less machine downtime" },
            { value: "43%", label: "maintenance cost savings" },
          ],
        },
      ]}
      footnote={`Client details are kept private. Team roles show the skills used on each ${BRAND.name} engagement. Results are examples, not guarantees.`}
    />

    <HirePod
      id="pod"
      eyebrow="One team. Two locations."
      headline={["How does your", "development pod", `look with ${BRAND.name}?`]}
      lede="Your leaders own the product and the architecture. Our India-based engineers join your delivery process with planned overlap hours, clear ownership and written handoffs between working days."
      points={[
        { lead: "Start small", rest: "with the role you need now." },
        { lead: "Work your way", rest: "in your codebase, tools and quality process." },
        { lead: "Grow when needed", rest: "with app, data, AI and cloud skills." },
      ]}
      rosterLabel="Delivery pod / 01"
      status="Active"
      members={[
        { initials: "TL", role: "Technical lead", layer: "Architecture" },
        { initials: "FS", role: "Full-stack engineer", layer: "Product layer" },
        { initials: "MB", role: "Mobile engineer", layer: "Apps" },
        { initials: "ML", role: "ML engineer", layer: "Model layer" },
        { initials: "QA", role: "QA automation engineer", layer: "Quality gates" },
      ]}
      terms={[
        { label: "Rituals", value: "Daily overlap" },
        { label: "Ownership", value: "Sprint outcomes" },
        { label: "Start", value: "Roadmap-led" },
      ]}
      cta={{ label: "Talk about your team", href: "#contact" }}
    />

    <HireFit
      id="fit"
      tone="tint"
      eyebrow="Is this a good fit?"
      headline={["Built for teams", "that need more", "engineering help."]}
      items={[
        "You need more engineers to meet your delivery goals.",
        "You need skills your team doesn’t have today, from mobile and data to AI.",
        "You need engineers who can follow your security and release process.",
        `You want India-based engineers who work closely with your US team through ${BRAND.name}.`,
      ]}
    />

    <HireProcess
      id="process"
      eyebrow={`How ${BRAND.name} works`}
      headline={["Five simple steps", "to add engineers."]}
      lede="From the first call to an engineer working in your sprint."
      detailLabel="Leadership context"
      steps={[
        {
          title: "Discovery call",
          body: "Tell us about your roadmap, your team gap and the work that needs more support.",
          covers: ["Your goals", "Team gap", "Tech context"],
          photo: { image: stepCall, alt: "An engineering leader talks with a team on a video call at his laptop.", focus: "60% 45%" },
        },
        {
          title: "Pick the suitable model",
          body: "Choose one engineer, a squad or a managed pod, and agree the overlap hours you need.",
          covers: ["Engagement model", "Team size", "Overlap hours"],
        },
        {
          title: "Receive pre-vetted options",
          body: "Get engineer profiles matched to your stack, your work and your budget.",
          covers: ["Skills", "Experience", "Availability"],
        },
        {
          title: "Interview & selection",
          body: "Meet the engineers, test the fit and choose who joins your team.",
          covers: ["Technical interview", "Team fit", "Your decision"],
          photo: { image: stepTeam, alt: "Engineers work together at laptops around a long table.", focus: "45% 55%" },
        },
        {
          title: "Onboarding & kickoff",
          body: "Access, rituals, handoff notes and a first task, so the work starts in week one.",
          covers: ["Access and tools", "Overlap rituals", "First sprint"],
        },
      ]}
      cta={{ label: `Plan your ${BRAND.name} hires`, href: "#contact" }}
    />

