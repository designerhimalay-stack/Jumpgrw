---
import "@pg/page32/styles/globals.css";
import "@/styles/globals.css";
import Layout from "@pg/page32/layouts/Layout.astro";
import FaqSection from "@pg/page32/components/FaqSection.astro";
import Footer from "@/components/Footer.astro";
import Navbar from "@/components/Navbar.astro";
import PageHero from "@pg/page32/components/PageHero.astro";
import SmoothScroll from "@pg/page32/components/SmoothScroll.astro";
import HireStack from "@pg/page32/components/hire/HireStack.astro";
import HireServices from "@pg/page32/components/hire/HireServices.astro";
import HireWhy from "@pg/page32/components/hire/HireWhy.astro";
import HireWays from "@pg/page32/components/hire/HireWays.astro";
import HirePlanner from "@pg/page32/components/hire/HirePlanner.astro";
import HireEngineers from "@pg/page32/components/hire/HireEngineers.astro";
import HireColumns from "@pg/page32/components/hire/HireColumns.astro";
import HireSteps from "@pg/page32/components/hire/HireSteps.astro";
import HireCases from "@pg/page32/components/hire/HireCases.astro";
import HirePod from "@pg/page32/components/hire/HirePod.astro";
import HireFit from "@pg/page32/components/hire/HireFit.astro";
import HireProcess from "@pg/page32/components/hire/HireProcess.astro";
import ContactForm from "@/components/ContactForm.astro";
import type { PageHeroContent } from "@pg/page32/types/page";
import { BRAND } from "@pg/page32/lib/brand";

import heroPhoto from "@pg/page32/assets/pages/p32-hero.jpg";
import faqPhoto from "@pg/page32/assets/pages/p32-faq.jpg";
import waysSolo from "@pg/page32/assets/pages/p32-ways-solo.jpg";
import waysSquad from "@pg/page32/assets/pages/p32-ways-squad.jpg";
import waysPod from "@pg/page32/assets/pages/p32-ways-pod.jpg";
import engWeb from "@pg/page32/assets/pages/p32-eng-web.jpg";
import engMobile from "@pg/page32/assets/pages/p32-eng-mobile.jpg";
import engBackend from "@pg/page32/assets/pages/p32-eng-backend.jpg";
import engData from "@pg/page32/assets/pages/p32-eng-data.jpg";
import engMl from "@pg/page32/assets/pages/p32-eng-ml.jpg";
import engQa from "@pg/page32/assets/pages/p32-eng-qa.jpg";
import engDevops from "@pg/page32/assets/pages/p32-eng-devops.jpg";
import stepCall from "@pg/page32/assets/pages/p32-step-call.jpg";
import stepModel from "@pg/page32/assets/pages/p32-step-model.jpg";
import stepOptions from "@pg/page32/assets/pages/p32-step-options.jpg";
import stepInterview from "@pg/page32/assets/pages/p32-step-interview.jpg";
import stepKickoff from "@pg/page32/assets/pages/p32-step-kickoff.jpg";

/* Engineers and teams in Canada. The page sells engineers and teams across
   the stack (web, mobile, back end, data, AI/ML, QA, DevOps and cloud) who
   work in the same or neighbouring time zones as US teams, in English and
   French. Built from the shared hire kit in src/components/hire/; every word
   on the page lives here. Figures, rates, the example cases and the FAQ
   answers are drafts: have them checked before launch (see docs/sections.md,
   "Copy to check before launch"). */

const HERO: PageHeroContent = {
  trail: ["X-Shore", "Nearshore", "Canada"],
  audience: "For engineering and product leaders",
  headline: ["Hire Canada-based", "engineers next door,", "on your schedule."],
  accent: 2,
  size: "long",
  lede: "Add senior Canada-based web, mobile, data, AI or full-stack engineers who share your workday and work in English or French, one short flight from your team.",
  ctas: [
    { label: "Plan your engineering hires", href: "#contact", arrow: "diagonal" },
    { label: "Explore team options", href: "#ways", arrow: "right" },
  ],
  assurances: [
    { icon: "shield", label: "Senior engineering oversight" },
    { icon: "clock", label: "US workday overlap" },
    { icon: "lock", label: "Your stack and controls" },
  ],
  image: heroPhoto,
  imageAlt: "An engineer works on a laptop at a counter by a tall window.",
  card: {
    status: "Build context / Active",
    place: "Canada-based delivery",
    note: "Begin with a single engineer. Scale to a squad as demand grows.",
    kicker: "Nearshore capacity, inside your org.",
    statement: "A team that answers in your business hours, in English or French.",
    foot: { label: "Built for app and platform leaders", value: "One senior engineer to a full nearshore squad" },
  },
  specs: [
    { label: "Years engineering software", value: "20+" },
    { label: "Engineers under one roof", value: "200+" },
    { label: "Clients served", value: "300+" },
    { label: "Global delivery locations", value: "4+" },
  ],
  base: { title: "Dallas headquartered", line: "Delivery across the USA, India, Canada and Mexico" },
};

const FAQS = [
  {
    q: "Is this staff augmentation or a managed delivery team?",
    a: "Either. Add one engineer to your team, a small squad, or a full pod with its own technical lead.",
  },
  {
    q: "Can we start with one engineer?",
    a: "Yes. Many teams start with one hire for a clear gap, then add more once the first one is settled.",
  },
  {
    q: "Can we interview engineers before we choose?",
    a: "Always. We send pre-vetted profiles; you interview whoever you like and make the final call.",
  },
  {
    q: "What skills can we hire for?",
    a: "Web, mobile, back end, data, AI and ML, QA, and DevOps and cloud, as one specialist or a mixed team.",
  },
  {
    q: "How do you match engineers to our team?",
    a: "From your stack, the gap on your roadmap and the hours you keep. Profiles only reach you when they fit all three.",
  },
  {
    q: "Which time zones do the engineers work in?",
    a: "Canada runs from Pacific to Atlantic time, so we match engineers to your hours, from the West Coast to the East.",
  },
  {
    q: "Can the team build and test in French?",
    a: "Yes. Bilingual engineers can build, write and test screens in English and French for customers in Québec and beyond.",
  },
  {
    q: `How do ${BRAND.name} engineers collaborate with US teams?`,
    a: "They keep your hours, join your standups and reviews, and work in your chat and ticket tools.",
  },
  {
    q: "Can the team work inside our cloud, tools and security controls?",
    a: "Yes. Engineers work in your repositories and cloud accounts, with the access you grant and your policies.",
  },
  {
    q: "Can we scale the team after the first engineer starts?",
    a: "Yes. Grow one hire at a time, or hand a whole stream of work to a pod with its own lead.",
  },
  {
    q: "What happens after we select an engineer?",
    a: "We arrange access, introductions and a first ticket together, so your new engineer ships in their first sprint.",
  },
];
---

<Layout
  title={`Engineers in Canada · ${BRAND.name}`}
  description="Hire senior engineers and teams in Canada: web, mobile, back end, data, AI/ML, QA and DevOps, in US time zones and in English or French."
  navTone="field"
>
  <SmoothScroll />
  <Navbar />
  <main>
    <PageHero content={HERO} />

    <HireStack
      id="stack"
      tone="tint"
      eyebrow="Tech we use"
      headline={["Engineers who", "fit your stack."]}
      lede="They already work in the languages, frameworks, data tools and clouds your product runs on."
      groups={[
        { name: "Web and front end", logos: ["react", "nextdotjs", "angular", "vuedotjs", "typescript", "nodedotjs"] },
        { name: "Mobile", logos: ["swift", "kotlin", "flutter", "android"], named: ["iOS", "React Native"] },
        { name: "Back end", logos: ["python", "django", "spring", "go", "dotnet", "postgresql", "graphql"] },
        { name: "Data", logos: ["snowflake", "databricks", "apacheairflow", "apachekafka"], named: ["dbt", "Power BI"] },
        { name: "AI and ML", logos: ["pytorch", "tensorflow", "scikitlearn", "huggingface", "langchain", "mlflow"], named: ["OpenAI", "Claude", "Gemini"] },
        { name: "QA and testing", logos: ["selenium", "cypress", "jest", "postman"], named: ["Playwright"] },
        { name: "DevOps and cloud", logos: ["docker", "kubernetes", "terraform", "githubactions", "googlecloud", "datadog"], named: ["AWS", "Azure"] },
      ]}
      note="We fit the tools to your product, your data rules and the cloud you already run."
    />

    <HireServices
      id="help"
      tone="tint"
      eyebrow="More ways we can help"
      headline={["Choose the work", "your team needs."]}
      lede="Pick a kind of work to see what our engineers in Canada take on, and the tools they use."
      services={[
        {
          name: "Web and front-end development",
          body: "Build the screens and features your customers use, from sign-up to account pages, inside your design system and release train.",
          work: ["Customer portals", "Design systems", "Accessibility fixes"],
          tools: ["React", "Next.js", "Angular", "TypeScript"],
        },
        {
          name: "Mobile apps",
          body: "Plan, build and release iOS and Android apps, and keep them quick, stable and in step with your web product.",
          work: ["New apps", "App rewrites", "Store releases"],
          tools: ["Swift", "Kotlin", "Flutter", "React Native"],
        },
        {
          name: "Back end and APIs",
          body: "Design the services, APIs and integrations behind your product, with the tests and monitoring to keep them healthy.",
          work: ["Public APIs", "Service design", "Payments and integrations"],
          tools: ["Java", "Spring", "Python", "Go", "PostgreSQL"],
        },
        {
          name: "Data engineering",
          body: "Move data from your apps into a warehouse your analysts trust, with pipelines that are tested, documented and on time.",
          work: ["Pipelines", "Warehouse models", "Reporting"],
          tools: ["Snowflake", "Databricks", "Airflow", "dbt"],
        },
        {
          name: "AI and machine learning",
          body: "Build models and AI features, from forecasting to assistants, and measure them before your users see them.",
          work: ["Forecasting", "LLM features", "Model evaluation"],
          tools: ["PyTorch", "scikit-learn", "Hugging Face", "MLflow"],
        },
        {
          name: "QA and test automation",
          body: "Plan the tests, automate the regression suite and add quality gates to your pipeline, in English and French.",
          work: ["Test automation", "API testing", "Bilingual test runs"],
          tools: ["Playwright", "Cypress", "Selenium", "Postman"],
        },
        {
          name: "DevOps and cloud",
          body: "Automate builds and deploys, manage infrastructure as code, and give your team the dashboards and alerts to run production.",
          work: ["CI/CD", "Kubernetes", "Monitoring and alerts"],
          tools: ["Docker", "Kubernetes", "Terraform", "AWS", "Datadog"],
        },
        {
          name: "English and French products",
          body: "Launch in both official languages: translated screens, French-first flows where the market expects them, and tests for each.",
          work: ["French and English UI", "Translation workflows", "Québec launches"],
          tools: ["i18next", "React Intl", "Playwright"],
        },
      ]}
    />

    <HireWhy
      id="why"
      eyebrow={`Why ${BRAND.name}`}
      headline={["Why teams", `choose ${BRAND.name}.`]}
      lede="Senior engineers in Canada who keep your hours, speak your customers’ languages and work inside your delivery process."
      reasons={[
        {
          title: "Senior engineers for the work in front of you",
          body: "Tell us the gap, whether a mobile release, a data platform or a test backlog. You see matched profiles and choose who joins.",
          points: ["Specialists and generalists", "Profiles you review", "You make the call"],
        },
        {
          title: "They join your team, not a vendor’s",
          body: "Engineers work in your codebase, sprints and tools, while senior leads on our side keep the quality and the hiring steady.",
          points: ["Your sprints and tools", "Senior oversight", "Grow or shrink as needed"],
        },
        {
          title: "In Canada, on your clock",
          body: "Canada shares the US time zones, so engineers sit in your standups, answer the same day and can fly in for a workshop.",
          points: ["Pacific to Eastern time", "English and French", "A short flight away"],
        },
      ]}
      figures={[
        { value: "20+", label: "Years building software" },
        { value: "200+", label: "Engineers in one team" },
        { value: "300+", label: "Clients served" },
      ]}
      cta={{ label: "Talk to our team", href: "#contact" }}
    />

    <HireWays
      id="ways"
      eyebrow="Ways to work together"
      headline={["Start with one engineer.", "Build a team", "when you need it."]}
      accent={2}
      lede="Pick the setup that matches your roadmap today, and change it as the work grows."
      models={[
        {
          kind: "Staff augmentation",
          size: "1 engineer",
          title: "Add one engineer",
          body: "One dedicated engineer who joins your standups, your repo and your sprint board.",
          skills: ["Web or mobile", "Back end", "QA"],
          photo: { image: waysSolo, alt: "An engineer works on a laptop at a desk in a meeting room.", focus: "70% 50%" },
        },
        {
          kind: "Augmented squad",
          size: "2–4 engineers",
          title: "Add a small team",
          body: "A few engineers to close a clear gap, such as a mobile release or a data backlog.",
          skills: ["Feature delivery", "Data pipelines", "Test automation"],
          photo: { image: waysSquad, alt: "Three engineers work through a problem together on one laptop.", focus: "40% 72%" },
        },
        {
          kind: "Managed delivery pod",
          size: "5–8 engineers",
          title: "Build a delivery pod",
          body: "A cross-skilled team with its own technical lead, accountable for an outcome.",
          skills: ["Architecture", "Delivery", "Data and AI"],
          photo: { image: waysPod, alt: "Engineers in headphones work at rows of screens in a shared studio.", focus: "60% 60%" },
        },
      ]}
      cta={{ label: "Plan this team shape", href: "#plan" }}
      control={{ lead: "You stay in control.", rest: `${BRAND.name} engineers work in your codebase, tools and delivery process.` }}
    />

    <HirePlanner
      id="plan"
      tone="tint"
      eyebrow="Team planning view"
      headline={["Size the engineering", "capacity you need."]}
      lede="Set the team size to see the monthly investment for engineers in Canada. Planning figures are directional, not a quote."
      rate={125}
      hours={160}
      max={12}
      start={3}
      panelLabel="Monthly team cost"
      oneLabel="One engineer in Canada at $125/hr"
      teamLabel="Your team of {n}"
      capacity="{n} senior {people} in your time zones, your tools and your release rhythm."
      sizeLabel="Your team size"
      unit={["engineer", "engineers"]}
      cta={{ label: "Build my team plan", href: "#contact" }}
      disclaimer="We can tailor the cost view to your roles, skills and stack."
      note={`Estimate at $125 an hour and 160 hours per engineer each month. Not a ${BRAND.name} quote.`}
    />

    <HireEngineers
      id="engineers"
      eyebrow="Find the right skill"
      headline={["Find the engineer", "you need."]}
      lede={`Choose a specialty to see the engineers ${BRAND.name} can match to your team in Canada.`}
      allLabel="All engineers"
      filters={[
        { key: "web", label: "Web & mobile" },
        { key: "backend", label: "Back end" },
        { key: "data", label: "Data & AI" },
        { key: "qa", label: "QA" },
        { key: "cloud", label: "DevOps & cloud" },
      ]}
      engineers={[
        {
          level: "Senior specialty role",
          role: "Front-end and full-stack developer",
          for: "For product screens and features, in English and French.",
          years: "8+ years",
          skills: ["React", "TypeScript", "Node.js", "EN/FR interfaces"],
          tags: ["web", "backend"],
          photo: { image: engWeb, alt: "A developer in a cap works at a monitor in a bright studio.", focus: "60% 40%" },
        },
        {
          level: "Senior specialty role",
          role: "Mobile app developer",
          for: "For iOS and Android apps, from first build to store release.",
          years: "7+ years",
          skills: ["Swift", "Kotlin", "Flutter", "App releases"],
          tags: ["web"],
          photo: { image: engMobile, alt: "A developer looks up from her laptop in a glass-walled office.", focus: "45% 30%" },
        },
        {
          level: "Senior specialty role",
          role: "Back-end engineer",
          for: "For services, APIs and the integrations between your systems.",
          years: "10+ years",
          skills: ["Java", "Spring", "Python", "PostgreSQL"],
          tags: ["backend"],
          photo: { image: engBackend, alt: "An engineer works at a wide monitor in a sunny office.", focus: "35% 45%" },
        },
        {
          level: "Senior specialty role",
          role: "Data engineer",
          for: "For pipelines, warehouses and reports your teams can trust.",
          years: "7+ years",
          skills: ["Snowflake", "Databricks", "Kafka", "dbt"],
          tags: ["data"],
          photo: { image: engData, alt: "A data engineer thinks through a problem at a desk with two screens.", focus: "40% 35%" },
        },
        {
          level: "Senior specialty role",
          role: "AI/ML engineer",
          for: "For forecasting, LLM features and model evaluation.",
          years: "7+ years",
          skills: ["PyTorch", "scikit-learn", "RAG", "MLflow"],
          tags: ["data"],
          photo: { image: engMl, alt: "An engineer studies a scatter plot on his monitor.", focus: "35% 40%" },
        },
        {
          level: "Senior specialty role",
          role: "QA automation engineer",
          for: "For test plans, automated suites and release sign-off.",
          years: "6+ years",
          skills: ["Playwright", "Cypress", "API tests", "Bilingual QA"],
          tags: ["qa"],
          photo: { image: engQa, alt: "A smiling engineer in glasses listens during a team meeting.", focus: "62% 35%" },
        },
        {
          level: "Senior specialty role",
          role: "DevOps and cloud engineer",
          for: "For pipelines, infrastructure as code and production uptime.",
          years: "9+ years",
          skills: ["Kubernetes", "Terraform", "AWS", "Datadog"],
          tags: ["cloud"],
          photo: { image: engDevops, alt: "An engineer in a plaid shirt works at a monitor in an open office.", focus: "55% 60%" },
        },
      ]}
      cta={{ label: "Discuss this engineering hire", href: "#contact" }}
      footnote={`These are example roles. ${BRAND.name} confirms availability and fit before you decide.`}
    />

    <HireColumns
      id="do"
      eyebrow="What our engineers do"
      headline={["Get help across", "your whole stack."]}
      lede="Bring in the skills you’re missing, from the first screen to production."
      columns={[
        {
          label: "Build",
          title: "Ship the product",
          body: "Web, mobile and back-end engineers who turn your roadmap into released features.",
          tags: ["Web apps", "Mobile apps", "APIs", "EN/FR screens"],
        },
        {
          label: "Data and AI",
          title: "Make the data useful",
          body: "Data and ML engineers who build the pipelines, models and AI features, then measure them.",
          tags: ["Pipelines", "Warehouses", "ML models", "LLM features"],
        },
        {
          label: "Platform",
          title: "Keep it running",
          body: "QA and DevOps engineers who test every release and keep the cloud fast and observable.",
          tags: ["Test automation", "CI/CD", "Cloud", "Monitoring"],
        },
      ]}
    />

    <HireSteps
      id="how"
      eyebrow="How they help"
      headline={["From the first sprint", "to production."]}
      lede={`Bring in one specialist or a whole team. ${BRAND.name} engineers pick up work wherever your product needs it.`}
      steps={[
        {
          title: "Add features to your product",
          body: "Screens, apps and APIs built to fit the architecture you already have.",
          focus: "Features, apps and APIs",
        },
        {
          title: "Put your data and AI to work",
          body: "Clean the data, pick the right models and tie them to numbers you track.",
          focus: "Data, models and metrics",
        },
        {
          title: "Test and release with confidence",
          body: "Automated checks in your pipeline, in both languages where you need them.",
          focus: "Testing, quality gates and release",
        },
        {
          title: "Run and improve",
          body: "Monitoring, fixes and steady upgrades once the work is live.",
          focus: "Uptime and improvement",
        },
      ]}
      close={{
        text: `Need help with one part of your stack? ${BRAND.name} can help.`,
        cta: { label: "Find the right role", href: "#engineers" },
      }}
    />

    <HireCases
      id="cases"
      eyebrow="How teams use us"
      headline={["Real examples of", "teams in action."]}
      lede="The roles we brought in, and what each team delivered."
      cases={[
        {
          sector: "US health-tech company",
          team: "Web, mobile and QA squad",
          title: "Bilingual patient portal",
          body: "Front-end, mobile and QA engineers rebuilt a patient portal and app in English and French from one codebase.",
          roles: ["Front-end developer", "Mobile developer", "QA automation engineer"],
          tools: ["React", "React Native", "Playwright"],
          results: [
            { value: "2", label: "languages from one codebase" },
            { value: "40%", label: "fewer defects reaching release" },
          ],
        },
        {
          sector: "US retail group",
          team: "Data and ML pod",
          title: "Demand forecasting team",
          body: "Data and ML engineers replaced spreadsheet forecasts with a model that plans stock for every store.",
          roles: ["Data engineer", "ML engineer", "Analytics engineer"],
          tools: ["Snowflake", "Airflow", "scikit-learn"],
          results: [
            { value: "25%", label: "less overstock" },
            { value: "Daily", label: "forecasts, up from weekly" },
          ],
        },
        {
          sector: "US logistics software company",
          team: "Platform and back-end team",
          title: "Cloud platform move",
          body: "Back-end and DevOps engineers moved a monolith to containers and automated its releases.",
          roles: ["Back-end engineer", "DevOps engineer", "Site reliability engineer"],
          tools: ["Kubernetes", "Terraform", "GitHub Actions"],
          results: [
            { value: "3×", label: "more frequent releases" },
            { value: "Zero", label: "downtime during the move" },
          ],
        },
      ]}
      footnote={`Client details are kept private. Team roles show the skills used on each ${BRAND.name} engagement. Results are examples, not guarantees.`}
    />

    <HirePod
      id="pod"
      eyebrow="One team. One operating rhythm."
      headline={["How does your", "development pod", `look with ${BRAND.name}?`]}
      lede={`You keep the product decisions and the architecture. ${BRAND.name} engineers work your way, in your hours, with enough context to own real work.`}
      points={[
        { lead: "Start with one role", rest: "and the gap you need closed first." },
        { lead: "Keep your standards", rest: "for code review, security and releases." },
        { lead: "Add skills as you grow", rest: "across mobile, data, AI and cloud." },
      ]}
      rosterLabel="Delivery pod / 01"
      status="Active"
      members={[
        { initials: "TL", role: "Tech lead", layer: "Architecture" },
        { initials: "FE", role: "Front-end engineer", layer: "EN/FR interfaces" },
        { initials: "BE", role: "Back-end engineer", layer: "Services and APIs" },
        { initials: "ML", role: "ML engineer", layer: "Models and data" },
        { initials: "DO", role: "DevOps engineer", layer: "Cloud and releases" },
      ]}
      terms={[
        { label: "Rituals", value: "Same-hours standups" },
        { label: "Ownership", value: "Sprint outcomes" },
        { label: "Start", value: "One role first" },
      ]}
      cta={{ label: "Talk about your team", href: "#contact" }}
    />

    <HireFit
      id="fit"
      tone="tint"
      eyebrow="Is this a good fit?"
      headline={["Built for teams", "that need more", "engineering help."]}
      items={[
        "Your roadmap has outgrown the engineers you have today.",
        "You need skills your team lacks, from mobile releases to machine learning.",
        "You want engineers who keep your hours and join every standup.",
        "You build for customers in English and French, or plan to.",
      ]}
    />

    <HireProcess
      id="process"
      eyebrow="How it works"
      headline={["Five simple steps", "to add engineers."]}
      lede="From a first conversation to an engineer shipping in your sprint."
      detailLabel={`${BRAND.name} onboarding`}
      steps={[
        {
          title: "Discovery call",
          body: "Walk us through your roadmap, the gap in your team and the stack you run.",
          covers: ["Your goals", "Team gap", "Stack and hours"],
          photo: { image: stepCall, alt: "An engineer talks with a colleague on a video call.", focus: "60% 45%" },
        },
        {
          title: "Pick the suitable model",
          body: "One engineer, a squad or a managed pod: we shape the team around the work.",
          covers: ["Engagement model", "Team size", "Start date"],
          photo: { image: stepModel, alt: "Two colleagues plan together at a desk beside a wall of notes.", focus: "50% 40%" },
        },
        {
          title: "Receive pre-vetted options",
          body: "Profiles matched to your stack, your time zone and your languages.",
          covers: ["Skills", "Experience", "Time zone and language"],
          photo: { image: stepOptions, alt: "Three colleagues review profiles together on a laptop.", focus: "50% 40%" },
        },
        {
          title: "Interview & selection",
          body: "Meet the engineers, run your technical interview and choose who joins.",
          covers: ["Technical interview", "Team fit", "Your decision"],
          photo: { image: stepInterview, alt: "Two colleagues smile during a conversation at a laptop.", focus: "50% 40%" },
        },
        {
          title: "Onboarding & kickoff",
          body: "Access, introductions and a first ticket, so the work starts in week one.",
          covers: ["Access and tools", "Team rituals", "First sprint"],
