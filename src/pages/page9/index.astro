---
import "@pg/page9/styles/globals.css";
import "@/styles/globals.css";
import Layout from "@pg/page9/layouts/Layout.astro";
import BotSection from "@pg/page9/components/BotSection.astro";
import ControlSection from "@pg/page9/components/ControlSection.astro";
import ContactForm from "@/components/ContactForm.astro";
import FloorSection from "@pg/page9/components/FloorSection.astro";
import Footer from "@/components/Footer.astro";
import GlobeSection from "@pg/page9/components/GlobeSection.astro";
import Navbar from "@/components/Navbar.astro";
import PageHero from "@pg/page9/components/PageHero.astro";
import FaqSection from "@pg/page9/components/FaqSection.astro";
import SmoothScroll from "@pg/page9/components/SmoothScroll.astro";
import type { PageHeroContent } from "@pg/page9/types/page";
import heroPhoto from "@pg/page9/assets/pages/p9-hero.jpg";
import botPhoto from "@pg/page9/assets/pages/p9-bot.jpg";
import govPhoto from "@pg/page9/assets/pages/p9-gov.jpg";
import faqPhoto from "@pg/page9/assets/pages/p9-faq.jpg";
import { BRAND } from "@pg/page9/lib/brand";

/* Global capability center. There was no brief for this page: the copy is
   written from what the home page says about X-Shore (Dallas-led delivery
   across the US, Mexico, Canada and India). The build-operate-transfer
   timings and shares, the floor plan and the FAQ answers are drafts. Have
   them checked before launch. See docs/sections.md. */

const HERO: PageHeroContent = {
  trail: ["Flexible", "Global capability center"],
  headline: ["Global capability", "center."],
  lede: `Your own engineering center, built, run and handed over by ${BRAND.name}: Dallas-led, across four time zones, and yours from day one.`,
  ctas: [
    { label: "Plan your center", href: "#contact", arrow: "diagonal" },
    { label: "See the model", href: "#model", arrow: "right" },
  ],
  image: heroPhoto,
  imageAlt: "A diverse team meets around a conference table with laptops open.",
  specs: [
    { label: "Model", value: "Build, operate, transfer" },
    { label: "Hubs", value: "US, Mexico, Canada, India" },
    { label: "Scale", value: "20 to 200+ people" },
    { label: "Ownership", value: "Yours, by design" },
  ],
};

const FAQS = [
  {
    q: "How is a center different from a team?",
    a: "A team works on your product. A center is a lasting part of your company: its own leadership, culture, hiring and roadmap, built to grow and eventually to be run by you.",
  },
  {
    q: "Where would our center be?",
    a: "Wherever the work fits best: nearshore in Mexico or Canada for overlap, offshore in India for scale, or a blend, led from Dallas.",
  },
  {
    q: "When does it become ours?",
    a: "When you choose. The transfer is planned from the start, with people, contracts and knowledge moving over on your timeline.",
  },
  {
    q: "Who hires the people?",
    a: "We do, to your bar and with your interviewers in the loop, so every hire is someone you’d have hired yourself.",
  },
];
---

<Layout
  title={`Global capability center · ${BRAND.name}`}
  description={`Your own engineering center across the US, Mexico, Canada and India, built, run and handed over by ${BRAND.name}.`}
  navTone="field"
>
  <SmoothScroll />
  <Navbar />
  <main>
    <PageHero content={HERO} />
    <GlobeSection
      id="hubs"
      eyebrow="Four hubs"
      headline={["One center.", "Four time zones."]}
      lede="Led from Dallas, staffed across the Americas and India, working as one center around the clock. Choose a hub to find it on the globe."
      caption="A globe turning slowly, with arcs of light joining Dallas, Mexico City, Toronto and Pune."
      hubs={[
        { name: "Dallas", city: "Dallas", role: "Headquarters · leadership", zone: "America/Chicago", lat: 32.78, lon: -96.8 },
        { name: "Mexico City", city: "Mexico City", role: "Nearshore engineering", zone: "America/Mexico_City", lat: 19.43, lon: -99.13 },
        { name: "Toronto", city: "Toronto", role: "Nearshore engineering", zone: "America/Toronto", lat: 43.65, lon: -79.38 },
        { name: "Pune", city: "Pune", role: "Offshore capability hub", zone: "Asia/Kolkata", lat: 18.52, lon: 73.86 },
      ]}
      links={[[0, 1], [0, 2], [0, 3], [2, 3], [1, 3]]}
    />
    <BotSection
      id="model"
      eyebrow="The model"
      headline={["Build. Operate.", "Transfer."]}
      accent={1}
      lede="We build the center, run it until it’s steady, then hand it over, on a timeline you set."
      media={{ image: botPhoto, alt: "A leadership team meets around a long boardroom table, laptops open.", focus: "50% 50%" }}
      phases={[
        { name: "Build", when: "Months 0–6", body: "Entity, office, leadership and the first hires, to your bar.", yours: 10 },
        { name: "Operate", when: "Months 6–24", body: "We run and grow the center while your leaders step in.", yours: 45 },
        { name: "Transfer", when: "When you choose", body: "People, contracts and knowledge move over to you.", yours: 100 },
      ]}
    />
    <FloorSection
      id="blueprint"
      eyebrow="Inside the center"
      headline={["Every capability,", "under one roof."]}
      lede="A center grows the capabilities your product needs, around a leadership team that answers to you."
      caption="An example center, drawn to plan"
      rooms={[
        { name: "Leadership & PMO", note: "Center head, delivery, hiring", area: [1, 4, 1, 3], lead: true },
        { name: "Engineering", note: "Product squads, full stack", area: [5, 5, 1, 5] },
        { name: "Design", note: "Product and UX", area: [10, 3, 1, 3] },
        { name: "Data & AI", note: "Pipelines, models, analytics", area: [1, 4, 4, 3] },
        { name: "QA", note: "Automation and release", area: [10, 3, 4, 2] },
        { name: "DevOps & Cloud", note: "Platforms, on call", area: [5, 3, 6, 3] },
        { name: "Collaboration hub", note: "Where your teams meet ours", area: [8, 5, 6, 3] },
        { name: "People & support", note: "HR, IT, facilities", area: [1, 4, 7, 2] },
      ]}
    />
    <ControlSection
      id="governance"
      eyebrow="Governance"
      headline={["Your center.", "Your control."]}
      lede="We run the day to day; the decisions stay with you."
      media={{ image: govPhoto, alt: "Colleagues talk around a table in a bright meeting room.", focus: "50% 45%" }}
      controls={[
        { icon: "lock", title: "Your IP and data", note: "Everything built belongs to you, in your systems." },
        { icon: "document", title: "Your hiring bar", note: "Your interviewers approve every senior hire." },
        { icon: "shield", title: "Your security standards", note: "Compliance and access to your policies." },
        { icon: "wallet", title: "Open books", note: "Costs shared line by line, every month." },
      ]}
    />
    <FaqSection
      eyebrow="Center questions"
      headline={["Big decision.", "Straight answers."]}
      accent={1}
      cta="Talk to a center lead"
      faqs={FAQS}
      media={{ image: faqPhoto, alt: "A team works together around a table with laptops.", focus: "50% 50%" }}
    />
    <ContactForm />
  </main>
  <Footer />
</Layout>
