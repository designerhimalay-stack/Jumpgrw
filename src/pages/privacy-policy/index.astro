---
import "@pg/page30/styles/globals.css";
import "@/styles/globals.css";
import Layout from "@/layouts/Layout.astro";
import Navbar from "@/components/Navbar.astro";
import { withBase } from "@/lib/paths";
import Footer from "@/components/Footer.astro";
import SimpleHero from "@/components/SimpleHero.astro";
import ArticleBody from "@/components/insights/ArticleBody.astro";
import LegalContact from "@/components/LegalContact.astro";
import SmoothScroll from "@pg/page30/components/SmoothScroll.astro";
import policy from "@/data/legal/privacy-policy.json";
import type { ArticleBlock } from "@/lib/articles";

/* Privacy Policy: the company's own policy text (src/data/legal), set in the
   article reading column as a numbered document with its "On this page" list,
   closed by a contact card. Linked from the footer, the cookie notice and
   beside every form's submit button. */

const blocks = policy.blocks as ArticleBlock[];
---

<Layout
  title="Privacy Policy"
  description="How JumpGrowth collects, uses, secures and shares personal data, including the details you send through our forms and the cookies the site uses."
  navTone="field"
  breadcrumbs={[{ name: "Privacy Policy", path: "/privacy-policy/" }]}
>
  <SmoothScroll />
  <Navbar contactHref={withBase("/contact/")} />
  <main>
    <SimpleHero
      label={["Company", "Privacy Policy"]}
      headline={["Your data,", "handled with care."]}
      lede="What we collect when you contact us, why we collect it, how we keep it safe, and what you can do about it."
    />
    <ArticleBody article={{ blocks }} numbered>
      <LegalContact
        title="Questions about your data?"
        body="If you have any question regarding our privacy policy or data handling practices, we would be glad to hear from you."
        email="info@jumpgrowth.com"
      />
    </ArticleBody>
  </main>
  <Footer />
</Layout>
