---
import "@pg/page30/styles/globals.css";
import "@/styles/globals.css";
import Layout from "@/layouts/Layout.astro";
import Navbar from "@/components/Navbar.astro";
import Footer from "@/components/Footer.astro";
import SimpleHero from "@/components/SimpleHero.astro";
import Arrow from "@pg/page30/components/icons/Arrow.astro";
import { withBase } from "@/lib/paths";

/* Not found. GitHub Pages serves this for any address the site doesn't have.
   It keeps the navbar and footer, says what happened in one line, and offers
   the pages most visitors were after. Kept out of search results. */

const LINKS = [
  { label: "Home", href: withBase("/"), note: "Start from the top" },
  { label: "Case Studies", href: withBase("/case-studies/"), note: "Products we took to market" },
  { label: "Engagement models", href: withBase("/engagement-models/"), note: "Nine ways to work with us" },
  { label: "Book a discovery call", href: withBase("/contact/"), note: "Talk to a team specialist" },
];
---

<Layout title="Page not found" description="The page you were looking for isn't here. Find JumpGrowth's team models, technologies, case studies and insights from the home page." navTone="field" noindex>
  <Navbar contactHref={withBase("/contact/")} />
  <main>
    <SimpleHero
      label={["Error 404"]}
      headline={["This page", "isn’t here."]}
      lede="The address may have changed, or the page may have moved. These will get you back on track."
    >
      <ul data-ac-notfound-links role="list">
        {LINKS.map((link) => (
          <li>
            <a href={link.href}>
              <span data-ac-notfound-label>{link.label}</span>
              <span data-ac-notfound-note>{link.note}</span>
              <Arrow direction="diagonal" />
            </a>
          </li>
        ))}
      </ul>
    </SimpleHero>
  </main>
  <Footer />
</Layout>

<style>
  [data-ac-notfound-links] {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    margin: clamp(32px, 5vh, 52px) 0 0;
    padding: 0;
    list-style: none;
    border: 1px solid var(--ac-line);
  }

  [data-ac-notfound-links] li + li {
    border-left: 1px solid var(--ac-line);
  }

  [data-ac-notfound-links] a {
    position: relative;
    display: flex;
    flex-direction: column;
    gap: 6px;
    height: 100%;
    min-height: 44px;
    padding: clamp(18px, 2vw, 28px);
    padding-right: 44px;
    color: #ffffff;
    text-decoration: none;
    transition: background-color 0.2s ease;
  }

  [data-ac-notfound-links] a:hover {
    background: rgb(255 255 255 / 0.05);
  }

  [data-ac-notfound-links] a:focus-visible {
    outline: 2px solid #ffffff;
    outline-offset: -2px;
  }

  [data-ac-notfound-links] a :global(svg) {
    position: absolute;
    top: clamp(18px, 2vw, 28px);
    right: clamp(16px, 1.6vw, 22px);
    color: var(--color-accent);
  }

  [data-ac-notfound-label] {
    font-family: var(--font-display-stack);
    font-size: clamp(19px, 1.6vw, 23px);
    line-height: 1.2;
  }

  [data-ac-notfound-note] {
    font-size: 14px;
    color: var(--sec-muted);
  }

  @media (max-width: 991px) {
    [data-ac-notfound-links] {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    [data-ac-notfound-links] li + li {
      border-left: 0;
    }

    [data-ac-notfound-links] li:nth-child(even) {
      border-left: 1px solid var(--ac-line);
    }

    [data-ac-notfound-links] li:nth-child(n + 3) {
      border-top: 1px solid var(--ac-line);
    }
  }

  @media (max-width: 559px) {
    [data-ac-notfound-links] {
      grid-template-columns: minmax(0, 1fr);
    }

    [data-ac-notfound-links] li:nth-child(even) {
      border-left: 0;
    }

    [data-ac-notfound-links] li + li {
      border-top: 1px solid var(--ac-line);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    [data-ac-notfound-links] a {
      transition: none;
    }
  }
</style>
