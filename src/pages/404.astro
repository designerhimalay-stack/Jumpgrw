---
import "@pg/page30/styles/globals.css";
import "@/styles/globals.css";
import Layout from "@/layouts/Layout.astro";
import Navbar from "@/components/Navbar.astro";
import Footer from "@/components/Footer.astro";
import GridRules from "@pg/page30/components/GridRules.astro";
import Arrow from "@pg/page30/components/icons/Arrow.astro";
import { withBase } from "@/lib/paths";

/* Not found. GitHub Pages serves this for any address the site doesn't have.
   It keeps the navbar and footer, says what happened in one line, and offers
   the pages most visitors were after. Kept out of search results. */

const LINKS = [
  { label: "Home", href: withBase("/"), note: "Start from the top" },
  { label: "Case Studies", href: withBase("/case-studies/"), note: "Products we took to market" },
  { label: "Engagement models", href: withBase("/engagement-models/"), note: "Nine ways to work with us" },
  { label: "Book a discovery call", href: withBase("/contact/"), note: "Talk to a team specialist" },
];
---

<Layout title="Page not found" description="The page you were looking for isn't here." navTone="field" noindex>
  <Navbar />
  <main>
    <section data-ac-sec="dark" data-ac-notfound>
      <GridRules />
      <div data-ac-sec-container>
        <p data-ac-notfound-code class="mono-label"><span aria-hidden="true">+</span> Error 404</p>
        <h1 data-ac-notfound-title>
          <span>This page</span>
          <span data-accent>isn’t here.</span>
        </h1>
        <p data-ac-notfound-lede>The address may have changed, or the page may have moved. These will get you back on track.</p>
        <ul data-ac-notfound-links role="list">
          {LINKS.map((link) => (
            <li>
              <a href={link.href}>
                <span data-ac-notfound-label>{link.label}</span>
                <span data-ac-notfound-note>{link.note}</span>
                <Arrow direction="diagonal" />
              </a>
            </li>
          ))}
        </ul>
      </div>
    </section>
  </main>
  <Footer />
</Layout>

<style>
  [data-ac-notfound][data-ac-sec] {
    padding-top: calc(108px + clamp(48px, 9vh, 110px));
    padding-bottom: clamp(64px, 11vh, 130px);
    background:
      radial-gradient(55% 65% at 88% 18%, rgb(80 122 247 / 0.2), transparent 70%),
      linear-gradient(180deg, #000715 0%, #071127 34%, #0d1c41 74%, #132658 100%);
  }

  [data-ac-notfound-code] {
    display: flex;
    gap: 10px;
    margin: 0 0 clamp(18px, 3vh, 28px);
    color: var(--sec-muted);
  }

  [data-ac-notfound-code] span {
    color: var(--color-accent);
  }

  [data-ac-notfound-title] {
    display: flex;
    flex-direction: column;
    margin: 0;
    font-family: var(--font-display-stack);
    font-size: clamp(44px, 7vw, 104px);
    font-weight: var(--display-weight);
    line-height: 1;
    letter-spacing: -0.03em;
    color: #ffffff;
  }

  [data-ac-notfound-title] [data-accent] {
    color: var(--color-accent);
  }

  [data-ac-notfound-lede] {
    max-width: 48ch;
    margin: clamp(20px, 3vh, 30px) 0 clamp(32px, 5vh, 52px);
    font-size: clamp(16px, 1.3vw, 19px);
    line-height: 1.5;
    color: var(--sec-soft);
  }

  [data-ac-notfound-links] {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    margin: 0;
    padding: 0;
    list-style: none;
    border: 1px solid var(--ac-line);
  }

  [data-ac-notfound-links] li + li {
    border-left: 1px solid var(--ac-line);
  }

  [data-ac-notfound-links] a {
    position: relative;
    display: flex;
    flex-direction: column;
    gap: 6px;
    height: 100%;
    min-height: 44px;
    padding: clamp(18px, 2vw, 28px);
    padding-right: 44px;
    color: #ffffff;
    text-decoration: none;
    transition: background-color 0.2s ease;
  }

  [data-ac-notfound-links] a:hover {
    background: rgb(255 255 255 / 0.05);
  }

  [data-ac-notfound-links] a:focus-visible {
    outline: 2px solid #ffffff;
    outline-offset: -2px;
  }

  [data-ac-notfound-links] a :global(svg) {
    position: absolute;
    top: clamp(18px, 2vw, 28px);
    right: clamp(16px, 1.6vw, 22px);
    color: var(--color-accent);
  }

  [data-ac-notfound-label] {
    font-family: var(--font-display-stack);
    font-size: clamp(19px, 1.6vw, 23px);
    line-height: 1.2;
  }

  [data-ac-notfound-note] {
    font-size: 14px;
    color: var(--sec-muted);
  }

  @media (max-width: 991px) {
    [data-ac-notfound-links] {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    [data-ac-notfound-links] li + li {
      border-left: 0;
    }

    [data-ac-notfound-links] li:nth-child(even) {
      border-left: 1px solid var(--ac-line);
    }

    [data-ac-notfound-links] li:nth-child(n + 3) {
      border-top: 1px solid var(--ac-line);
    }
  }

  @media (max-width: 559px) {
    [data-ac-notfound-links] {
      grid-template-columns: 1fr;
    }

    [data-ac-notfound-links] li:nth-child(even) {
      border-left: 0;
    }

    [data-ac-notfound-links] li + li {
      border-top: 1px solid var(--ac-line);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    [data-ac-notfound-links] a {
      transition: none;
    }
  }
</style>
