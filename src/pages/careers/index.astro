---
import "@pg/page30/styles/globals.css";
import "@/styles/globals.css";
import Layout from "@/layouts/Layout.astro";
import Navbar from "@/components/Navbar.astro";
import Footer from "@/components/Footer.astro";
import ContactForm from "@/components/ContactForm.astro";
import PageHero from "@pg/page30/components/PageHero.astro";
import SmoothScroll from "@pg/page30/components/SmoothScroll.astro";
import HireWhy from "@pg/page30/components/hire/HireWhy.astro";
import HireSteps from "@pg/page30/components/hire/HireSteps.astro";
import LocationsSection from "@/components/about/LocationsSection.astro";
import OpenRoles from "@/components/careers/OpenRoles.astro";
import type { PageHeroContent } from "@pg/page30/types/page";
import heroPhoto from "@/assets/teams/production.jpg";
import { OFFICES } from "@/lib/offices";
import { ROLES } from "@/lib/roles";

/* Careers. The open roles live in src/lib/roles.ts (placeholders until the
   owner confirms the live openings). Below them: what working here is like
   (from the About page's facts), how hiring works, where the offices are, and
   the shared form's careers variant for an applicant's details. */

const HERO: PageHeroContent = {
  trail: ["Company", "Careers"],
  audience: "Careers at JumpGrowth",
  headline: ["Build products", "with us."],
  size: "long",
  lede: "A digital studio of 200+ engineers building web, mobile and AI products for startups and growing businesses, with offices in the US, Canada, Mexico, India and Australia.",
  ctas: [
    { label: "See open roles", href: "#roles", arrow: "right" },
    { label: "Why JumpGrowth", href: "#why", arrow: "diagonal" },
  ],
  assurances: [
    { icon: "users", label: "200+ engineers under one roof" },
    { icon: "globe", label: `${OFFICES.length} offices worldwide` },
    { icon: "shield", label: "Part of OTS Solutions" },
  ],
  image: heroPhoto,
  imageAlt: "A smiling JumpGrowth engineer standing by a bright office window.",
  card: {
    status: "Careers / Hiring",
    place: "Dallas headquartered",
    note: `${ROLES.length} open roles across engineering, QA, cloud, design and sales.`,
    kicker: "Join us.",
    statement: "Real products, senior teams, four delivery countries.",
    foot: { label: "Offices", value: OFFICES.map((o) => o.city.split(",")[0]).join(", ") },
  },
  specs: [
    { label: "Engineers under one roof", value: "200+" },
    { label: "Offices", value: String(OFFICES.length) },
    { label: "Years of experience", value: "20+" },
    { label: "Clients served", value: "300+" },
  ],
  base: { title: "Dallas headquartered", line: "Offices in the USA, Canada, Mexico, India and Australia" },
};
---

<Layout
  title="Careers · JumpGrowth"
  description="Careers at JumpGrowth: build web, mobile and AI products with 200+ engineers across the US, Canada, Mexico, India and Australia."
  navTone="field"
>
  <SmoothScroll />
  <Navbar />
  <main>
    <PageHero content={HERO} />

    <OpenRoles
      eyebrow="Open roles"
      headline={["Find the role", "that fits you."]}
      lede="Engineers, testers, designers and delivery leads for web, mobile and AI products. Open a role to see what it involves, then apply."
    />

    <HireWhy
      id="why"
      tone="tint"
      eyebrow="Why JumpGrowth"
      headline={["Why build", "your career here."]}
      lede="What the work looks like: real products, senior colleagues and teams that span four delivery countries."
      reasons={[
        {
          title: "Real products, start to finish",
          body: "Our teams take web and mobile products from discovery to release for startups and growing businesses, in fintech, security, AI, real estate and wellness.",
          points: ["Discovery to release", "Web, iOS and Android", "AI, AR/VR and IoT"],
        },
        {
          title: "Senior people around you",
          body: "Work alongside 200+ engineers under one roof, on a delivery process refined over two decades and backed by OTS Solutions.",
          points: ["200+ engineers", "20 years of proven process", "Part of OTS Solutions"],
        },
        {
          title: "Teams across four countries",
          body: "Onshore in the US, nearshore in Mexico and Canada, offshore in India: work with colleagues and clients across time zones.",
          points: ["USA, Canada, Mexico and India", "Onshore, nearshore and offshore", "Clients across the globe"],
        },
      ]}
      figures={[
        { value: "20+", label: "Years of experience" },
        { value: "200+", label: "Engineers under one roof" },
        { value: "300+", label: "Clients served" },
      ]}
      cta={{ label: "Send your details", href: "#apply" }}
    />

    <HireSteps
      id="hiring"
      eyebrow="How we hire"
      headline={["A clear process,", "start to finish."]}
      lede="Four steps from your first message to your first day, with a person you can reply to at every one."
      steps={[
        { title: "Apply", body: "Pick a role or send your details. Share a CV, LinkedIn or portfolio link if you have one.", focus: "A reply within a few days" },
        { title: "Intro call", body: "A conversation with our talent team about your work, what you want next and where you would like to be based.", focus: "30 minutes" },
        { title: "Working session", body: "Talk through real work with the people you would join: a code or design review, a test plan or a delivery scenario.", focus: "Role-specific" },
        { title: "Offer", body: "A clear offer, the team you will join and an onboarding plan so your first weeks are never a guessing game.", focus: "Onboarding plan included" },
      ]}
      close={{ text: "Ready to start? Send your details and tell us the work you do best.", cta: { label: "Send your details", href: "#apply" } }}
    />

    <LocationsSection
      eyebrow="Where we work"
      headline={["Offices across", "the globe."]}
      lede="Join a team in Dallas, Toronto, Mexico City, Delhi NCR, Pune or Sydney."
    />

    <ContactForm id="apply" variant="careers" />
  </main>
  <Footer />
</Layout>
