---
import "@pg/page30/styles/globals.css";
import "@/styles/globals.css";
import Layout from "@pg/page30/layouts/Layout.astro";
import Navbar from "@/components/Navbar.astro";
import Footer from "@/components/Footer.astro";
import ContactForm from "@/components/ContactForm.astro";
import DetailHero from "@/components/DetailHero.astro";
import ArticleBody from "@/components/insights/ArticleBody.astro";
import RelatedPosts from "@/components/insights/RelatedPosts.astro";
import SmoothScroll from "@pg/page30/components/SmoothScroll.astro";
import { BLOG_POSTS } from "@/lib/insights";
import { formatDate, getArticle, related } from "@/lib/articles";
import { withBase } from "@/lib/paths";

/* One blog article, in the site's own layout. The text comes from
   src/data/blog/<slug>.json (see src/lib/articles.ts); the cover, topic and
   summary from the post's entry in src/lib/insights.ts. */

export function getStaticPaths() {
  return BLOG_POSTS.map((post) => ({ params: { slug: post.slug }, props: { post } }));
}

const { post } = Astro.props;
const article = getArticle(post.slug);
---

<Layout title={`${post.title} · JumpGrowth`} description={post.excerpt} navTone="field">
  <SmoothScroll />
  <Navbar />
  <main>
    <DetailHero
      trail={["Insights", "Blog", post.category]}
      title={article.title}
      chips={[post.category]}
      facts={[
        { label: "Written by", value: article.author },
        { label: "Published", value: formatDate(article.published) },
        { label: "Reading time", value: article.readTime },
      ]}
      actions={[
        { label: "Plan my team", href: "#contact", arrow: "right" },
        { label: "All articles", href: withBase("/blog/#articles"), arrow: "diagonal" },
      ]}
      image={post.cover}
      imageAlt={`Cover image for “${post.title}”`}
    />
    <ArticleBody article={article} />
    <RelatedPosts posts={related(post)} />
    <ContactForm />
  </main>
  <Footer />
</Layout>
