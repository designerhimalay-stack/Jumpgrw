---
import "@pg/page31/styles/globals.css";
import "@/styles/globals.css";
import Layout from "@pg/page31/layouts/Layout.astro";
import FaqSection from "@pg/page31/components/FaqSection.astro";
import Footer from "@/components/Footer.astro";
import Navbar from "@/components/Navbar.astro";
import PageHero from "@pg/page31/components/PageHero.astro";
import SmoothScroll from "@pg/page31/components/SmoothScroll.astro";
import HireStack from "@pg/page31/components/hire/HireStack.astro";
import HireServices from "@pg/page31/components/hire/HireServices.astro";
import HireWhy from "@pg/page31/components/hire/HireWhy.astro";
import HireWays from "@pg/page31/components/hire/HireWays.astro";
import HirePlanner from "@pg/page31/components/hire/HirePlanner.astro";
import HireEngineers from "@pg/page31/components/hire/HireEngineers.astro";
import HireColumns from "@pg/page31/components/hire/HireColumns.astro";
import HireSteps from "@pg/page31/components/hire/HireSteps.astro";
import HireCases from "@pg/page31/components/hire/HireCases.astro";
import HirePod from "@pg/page31/components/hire/HirePod.astro";
import HireFit from "@pg/page31/components/hire/HireFit.astro";
import HireProcess from "@pg/page31/components/hire/HireProcess.astro";
import ContactForm from "@/components/ContactForm.astro";
import type { PageHeroContent } from "@pg/page31/types/page";
import { BRAND } from "@pg/page31/lib/brand";

import heroPhoto from "@pg/page31/assets/pages/p31-hero.jpg";
import faqPhoto from "@pg/page31/assets/pages/p31-faq.jpg";
import waysSolo from "@pg/page31/assets/pages/p31-ways-solo.jpg";
import waysSquad from "@pg/page31/assets/pages/p31-ways-squad.jpg";
import waysPod from "@pg/page31/assets/pages/p31-ways-pod.jpg";
import engWeb from "@pg/page31/assets/pages/p31-eng-web.jpg";
import engMobile from "@pg/page31/assets/pages/p31-eng-mobile.jpg";
import engBackend from "@pg/page31/assets/pages/p31-examples.jpg";
import engData from "@pg/page31/assets/pages/p31-eng-data.jpg";
import engMl from "@pg/page31/assets/pages/p31-eng-ml.jpg";
import engGenai from "@pg/page31/assets/pages/p31-eng-genai.jpg";
import engQa from "@pg/page31/assets/pages/p31-eng-qa.jpg";
import engDevops from "@pg/page31/assets/pages/p31-eng-devops.jpg";
import stepCall from "@pg/page31/assets/pages/p31-step-call.jpg";
import stepModel from "@pg/page31/assets/pages/p31-step-model.jpg";
import stepOptions from "@pg/page31/assets/pages/p31-step-options.jpg";
import stepInterview from "@pg/page31/assets/pages/p31-step-interview.jpg";
import stepKickoff from "@pg/page31/assets/pages/p31-step-kickoff.jpg";

/* Engineers and teams in Mexico. The page sells engineers and teams across
   the stack (web and app, mobile, back end, data, AI/ML, QA, DevOps and
   cloud), built from the shared hire kit in src/components/hire/. Every word
   on the page lives here. Figures, rates, example results and FAQ answers
   are the owner's figures or drafts: have them checked before launch (see
   docs/sections.md, "Copy to check before launch"). */

const HERO: PageHeroContent = {
  trail: ["X-Shore", "Nearshore", "Mexico"],
  audience: "For app and engineering leaders",
  headline: ["Hire Mexico-based", "engineers who work", "close to your team."],
  accent: 2,
  size: "long",
  lede: "Add senior web, mobile, data, AI or full-stack engineers in Mexico, with strong US time-zone overlap and a delivery model built for nearshore teams.",
  ctas: [
    { label: "Plan your engineering hires", href: "#contact", arrow: "diagonal" },
    { label: "Explore team options", href: "#ways", arrow: "right" },
  ],
  assurances: [
    { icon: "shield", label: "Senior engineering oversight" },
    { icon: "clock", label: "US workday overlap" },
    { icon: "lock", label: "Your stack and controls" },
  ],
  image: heroPhoto,
  imageAlt: "A software engineer works at a laptop.",
  card: {
    status: "Build context / Active",
    place: "Mexico-based delivery",
    note: "Start with one engineer. Add a team when you need more hands.",
    kicker: "Engineering capacity, inside your org.",
    statement: "Developers who work in your codebase, quality gates and release rhythm.",
    foot: { label: "Built for VP application development", value: "One senior engineer to a full delivery pod" },
  },
  specs: [
    { label: "Years engineering software", value: "20+" },
    { label: "Engineers under one roof", value: "200+" },
    { label: "Clients served", value: "300+" },
    { label: "Global delivery locations", value: "4+" },
  ],
  base: { title: "Dallas headquartered", line: "Delivery across the USA, India, Canada and Mexico" },
};

const FAQS = [
  {
    q: "Is this staff augmentation or a managed delivery team?",
    a: "Both. Add one engineer, a small team, or a full pod with technical leadership.",
  },
  {
    q: "Can we start with one engineer?",
    a: "Yes. Most teams start with one or two engineers and grow from there.",
  },
  {
    q: "Can we interview engineers before we choose?",
    a: "Yes. You see pre-vetted profiles, interview the ones you like and decide.",
  },
  {
    q: "What skills can we hire for?",
    a: "Web and app, mobile, back end, data, AI and ML, QA, and DevOps and cloud: one specialist or a full team.",
  },
  {
    q: "How do you match engineers to our team?",
    a: "We start from your stack, your work and your hours, then send profiles that fit all three.",
  },
  {
    q: `How do ${BRAND.name} engineers collaborate with US teams?`,
    a: "They share most of your workday, join your rituals and work in your tools, so questions get answers the same day.",
  },
  {
    q: "Can the team work inside our cloud, tools and security controls?",
    a: "Yes. Engineers work in your repositories, cloud accounts and tools, under your access rules.",
  },
  {
    q: "Can we scale the team after the first engineer starts?",
    a: "Yes. Add engineers as the roadmap grows, or move to a managed pod with its own lead.",
  },
  {
    q: "What happens after we select an engineer?",
    a: "We set up access, rituals and a first task, so the work starts in the first week.",
  },
];
---

<Layout
  title={`Engineers in Mexico · ${BRAND.name}`}
  description="Hire senior engineers and teams in Mexico: web and app, mobile, back end, data, AI/ML, QA and DevOps, on US hours and inside your delivery process."
  navTone="field"
>
  <SmoothScroll />
  <Navbar />
  <main>
    <PageHero content={HERO} />

    <HireStack
      id="stack"
      tone="tint"
      eyebrow="Tech we use"
      headline={["Engineers who", "fit your stack."]}
      lede="They work with the languages, frameworks, clouds and tools your teams already use."
      groups={[
        { name: "Web and app", logos: ["react", "nextdotjs", "vuedotjs", "angular", "typescript", "nodedotjs"] },
        { name: "Mobile", logos: ["swift", "kotlin", "flutter", "android"], named: ["iOS", "React Native"] },
        { name: "Back end", logos: ["python", "go", "openjdk", "dotnet", "postgresql", "mongodb", "redis", "graphql"] },
        { name: "Data", logos: ["snowflake", "databricks", "apacheairflow", "apachekafka", "pandas"], named: ["dbt", "Power BI"] },
        { name: "AI and ML", logos: ["pytorch", "tensorflow", "huggingface", "langchain", "claude", "googlegemini", "mlflow"], named: ["OpenAI", "Llama", "Mistral"] },
        { name: "QA and testing", logos: ["selenium", "cypress", "jest", "postman"], named: ["Playwright"] },
        { name: "DevOps and cloud", logos: ["docker", "kubernetes", "terraform", "githubactions", "googlecloud", "gitlab"], named: ["AWS", "Azure"] },
      ]}
      note="We choose tools for your product, data, security needs and deployment plan."
    />

    <HireServices
      id="help"
      tone="tint"
      eyebrow="More ways we can help"
      headline={["Choose the work", "your team needs."]}
      lede="Explore the work our engineers in Mexico take on, and the tools they use every day."
      services={[
        {
          name: "Web and app development",
          body: "Build and extend web products, from customer screens to internal tools, with engineers who ship inside your release process.",
          work: ["Customer portals", "Internal tools", "Design systems"],
          tools: ["React", "Next.js", "TypeScript", "Node.js"],
        },
        {
          name: "Mobile apps",
          body: "Ship iOS and Android apps, native or cross-platform, and keep them fast, stable and in step with your web product.",
          work: ["New apps", "App modernization", "Offline and sync"],
          tools: ["Swift", "Kotlin", "Flutter", "React Native"],
        },
        {
          name: "Back end and APIs",
          body: "Design services and APIs that scale, connect your systems and keep your data safe.",
          work: ["APIs and integrations", "Microservices", "Performance tuning"],
          tools: ["Python", "Go", "Java", ".NET", "PostgreSQL"],
        },
        {
          name: "Data engineering",
          body: "Build the pipelines, warehouses and models that turn raw data into numbers your teams trust.",
          work: ["Pipelines", "Data warehouses", "Dashboards"],
          tools: ["Snowflake", "Databricks", "Airflow", "dbt", "Kafka"],
        },
        {
          name: "AI and machine learning",
          body: "Add AI to your product: assistants, search, predictions and agents, tested before they reach your users.",
          work: ["LLM features", "RAG and search", "Predictive models", "Computer vision"],
          tools: ["PyTorch", "Hugging Face", "LangChain", "OpenAI SDK"],
        },
        {
          name: "QA and test automation",
          body: "Catch defects before release with test plans, automated suites and quality gates in your pipeline.",
          work: ["Test automation", "Regression suites", "Release checks"],
          tools: ["Playwright", "Cypress", "Selenium", "Postman"],
        },
        {
          name: "DevOps and cloud",
          body: "Automate builds, deploys and infrastructure, and keep production observable and secure.",
          work: ["CI/CD", "Infrastructure as code", "Monitoring"],
          tools: ["Docker", "Kubernetes", "Terraform", "AWS", "GitHub Actions"],
        },
        {
          name: "Product modernization",
          body: "Move legacy systems to a modern stack one piece at a time, without stopping the roadmap.",
          work: ["Legacy migration", "Cloud moves", "Refactoring"],
          tools: ["Java", ".NET", "Node.js", "Azure"],
        },
      ]}
    />

    <HireWhy
      id="why"
      eyebrow={`Why ${BRAND.name}`}
      headline={["Why teams", `choose ${BRAND.name}.`]}
      lede="Senior engineers in Mexico who overlap your hours, follow your standards and join your delivery process."
      reasons={[
        {
          title: "Senior engineers, matched to your work",
          body: "Start with the skill you need: web, mobile, data, AI, QA or cloud. You review the profiles and validate the fit before you choose.",
          points: ["Generalists to specialists", "Profiles you review", "Your final say"],
        },
        {
          title: "A delivery model built around your team",
          body: "Engineers join your rituals, tools and codebase, and senior oversight keeps quality steady as the team grows.",
          points: ["Your sprints and tools", "Senior oversight", "Scale up or down"],
        },
        {
          title: "Based in Mexico, aligned to your day",
          body: "Mexico shares the US working day, so questions get answers the same day and releases don’t wait overnight.",
          points: ["US workday overlap", "Same-day answers", "Short trips when needed"],
        },
      ]}
      figures={[
        { value: "20+", label: "Years building software" },
        { value: "200+", label: "Engineers in one team" },
        { value: "300+", label: "Clients served" },
      ]}
      cta={{ label: "Talk to our team", href: "#contact" }}
    />

    <HireWays
      id="ways"
      eyebrow="Ways to work together"
      headline={["Start with one engineer.", "Build a team", "when you need it."]}
      accent={2}
      lede="Choose the setup that fits your team and your delivery plan."
      models={[
        {
          kind: "Staff augmentation",
          size: "1 engineer",
          title: "Add one engineer",
          body: "A dedicated engineer in your team, codebase and sprint cycle.",
          skills: ["Web and mobile", "Back end", "QA"],
          photo: { image: waysSolo, alt: "An engineer plans his next task at a desk beside a window.", focus: "40% 40%" },
        },
        {
          kind: "Augmented squad",
          size: "2–4 engineers",
          title: "Add a small team",
          body: "Web, mobile, data or QA engineers to close a clear team gap.",
          skills: ["Feature delivery", "Data pipelines", "Test automation"],
          photo: { image: waysSquad, alt: "Three engineers laugh as they work through a problem at a shared table.", focus: "50% 45%" },
        },
        {
          kind: "Managed delivery pod",
          size: "5–8 engineers",
          title: "Build a delivery pod",
          body: "A connected team with its own technical lead, when you need more capacity.",
          skills: ["Architecture", "Delivery", "AI products"],
          photo: { image: waysPod, alt: "A product team talks through a plan around a desk in an open office.", focus: "60% 60%" },
        },
      ]}
      cta={{ label: "Plan this team shape", href: "#plan" }}
      control={{ lead: "You stay in control.", rest: `${BRAND.name} engineers work in your codebase, tools and delivery process.` }}
    />

    <HirePlanner
      id="plan"
      tone="tint"
      eyebrow="Team planning view"
      headline={["Size the engineering", "capacity you need."]}
      lede="See the monthly investment for a team in Mexico at your target size. Planning figures are directional, not a quote."
      rate={125}
      hours={160}
      max={12}
      start={3}
      panelLabel="Monthly team cost"
      oneLabel="One engineer in Mexico at $125/hr"
      teamLabel="Your team of {n}"
      capacity="{n} senior {people} inside your hours, standards and release rhythm."
      sizeLabel="Your team size"
      unit={["engineer", "engineers"]}
      cta={{ label: "Build my team plan", href: "#contact" }}
      disclaimer="Get a tailored cost view based on your roles, skills and stack."
      note={`Estimate at $125 an hour and 160 hours per engineer each month. Not a ${BRAND.name} quote.`}
    />

    <HireEngineers
      id="engineers"
      eyebrow="Find the right skill"
      headline={["Find the engineer", "you need."]}
      lede={`Pick a specialty to see the engineers ${BRAND.name} can match to your team.`}
      allLabel="All engineers"
      filters={[
        { key: "web", label: "Web & mobile" },
        { key: "backend", label: "Back end" },
        { key: "data", label: "Data & AI" },
        { key: "qa", label: "QA" },
        { key: "cloud", label: "DevOps & cloud" },
      ]}
      engineers={[
        {
          level: "Senior specialty role",
          role: "Full-stack web developer",
          for: "For product screens, APIs and the features your customers use every day.",
          years: "8+ years",
          skills: ["React", "Next.js", "Node.js", "TypeScript"],
          tags: ["web", "backend"],
          photo: { image: engWeb, alt: "A developer works at a desktop computer in a busy open-plan office.", focus: "62% 40%" },
        },
        {
          level: "Senior specialty role",
          role: "Mobile app developer",
          for: "For iOS and Android apps, native or cross-platform.",
          years: "7+ years",
          skills: ["Swift", "Kotlin", "Flutter", "App releases"],
          tags: ["web"],
          photo: { image: engMobile, alt: "A developer smiles as she works on a laptop in a café.", focus: "50% 30%" },
        },
        {
          level: "Senior specialty role",
          role: "Back-end engineer",
          for: "For services, APIs, integrations and performance.",
          years: "9+ years",
          skills: ["Python", "Go", "Java", "PostgreSQL"],
          tags: ["backend"],
          photo: { image: engBackend, alt: "A developer in Playa del Carmen, Mexico, works at a laptop on a terrace.", focus: "55% 40%" },
        },
        {
          level: "Senior specialty role",
          role: "Data engineer",
          for: "For pipelines, warehouses, data quality and analytics.",
          years: "7+ years",
          skills: ["Snowflake", "Airflow", "dbt", "SQL"],
          tags: ["data"],
          photo: { image: engData, alt: "A data engineer types on a laptop at a bright desk.", focus: "45% 40%" },
        },
        {
          level: "Senior specialty role",
          role: "AI/ML engineer",
          for: "For predictive models, training, evaluation and deployment.",
          years: "8+ years",
          skills: ["PyTorch", "scikit-learn", "MLflow", "Python"],
          tags: ["data"],
          photo: { image: engMl, alt: "An engineer works at a laptop at a standing desk.", focus: "70% 35%" },
        },
        {
          level: "Senior specialty role",
          role: "GenAI and LLM developer",
          for: "For assistants, RAG search, agents and AI quality checks.",
          years: "6+ years",
          skills: ["LLM apps", "RAG", "LangChain", "Evaluation"],
          tags: ["data"],
          photo: { image: engGenai, alt: "An engineer smiles at her laptop in a bright room.", focus: "50% 35%" },
        },
        {
          level: "Senior specialty role",
          role: "QA automation engineer",
          for: "For test plans, automated suites and release checks.",
          years: "7+ years",
          skills: ["Playwright", "Cypress", "Selenium", "API tests"],
          tags: ["qa"],
          photo: { image: engQa, alt: "A QA engineer works at a desktop computer in an office with colleagues.", focus: "22% 55%" },
        },
        {
          level: "Senior specialty role",
          role: "DevOps and cloud engineer",
          for: "For CI/CD, infrastructure as code, monitoring and uptime.",
          years: "8+ years",
          skills: ["Kubernetes", "Terraform", "AWS", "GitHub Actions"],
          tags: ["cloud"],
          photo: { image: engDevops, alt: "An engineer in headphones works at a desk with a large screen.", focus: "45% 40%" },
        },
      ]}
      cta={{ label: "Discuss this engineering hire", href: "#contact" }}
      footnote={`These are example roles. ${BRAND.name} confirms availability and fit before you decide.`}
    />

    <HireColumns
      id="do"
      eyebrow="What our engineers do"
      headline={["Get help across", "your whole stack."]}
      lede="Add the skills you need across product, data and operations."
      columns={[
        {
          label: "Build",
          title: "Build your product",
          body: "Engineers who build web and mobile features, APIs and the screens your users touch.",
          tags: ["Web apps", "Mobile apps", "APIs", "Design systems"],
        },
        {
          label: "Data and AI",
          title: "Put data and AI to work",
          body: "Specialists who build pipelines, models and AI features, then test them properly.",
          tags: ["Data pipelines", "Analytics", "ML models", "GenAI"],
        },
        {
          label: "Platform",
          title: "Run it in production",
          body: "Engineers for testing, releases, cloud and the monitoring that keeps it up.",
          tags: ["QA automation", "CI/CD", "Cloud", "Observability"],
        },
      ]}
    />

    <HireSteps
      id="how"
      eyebrow="How they help"
      headline={["Build, ship and", "improve your product."]}
      lede={`Hire one specialist or a full team. ${BRAND.name} covers the work from product to production.`}
      steps={[
        {
          title: "Build inside your product",
          body: "Features, apps and APIs that sit inside your existing architecture.",
          focus: "Features, APIs and interfaces",
        },
        {
          title: "Shape the data and AI layer",
          body: "Prepare the data, choose the models and tie them to goals you can measure.",
          focus: "Data, models and measurement",
        },
        {
          title: "Integrate and release",
          body: "Work inside your services, quality gates, cloud and release process.",
          focus: "Integration, testing and release",
        },
        {
          title: "Operate and improve",
          body: "Keep it reliable with monitoring, upkeep and steady improvement.",
          focus: "Observability and evolution",
        },
      ]}
      close={{
        text: `Need help with one part of your stack? ${BRAND.name} can help.`,
        cta: { label: "Find the right role", href: "#engineers" },
      }}
    />

    <HireCases
      id="cases"
      eyebrow="How teams use us"
      headline={["Real examples of", "teams in action."]}
      lede="The roles we brought in, and what the teams achieved."
      cases={[
        {
          sector: "US industrial engineering company",
          team: "Computer vision and data pod",
          title: "Production quality vision team",
          body: "Computer vision, data and QA automation engineers built models that check production imagery and designs for quality issues.",
          roles: ["Computer vision ML engineer", "Data engineer", "QA automation engineer"],
          tools: ["OpenCV", "PyTorch", "Image classification"],
          results: [
            { value: "Automated", label: "imagery quality checks" },
            { value: "Consistent", label: "design review workflows" },
          ],
        },
        {
          sector: "US fintech lending platform",
          team: "Dedicated ML and data specialists",
          title: "Lending risk-model team",
          body: "ML and data specialists improved scoring, eligibility checks and the model platform.",
          roles: ["ML engineer", "Data scientist", "MLOps engineer"],
          tools: ["H2O.ai", "Kubeflow", "ML scoring"],
          results: [
            { value: "87%", label: "improved approval accuracy" },
            { value: "61%", label: "improved fraud detection" },
          ],
        },
        {
          sector: "US industrial equipment supplier",
          team: "AI, data and integration team",
          title: "Predictive maintenance team",
          body: "AI, data and integration engineers turned sensor data into useful maintenance alerts.",
          roles: ["ML engineer", "Data engineer", "Integration developer"],
          tools: ["Deep learning", "IoT sensors", "Predictive analytics"],
          results: [
            { value: "6×", label: "less machine downtime" },
            { value: "43%", label: "maintenance cost savings" },
          ],
        },
      ]}
      footnote={`Client details are kept private. Team roles show the skills used on each ${BRAND.name} engagement. Results are examples, not guarantees.`}
    />

    <HirePod
      id="pod"
      eyebrow="One team. One operating rhythm."
      headline={["How does your", "development pod", `look with ${BRAND.name}?`]}
      lede={`Your leaders own the product and the architecture. ${BRAND.name} engineers join your way of working, with the context and overlap to contribute inside the team.`}
      points={[
        { lead: "Start small", rest: "with the role you need now." },
        { lead: "Work your way", rest: "in your codebase, tools and quality process." },
        { lead: "Grow when needed", rest: "with web, mobile, data, AI and cloud skills." },
      ]}
      rosterLabel="Delivery pod / 01"
      status="Active"
      members={[
        { initials: "TL", role: "Tech lead", layer: "Architecture" },
        { initials: "FS", role: "Full-stack engineer", layer: "Product layer" },
        { initials: "MB", role: "Mobile engineer", layer: "Apps" },
        { initials: "DE", role: "Data engineer", layer: "Data systems" },
        { initials: "QA", role: "QA engineer", layer: "Quality gates" },
      ]}
      terms={[
        { label: "Rituals", value: "Daily overlap" },
        { label: "Ownership", value: "Sprint outcomes" },
        { label: "Start", value: "Roadmap-led" },
      ]}
      cta={{ label: "Talk about your team", href: "#contact" }}
    />

    <HireFit
      id="fit"
      tone="tint"
      eyebrow="Is this a good fit?"
      headline={["Built for teams", "that need more", "engineering help."]}
      items={[
        "You need more engineers to meet your delivery goals.",
        "You need skills your team doesn’t have today, from mobile to AI.",
        "You need engineers who follow your security and release process.",
        "You want engineers in Mexico who overlap your US workday.",
      ]}
    />

    <HireProcess
      id="process"
      eyebrow="How it works"
      headline={["Five simple steps", "to add engineers."]}
      lede="From the first call to an engineer working in your sprint."
      detailLabel={`${BRAND.name} onboarding`}
      steps={[
        {
          title: "Discovery call",
          body: "Tell us about your roadmap, your team gap and the work that needs more support.",
          covers: ["Your goals", "Team gap", "Tech context"],
          photo: { image: stepCall, alt: "A team lead talks with an engineer on a video call.", focus: "40% 45%" },
        },
        {
          title: "Pick the suitable model",
          body: "Choose one engineer, a squad or a managed pod. We shape the team with you.",
          covers: ["Engagement model", "Team size", "Start date"],
          photo: { image: stepModel, alt: "Two colleagues sketch a plan on a whiteboard.", focus: "60% 35%" },
        },
        {
          title: "Receive pre-vetted options",
          body: "Get engineer profiles matched to your stack, your hours and your budget.",
          covers: ["Skills", "Experience", "Time-zone overlap"],
          photo: { image: stepOptions, alt: "A team reviews profiles and plans around a table.", focus: "50% 40%" },
        },
        {
          title: "Interview & selection",
          body: "Meet the engineers, test the fit and choose who joins your team.",
          covers: ["Technical interview", "Team fit", "Your decision"],
          photo: { image: stepInterview, alt: "An engineer in a blazer interviews on a call at her laptop.", focus: "50% 40%" },
        },
        {
          title: "Onboarding & kickoff",
          body: "Access, rituals and a first task, so the work starts in week one.",
          covers: ["Access and tools", "Team rituals", "First sprint"],
          photo: { image: stepKickoff, alt: "A new team plans its first sprint at a wall of notes.", focus: "45% 50%" },
        },
      ]}
      cta={{ label: `Plan your ${BRAND.name} hires`, href: "#contact" }}
    />

    <FaqSection
      eyebrow="Common questions"
      headline={["Before you add", "engineers."]}
