---
import "@pg/page4/styles/globals.css";
import "@/styles/globals.css";
import Layout from "@/layouts/Layout.astro";
import CadenceSection from "@pg/page4/components/CadenceSection.astro";
import FaqSection from "@pg/page4/components/FaqSection.astro";
import ContactForm from "@/components/ContactForm.astro";
import Footer from "@/components/Footer.astro";
import Navbar from "@/components/Navbar.astro";
import PageHero from "@pg/page4/components/PageHero.astro";
import ReleaseFeedSection from "@pg/page4/components/ReleaseFeedSection.astro";
import SignalsSection from "@pg/page4/components/SignalsSection.astro";
import SizerSection from "@pg/page4/components/SizerSection.astro";
import SmoothScroll from "@pg/page4/components/SmoothScroll.astro";
import type { PageHeroContent } from "@pg/page4/types/page";
import heroPhoto from "@pg/page4/assets/pages/p4-hero.jpg";
import floorPhoto from "@pg/page4/assets/pages/p4-floor.jpg";
import sizePhoto from "@pg/page4/assets/pages/p4-size.jpg";
import faqPhoto from "@pg/page4/assets/pages/p4-faq.jpg";
import { BRAND } from "@pg/page4/lib/brand";

/* Production teams. There was no brief for this page: the copy is written
   from what the home page says about production teams (full-stack
   engineering, QA automation, release and DevOps, products already in
   market). The release feed is illustrative, the team sizes and role order
   are a draft, and so are the FAQ answers. Have them checked before
   launch. See docs/sections.md. */

const HERO: PageHeroContent = {
  trail: ["Team models", "Production teams"],
  headline: ["Production", "teams."],
  lede: "Full-stack delivery for products already in market. A dedicated team that builds, tests, releases and runs your product, sprint after sprint.",
  ctas: [
    { label: "Build your team", href: "#contact", arrow: "diagonal" },
    { label: "Size your team", href: "#team-size", arrow: "right" },
  ],
  image: heroPhoto,
  imageAlt: "An engineer works across two screens of a live product dashboard in a warm, wood-panelled studio.",
  specs: [
    { label: "Stage", value: "Product in market" },
    { label: "Team", value: "4 to 12 engineers" },
    { label: "Owns", value: "Build, test, release" },
    { label: "Cadence", value: "Two-week sprints" },
  ],
};

const FAQS = [
  {
    q: "Can you take over a codebase another team built?",
    a: "Yes. The first sprint is a guided handover: we read the code, the pipelines and the incident history before we change anything.",
  },
  {
    q: "Do you work in our tools and rituals?",
    a: "Yes. Your tracker, your repos, your stand-ups. The team joins your cadence rather than asking you to join ours.",
  },
  {
    q: "What if we need to scale down?",
    a: "Tell us a sprint ahead. The team shrinks around its core, and the knowledge stays documented.",
  },
];
---

<Layout
  title={`Production teams · ${BRAND.name}`}
  description="A dedicated full-stack team that builds, tests, releases and runs your product, sprint after sprint."
  navTone="field"
>
  <SmoothScroll />
  <Navbar />
  <main>
    <PageHero content={HERO} />
    <ReleaseFeedSection
      id="shipping"
      eyebrow="Products in market"
      headline={["Keep shipping.", "Keep scaling."]}
      lede="A live product needs a team that ships every week without breaking what already works."
      media={{ image: floorPhoto, alt: "A large open-plan studio, rows of engineers at work on laptops and monitors.", focus: "50% 55%" }}
      feedLabel="This week’s releases"
      releases={[
        { version: "v4.12.0", title: "Checkout redesign", kind: "Feature" },
        { version: "v4.11.3", title: "Search latency down", kind: "Performance" },
        { version: "v4.11.2", title: "Payment retry edge case", kind: "Fix" },
        { version: "v4.11.0", title: "Team roles & permissions", kind: "Feature" },
        { version: "v4.10.4", title: "Dependency upgrades", kind: "Maintenance" },
        { version: "v4.10.2", title: "Onboarding emails", kind: "Feature" },
        { version: "v4.10.1", title: "Mobile layout fixes", kind: "Fix" },
      ]}
    />
    <SignalsSection
      id="signals"
      eyebrow="What we watch"
      headline={["Four signals.", "One healthy product."]}
      accent={1}
      lede="Every production team reports on the same four delivery signals, so you always know how the product is moving."
      signals={[
        { label: "Deploy frequency", goal: "More often", direction: "up", note: "Small releases, shipped weekly or faster.", trend: [0.2, 0.25, 0.3, 0.38, 0.45, 0.55, 0.68, 0.82] },
        { label: "Lead time", goal: "Shorter", direction: "down", note: "From merged code to production.", trend: [0.85, 0.8, 0.72, 0.66, 0.55, 0.48, 0.38, 0.3] },
        { label: "Change failures", goal: "Fewer", direction: "down", note: "Releases that need a fix or rollback.", trend: [0.6, 0.66, 0.5, 0.45, 0.4, 0.3, 0.26, 0.18] },
        { label: "Time to restore", goal: "Faster", direction: "down", note: "From an incident to service restored.", trend: [0.75, 0.6, 0.68, 0.5, 0.42, 0.35, 0.28, 0.22] },
      ]}
    />
    <SizerSection
      id="team-size"
      eyebrow="Sized to your roadmap"
      headline={["A team that grows", "with your product."]}
      accent={1}
      lede="Drag to see who joins as the team grows. The core stays; specialists join as the roadmap needs them."
      media={{ image: sizePhoto, alt: "Two teammates talk through a design on a laptop at a shared desk.", focus: "40% 50%" }}
      sliderLabel="Team size"
      min={4}
      start={6}
      seats={[
        { mark: "TL", role: "Tech lead" },
        { mark: "FS", role: "Full-stack engineer" },
        { mark: "FS", role: "Full-stack engineer" },
        { mark: "QA", role: "QA automation" },
        { mark: "PM", role: "Product manager" },
        { mark: "FS", role: "Full-stack engineer" },
        { mark: "DO", role: "DevOps engineer" },
        { mark: "PD", role: "Product designer" },
        { mark: "FS", role: "Full-stack engineer" },
        { mark: "MO", role: "Mobile engineer" },
        { mark: "QA", role: "QA automation" },
        { mark: "DE", role: "Data engineer" },
      ]}
    />
    <CadenceSection
      id="cadence"
      eyebrow="How we work"
      headline={["One rhythm,", "every sprint."]}
      lede="The team runs a steady loop, in your tools and your time zone, so releases are routine rather than events."
      centre={{ value: "2 wks", label: "Per sprint" }}
      stages={["Plan", "Build", "Review", "Release", "Learn"]}
      rituals={[
        { title: "Sprint planning", note: "Priorities set with your product lead." },
        { title: "Daily stand-up", note: "In your time zone, in your channel." },
        { title: "Demo", note: "Working software, every sprint." },
        { title: "Retrospective", note: "What to change next time." },
      ]}
    />
    <FaqSection
      eyebrow="Production questions"
      headline={["Ask us", "anything."]}
      cta="Talk to a delivery lead"
      faqs={FAQS}
      media={{ image: faqPhoto, alt: "A team sits together at their desks in a bright office, laptops open.", focus: "55% 50%" }}
    />
    <ContactForm />
  </main>
  <Footer />
</Layout>
