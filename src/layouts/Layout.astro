---
import { Font, getImage } from "astro:assets";
import type { ImageMetadata } from "astro";
import icon32 from "@/assets/brand/icon-32.png";
import icon180 from "@/assets/brand/icon-180.png";
import icon512 from "@/assets/brand/icon-512.png";
import { SITE, metaDescription, pageTitle } from "@/lib/site";
import { withBase } from "@/lib/paths";
import CookieNotice from "@/components/CookieNotice.astro";

/* The one layout every page uses: the <head> (title, description, canonical
   address, share cards, icons, structured data), the pre-paint script and the
   cookie notice. Pages import their own stylesheets; this file carries none
   (the notice's styles are its own, scoped and fixed-position), so it never
   changes how a page looks.

   Share cards and the canonical address need the site's origin, which the
   deploy workflow passes as SITE_URL (astro.config.mjs `site`). A local build
   without it still renders, with relative share-image paths and no canonical
   link. */

interface Props {
  /** The page's own name; " · JumpGrowth" is added unless it already names the brand. */
  title?: string;
  description?: string;
  /** What sits under the fixed navbar on first paint. A page that opens on a
      dark hero passes "field" so the bar is dark from the first frame; the
      hero then follows the scroll. The home page's Hero sets it itself. */
  navTone?: "paper" | "field";
  /** The share-card picture; the default brand card when left out. */
  image?: ImageMetadata;
  imageAlt?: string;
  type?: "website" | "article";
  /** For an article: dates (ISO) and byline, for its share card and structured data. */
  article?: { published: string; modified?: string; author?: string; section?: string };
  /** Extra structured data for this page (Article, FAQPage …). */
  schema?: Record<string, unknown>[];
  /** The page's place in the site, home first; becomes a BreadcrumbList.
      Paths go through withBase() like any link. */
  breadcrumbs?: { name: string; path: string }[];
  /** Keep a page out of search results (the 404 page). */
  noindex?: boolean;
}

const {
  title,
  description: fullDescription = SITE.description,
  navTone,
  image = SITE.ogImage,
  imageAlt = image === SITE.ogImage ? SITE.ogImageAlt : (title ?? SITE.name),
  type = "website",
  article,
  schema = [],
  breadcrumbs = [],
  noindex = false,
} = Astro.props;

const fullTitle = pageTitle(title);
const description = metaDescription(fullDescription);
const site = Astro.site;
const absolute = (path: string) => (site ? new URL(path, site).href : path);
const canonical = site ? new URL(Astro.url.pathname, site).href : undefined;

/* Share cards want a 1200 x 630 picture; crop whatever the page passes. */
const card = await getImage({ src: image, width: 1200, height: 630, fit: "cover", format: "jpeg", quality: 82 });
const cardUrl = absolute(card.src);

const organization = {
  "@context": "https://schema.org",
  "@type": "Organization",
  name: SITE.name,
  url: absolute(withBase("/")),
  logo: absolute(icon512.src),
  email: SITE.email,
  address: {
    "@type": "PostalAddress",
    streetAddress: SITE.address.street,
    addressLocality: SITE.address.locality,
    addressRegion: SITE.address.region,
    postalCode: SITE.address.postalCode,
    addressCountry: SITE.address.country,
  },
};
const trail =
  breadcrumbs.length > 0
    ? [
        {
          "@context": "https://schema.org",
          "@type": "BreadcrumbList",
          itemListElement: [{ name: "Home", path: "/" }, ...breadcrumbs].map((crumb, i) => ({
            "@type": "ListItem",
            position: i + 1,
            name: crumb.name,
            item: absolute(withBase(crumb.path)),
          })),
        },
      ]
    : [];
const isHome = Astro.url.pathname.replace(/\/$/, "") === withBase("/").replace(/\/$/, "");
const website = isHome
  ? [{ "@context": "https://schema.org", "@type": "WebSite", name: SITE.name, url: absolute(withBase("/")) }]
  : [];
const structured = [organization, ...website, ...trail, ...schema];
---

<!doctype html>
<html lang="en" data-portal-phase={navTone}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    {canonical && <link rel="canonical" href={canonical} />}
    {noindex && <meta name="robots" content="noindex" />}
    <meta name="theme-color" content={SITE.themeColor} />

    <link rel="icon" type="image/png" sizes="32x32" href={icon32.src} />
    <link rel="icon" type="image/png" sizes="512x512" href={icon512.src} />
    <link rel="apple-touch-icon" sizes="180x180" href={icon180.src} />

    <meta property="og:site_name" content={SITE.name} />
    <meta property="og:type" content={type} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    {canonical && <meta property="og:url" content={canonical} />}
    <meta property="og:image" content={cardUrl} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={imageAlt} />
    <meta property="og:locale" content="en_US" />
    {article && <meta property="article:published_time" content={article.published} />}
    {article?.modified && <meta property="article:modified_time" content={article.modified} />}
    {article?.section && <meta property="article:section" content={article.section} />}
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={fullTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={cardUrl} />
    <meta name="twitter:image:alt" content={imageAlt} />

    {structured.map((data) => <script type="application/ld+json" set:html={JSON.stringify(data)} />)}

    {/* Runs before the browser restores a scroll position on reload. Setting
        this from a module script is too late: the restore has already happened
        by then, and Chrome re-applies it as the document grows, which it does
        here because the hero portal's scroll length is only known once it
        mounts. A reload has to start at the top, since the hero is a
        scroll-driven camera and every section's entrance is gated on arriving
        at it.

        It also holds the navbar and hero at their start positions before the
        first paint, so the entrance never opens on a page that has already
        shown itself for a frame. The timeout is a dead-man's switch: if the
        page scripts never run, un-hide rather than leaving a blank page. */}
    <script is:inline>try{history.scrollRestoration='manual'}catch{}try{const d=document.documentElement;d.dataset.acIntro='start';setTimeout(()=>{if(d.dataset.acIntro!=='done')d.dataset.acIntro='done'},6000)}catch{}</script>
    <Font cssVariable="--font-display" preload />
    <Font cssVariable="--font-body" preload />
  </head>
  <body>
    <slot />
    <CookieNotice />
  </body>
</html>
