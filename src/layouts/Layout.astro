---
import { Font } from "astro:assets";

import "@/styles/globals.css";

const title = "JumpGrowth · AI-assisted product teams";
const description =
  "Senior product builders across the US, Mexico, Canada and India, assembled in weeks.";

/* No icon link yet. The browser falls back to its own generic document icon
   until JumpGrowth has a mark of its own. */
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    {/* Runs before the browser restores a scroll position on reload. Setting
        this from a module script is too late: the restore has already happened
        by then, and Chrome re-applies it as the document grows, which it does
        here because the hero portal's scroll length is only known once it
        mounts. A reload has to start at the top, since the hero is a
        scroll-driven camera and every section's entrance is gated on arriving
        at it.

        It also holds the navbar and hero at their start positions before the
        first paint, so the entrance never opens on a page that has already
        shown itself for a frame. The timeout is a dead-man's switch: if the
        page scripts never run, un-hide rather than leaving a blank page. */}
    <script is:inline>try{history.scrollRestoration='manual'}catch{}try{const d=document.documentElement;d.dataset.acIntro='start';setTimeout(()=>{if(d.dataset.acIntro!=='done')d.dataset.acIntro='done'},6000)}catch{}</script>
    <Font cssVariable="--font-display" preload />
    <Font cssVariable="--font-body" preload />
  </head>
  <body>
    <slot />
  </body>
</html>
