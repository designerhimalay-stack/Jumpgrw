---
import Arrow from "@pg/page15/components/icons/Arrow.astro";
import GridRules from "@pg/page15/components/GridRules.astro";
import SectionHead from "@pg/page15/components/SectionHead.astro";
import Joints from "@pg/page15/components/process/Joints.astro";
import { BRAND } from "@pg/page15/lib/brand";

/* The close, on the accent: where does your team need help? Columns 1–2: the
   headline, a line on what happens next, where to write, and how the details
   are used. Columns 3–4: the brief as a white form. The page has no server,
   so sending the brief opens the reader's email with it written out, to
   BRAND.email; without the script the form still sends by email. Swap the
   action for a form service when there is one (docs/sections.md). */

interface Field {
  label: string;
  placeholder?: string;
  options?: string[];
}

interface Props {
  copy: {
    eyebrow: string;
    headline: string[];
    body: string;
    formKicker: string;
    formTitle: string;
    fields: Record<"name" | "company" | "email" | "need" | "when" | "brief", Field>;
    submit: string;
    consent: string;
    promise: string;
    subject: string;
  };
}

const { copy } = Astro.props;
const { fields } = copy;
const mailto = `mailto:${BRAND.email}`;
---

<section data-ac-sec="accent" data-ac-contact id="contact">
  <GridRules />

  <div data-ac-sec-container data-ac-contact-grid>
    <div data-ac-contact-copy>
      <SectionHead eyebrow={copy.eyebrow} headline={copy.headline} accent={1} />
      <p data-ac-contact-body data-ac-sec-rise>{copy.body}</p>
      <a data-ac-contact-mail data-ac-sec-rise href={mailto}>
        <svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true"><rect x="2.5" y="4.5" width="19" height="15" rx="2" /><path d="m3 6 9 7 9-7" /></svg>
        {BRAND.email}
      </a>
      <p data-ac-contact-consent data-ac-sec-rise>
        <svg viewBox="0 0 24 24" width="16" height="16" aria-hidden="true"><path d="M12 21.5s7.5-3.6 7.5-9.4V5.4L12 2.5 4.5 5.4v6.7c0 5.8 7.5 9.4 7.5 9.4Z" /><path d="m9 12 2.2 2.2L15.5 10" /></svg>
        {copy.consent}
      </p>
    </div>

    <form
      data-ac-brief
      data-ac-sec-rise
      action={mailto}
      method="post"
      enctype="text/plain"
      data-subject={copy.subject}
      data-to={BRAND.email}
    >
      <Joints />
      <div data-ac-brief-head>
        <p class="mono-label-sm">{copy.formKicker}</p>
        <h3>{copy.formTitle}</h3>
      </div>
      <div data-ac-brief-fields>
        <label data-ac-brief-field>
          <span>{fields.name.label}</span>
          <input name="name" type="text" autocomplete="name" placeholder={fields.name.placeholder} required />
        </label>
        <label data-ac-brief-field>
          <span>{fields.company.label}</span>
          <input name="company" type="text" autocomplete="organization" placeholder={fields.company.placeholder} />
        </label>
        <label data-ac-brief-field data-wide>
          <span>{fields.email.label}</span>
          <input name="email" type="email" autocomplete="email" placeholder={fields.email.placeholder} required />
        </label>
        <label data-ac-brief-field>
          <span>{fields.need.label}</span>
          <select name="need">
            <option value="">Select one</option>
            {fields.need.options!.map((o) => <option>{o}</option>)}
          </select>
        </label>
        <label data-ac-brief-field>
          <span>{fields.when.label}</span>
          <select name="when">
            <option value="">Select one</option>
            {fields.when.options!.map((o) => <option>{o}</option>)}
          </select>
        </label>
        <label data-ac-brief-field data-wide>
          <span>{fields.brief.label}</span>
          <textarea name="brief" rows="4" placeholder={fields.brief.placeholder} />
        </label>
      </div>
      <button type="submit" data-ac-brief-submit class="mono-label">
        {copy.submit}
        <Arrow direction="right" />
      </button>
      <p data-ac-brief-promise>{copy.promise}</p>
    </form>
  </div>
</section>

<script>
  import { toggleInView } from "@pg/page15/lib/in-view";

  const section = document.querySelector<HTMLElement>("[data-ac-contact]")!;
  toggleInView(section);

  /* Write the brief out as an email: one line per answered field, under its
     label, so it reads as a note rather than form data. */
  const form = section.querySelector<HTMLFormElement>("[data-ac-brief]")!;
  form.addEventListener("submit", (event) => {
    event.preventDefault();
    if (!form.reportValidity()) return;
    const lines = [...form.querySelectorAll<HTMLLabelElement>("[data-ac-brief-field]")]
      .map((field) => {
        const label = field.querySelector("span")!.textContent!.trim();
        const input = field.querySelector<HTMLInputElement | HTMLSelectElement | HTMLTextAreaElement>("input, select, textarea")!;
        return input.value.trim() ? `${label}\n${input.value.trim()}` : "";
      })
      .filter(Boolean);
    const subject = encodeURIComponent(form.dataset.subject!);
    const body = encodeURIComponent(lines.join("\n\n"));
    window.location.href = `mailto:${form.dataset.to}?subject=${subject}&body=${body}`;
  });
</script>
