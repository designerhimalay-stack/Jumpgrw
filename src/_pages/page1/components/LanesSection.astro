---
import { Image } from "astro:assets";
import GridRules from "@pg/page1/components/GridRules.astro";
import RevealText from "@pg/page1/components/RevealText.astro";
import Joints from "@pg/page1/components/process/Joints.astro";
import type { SectionPhoto } from "@pg/page1/types/page";

/* The case for a launch team, as a race. A photo band across the four
   columns carries the headline; under it, one lane per way of staffing a
   launch, each bar as long as that route takes to reach a first commit. The
   bars run out from the start line as the section arrives, ours the
   shortest and on the accent. A row of what only a launch team brings
   closes it. See docs/sections.md. */

interface Lane {
  label: string;
  verdict: string;
  /** Where the bar ends, as a share of the track (0–1). */
  length: number;
  value: string;
  featured?: boolean;
}

interface Props {
  id: string;
  eyebrow: string;
  headline: string[];
  accent?: number;
  lede: string;
  media: SectionPhoto;
  trackLabel: string;
  scale: string[];
  lanes: Lane[];
  extrasLabel: string;
  extras: string[];
}

const { id, eyebrow, headline, accent = headline.length - 1, lede, media, trackLabel, scale, lanes, extrasLabel, extras } = Astro.props;
const offsets = headline.map((_, i) => headline.slice(0, i).reduce((n, line) => n + Array.from(line).length + 1, 0));
---

<section data-ac-sec="light" data-ac-lanes id={id}>
  <GridRules />

  <div data-ac-sec-container>
    <div data-ac-lanes-band>
      <Joints />
      <div data-ac-lanes-photo>
        <Image
          src={media.image}
          alt={media.alt}
          widths={[640, 1024, 1440, media.image.width]}
          sizes="(max-width: 991px) 100vw, 92vw"
          quality={78}
          style={media.focus ? `object-position:${media.focus}` : undefined}
        />
      </div>
      <div data-ac-lanes-caption>
        <p data-ac-sec-eyebrow class="mono-label">
          <span aria-hidden="true">+</span>
          {eyebrow}
        </p>
        <h2 data-ac-lanes-headline aria-label={headline.join(" ")}>
          {headline.map((line, i) => (
            <Fragment>
              {i > 0 && <Fragment>{" "}<br aria-hidden="true" /></Fragment>}
              <span data-ac-sec-line data-accent={i === accent || undefined}>
                <RevealText text={line} offset={offsets[i]} />
              </span>
            </Fragment>
          ))}
        </h2>
        <p data-ac-lanes-lede data-ac-sec-rise>{lede}</p>
      </div>
    </div>

    <div data-ac-lanes-board role="list" aria-label={trackLabel}>
      <div data-ac-lanes-scale aria-hidden="true">
        <span class="mono-label">{trackLabel}</span>
        <span data-ac-lanes-ticks>
          {scale.map((mark) => <span class="mono-label-sm">{mark}</span>)}
        </span>
      </div>
      {lanes.map((lane, i) => (
        <div role="listitem" data-ac-lane data-featured={lane.featured || undefined} style={`--ac-i:${i};--ac-len:${lane.length}`}>
          <p data-ac-lane-name>
            <span class="mono-label">{lane.label}</span>
            <span data-ac-lane-verdict>{lane.verdict}</span>
          </p>
          <div data-ac-lane-track>
            <span data-ac-lane-bar data-text={lane.length >= 0.5 ? "in" : "after"}>
              <span data-ac-lane-value>{lane.value}</span>
            </span>
          </div>
        </div>
      ))}
    </div>

    <div data-ac-lanes-extras>
      <p class="mono-label">{extrasLabel}</p>
      <ul>
        {extras.map((item) => (
          <li>
            <span data-ac-lanes-check aria-hidden="true">
              <svg viewBox="0 0 24 24"><path d="M20 6 9 17l-5-5" /></svg>
            </span>
            {item}
          </li>
        ))}
      </ul>
    </div>
  </div>
</section>

<script>
  import { toggleInView } from "@pg/page1/lib/in-view";

  document.querySelectorAll<HTMLElement>("[data-ac-lanes]").forEach(toggleInView);
</script>
