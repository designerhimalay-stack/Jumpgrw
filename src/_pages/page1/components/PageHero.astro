---
import { Image } from "astro:assets";
import Arrow from "@pg/page1/components/icons/Arrow.astro";
import GridRules from "@pg/page1/components/GridRules.astro";
import RevealText from "@pg/page1/components/RevealText.astro";
import Joints from "@pg/page1/components/process/Joints.astro";
import type { PageHeroContent } from "@pg/page1/types/page";

/* The opening of every subpage, on the home hero's navy field and the page's
   four columns. Columns 1–2: breadcrumb, the page's name as a two-tone
   headline, lede and buttons, the buttons on the column's floor. Columns 3–4:
   the photo, framed, the same height as the copy. Along the foot, four spec
   cells, one per column, closing the hero on the grid. The navbar goes dark
   while this is under it (Layout's navTone, then the script below). See
   docs/components/subpages.md. */

interface Props {
  content: PageHeroContent;
}

const { content } = Astro.props;
const { trail, headline, accent = headline.length - 1, lede, ctas, image, imageAlt, specs } = content;
const pad = (n: number) => String(n).padStart(2, "0");

/* Each line's first character index, so the stagger keeps counting across
   the break (+1 for the space the break stands in for). */
const offsets = headline.map((_, i) =>
  headline.slice(0, i).reduce((n, line) => n + Array.from(line).length + 1, 0),
);
---

<section data-ac-sec="dark" data-ac-phero id="top">
  <GridRules />

  <div data-ac-sec-container data-ac-phero-grid>
    <div data-ac-phero-copy>
      <nav data-ac-phero-trail class="mono-label" aria-label="Breadcrumb">
        <span aria-hidden="true">+</span>
        <ol>
          {trail.map((step, i) => (
            <li aria-current={i === trail.length - 1 ? "page" : undefined}>{step}</li>
          ))}
        </ol>
      </nav>

      <h1 data-ac-phero-headline aria-label={headline.join(" ")}>
        {headline.map((line, i) => (
          <Fragment>
            {i > 0 && <Fragment>{" "}<br aria-hidden="true" /></Fragment>}
            <span data-ac-sec-line data-accent={i === accent || undefined}>
              <RevealText text={line} offset={offsets[i]} />
            </span>
          </Fragment>
        ))}
      </h1>

      <div data-ac-phero-foot>
        <p data-ac-phero-lede data-ac-sec-rise>{lede}</p>
        <div data-ac-phero-ctas data-ac-sec-rise>
          {ctas.map((cta, i) => (
            <a href={cta.href} data-ac-phero-cta={i === 0 ? "primary" : "ghost"} class="mono-label">
              {cta.label}
              <Arrow direction={cta.arrow} />
            </a>
          ))}
        </div>
      </div>
    </div>

    <div data-ac-phero-media>
      <Joints />
      <div data-ac-phero-photo>
        <Image
          src={image}
          alt={imageAlt}
          widths={[320, 480, image.width]}
          sizes="(max-width: 991px) 100vw, 45vw"
          quality={82}
          loading="eager"
          fetchpriority="high"
        />
      </div>
    </div>

    <dl data-ac-phero-specs>
      {specs.map((spec, i) => (
        <div data-ac-phero-spec style={`--ac-i:${i}`}>
          <dt class="mono-label">
            <span>{pad(i + 1)}</span>
            {spec.label}
          </dt>
          <dd>{spec.value}</dd>
        </div>
      ))}
    </dl>
  </div>
</section>

<script>
  import { toggleInView } from "@pg/page1/lib/in-view";

  const hero = document.querySelector<HTMLElement>("[data-ac-phero]")!;
  const nav = document.querySelector<HTMLElement>(".ac-nav");
  const root = document.documentElement;

  toggleInView(hero);

  /* The navbar is fixed, so its tone follows what is under it: dark while
     the hero is behind the bar, light once the page has moved past it. Same
     attribute the home page's Hero writes. */
  let frame = 0;
  const apply = () => {
    frame = 0;
    const under = hero.getBoundingClientRect().bottom > (nav?.offsetHeight ?? 0);
    const phase = under ? "field" : "paper";
    if (root.dataset.portalPhase !== phase) root.dataset.portalPhase = phase;
  };
  const schedule = () => {
    if (!frame) frame = requestAnimationFrame(apply);
  };
  apply();
  window.addEventListener("scroll", schedule, { passive: true });
  window.addEventListener("resize", schedule, { passive: true });
</script>
