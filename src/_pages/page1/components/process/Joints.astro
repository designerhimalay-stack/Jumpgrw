---
/* A plain crosshair at each cell corner: two hairlines from the same token,
   set in the cell's padding. A standard drafting mark, it carries no artwork
   to maintain and it echoes the "+" in our section eyebrows. Four per cell,
   positioned entirely in CSS. */
const CORNERS = ["tl", "tr", "bl", "br"] as const;
---

<span data-ac-joints aria-hidden="true">
  {CORNERS.map((corner) => (
    <i data-ac-corner={corner} />
  ))}
</span>
