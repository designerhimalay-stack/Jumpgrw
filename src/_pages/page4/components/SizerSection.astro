---
import GridRules from "@pg/page4/components/GridRules.astro";
import SectionHead from "@pg/page4/components/SectionHead.astro";
import Joints from "@pg/page4/components/process/Joints.astro";
import type { SectionPhoto } from "@pg/page4/types/page";

/* Team size, as a slider. The header splits around a photo of a team at
   work. Under it, drag from the smallest team to the largest: the seats
   fill one by one, each with its role's monogram, and the list on the
   right marks which roles the team has at that size. Every seat and every
   role is always drawn, so nothing moves as the size changes. Starts at a
   sensible default; works without the script at that size. See
   docs/sections.md. */

interface Seat {
  mark: string;
  role: string;
}

interface Props {
  id: string;
  eyebrow: string;
  headline: string[];
  accent?: number;
  lede: string;
  media: SectionPhoto;
  /** In the order they join as the team grows. The first `min` are the core. */
  seats: Seat[];
  min: number;
  start: number;
  sliderLabel: string;
}

const { id, eyebrow, headline, accent, lede, media, seats, min, start, sliderLabel } = Astro.props;
const max = seats.length;
/* Each role once, in the order it first joins, with the size it joins at. */
const roles = seats.reduce<{ role: string; mark: string; at: number }[]>((list, seat, i) => {
  if (!list.some((r) => r.role === seat.role)) list.push({ role: seat.role, mark: seat.mark, at: i + 1 });
  return list;
}, []);
---

<section data-ac-sec="light" data-ac-sizer id={id} data-min={min}>
  <GridRules />

  <div data-ac-sec-container>
    <SectionHead eyebrow={eyebrow} headline={headline} accent={accent} lede={lede} media={media} />

    <div data-ac-sec-frame data-ac-sizer-frame>
      <Joints />
      <div data-ac-sizer-control>
        <label data-ac-sizer-label for={`${id}-size`} class="mono-label">{sliderLabel}</label>
        <p data-ac-sizer-count aria-live="polite">
          <span data-ac-sizer-value>{start}</span>
          <span data-ac-sizer-unit>engineers</span>
        </p>
        <input
          id={`${id}-size`}
          type="range"
          min={min}
          max={max}
          step="1"
          value={start}
          data-ac-sizer-input
          style={`--ac-fill:${((start - min) / (max - min)) * 100}%`}
        />
        <p data-ac-sizer-ends class="mono-label-sm" aria-hidden="true">
          <span>{min}</span>
          <span>{max}</span>
        </p>
      </div>

      <ol data-ac-sizer-seats aria-hidden="true">
        {seats.map((seat, i) => (
          <li data-ac-sizer-seat data-on={i < start || undefined} data-core={i < min || undefined} style={`--ac-i:${i}`}>
            <span>{seat.mark}</span>
          </li>
        ))}
      </ol>

      <ul data-ac-sizer-roles>
        {roles.map((role) => (
          <li data-ac-sizer-role data-at={role.at} data-on={role.at <= start || undefined}>
            <span data-ac-sizer-role-mark aria-hidden="true">{role.mark}</span>
            <span data-ac-sizer-role-name>{role.role}</span>
            <span data-ac-sizer-role-state class="mono-label-sm">
              <span data-state="on">In the team</span>
              <span data-state="off">From {role.at}</span>
            </span>
          </li>
        ))}
      </ul>
    </div>
  </div>
</section>

<script>
  import { toggleInView } from "@pg/page4/lib/in-view";

  document.querySelectorAll<HTMLElement>("[data-ac-sizer]").forEach((section) => {
    toggleInView(section);

    const input = section.querySelector<HTMLInputElement>("[data-ac-sizer-input]")!;
    const value = section.querySelector<HTMLElement>("[data-ac-sizer-value]")!;
    const seats = Array.from(section.querySelectorAll<HTMLElement>("[data-ac-sizer-seat]"));
    const roles = Array.from(section.querySelectorAll<HTMLElement>("[data-ac-sizer-role]"));
    const min = Number(input.min);
    const max = Number(input.max);

    const update = () => {
      const size = Number(input.value);
      value.textContent = String(size);
      input.style.setProperty("--ac-fill", `${((size - min) / (max - min)) * 100}%`);
      seats.forEach((seat, i) => seat.toggleAttribute("data-on", i < size));
      roles.forEach((role) => role.toggleAttribute("data-on", Number(role.dataset.at) <= size));
    };

    input.addEventListener("input", update);
    update();
  });
</script>
