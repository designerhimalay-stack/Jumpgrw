---
import GridRules from "@pg/page4/components/GridRules.astro";
import RevealText from "@pg/page4/components/RevealText.astro";

/* The team's rhythm, as a loop, on a grey band. Columns 1–2: a ring drawn
   in the display face's weight, the stages of a sprint set round it and a
   marker travelling the ring for good, one lap every twelve seconds; the
   stage nearest the marker lights as it passes. Columns 3–4: the claim and
   the rituals the team keeps with yours. See docs/sections.md. */

interface Props {
  id: string;
  eyebrow: string;
  headline: string[];
  accent?: number;
  lede: string;
  centre: { value: string; label: string };
  stages: string[];
  rituals: { title: string; note: string }[];
}

const { id, eyebrow, headline, accent = headline.length - 1, lede, centre, stages, rituals } = Astro.props;
const offsets = headline.map((_, i) => headline.slice(0, i).reduce((n, line) => n + Array.from(line).length + 1, 0));
/* Stage positions round a ring of radius 42 in a 100 × 100 box, from the top, clockwise. */
const at = (i: number) => {
  const a = (i / stages.length) * Math.PI * 2 - Math.PI / 2;
  return { x: 50 + Math.cos(a) * 42, y: 50 + Math.sin(a) * 42 };
};
---

<section data-ac-sec="light" data-ac-cadence id={id} style={`--ac-stages:${stages.length}`}>
  <GridRules />

  <div data-ac-sec-container data-ac-cadence-grid>
    <div data-ac-cadence-dial>
      <svg viewBox="0 0 100 100" aria-hidden="true">
        <circle data-ac-cadence-track cx="50" cy="50" r="42" />
        <circle data-ac-cadence-ticks cx="50" cy="50" r="47" />
      </svg>
      <span data-ac-cadence-orbit aria-hidden="true"><i /></span>
      <ol data-ac-cadence-stages>
        {stages.map((stage, i) => (
          <li style={`--x:${at(i).x}%;--y:${at(i).y}%;--ac-i:${i}`}>
            <span data-ac-cadence-node aria-hidden="true" />
            <span data-ac-cadence-name>{stage}</span>
          </li>
        ))}
      </ol>
      <p data-ac-cadence-centre>
        <span>{centre.value}</span>
        <span class="mono-label-sm">{centre.label}</span>
      </p>
    </div>

    <div data-ac-cadence-copy>
      <p data-ac-sec-eyebrow class="mono-label">
        <span aria-hidden="true">+</span>
        {eyebrow}
      </p>
      <h2 data-ac-cadence-headline aria-label={headline.join(" ")}>
        {headline.map((line, i) => (
          <Fragment>
            {i > 0 && <Fragment>{" "}<br aria-hidden="true" /></Fragment>}
            <span data-ac-sec-line data-accent={i === accent || undefined}>
              <RevealText text={line} offset={offsets[i]} />
            </span>
          </Fragment>
        ))}
      </h2>
      <p data-ac-cadence-lede data-ac-sec-rise>{lede}</p>
      <dl data-ac-cadence-rituals data-ac-sec-rise>
        {rituals.map((ritual) => (
          <div>
            <dt>{ritual.title}</dt>
            <dd>{ritual.note}</dd>
          </div>
        ))}
      </dl>
    </div>
  </div>
</section>

<script>
  import { toggleInView } from "@pg/page4/lib/in-view";

  /* Lights the stage the marker is passing. The marker itself is a CSS
     rotation; this reads its angle once a frame while the section is on
     screen, and only writes when the stage changes. */
  document.querySelectorAll<HTMLElement>("[data-ac-cadence]").forEach((section) => {
    toggleInView(section);
    const orbit = section.querySelector<HTMLElement>("[data-ac-cadence-orbit]")!;
    const stages = Array.from(section.querySelectorAll<HTMLElement>("[data-ac-cadence-stages] li"));
    if (window.matchMedia("(prefers-reduced-motion: reduce)").matches) return;

    let running = false;
    let current = -1;
    const step = () => {
      if (!running) return;
      const [a, b] = new DOMMatrixReadOnly(getComputedStyle(orbit).transform).toFloat32Array();
      const turn = ((Math.atan2(b, a) / (Math.PI * 2)) + 1) % 1;
      const index = Math.round(turn * stages.length) % stages.length;
      if (index !== current) {
        stages[current]?.removeAttribute("data-active");
        stages[index].setAttribute("data-active", "");
        current = index;
      }
      requestAnimationFrame(step);
    };
    new IntersectionObserver(([entry]) => {
      running = entry.isIntersecting;
      if (running) requestAnimationFrame(step);
    }).observe(section);
  });
</script>
