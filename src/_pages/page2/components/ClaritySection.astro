---
import { Image } from "astro:assets";
import GridRules from "@pg/page2/components/GridRules.astro";
import RevealText from "@pg/page2/components/RevealText.astro";
import Joints from "@pg/page2/components/process/Joints.astro";
import type { Outcome, SectionPhoto } from "@pg/page2/types/page";

/* The case for discovery, on drafting paper. One frame across the page:
   the photo of a workshop fills columns 1–2; columns 3–4 are grid paper
   with the claim, the argument, and the result as an annotated list, each
   outcome numbered in a dashed drafting circle, its note set against the
   right edge. See docs/sections.md. */

interface Props {
  id: string;
  eyebrow: string;
  headline: string[];
  accent?: number;
  lede: string;
  media: SectionPhoto;
  resultLabel: string;
  outcomes: Outcome[];
}

const { id, eyebrow, headline, accent = headline.length - 1, lede, media, resultLabel, outcomes } = Astro.props;
const pad = (n: number) => String(n).padStart(2, "0");
const offsets = headline.map((_, i) => headline.slice(0, i).reduce((n, line) => n + Array.from(line).length + 1, 0));
---

<section data-ac-sec="light" data-ac-clarity id={id}>
  <GridRules />

  <div data-ac-sec-container>
    <div data-ac-sec-frame data-ac-clarity-frame>
      <div data-ac-clarity-photo>
        <Joints />
        <div data-ac-clarity-image>
          <Image
            src={media.image}
            alt={media.alt}
            widths={[480, 800, 1200, media.image.width]}
            sizes="(max-width: 991px) 100vw, 46vw"
            quality={78}
            style={media.focus ? `object-position:${media.focus}` : undefined}
          />
        </div>
      </div>

      <div data-ac-clarity-body>
        <Joints />
        <p data-ac-sec-eyebrow class="mono-label">
          <span aria-hidden="true">+</span>
          {eyebrow}
        </p>
        <h2 data-ac-clarity-headline aria-label={headline.join(" ")}>
          {headline.map((line, i) => (
            <Fragment>
              {i > 0 && <Fragment>{" "}<br aria-hidden="true" /></Fragment>}
              <span data-ac-sec-line data-accent={i === accent || undefined}>
                <RevealText text={line} offset={offsets[i]} />
              </span>
            </Fragment>
          ))}
        </h2>
        <p data-ac-clarity-lede data-ac-sec-rise>{lede}</p>

        <p data-ac-clarity-label class="mono-label">{resultLabel}</p>
        <ol data-ac-clarity-list>
          {outcomes.map((outcome, i) => (
            <li style={`--ac-i:${i}`}>
              <span data-ac-clarity-badge aria-hidden="true">{pad(i + 1)}</span>
              <span data-ac-clarity-title>{outcome.title}</span>
              <span data-ac-clarity-note>{outcome.note}</span>
            </li>
          ))}
        </ol>
      </div>
    </div>
  </div>
</section>

<script>
  import { toggleInView } from "@pg/page2/lib/in-view";

  document.querySelectorAll<HTMLElement>("[data-ac-clarity]").forEach(toggleInView);
</script>
