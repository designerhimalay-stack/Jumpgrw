---
import Chevron from "@pg/page2/components/icons/Chevron.astro";
import { pageHref, sectionHref, SITE_URL } from "@pg/page2/lib/paths";
import type { NavIcon, NavLink } from "@pg/page2/types/hero";
import BrandMark from "@pg/page2/components/BrandMark.astro";
import { BRAND } from "@pg/page2/lib/brand";

/* Links point at the home page's sections on the main site, except the
   links to the AgentCraft pages (the team models, Flexible and Launch in
   Teams; every link in Technologies and X-Shore), which open those pages
   (this one stays on this site; see pageHref in src/lib/paths.ts).
   In-page links are handled by SmoothScroll (it retires the opening frame
   first, then travels clear of this bar). The menus are demo content mapped
   onto those sections.

   There is one dropdown. Each trigger fills the same panel (two large cards,
   two columns of icon rows, a prompt along the bottom; Technologies and
   X-Shore, lists of links, fill it with columns of them instead), and moving
   between triggers swaps the content in place.
   NavMenu and NavDirectoryMenu hold the menus to those shapes. See
   docs/components/navbar.md. */
const NAV_LINKS: NavLink[] = [
  {
    label: "Teams",
    href: "#teams",
    menu: {
      feature: {
        title: "Team models",
        items: [
          { label: "MVP launch teams", href: pageHref("page1"), note: "A compact, senior team to ship your first release", icon: "rocket" },
          { label: "Production teams", href: pageHref("page4"), note: "Full-stack delivery for products already in market", icon: "layers" },
        ],
      },
      columns: [
        {
          title: "Flexible",
          items: [
            { label: "Specialist developers", href: pageHref("page8"), note: "AI, data and cloud on call", icon: "cpu" },
            { label: "Staff augmentation", href: pageHref("page7"), note: "Senior engineers inside your team", icon: "userPlus" },
            { label: "Global capability center", href: pageHref("page9"), note: "Your own center, built and run", icon: "globe" },
          ],
        },
        {
          title: "Launch",
          items: [
            { label: "Product discovery", href: pageHref("page2"), note: "Clarity before code", icon: "compass" },
            { label: "Prototype to launch", href: pageHref("page3"), note: "From Figma to production", icon: "browser" },
          ],
        },
      ],
      footer: { text: "Not sure which model fits?", label: "Talk to a specialist", href: "#contact" },
    },
  },
  {
    label: "Technologies",
    href: "#skills",
    menu: {
      directory: [
        {
          title: "Product & experience",
          href: "#skills",
          items: [
            { label: "Product Managers", href: pageHref("page10") },
            { label: "UX/UI Designers", href: pageHref("page11") },
            { label: "Business Analysts", href: pageHref("page12") },
          ],
        },
        {
          title: "Frontend",
          href: "#skills",
          items: [
            { label: "React", href: pageHref("page13") },
            { label: "Angular", href: pageHref("page14") },
          ],
        },
        {
          title: "Backend",
          href: "#skills",
          items: [
            { label: "Full Stack", href: pageHref("page15") },
            { label: "Node.js", href: pageHref("page16") },
            { label: "Python", href: pageHref("page17") },
            { label: ".NET", href: pageHref("page18") },
            { label: "Java", href: pageHref("page19") },
            { label: "PHP", href: pageHref("page20") },
          ],
        },
        {
          title: "Mobile",
          href: "#skills",
          items: [
            { label: "iOS", href: pageHref("page21") },
            { label: "Android", href: pageHref("page22") },
            { label: "Kotlin", href: pageHref("page23") },
            { label: "React Native", href: pageHref("page24") },
            { label: "Flutter", href: pageHref("page25") },
          ],
        },
        {
          title: "AI & data",
          href: "#skills",
          items: [
            { label: "Generative AI", href: pageHref("page26") },
            { label: "Machine Learning", href: pageHref("page27") },
            { label: "Data Engineers", href: pageHref("page28") },
          ],
        },
        {
          title: "Delivery",
          href: "#skills",
          items: [
            { label: "QA Engineers", href: pageHref("page5") },
            { label: "Automation QA Engineers", href: pageHref("page29") },
            { label: "DevOps Engineers", href: pageHref("page6") },
          ],
        },
      ],
      footer: { text: "Working on a stack we haven’t listed?", label: "Ask an engineer", href: "#contact" },
    },
  },
  { label: "Case Studies", href: "#case-studies" },
  {
    label: "X-Shore",
    href: "#x-shore",
    menu: {
      directory: [
        {
          title: "Onshore",
          href: "#x-shore",
          items: [{ label: "United States", href: pageHref("page30") }],
        },
        {
          title: "Nearshore",
          href: "#x-shore",
          items: [
            { label: "Mexico", href: pageHref("page31") },
            { label: "Canada", href: pageHref("page32") },
          ],
        },
        {
          title: "Offshore",
          href: "#x-shore",
          items: [
            { label: "India", href: pageHref("page33") },
            { label: "GCC from India", href: pageHref("page34") },
          ],
        },
      ],
      footer: { text: "Want a blend of regions?", label: "Plan your coverage", href: "#contact" },
    },
  },
  {
    label: "Company",
    href: "#why-agentcraft",
    menu: {
      feature: {
        title: "About us",
        items: [
          { label: `Why ${BRAND.name}`, href: "#why-agentcraft", note: "Experienced people, one accountable system", icon: "users" },
          { label: "How we work", href: "#process", note: "From first call to first commit", icon: "compass" },
        ],
      },
      columns: [
        {
          title: "Company",
          items: [
            { label: "Client stories", href: "#client-stories", note: "Teams that bring products to life", icon: "message" },
            { label: "X-Shore delivery", href: "#x-shore", note: "Onshore, nearshore, offshore", icon: "globe" },
          ],
        },
        {
          title: "Connect",
          items: [
            { label: "Contact", href: "#contact", note: "Plan your team with us", icon: "mail" },
            { label: "Headquarters", href: "#contact", note: "Dallas, TX", icon: "pin" },
          ],
        },
      ],
      footer: { text: "Building something new?", label: "Get in touch", href: "#contact" },
    },
  },
  {
    label: "Insights",
    href: "#faq",
    menu: {
      feature: {
        title: "Read",
        items: [
          { label: "Case studies", href: "#case-studies", note: "Proof is in the product", icon: "book" },
          { label: "AI-assisted delivery", href: "#teams", note: "AI adds speed, people own the outcome", icon: "sparkles" },
        ],
      },
      columns: [
        {
          title: "Answers",
          items: [
            { label: "FAQ", href: "#faq", note: "Straight answers about your team", icon: "help" },
            { label: "Client stories", href: "#client-stories", note: "What our clients say", icon: "message" },
          ],
        },
        {
          title: "Explore",
          items: [
            { label: "Skills", href: "#skills", note: "Every role your product needs", icon: "grid" },
            { label: "How we work", href: "#process", note: "From first call to first commit", icon: "compass" },
          ],
        },
      ],
      footer: { text: "Have a question we haven’t answered?", label: "Ask a team specialist", href: "#contact" },
    },
  },
];

/* The section links lead to the home page's sections on the main site
   (sectionHref), and the wordmark goes to the main site's home page. */
const resolve = sectionHref;

/* The links that open the dropdown, in bar order; trigger n fills pane n. */
const MENUS = NAV_LINKS.filter((link): link is NavLink & Required<Pick<NavLink, "menu">> => Boolean(link.menu));
const paneId = (link: NavLink) => `nav-pane-${link.label.toLowerCase().replace(/\W+/g, "-")}`;

/* 24-unit line icons, stroked in currentColor, in the same style as the
   skills cards (shared icons use the same paths). */
const NAV_ICONS: Record<NavIcon, string> = {
  rocket:
    '<path d="M4.5 16.5c-1.5 1.3-2 5-2 5s3.7-.5 5-2c.7-.8.7-2.1-.1-2.9a2.2 2.2 0 0 0-2.9-.1Z"/><path d="m12 15-3-3a22 22 0 0 1 2-4A12.9 12.9 0 0 1 22 2c0 2.7-.8 7.5-6 11a22.4 22.4 0 0 1-4 2Z"/><path d="M9 12H4s.6-3 2-4c1.6-1.1 5 0 5 0M12 15v5s3-.6 4-2c1.1-1.6 0-5 0-5"/>',
  layers: '<path d="m12 2.5 9.5 5-9.5 5-9.5-5 9.5-5Z"/><path d="m2.5 12 9.5 5 9.5-5"/><path d="m2.5 16.5 9.5 5 9.5-5"/>',
  cpu: '<rect x="5" y="5" width="14" height="14" rx="2"/><rect x="9" y="9" width="6" height="6" rx="1"/><path d="M9 2v3M15 2v3M9 19v3M15 19v3M2 9h3M2 15h3M19 9h3M19 15h3"/>',
  userPlus: '<path d="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M19 8v6M22 11h-6"/>',
  grid: '<rect x="3" y="3" width="7" height="7" rx="1.5"/><rect x="14" y="3" width="7" height="7" rx="1.5"/><rect x="3" y="14" width="7" height="7" rx="1.5"/><rect x="14" y="14" width="7" height="7" rx="1.5"/>',
  compass: '<circle cx="12" cy="12" r="9"/><path d="m15.5 8.5-2 5-5 2 2-5 5-2Z"/>',
  browser: '<rect x="2.5" y="4" width="19" height="16" rx="2"/><path d="M2.5 8.5h19"/><path d="m10 12.5-2 2 2 2"/><path d="m14 12.5 2 2-2 2"/>',
  server: '<rect x="3" y="3" width="18" height="7" rx="2"/><rect x="3" y="14" width="18" height="7" rx="2"/><path d="M7 6.5h.01M7 17.5h.01"/>',
  phone: '<rect x="6" y="2.5" width="12" height="19" rx="2.5"/><path d="M11 18h2"/>',
  sparkles:
    '<path d="M11 3.5 12.9 8.6 18 10.5l-5.1 1.9L11 17.5l-1.9-5.1L4 10.5l5.1-1.9L11 3.5Z"/><path d="m18.5 15 .8 2.2 2.2.8-2.2.8-.8 2.2-.8-2.2-2.2-.8 2.2-.8.8-2.2Z"/>',
  shield: '<path d="M12 21.5s7.5-3.6 7.5-9.4V5.4L12 2.5 4.5 5.4v6.7c0 5.8 7.5 9.4 7.5 9.4Z"/><path d="m9 12 2.2 2.2L15.5 10"/>',
  cloud: '<path d="M17.5 19H8a5.5 5.5 0 1 1 1.2-10.9A6 6 0 0 1 20.8 10 4.5 4.5 0 0 1 17.5 19Z"/><path d="m10.5 12.5-1.5 1.5 1.5 1.5M13.5 12.5l1.5 1.5-1.5 1.5"/>',
  pen: '<path d="m12 19 7-7 3 3-7 7-3-3Z"/><path d="m18 13-1.5-7.5L2 2l3.5 14.5L13 18l5-5Z"/><path d="m2 2 7.6 7.6"/><circle cx="11" cy="11" r="2"/>',
  pin: '<path d="M20 10c0 6-8 12-8 12s-8-6-8-12a8 8 0 0 1 16 0Z"/><circle cx="12" cy="10" r="3"/>',
  globe: '<circle cx="12" cy="12" r="9.5"/><path d="M2.5 12h19"/><path d="M12 2.5a14.5 14.5 0 0 1 0 19 14.5 14.5 0 0 1 0-19Z"/>',
  sun: '<circle cx="12" cy="12" r="4"/><path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4"/>',
  clock: '<circle cx="12" cy="12" r="9.5"/><path d="M12 7v5l3 2"/>',
  users: '<path d="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M22 21v-2a4 4 0 0 0-3-3.9M16 3.1a4 4 0 0 1 0 7.8"/>',
  message: '<path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2Z"/><path d="M8 8.5h8M8 12h5"/>',
  mail: '<rect x="2.5" y="4.5" width="19" height="15" rx="2"/><path d="m3 6 9 7 9-7"/>',
  book: '<path d="M2 4.5h6a4 4 0 0 1 4 4v12a3 3 0 0 0-3-3H2Z"/><path d="M22 4.5h-6a4 4 0 0 0-4 4v12a3 3 0 0 1 3-3h7Z"/>',
  help: '<circle cx="12" cy="12" r="9.5"/><path d="M9.1 9a3 3 0 0 1 5.8 1c0 2-3 3-3 3"/><path d="M12 17h.01"/>',
};

const ARROW = '<path d="M4.5 11.5L11.5 4.5M11.5 4.5H5.5M11.5 4.5V10.5" />';

const REGIONS = ["US", "Mexico", "Canada", "India"];

/* Tighter between 992 and 1199, where six links, the logo and the button
   otherwise wrap. An open menu's trigger keeps the hover state. */
const MENU_LINK_CLASS =
  "ac-nav-link inline-flex items-center gap-[6px] whitespace-nowrap px-[13px] py-[9px] text-[15px] font-medium leading-[1.5] tracking-[-0.005em] text-[#0e121a] no-underline " +
  "max-[1199px]:px-[8px] max-[1199px]:text-[14px] " +
  "border border-transparent transition-colors duration-200 " +
  "hover:border-[#0e121a]/12 hover:bg-[#0e121a]/[0.04] aria-expanded:border-[#0e121a]/12 aria-expanded:bg-[#0e121a]/[0.04]";

const MOBILE_MENU_LINK_CLASS =
  "flex w-full items-center justify-between border-b border-[#0e121a]/10 px-0 py-[18px] text-[24px] font-medium text-[#0e121a] no-underline";

const pad = (n: number) => String(n).padStart(2, "0");
---

<header class="ac-nav fixed inset-x-0 top-0 z-[20]">
  {/* Meta strip — mono micro-labels on a dark rule above the main nav. */}
  <div class="ac-nav-strip bg-[#0a0d14] text-[#e4e4e7] sdown:hidden">
    <div class="mx-auto flex h-[34px] w-full max-w-[1920px] items-center justify-between px-[var(--gutter)]">
      <span class="mono-label flex items-center gap-[10px] text-white">
        <span
          aria-hidden="true"
          class="h-[5px] w-[5px] rounded-full bg-[var(--color-accent)]"
        />
        Dallas
        <span class="text-white/25">/</span>
        X-Shore
      </span>

      <span class="mono-label flex items-center gap-[8px] text-white/45">
        <span>Delivery</span>
        <span class="text-white/25">:</span>
        {REGIONS.map((region, i) => (
          <span class="flex items-center gap-[8px]">
            {i > 0 ? <span class="text-white/20">·</span> : null}
            <span class="text-white/80">{region}</span>
          </span>
        ))}
      </span>
    </div>
  </div>

  {/* Main bar. The border tone follows scroll position; the script below swaps
      border-transparent for the hairline once the page has moved. */}
  <div
    data-ac-nav-bar
    class="ac-nav-bar border-b transition-colors duration-300 border-transparent bg-white"
  >
    <div class="relative mx-auto w-full max-w-[1920px] px-[var(--gutter)]">
      <div class="flex items-center justify-between py-[16px] mdown:py-[12px]">
        <a href={SITE_URL} class="-my-[11px] py-[11px] no-underline" aria-label={`${BRAND.name} home`}>
          <span class="ac-nav-logo font-[family-name:var(--font-display-stack)] text-[23px] font-semibold tracking-[-0.03em] text-[#0e121a] sdown:text-[18px]">
            <BrandMark size={26} />
          </span>
        </a>

        <nav aria-label="Primary" class="flex gap-[2px] mdown:hidden">
          {NAV_LINKS.map((link) =>
            link.menu ? (
              <button
                type="button"
                class={MENU_LINK_CLASS}
                aria-expanded="false"
                aria-controls={paneId(link)}
                data-ac-nav-trigger
              >
                {link.label}
                <Chevron class="ac-nav-chevron" />
              </button>
            ) : (
              <a href={resolve(link.href)} class={MENU_LINK_CLASS}>
                {link.label}
              </a>
            ),
          )}
        </nav>

        <div class="flex items-center">
          <div class="xsdown:hidden">
            <a
              href="#contact"
              data-ac-nav-cta
              class="mono-label flex items-center gap-[9px] whitespace-nowrap bg-[var(--color-accent)] px-[20px] py-[11px] text-white no-underline hover:bg-[var(--color-accent-dark)] max-[1199px]:px-[14px]"
            >
              Build your team
              <svg
                width="11"
                height="11"
                viewBox="0 0 16 16"
                fill="none"
                aria-hidden="true"
                class="shrink-0"
              >
                <path
                  d="M4.5 11.5L11.5 4.5M11.5 4.5H5.5M11.5 4.5V10.5"
                  stroke="currentColor"
                  stroke-width="1.8"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                />
              </svg>
            </a>
          </div>

          <button
            type="button"
            aria-label="Open menu"
            aria-expanded="false"
            aria-controls="mobile-menu"
            data-ac-nav-burger
            class="ac-nav-burger -my-[5px] -mr-[5px] ml-[13px] hidden h-[44px] w-[44px] flex-col items-center justify-center gap-[6px] mdown:flex"
          >
            <span aria-hidden="true" class="block h-[1.5px] w-[20px] bg-[#0e121a]" />
            <span aria-hidden="true" class="block h-[1.5px] w-[20px] bg-[#0e121a]" />
            <span aria-hidden="true" class="block h-[1.5px] w-[20px] bg-[#0e121a]" />
          </button>
        </div>
      </div>

      {/* The one dropdown. It hangs from the bar across the page between the
          outer column rules; every menu's pane sits in the same grid cell, so
          the panel keeps the tallest one's height whichever is showing. */}
      <div data-ac-nav-mega>
        <span data-ac-joints aria-hidden="true">
          <i data-ac-corner="tl" />
          <i data-ac-corner="tr" />
          <i data-ac-corner="bl" />
          <i data-ac-corner="br" />
        </span>
        <span data-ac-nav-caret aria-hidden="true" />
        {MENUS.map((link) => (
          <div data-ac-nav-pane id={paneId(link)} role="group" aria-label={link.label}>
            {"directory" in link.menu ? (
            <div data-ac-nav-pane-body data-ac-nav-dir style={`--dir-cols: ${link.menu.directory.length}`}>
              {link.menu.directory.map((group) => (
                <div data-ac-nav-group>
                  <a href={resolve(group.href)} data-ac-nav-dir-head class="mono-label">
                    {group.title.split(" ").slice(0, -1).join(" ")}{" "}
                    <span>
                      {group.title.split(" ").at(-1)}
                      <svg width="11" height="11" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" set:html={ARROW} />
                    </span>
                  </a>
                  <ul>
                    {group.items.map((item) => (
                      <li>
                        <a href={item.href} data-ac-nav-dir-link>
                          <span>{item.label}</span>
                          <svg width="12" height="12" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" set:html={ARROW} />
                        </a>
                      </li>
                    ))}
                  </ul>
                </div>
              ))}
            </div>
            ) : (
            <div data-ac-nav-pane-body>
              <div data-ac-nav-group="feature">
                <p data-ac-nav-group-title class="mono-label">{link.menu.feature.title}</p>
                <ul>
                  {link.menu.feature.items.map((item, i) => (
                    <li>
                      <a href={resolve(item.href)} data-ac-nav-card>
                        <span data-ac-nav-icon>
                          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" set:html={NAV_ICONS[item.icon]} />
                        </span>
                        <span data-ac-nav-card-mark aria-hidden="true">
                          <span data-ac-nav-card-number>{pad(i + 1)}</span>
                          <svg width="14" height="14" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" set:html={ARROW} />
                        </span>
                        <span data-ac-nav-card-copy>
                          <span data-ac-nav-label>{item.label}</span>
                          <span data-ac-nav-note>{item.note}</span>
                        </span>
                      </a>
                    </li>
                  ))}
                </ul>
              </div>
              {link.menu.columns.map((group) => (
                <div data-ac-nav-group>
                  <p data-ac-nav-group-title class="mono-label">{group.title}</p>
                  <ul>
                    {group.items.map((item) => (
                      <li>
                        <a href={resolve(item.href)} data-ac-nav-row>
                          <span data-ac-nav-icon>
                            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" set:html={NAV_ICONS[item.icon]} />
                          </span>
                          <span>
                            <span data-ac-nav-label>{item.label}</span>
                            <span data-ac-nav-note>{item.note}</span>
                          </span>
                        </a>
                      </li>
                    ))}
                  </ul>
                </div>
              ))}
            </div>
            )}
            <div data-ac-nav-pane-foot>
              <a href={resolve(link.href)} data-ac-nav-overview class="mono-label">
                <span aria-hidden="true">+</span>
                {link.label} overview
              </a>
              <p>
                {link.menu.footer.text}
                <a href={resolve(link.menu.footer.href)} data-ac-nav-foot-link>
                  {link.menu.footer.label}
                  <svg width="12" height="12" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" set:html={ARROW} />
                </a>
              </p>
            </div>
          </div>
        ))}
      </div>
    </div>
  </div>

  <nav
    id="mobile-menu"
    aria-label="Mobile"
    inert
    class="absolute left-0 top-full hidden h-screen w-full overflow-y-auto bg-white px-[var(--gutter)] pb-[160px] pt-[28px] transition-[opacity,transform] duration-[300ms] ease-[ease] mdown:block pointer-events-none -translate-y-[12px] opacity-0"
  >
    <span class="mono-label mb-[14px] block text-[#0e121a]/40">Menu</span>
    {NAV_LINKS.map((link) =>
      link.menu ? (
        <details data-ac-mnav-group name="mobile-nav">
          <summary class={MOBILE_MENU_LINK_CLASS}>
            {link.label}
            <Chevron class="ac-nav-chevron h-[16px] w-[16px]" />
          </summary>
          {"directory" in link.menu ? (
            <div data-ac-mnav-dir>
              {link.menu.directory.map((group) => (
                <div>
                  <p data-ac-mnav-dir-title class="mono-label">{group.title}</p>
                  <ul>
                    {group.items.map((item) => (
                      <li>
                        <a href={item.href}>{item.label}</a>
                      </li>
                    ))}
                  </ul>
                </div>
              ))}
            </div>
          ) : (
            <ul data-ac-mnav-list>
              {[link.menu.feature, ...link.menu.columns].flatMap((group) => group.items).map((item) => (
                <li>
                  <a href={resolve(item.href)}>
                    <span>{item.label}</span>
                    <span data-ac-mnav-note>{item.note}</span>
                  </a>
                </li>
              ))}
            </ul>
          )}
        </details>
      ) : (
        <a href={resolve(link.href)} class={MOBILE_MENU_LINK_CLASS}>
          {link.label}
        </a>
      ),
    )}
    <a
      href="#contact"
      class="mono-label mt-[28px] inline-flex items-center gap-[9px] bg-[var(--color-accent)] px-[20px] py-[14px] text-white no-underline"
    >
      Build your team
      <svg width="11" height="11" viewBox="0 0 16 16" fill="none" aria-hidden="true" class="shrink-0">
        <path d="M4.5 11.5L11.5 4.5M11.5 4.5H5.5M11.5 4.5V10.5" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" />
      </svg>
    </a>
  </nav>
</header>

<script>
  const header = document.querySelector<HTMLElement>(".ac-nav")!;
  const bar = document.querySelector<HTMLElement>("[data-ac-nav-bar]")!;
  const burger = document.querySelector<HTMLButtonElement>("[data-ac-nav-burger]")!;
  const menu = document.getElementById("mobile-menu")!;

  const handleScroll = () => {
    const scrolled = window.scrollY > 0;
    bar.classList.toggle("border-[#0e121a]/10", scrolled);
    bar.classList.toggle("border-transparent", !scrolled);
  };
  handleScroll();
  window.addEventListener("scroll", handleScroll, { passive: true });

  /* -- mobile menu -- */

  const OPEN = ["pointer-events-auto", "translate-y-0", "opacity-100"];
  const CLOSED = ["pointer-events-none", "-translate-y-[12px]", "opacity-0"];
  let isMenuOpen = false;

  const setMenuOpen = (open: boolean) => {
    isMenuOpen = open;
    burger.setAttribute("aria-label", open ? "Close menu" : "Open menu");
    burger.setAttribute("aria-expanded", String(open));
    menu.inert = !open;
    menu.classList.remove(...(open ? CLOSED : OPEN));
    menu.classList.add(...(open ? OPEN : CLOSED));
  };

  burger.addEventListener("click", () => setMenuOpen(!isMenuOpen));
  for (const link of menu.querySelectorAll("a")) {
    link.addEventListener("click", () => setMenuOpen(false));
  }

  /* -- the dropdown --
     One panel, one pane per trigger. Hover opens at once and closes after a
     short grace period, so the pointer can cross from a trigger to the panel
     or on to the next trigger, which swaps the pane without closing. Click
     toggles; a click on a menu hover already opened keeps it open instead of
     closing it under the pointer. Escape, a click outside, or focus leaving
     the trigger and its pane all close. */

  const mega = document.querySelector<HTMLElement>("[data-ac-nav-mega]")!;
  const caret = mega.querySelector<HTMLElement>("[data-ac-nav-caret]")!;
  const triggers = Array.from(document.querySelectorAll<HTMLButtonElement>("[data-ac-nav-trigger]"));
  const panes = triggers.map((trigger) => document.getElementById(trigger.getAttribute("aria-controls")!)!);
  const linksIn = (pane: HTMLElement) => Array.from(pane.querySelectorAll<HTMLElement>("a[href]"));
  let open: number | null = null;
  let openedByHover = false;
  let closeTimer = 0;

  const setOpen = (index: number | null) => {
    window.clearTimeout(closeTimer);
    if (open === index) return;
    const opening = open === null;
    open = index;
    triggers.forEach((trigger, i) => trigger.setAttribute("aria-expanded", String(i === index)));
    panes.forEach((pane, i) => pane.toggleAttribute("data-active", i === index));
    mega.toggleAttribute("data-open", index !== null);
    if (index === null) return;

    /* The caret marks the open trigger on the panel's top edge and slides
       between triggers; opening from closed, it starts in place. */
    const t = triggers[index].getBoundingClientRect();
    const m = mega.getBoundingClientRect();
    if (opening) caret.style.transition = "none";
    mega.style.setProperty("--caret-x", `${t.left - m.left}px`);
    mega.style.setProperty("--caret-w", `${t.width}px`);
    if (opening) {
      void caret.offsetWidth;
      caret.style.transition = "";
    }
  };

  const closeSoon = () => {
    window.clearTimeout(closeTimer);
    closeTimer = window.setTimeout(() => setOpen(null), 180);
  };

  triggers.forEach((trigger, i) => {
    trigger.addEventListener("click", () => {
      if (open === i && openedByHover) {
        openedByHover = false;
        return;
      }
      openedByHover = false;
      setOpen(open === i ? null : i);
    });
    trigger.addEventListener("pointerenter", (event) => {
      if (event.pointerType !== "mouse") return;
      if (open !== i) openedByHover = true;
      setOpen(i);
    });
    trigger.addEventListener("pointerleave", (event) => {
      if (event.pointerType === "mouse") closeSoon();
    });
    /* The pane lives after the bar in the document, so Tab from an open
       trigger is sent into it, as if it followed the trigger. */
    trigger.addEventListener("keydown", (event) => {
      if (event.key === "Tab" && !event.shiftKey && open === i) {
        event.preventDefault();
        linksIn(panes[i])[0]?.focus();
      }
    });
  });

  mega.addEventListener("pointerenter", (event) => {
    if (event.pointerType === "mouse") window.clearTimeout(closeTimer);
  });
  mega.addEventListener("pointerleave", (event) => {
    if (event.pointerType === "mouse") closeSoon();
  });

  /* Out of the pane by keyboard: back to its trigger, or on to whatever
     follows the trigger in the bar. */
  mega.addEventListener("keydown", (event) => {
    if (event.key !== "Tab" || open === null) return;
    const links = linksIn(panes[open]);
    const trigger = triggers[open];
    if (event.shiftKey && document.activeElement === links[0]) {
      event.preventDefault();
      trigger.focus();
    } else if (!event.shiftKey && document.activeElement === links[links.length - 1]) {
      const inBar = Array.from(bar.querySelectorAll<HTMLElement>("a[href], button")).filter(
        (el) => !mega.contains(el) && el.checkVisibility(),
      );
      const next = inBar[inBar.indexOf(trigger) + 1];
      if (next) {
        event.preventDefault();
        next.focus();
      }
    }
  });

  header.addEventListener("focusout", (event) => {
    if (open === null) return;
    const to = event.relatedTarget as Node | null;
    if (to && (to === triggers[open] || mega.contains(to))) return;
    setOpen(null);
  });

  for (const link of linksIn(mega)) {
    link.addEventListener("click", () => setOpen(null));
  }

  document.addEventListener("keydown", (event) => {
    if (event.key !== "Escape") return;
    if (open !== null) {
      const trigger = triggers[open];
      setOpen(null);
      trigger.focus();
    } else if (isMenuOpen) {
      setMenuOpen(false);
      burger.focus();
    }
  });
  document.addEventListener("pointerdown", (event) => {
    const target = event.target as Node;
    if (open !== null && !mega.contains(target) && !triggers.some((trigger) => trigger.contains(target))) setOpen(null);
  });
</script>
