---
import Arrow from "@pg/page34/components/icons/Arrow.astro";
import GridRules from "@pg/page34/components/GridRules.astro";
import SectionHead from "@pg/page34/components/SectionHead.astro";
import { withBase } from "@pg/page34/lib/paths";

/* The closing call to action, on the accent. Behind it, a drafting mark:
   concentric circles on a crosshair with one dashed ring turning slowly, the
   compass the team plans with. Copy is the brief's. See
   docs/components/cta-footer.md. */

interface Props {
  /** A subpage's own close; the home page uses the defaults below. */
  eyebrow?: string;
  headline?: string[];
  accent?: number;
  body?: string;
  cta?: string;
}

const {
  eyebrow = "Ready when you are",
  headline = ["Let’s assemble the team", "behind your next release."],
  accent = headline.length - 1,
  body = "Tell us what you are building, where the roadmap is blocked, and which capabilities you need. We will map a practical team and delivery model.",
  cta = "Plan my team",
} = Astro.props;
---

<section data-ac-sec="accent" data-ac-cta-section id="contact">
  <GridRules />

  <svg data-ac-cta-compass viewBox="0 0 600 600" aria-hidden="true">
    <circle cx="300" cy="300" r="290" />
    <circle cx="300" cy="300" r="200" />
    <circle data-ac-cta-ring cx="300" cy="300" r="245" />
    <circle cx="300" cy="300" r="70" data-ac-cta-core />
    <path d="M300 0v600M0 300h600" />
  </svg>

  <div data-ac-sec-container>
    <SectionHead eyebrow={eyebrow} headline={headline} accent={accent}>
      <div data-ac-cta-side data-ac-sec-rise>
        <p data-ac-cta-body>{body}</p>
        <a data-ac-cta-button class="mono-label" href={withBase("/contact")}>
          {cta}
          <Arrow direction="diagonal" />
        </a>
      </div>
    </SectionHead>
  </div>
</section>

<script>
  import { toggleInView } from "@pg/page34/lib/in-view";

  toggleInView(document.querySelector<HTMLElement>("[data-ac-cta-section]")!);
</script>
