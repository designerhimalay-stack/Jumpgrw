---
import { Image } from "astro:assets";
import Arrow from "@pg/page34/components/icons/Arrow.astro";
import GridRules from "@pg/page34/components/GridRules.astro";
import SectionHead from "@pg/page34/components/SectionHead.astro";
import Joints from "@pg/page34/components/process/Joints.astro";
import type { HireHead, HireLink, HireModel } from "@pg/page34/components/hire/types";

/* Ways to work together. Three photo cards side by side (staff augmentation,
   augmented squad, managed delivery pod): a large photo of people at work
   with the model's name and team size set on it, then the title, one line,
   the skills and a link to the planner. A line under the cards says who stays
   in control. Cards rise in turn as the section arrives.

   Phones: the cards become a sideways rail (scroll-snap), one and a bit in
   view, so the section stays one card tall. */

interface Props extends HireHead {
  /** Three reads best. */
  models: HireModel[];
  /** The link on every card, e.g. "Plan this team shape" to "#plan". */
  cta: HireLink;
  /** The closing line; `lead` is set in bold. */
  control?: { lead: string; rest: string };
  /** "tint" is a light section on a pale blue ground. */
  tone?: "light" | "tint" | "dark";
}

const { id, eyebrow, headline, accent, lede, models, cta, control, tone = "light" } = Astro.props;
---

<section data-ac-sec={tone === "tint" ? "light" : tone} data-ac-hire-tint={tone === "tint" || undefined} data-ac-hire="ways" id={id}>
  <GridRules />
  <div data-ac-sec-container>
    <SectionHead eyebrow={eyebrow} headline={headline} accent={accent ?? headline.length - 1} lede={lede} />

    <ul data-ac-hire-rail data-ac-hire-ways-cards role="list">
      {models.map((model, i) => (
        <li data-ac-sec-frame data-ac-hire-ways-card style={`--i:${i}`}>
          <Joints />
          <div data-ac-hire-photo data-ac-hire-ways-photo>
            <Image
              src={model.photo.image}
              alt={model.photo.alt}
              widths={[400, 640, 960]}
              sizes="(max-width: 599px) 82vw, (max-width: 991px) 46vw, 30vw"
              quality={78}
              style={model.photo.focus ? `object-position:${model.photo.focus}` : undefined}
            />
            <span data-ac-hire-tag class="mono-label">{model.kind}</span>
            <span data-ac-hire-ways-size class="mono-label">{model.size}</span>
          </div>
          <div data-ac-hire-ways-body>
            <h3 data-ac-hire-card-title>{model.title}</h3>
            <p data-ac-hire-card-body>{model.body}</p>
            <ul data-ac-hire-chips role="list">
              {model.skills.map((skill) => <li>{skill}</li>)}
            </ul>
            <a data-ac-hire-link class="mono-label" href={cta.href}>
              {cta.label}
              <Arrow direction="right" />
            </a>
          </div>
        </li>
      ))}
    </ul>

    {control && (
      <p data-ac-hire-note data-ac-sec-rise>
        <strong>{control.lead}</strong> {control.rest}
      </p>
    )}
  </div>
</section>

<script>
  import { toggleInView } from "@pg/page34/lib/in-view";

  document.querySelectorAll<HTMLElement>('[data-ac-hire="ways"]').forEach(toggleInView);
</script>
