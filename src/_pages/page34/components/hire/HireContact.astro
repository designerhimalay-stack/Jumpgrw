---
import Arrow from "@pg/page34/components/icons/Arrow.astro";
import GridRules from "@pg/page34/components/GridRules.astro";
import SectionHead from "@pg/page34/components/SectionHead.astro";
import Joints from "@pg/page34/components/process/Joints.astro";
import { BRAND } from "@pg/page34/lib/brand";
import type { HireContactCopy } from "@pg/page34/components/hire/types";

/* Contact: "Where does your team need help?" On the accent band, so it
   closes the page the way CtaSection does, and replaces it on hire pages.
   Columns 1–2: the eyebrow, headline, one line, the email and phone, and
   the consent line. Columns 3–4: a white brief form (name, company, work
   email, phone, what you need, when, a message). Every field has a real
   <label>; name, email and "what you need" are required and validated by
   the browser.

   Sending: the site is static. When BRAND.contact.formAction is set, the
   form posts there. Otherwise the script opens a mailto: to
   BRAND.contact.email with the fields in the body; without the script the
   form falls back to a plain mailto: action. */

interface Props {
  id?: string;
  copy: HireContactCopy;
}

const { id = "contact", copy } = Astro.props;
const { email, phone, formAction } = BRAND.contact;
const action = formAction || `mailto:${email}`;
const tel = `tel:${phone.replace(/[^\d+]/g, "")}`;
const f = (name: string) => `${id}-${name}`;
---

<section data-ac-sec="accent" data-ac-hire="contact" id={id} data-email={email} data-has-action={formAction ? "" : undefined}>
  <GridRules />
  <div data-ac-sec-container data-ac-hire-contact>
    <div data-ac-hire-contact-copy>
      <SectionHead eyebrow={copy.eyebrow} headline={copy.headline} accent={copy.accent ?? copy.headline.length - 1} />
      <div data-ac-sec-rise>
        <p data-ac-hire-contact-body>{copy.body}</p>
        <ul data-ac-hire-contact-ways role="list">
          <li><a href={`mailto:${email}`}>{email}</a></li>
          <li><a href={tel}>{phone}</a></li>
        </ul>
        <p data-ac-hire-contact-consent>{copy.consent}</p>
      </div>
    </div>

    <form
      data-ac-sec-frame
      data-ac-hire-form
      data-ac-sec-rise
      action={action}
      method="post"
      enctype={formAction ? undefined : "text/plain"}
    >
      <Joints />
      <p data-ac-hire-form-title>
        <span class="mono-label">{BRAND.name} · brief</span>
        <strong>{copy.formTitle}</strong>
      </p>

      <div data-ac-hire-form-grid>
        <div data-ac-hire-field>
          <label for={f("name")}>Your name</label>
          <input id={f("name")} name="name" type="text" autocomplete="name" placeholder="Full name" required />
        </div>
        <div data-ac-hire-field>
          <label for={f("company")}>Company <span>(optional)</span></label>
          <input id={f("company")} name="company" type="text" autocomplete="organization" placeholder="Company name" />
        </div>
        <div data-ac-hire-field>
          <label for={f("email")}>Work email</label>
          <input id={f("email")} name="email" type="email" autocomplete="email" placeholder="you@company.com" required />
        </div>
        <div data-ac-hire-field>
          <label for={f("phone")}>Phone <span>(optional)</span></label>
          <input id={f("phone")} name="phone" type="tel" autocomplete="tel" placeholder="Phone number" />
        </div>
        <div data-ac-hire-field>
          <label for={f("need")}>What do you need?</label>
          <select id={f("need")} name="need" required>
            <option value="">Select one</option>
            {copy.needs.map((need) => <option>{need}</option>)}
          </select>
        </div>
        <div data-ac-hire-field>
          <label for={f("when")}>When do you need help? <span>(optional)</span></label>
          <select id={f("when")} name="when">
            <option value="">Select one</option>
            {copy.timings.map((when) => <option>{when}</option>)}
          </select>
        </div>
        <div data-ac-hire-field data-wide>
          <label for={f("message")}>The role or skill you need <span>(optional)</span></label>
          <textarea id={f("message")} name="message" rows="3" placeholder="Share the role, tech stack or team gap"></textarea>
        </div>
      </div>

      <button type="submit" data-ac-hire-button data-variant="block" class="mono-label">
        {copy.submit}
        <Arrow direction="right" />
      </button>
      <p data-ac-hire-form-note>{copy.note}</p>
    </form>
  </div>
</section>

<script>
  import { toggleInView } from "@pg/page34/lib/in-view";

  document.querySelectorAll<HTMLElement>('[data-ac-hire="contact"]').forEach((section) => {
    toggleInView(section);

    /* With a form service set, the browser posts the form as usual. */
    if (section.hasAttribute("data-has-action")) return;

    const form = section.querySelector<HTMLFormElement>("[data-ac-hire-form]")!;
    const email = section.dataset.email ?? "";

    /* "submit" only fires once the browser has validated the required
       fields, so this builds the email from a complete brief. */
    form.addEventListener("submit", (event) => {
      event.preventDefault();
      const lines: string[] = [];
      form.querySelectorAll<HTMLInputElement | HTMLSelectElement | HTMLTextAreaElement>("input, select, textarea").forEach(
        (field) => {
          const label = form.querySelector(`label[for="${field.id}"]`)?.firstChild?.textContent?.trim() ?? field.name;
          if (field.value.trim()) lines.push(`${label}: ${field.value.trim()}`);
        },
      );
      const need = form.querySelector<HTMLSelectElement>("select[name='need']")?.value ?? "";
      const subject = encodeURIComponent(need ? `Team brief: ${need}` : "Team brief");
      window.location.href = `mailto:${email}?subject=${subject}&body=${encodeURIComponent(lines.join("\n"))}`;
    });
  });
</script>
