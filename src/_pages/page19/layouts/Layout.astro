---
import { Font } from "astro:assets";

import { BRAND } from "@pg/page19/lib/brand";

interface Props {
  title?: string;
  description?: string;
  /** What sits under the fixed navbar on first paint. A subpage that opens on
      the dark PageHero passes "field" so the bar is dark from the first frame;
      PageHero then follows the scroll. The home page's Hero sets it itself. */
  navTone?: "paper" | "field";
}

const {
  title = `${BRAND.name} · ${BRAND.descriptor}`,
  description = "Senior product builders across the US, Mexico, Canada and India, assembled in weeks.",
  navTone,
} = Astro.props;

/* The tab icon is the logo from src/lib/brand.ts, once one is set; until
   then the browser shows its own generic document icon. */
---

<!doctype html>
<html lang="en" data-portal-phase={navTone}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    {BRAND.logo && <link rel="icon" href={BRAND.logo.src} />}
    {/* Runs before the browser restores a scroll position on reload. Setting
        this from a module script is too late: the restore has already happened
        by then, and Chrome re-applies it as the document grows, which it does
        here because the hero portal's scroll length is only known once it
        mounts. A reload has to start at the top, since the hero is a
        scroll-driven camera and every section's entrance is gated on arriving
        at it.

        It also holds the navbar and hero at their start positions before the
        first paint, so the entrance never opens on a page that has already
        shown itself for a frame. The timeout is a dead-man's switch: if the
        page scripts never run, un-hide rather than leaving a blank page. */}
    <script is:inline>try{history.scrollRestoration='manual'}catch{}try{const d=document.documentElement;d.dataset.acIntro='start';setTimeout(()=>{if(d.dataset.acIntro!=='done')d.dataset.acIntro='done'},6000)}catch{}</script>
    <Font cssVariable="--font-display" preload />
    <Font cssVariable="--font-body" preload />
  </head>
  <body>
    <slot />
  </body>
</html>
