---
import Arrow from "@pg/page32/components/icons/Arrow.astro";
import GridRules from "@pg/page32/components/GridRules.astro";
import SectionHead from "@pg/page32/components/SectionHead.astro";
import Joints from "@pg/page32/components/process/Joints.astro";
import type { HireHead, HireLink } from "@pg/page32/components/hire/types";

/* Team planning view. A team-size slider (a native range input: labelled,
   arrow keys and Home/End work) in columns 1–2, and the cost panel on the
   ink in columns 3–4: one engineer's month, the selected team's month and the
   capacity at that size, then the call to action. The script rewrites only
   the numbers, each in a box with a reserved width and tabular figures, so
   the layout never moves. Without the script the page shows the starting
   size and its true totals.

   Cost = rate × hours × team size; at $125 × 160 one engineer is $20,000. */

interface Props extends HireHead {
  /** Hourly rate in US dollars. */
  rate: number;
  /** Hours per engineer per month. */
  hours: number;
  min?: number;
  max: number;
  start: number;
  /** Over the panel, e.g. "Monthly team cost". */
  panelLabel: string;
  /** Caption of the one-engineer figure, e.g. "One engineer in Mexico at $125/hr". */
  oneLabel: string;
  /** Caption of the team figure; "{n}" is replaced by the size. */
  teamLabel: string;
  /** The capacity line; "{n}" is replaced by the size, "{people}" by engineer/engineers. */
  capacity: string;
  /** Slider label, e.g. "Your team size". */
  sizeLabel: string;
  /** Singular and plural for the unit, e.g. ["engineer", "engineers"]. */
  unit: [string, string];
  cta: HireLink;
  /** Under the button, e.g. "Planning figures are directional, not a quote." */
  disclaimer: string;
  /** Under the slider: how the estimate is made. */
  note: string;
  /** "tint" is a light section on a pale blue ground. */
  tone?: "light" | "tint" | "dark";
}

const {
  id,
  eyebrow,
  headline,
  accent,
  lede,
  rate,
  hours,
  min = 1,
  max,
  start,
  panelLabel,
  oneLabel,
  teamLabel,
  capacity,
  sizeLabel,
  unit,
  cta,
  disclaimer,
  note,
  tone = "light",
} = Astro.props;

const money = (n: number) => `$${n.toLocaleString("en-US")}`;
const people = (n: number) => (n === 1 ? unit[0] : unit[1]);
const fill = (text: string, n: number) => text.replace("{n}", String(n)).replace("{people}", people(n));
const mid = Math.round((min + max) / 2);
---

<section
  data-ac-sec={tone === "tint" ? "light" : tone}
  data-ac-hire-tint={tone === "tint" || undefined}
  data-ac-hire="plan"
  id={id}
  data-rate={rate}
  data-hours={hours}
  data-unit-one={unit[0]}
  data-unit-many={unit[1]}
  data-team-label={teamLabel}
  data-capacity={capacity}
>
  <GridRules />
  <div data-ac-sec-container>
    <SectionHead eyebrow={eyebrow} headline={headline} accent={accent ?? headline.length - 1} lede={lede} />

    <div data-ac-hire-plan data-ac-sec-rise>
      <div data-ac-sec-frame data-ac-hire-plan-control>
        <Joints />
        <div data-ac-hire-plan-size>
          <label for={`${id}-size`} class="mono-label">{sizeLabel}</label>
          <output for={`${id}-size`} data-ac-hire-plan-out>
            <span data-ac-hire-plan-n>{start}</span> <span data-ac-hire-plan-unit>{people(start)}</span>
          </output>
        </div>
        <input
          id={`${id}-size`}
          type="range"
          min={min}
          max={max}
          step="1"
          value={start}
          data-ac-hire-plan-input
          style={`--fill:${((start - min) / (max - min)) * 100}%`}
        />
        <div data-ac-hire-plan-ticks class="mono-label" aria-hidden="true">
          <span>{min} {people(min)}</span>
          <span>{mid} {people(mid)}</span>
          <span>{max} {people(max)}</span>
        </div>
        <p data-ac-hire-plan-note>{note}</p>
      </div>

      <div data-ac-hire-plan-panel>
        <p data-ac-hire-plan-head class="mono-label">
          <span>{panelLabel}</span>
          <span data-ac-hire-plan-team-tag>{fill("{n} {people}", start)}</span>
        </p>
        <dl data-ac-hire-plan-sums>
          <div>
            <dt>{oneLabel}</dt>
            <dd><span data-ac-hire-plan-money>{money(rate * hours)}</span><small>per month</small></dd>
          </div>
          <div>
            <dt data-ac-hire-plan-team-label>{fill(teamLabel, start)}</dt>
            <dd><span data-ac-hire-plan-money data-ac-hire-plan-total>{money(rate * hours * start)}</span><small>per month</small></dd>
          </div>
        </dl>
        <p data-ac-hire-plan-capacity>
          <span data-ac-hire-plan-big data-ac-hire-plan-n>{start}</span>
          <span data-ac-hire-plan-cap-text>{fill(capacity, start)}</span>
        </p>
        <a data-ac-hire-button data-variant="block" class="mono-label" href={cta.href}>
          {cta.label}
          <Arrow direction="right" />
        </a>
        <p data-ac-hire-plan-disclaimer>{disclaimer}</p>
      </div>
    </div>
  </div>
</section>

<script>
  import { toggleInView } from "@pg/page32/lib/in-view";

  document.querySelectorAll<HTMLElement>('[data-ac-hire="plan"]').forEach((section) => {
    toggleInView(section);

    const { rate, hours, unitOne = "", unitMany = "", teamLabel = "", capacity = "" } = section.dataset;
    const input = section.querySelector<HTMLInputElement>("[data-ac-hire-plan-input]")!;
    const min = Number(input.min);
    const max = Number(input.max);
    const people = (n: number) => (n === 1 ? unitOne : unitMany);
    const fill = (text: string, n: number) => text.replace("{n}", String(n)).replace("{people}", people(n));
    const set = (selector: string, text: string) =>
      section.querySelectorAll<HTMLElement>(selector).forEach((el) => (el.textContent = text));

    const update = () => {
      const n = Number(input.value);
      input.style.setProperty("--fill", `${((n - min) / (max - min)) * 100}%`);
      set("[data-ac-hire-plan-n]", String(n));
      set("[data-ac-hire-plan-unit]", people(n));
      set("[data-ac-hire-plan-team-tag]", `${n} ${people(n)}`);
      set("[data-ac-hire-plan-team-label]", fill(teamLabel, n));
      set("[data-ac-hire-plan-cap-text]", fill(capacity, n));
      set("[data-ac-hire-plan-total]", `$${(Number(rate) * Number(hours) * n).toLocaleString("en-US")}`);
    };

    input.addEventListener("input", update);
    update();
  });
</script>
