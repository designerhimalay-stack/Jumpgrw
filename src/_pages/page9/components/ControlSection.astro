---
import { Image } from "astro:assets";
import GridRules from "@pg/page9/components/GridRules.astro";
import RevealText from "@pg/page9/components/RevealText.astro";
import Joints from "@pg/page9/components/process/Joints.astro";
import { LINE_ICONS } from "@pg/page9/lib/line-icons";
import type { LineIcon, SectionPhoto } from "@pg/page9/types/page";

/* Governance, on the dark tone. A tall photo of the team holds columns
   1–2; columns 3–4 list what stays in the client's control, each with a
   ring that draws itself closed as the section arrives, one after
   another. See docs/sections.md. */

interface Props {
  id: string;
  eyebrow: string;
  headline: string[];
  accent?: number;
  lede: string;
  media: SectionPhoto;
  controls: { icon: LineIcon; title: string; note: string }[];
}

const { id, eyebrow, headline, accent = headline.length - 1, lede, media, controls } = Astro.props;
const offsets = headline.map((_, i) => headline.slice(0, i).reduce((n, line) => n + Array.from(line).length + 1, 0));
---

<section data-ac-sec="dark" data-ac-control id={id}>
  <GridRules />

  <div data-ac-sec-container data-ac-control-grid>
    <div data-ac-control-photo>
      <Joints />
      <div data-ac-control-image>
        <Image
          src={media.image}
          alt={media.alt}
          widths={[480, 800, 1200]}
          sizes="(max-width: 991px) 100vw, 46vw"
          quality={78}
          style={media.focus ? `object-position:${media.focus}` : undefined}
        />
      </div>
    </div>

    <div data-ac-control-copy>
      <p data-ac-sec-eyebrow class="mono-label">
        <span aria-hidden="true">+</span>
        {eyebrow}
      </p>
      <h2 data-ac-control-headline aria-label={headline.join(" ")}>
        {headline.map((line, i) => (
          <Fragment>
            {i > 0 && <Fragment>{" "}<br aria-hidden="true" /></Fragment>}
            <span data-ac-sec-line data-accent={i === accent || undefined}>
              <RevealText text={line} offset={offsets[i]} />
            </span>
          </Fragment>
        ))}
      </h2>
      <p data-ac-control-lede data-ac-sec-rise>{lede}</p>

      <ul data-ac-control-list>
        {controls.map((control, i) => (
          <li style={`--ac-i:${i}`}>
            <span data-ac-control-icon>
              <svg data-ac-control-ring viewBox="0 0 48 48" aria-hidden="true">
                <circle cx="24" cy="24" r="22" pathLength="1" />
              </svg>
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" set:html={LINE_ICONS[control.icon]} />
            </span>
            <span data-ac-control-text>
              <span>{control.title}</span>
              <span>{control.note}</span>
            </span>
          </li>
        ))}
      </ul>
    </div>
  </div>
</section>

<script>
  import { toggleInView } from "@pg/page9/lib/in-view";

  document.querySelectorAll<HTMLElement>("[data-ac-control]").forEach(toggleInView);
</script>
