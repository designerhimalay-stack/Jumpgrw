---
import GridRules from "@pg/page12/components/GridRules.astro";
import SectionHead from "@pg/page12/components/SectionHead.astro";
import Joints from "@pg/page12/components/process/Joints.astro";

/* Is this a good fit? The headline holds columns 1–2; the four signs that it
   is fill a numbered list in columns 3–4, each row lighting its number and
   check as it arrives. Phones: the list under the headline. See
   docs/sections.md. */

interface Props {
  copy: { eyebrow: string; headline: string[]; items: string[] };
}

const { copy } = Astro.props;
const pad = (n: number) => String(n).padStart(2, "0");
---

<section data-ac-sec="light" data-ac-fit id="fit">
  <GridRules />

  <div data-ac-sec-container data-ac-fit-grid>
    <div data-ac-fit-head>
      <SectionHead eyebrow={copy.eyebrow} headline={copy.headline} accent={1} />
    </div>
    <div data-ac-sec-frame data-ac-fit-list>
      <Joints />
      <ol data-ac-fit-items>
      {copy.items.map((item, i) => (
        <li data-ac-fit-item style={`--ac-i:${i}`}>
          <span data-ac-fit-num>{pad(i + 1)}</span>
          <span data-ac-fit-text>{item}</span>
          <svg data-ac-fit-check viewBox="0 0 24 24" width="18" height="18" aria-hidden="true"><path d="m5 12.5 4.5 4.5L19 7.5" /></svg>
        </li>
      ))}
      </ol>
    </div>
  </div>
</section>

<script>
  import { toggleInView } from "@pg/page12/lib/in-view";

  toggleInView(document.querySelector<HTMLElement>("[data-ac-fit]")!);
</script>
