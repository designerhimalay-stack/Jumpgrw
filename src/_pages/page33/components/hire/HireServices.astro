---
import GridRules from "@pg/page33/components/GridRules.astro";
import SectionHead from "@pg/page33/components/SectionHead.astro";
import Joints from "@pg/page33/components/process/Joints.astro";
import HireSwitch from "@pg/page33/components/hire/HireSwitch.astro";
import type { HireHead, HireService } from "@pg/page33/components/hire/types";

/* Choose the work your team needs. The services as a list of options in
   columns 1–2 (two per row on a desk); picking one shows its panel in
   columns 3–4: the description, the common work and the tools used. Built on
   HireSwitch, so it works by keyboard and without JavaScript, and every
   panel shares one grid cell (the tallest sets the height; nothing moves).

   Phones: the options become a sideways rail of chips over the panel. */

interface Props extends HireHead {
  /** Up to eight. */
  services: HireService[];
  /** Legend for the option group (read by screen readers). */
  pickLabel?: string;
  workLabel?: string;
  toolsLabel?: string;
  /** "tint" is a light section on a pale blue ground. */
  tone?: "light" | "tint" | "dark";
}

const {
  id,
  eyebrow,
  headline,
  accent,
  lede,
  services,
  pickLabel = "Pick a service",
  workLabel = "Common work",
  toolsLabel = "Tools we use",
  tone = "light",
} = Astro.props;
const name = `${id}-service`;
---

<section data-ac-sec={tone === "tint" ? "light" : tone} data-ac-hire-tint={tone === "tint" || undefined} data-ac-hire="services" id={id}>
  <GridRules />
  <div data-ac-sec-container>
    <SectionHead eyebrow={eyebrow} headline={headline} accent={accent ?? headline.length - 1} lede={lede} />

    <div data-ac-hire-switch data-ac-hire-services data-ac-sec-rise>
      <fieldset data-ac-hire-switch-list data-ac-hire-services-list>
        <legend class="sr-only">{pickLabel}</legend>
        {services.map((service, i) => (
          <HireSwitch name={name} index={i + 1} checked={i === 0}>
            <span data-ac-hire-opt-mark aria-hidden="true" />
            <span data-ac-hire-opt-text>{service.name}</span>
          </HireSwitch>
        ))}
      </fieldset>

      <div data-ac-sec-frame data-ac-hire-panes data-ac-hire-services-panes>
        <Joints />
        {services.map((service, i) => (
          <article data-ac-hire-pane={i + 1} data-ac-hire-services-pane>
            <p data-ac-hire-index class="mono-label">{String(i + 1).padStart(2, "0")} / {String(services.length).padStart(2, "0")}</p>
            <h3 data-ac-hire-pane-title>{service.name}</h3>
            <p data-ac-hire-pane-body>{service.body}</p>
            <p data-ac-hire-sub class="mono-label">{workLabel}</p>
            <ul data-ac-hire-chips role="list">
              {service.work.map((item) => <li>{item}</li>)}
            </ul>
            <p data-ac-hire-sub class="mono-label">{toolsLabel}</p>
            <ul data-ac-hire-chips data-variant="outline" role="list">
              {service.tools.map((item) => <li>{item}</li>)}
            </ul>
          </article>
        ))}
      </div>
    </div>
  </div>
</section>

<script>
  import { toggleInView } from "@pg/page33/lib/in-view";

  document.querySelectorAll<HTMLElement>('[data-ac-hire="services"]').forEach(toggleInView);
</script>
