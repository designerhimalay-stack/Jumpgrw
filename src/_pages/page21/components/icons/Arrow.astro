---
import type { HeroCta } from "@pg/page21/types/hero";

interface Props {
  direction: HeroCta["arrow"];
}

const { direction } = Astro.props;
---

<svg width="15" height="15" viewBox="0 0 16 16" fill="none" aria-hidden="true" class="shrink-0">
  <path
    d={direction === "diagonal"
      ? "M4.5 11.5L11.5 4.5M11.5 4.5H5.5M11.5 4.5V10.5"
      : "M3 8H13M13 8L9 4M13 8L9 12"}
    stroke="currentColor"
    stroke-width="1.6"
    stroke-linecap="round"
    stroke-linejoin="round"
  />
</svg>
