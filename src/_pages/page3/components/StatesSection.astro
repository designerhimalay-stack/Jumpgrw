---
import GridRules from "@pg/page3/components/GridRules.astro";
import SectionHead from "@pg/page3/components/SectionHead.astro";
import Joints from "@pg/page3/components/process/Joints.astro";

/* Prototype against production, drawn. A strip across the top shows what a
   prototype shows: one happy screen. Under it, one card per column for the
   states production has to handle, each a small browser window drawn in
   CSS in that state (a shimmering loading skeleton, a field with an error,
   a code prompt, the same view on three screen sizes). The handoff runs
   along the foot of the frame. No images. */

interface Props {
  id: string;
  eyebrow: string;
  headline: string[];
  accent?: number;
  lede: string;
  prototype: { label: string; note: string; tag: string };
  states: { label: string; note: string }[];
  handoffLabel: string;
  handoff: { title: string; note: string }[];
}

const { id, eyebrow, headline, accent, lede, prototype, states, handoffLabel, handoff } = Astro.props;
const kinds = ["loading", "error", "auth", "devices"] as const;
const pad = (n: number) => String(n).padStart(2, "0");
---

<section data-ac-sec="light" data-ac-states id={id}>
  <GridRules />

  <div data-ac-sec-container>
    <SectionHead eyebrow={eyebrow} headline={headline} accent={accent} lede={lede} />

    <div data-ac-sec-frame data-ac-states-frame>
      <Joints />

      <div data-ac-states-proto>
        <div data-ac-states-window data-kind="happy" aria-hidden="true">
          <span data-ac-states-chrome><i /><i /><i /></span>
          <span data-ac-states-screen>
            <i data-bar="title" /><i data-bar /><i data-bar="short" /><i data-bar="button" />
          </span>
        </div>
        <div data-ac-states-proto-copy>
          <p class="mono-label">{prototype.label}</p>
          <p data-ac-states-proto-note>{prototype.note}</p>
        </div>
        <p data-ac-states-tag class="mono-label-sm">{prototype.tag}</p>
      </div>

      <ul data-ac-states-grid>
        {states.map((state, i) => (
          <li data-ac-states-tile style={`--ac-i:${i}`}>
            <div data-ac-states-window data-kind={kinds[i]} aria-hidden="true">
              <span data-ac-states-chrome><i /><i /><i /></span>
              <span data-ac-states-screen>
                {kinds[i] === "loading" && (
                  <Fragment><i data-bar="title" /><i data-bar /><i data-bar /><i data-bar="short" /></Fragment>
                )}
                {kinds[i] === "error" && (
                  <Fragment><i data-bar="title" /><i data-field /><i data-message /><i data-bar="button" /></Fragment>
                )}
                {kinds[i] === "auth" && (
                  <Fragment><i data-lock /><span data-code><i /><i /><i /><i /></span></Fragment>
                )}
                {kinds[i] === "devices" && (
                  <Fragment><i data-device="desk" /><i data-device="tab" /><i data-device="phone" /></Fragment>
                )}
              </span>
            </div>
            <p data-ac-states-num class="mono-label">{pad(i + 1)}</p>
            <p data-ac-states-label>{state.label}</p>
            <p data-ac-states-note>{state.note}</p>
          </li>
        ))}
      </ul>

      <div data-ac-states-handoff>
        <p class="mono-label">{handoffLabel}</p>
        <ol>
          {handoff.map((step, i) => (
            <li style={`--ac-i:${i}`}>
              <span data-ac-states-step>{step.title}</span>
              <span data-ac-states-step-note>{step.note}</span>
            </li>
          ))}
        </ol>
      </div>
    </div>
  </div>
</section>

<script>
  import { toggleInView } from "@pg/page3/lib/in-view";

  document.querySelectorAll<HTMLElement>("[data-ac-states]").forEach(toggleInView);
</script>
