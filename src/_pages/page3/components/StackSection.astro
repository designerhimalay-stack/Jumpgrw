---
import GridRules from "@pg/page3/components/GridRules.astro";
import SectionHead from "@pg/page3/components/SectionHead.astro";
import Joints from "@pg/page3/components/process/Joints.astro";
import { LINE_ICONS } from "@pg/page3/lib/line-icons";
import type { ArchLayer, ArchRequirement } from "@pg/page3/types/page";

/* The architecture mapper, as a stack diagram and a console. Columns 1–3:
   the target stack drawn top to bottom as connected layers, each with its
   base and one capability tag per requirement. Column 4: a dark console
   with a switch per requirement. A tag is always drawn, dashed while its
   requirement is off and filled when it is on, so the diagram never
   changes height. See docs/sections.md. */

interface Props {
  id: string;
  eyebrow: string;
  headline: string[];
  accent?: number;
  lede: string;
  label: string;
  requirements: ArchRequirement[];
  layers: ArchLayer[];
}

const { id, eyebrow, headline, accent, lede, label, requirements, layers } = Astro.props;
const pad = (n: number) => String(n).padStart(2, "0");
---

<section data-ac-sec="light" data-ac-stack id={id}>
  <GridRules />

  <div data-ac-sec-container>
    <SectionHead eyebrow={eyebrow} headline={headline} accent={accent} lede={lede} />

    <div data-ac-stack-grid>
      <ol data-ac-stack-diagram>
        {layers.map((layer, i) => (
          <li data-ac-stack-layer style={`--ac-i:${i}`}>
            <Joints />
            <span data-ac-stack-meta>
              <span class="mono-label">Layer {pad(i + 1)}</span>
              <span data-ac-stack-title>{layer.title}</span>
              <span data-ac-stack-base>{layer.base}</span>
            </span>
            <ul data-ac-stack-tags aria-label={`${layer.title} additions`}>
              {layer.additions.map((addition, r) => (
                <li data-ac-stack-tag data-req={r}>
                  <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 5v14M5 12h14" /></svg>
                  {addition}
                </li>
              ))}
            </ul>
          </li>
        ))}
      </ol>

      <fieldset data-ac-stack-console>
        <legend class="mono-label">{label}</legend>
        {requirements.map((req) => (
          <label data-ac-stack-switch>
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" set:html={LINE_ICONS[req.icon]} />
            <span>{req.label}</span>
            <input type="checkbox" role="switch" data-ac-stack-input />
            <span data-ac-stack-track aria-hidden="true"><i /></span>
          </label>
        ))}
        <p data-ac-stack-count aria-live="polite">
          <span class="mono-label">Base stack</span>
          <span data-ac-stack-added>+ 0</span>
        </p>
      </fieldset>
    </div>
  </div>
</section>

<script>
  import { toggleInView } from "@pg/page3/lib/in-view";

  document.querySelectorAll<HTMLElement>("[data-ac-stack]").forEach((section) => {
    toggleInView(section);

    const inputs = Array.from(section.querySelectorAll<HTMLInputElement>("[data-ac-stack-input]"));
    const tags = Array.from(section.querySelectorAll<HTMLElement>("[data-ac-stack-tag]"));
    const added = section.querySelector<HTMLElement>("[data-ac-stack-added]")!;

    const update = () => {
      const on = inputs.map((input) => input.checked);
      tags.forEach((tag) => tag.toggleAttribute("data-on", on[Number(tag.dataset.req)]));
      added.textContent = `+ ${on.filter(Boolean).length}`;
    };

    inputs.forEach((input) => input.addEventListener("change", update));
    update();
  });
</script>
