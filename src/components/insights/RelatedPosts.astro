---
import { Image } from "astro:assets";
import GridRules from "@pg/page30/components/GridRules.astro";
import SectionHead from "@pg/page30/components/SectionHead.astro";
import Joints from "@pg/page30/components/process/Joints.astro";
import { withBase } from "@/lib/paths";
import type { BlogPost } from "@/lib/insights";

/* Up to three articles in a ruled frame: cover, topic, title and a link, the
   same card shape as the blog index. Under an article it offers more from the
   team; on a white paper or event page it offers reading on the same topic.
   "tint" (the default) or "light", so the page's bands keep alternating. */

interface Props {
  posts: BlogPost[];
  eyebrow?: string;
  headline?: string[];
  tone?: "tint" | "light";
}

const { posts, eyebrow = "Keep reading", headline = ["More from", "the team."], tone = "tint" } = Astro.props;
const ARROW = '<path d="M4.5 11.5L11.5 4.5M11.5 4.5H5.5M11.5 4.5V10.5" />';
---

<section data-ac-sec="light" data-ac-hire-tint={tone === "tint" || undefined} data-ac-related>
  <GridRules />
  <div data-ac-sec-container>
    <SectionHead eyebrow={eyebrow} headline={headline} accent={headline.length - 1} />
    <div data-ac-sec-frame>
      <Joints />
      <ul data-ac-related-grid role="list" style={`--cols:${Math.min(Math.max(posts.length, 1), 3)}`}>
        {posts.map((post) => (
          <li data-ac-related-item>
            <a href={withBase(`/blog/${post.slug}/`)} data-ac-related-link>
              <div data-ac-related-cover>
                <Image src={post.cover} alt="" widths={[400, 640]} sizes="(max-width: 809px) 92vw, 30vw" quality={78} loading="lazy" />
              </div>
              <span class="mono-label" data-ac-related-topic>{post.category}</span>
              <h3 data-ac-related-title>{post.title}</h3>
              <span class="mono-label" data-ac-related-read>
                Read article
                <svg width="11" height="11" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" set:html={ARROW} />
              </span>
            </a>
          </li>
        ))}
      </ul>
    </div>
  </div>
</section>

<style>
  [data-ac-related-grid] {
    display: grid;
    grid-template-columns: repeat(var(--cols, 3), minmax(0, 1fr));
    margin: 0;
    padding: 0;
    list-style: none;
    background: #ffffff;
  }

  [data-ac-related-item] {
    border-right: 1px solid var(--ac-line);
  }

  [data-ac-related-item]:last-child {
    border-right: 0;
  }

  [data-ac-related-link] {
    display: flex;
    flex-direction: column;
    height: 100%;
    padding: clamp(12px, 1.2vw, 16px) clamp(12px, 1.2vw, 16px) clamp(20px, 2vw, 26px);
    color: inherit;
    text-decoration: none;
    transition: background-color 0.3s ease;
  }

  [data-ac-related-link]:hover {
    background: color-mix(in srgb, var(--color-accent) 4%, #ffffff);
  }

  [data-ac-related-link]:focus-visible {
    outline: 2px solid var(--color-accent);
    outline-offset: -2px;
  }

  [data-ac-related-cover] {
    aspect-ratio: 16 / 9;
    margin-bottom: 16px;
    border-radius: 10px;
    overflow: clip;
    background: #eef1f7;
  }

  [data-ac-related-cover] img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  [data-ac-related-topic] {
    margin: 0 4px 10px;
    color: var(--color-accent);
  }

  [data-ac-related-title] {
    margin: 0 4px 16px;
    font-family: var(--font-display-stack);
    font-size: clamp(17px, 1.3vw, 20px);
    font-weight: 400;
    line-height: 1.28;
    letter-spacing: -0.01em;
    color: #0a1022;
  }

  [data-ac-related-read] {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    margin: auto 4px 0;
    color: #0a1022;
  }

  [data-ac-related-link]:hover [data-ac-related-read] {
    color: var(--color-accent);
  }

  @media (max-width: 809px) {
    [data-ac-related-grid] {
      grid-template-columns: 1fr;
    }

    [data-ac-related-item] {
      border-right: 0;
      border-bottom: 1px solid var(--ac-line);
    }

    [data-ac-related-item]:last-child {
      border-bottom: 0;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    [data-ac-related-link] {
      transition: none;
    }
  }
</style>

<script>
  import { toggleInView } from "@pg/page30/lib/in-view";

  document.querySelectorAll<HTMLElement>("[data-ac-related]").forEach(toggleInView);
</script>
