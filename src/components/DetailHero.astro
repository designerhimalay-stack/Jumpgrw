---
import { Image } from "astro:assets";
import type { ImageMetadata } from "astro";
import Arrow from "@pg/page30/components/icons/Arrow.astro";
import GridRules from "@pg/page30/components/GridRules.astro";
import Joints from "@pg/page30/components/process/Joints.astro";

/* The opening of a detail page (one article, one case study): the same navy
   field, breadcrumb, framed picture and navbar hand-over as the subpage hero,
   with room for a long title. Copy on the left: breadcrumb, chips, title, a
   short lede, a row of facts and the buttons. On the right, the picture in
   its frame, reserved at a fixed shape so nothing moves when it loads.
   `fit: "contain"` sets a transparent device render on a lifted panel instead
   of cropping a photo. Phones stack the copy over the picture. */

interface Action {
  label: string;
  href: string;
  external?: boolean;
  arrow?: "right" | "diagonal";
}

interface Props {
  trail: string[];
  title: string;
  /** "name" is for a short product name, "title" for a full article headline. */
  size?: "name" | "title";
  chips?: string[];
  lede?: string;
  facts?: { label: string; value: string }[];
  actions?: Action[];
  image: ImageMetadata;
  imageAlt: string;
  fit?: "cover" | "contain";
}

const { trail, title, size = "title", chips = [], lede, facts = [], actions = [], image, imageAlt, fit = "cover" } = Astro.props;
---

<section data-ac-sec="dark" data-ac-dhero data-size={size} data-fit={fit}>
  <GridRules />
  <div data-ac-sec-container data-ac-dhero-grid>
    <div data-ac-dhero-copy>
      <nav data-ac-dhero-trail class="mono-label" aria-label="Breadcrumb">
        <span aria-hidden="true">+</span>
        <ol>
          {trail.map((step, i) => (
            <li aria-current={i === trail.length - 1 ? "page" : undefined}>{step}</li>
          ))}
        </ol>
      </nav>

      {chips.length > 0 && (
        <ul data-ac-dhero-chips role="list">
          {chips.map((chip) => <li class="mono-label">{chip}</li>)}
        </ul>
      )}

      <h1 data-ac-dhero-title>{title}</h1>
      {lede && <p data-ac-dhero-lede>{lede}</p>}

      {facts.length > 0 && (
        <dl data-ac-dhero-facts>
          {facts.map((fact) => (
            <div>
              <dt class="mono-label">{fact.label}</dt>
              <dd>{fact.value}</dd>
            </div>
          ))}
        </dl>
      )}

      {actions.length > 0 && (
        <div data-ac-dhero-actions>
          {actions.map((action, i) => (
            <a
              href={action.href}
              data-ac-dhero-action={i === 0 ? "primary" : "ghost"}
              class="mono-label"
              target={action.external ? "_blank" : undefined}
              rel={action.external ? "noopener" : undefined}
            >
              {action.label}
              <Arrow direction={action.arrow ?? "right"} />
            </a>
          ))}
        </div>
      )}
    </div>

    <div data-ac-dhero-media>
      <Joints />
      <div data-ac-dhero-photo>
        <Image
          src={image}
          alt={imageAlt}
          widths={[480, 800, Math.min(image.width, 1200)]}
          sizes="(max-width: 991px) 100vw, 45vw"
          quality={82}
          loading="eager"
          fetchpriority="high"
        />
      </div>
    </div>
  </div>
</section>

<style>
  [data-ac-dhero][data-ac-sec] {
    --ac-nav-h: 108px;
    padding-top: calc(var(--ac-nav-h) + clamp(32px, 6vh, 72px));
    padding-bottom: clamp(48px, 8vh, 96px);
    background:
      radial-gradient(55% 65% at 88% 18%, rgb(80 122 247 / 0.2), transparent 70%),
      linear-gradient(180deg, #000715 0%, #071127 34%, #0d1c41 74%, #132658 100%);
    overflow: clip;
  }

  [data-ac-dhero-grid] {
    display: grid;
    grid-template-columns: repeat(12, minmax(0, 1fr));
    column-gap: clamp(20px, 2.4vw, 40px);
    align-items: center;
  }

  [data-ac-dhero-copy] {
    grid-column: 1 / 8;
    min-width: 0;
  }

  [data-ac-dhero-trail] {
    display: flex;
    align-items: center;
    gap: 10px;
    margin: 0 0 clamp(18px, 3vh, 28px);
    color: var(--sec-muted);
  }

  [data-ac-dhero-trail] > span {
    color: var(--color-accent);
  }

  [data-ac-dhero-trail] ol {
    display: flex;
    flex-wrap: wrap;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  [data-ac-dhero-trail] li + li::before {
    content: "/";
    margin: 0 8px;
    color: rgb(255 255 255 / 0.3);
  }

  [data-ac-dhero-trail] li[aria-current] {
    color: #ffffff;
  }

  [data-ac-dhero-chips] {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    margin: 0 0 clamp(16px, 2.4vh, 24px);
    padding: 0;
    list-style: none;
  }

  [data-ac-dhero-chips] li {
    padding: 6px 12px;
    border: 1px solid rgb(255 255 255 / 0.24);
    border-radius: 999px;
    color: rgb(255 255 255 / 0.86);
  }

  [data-ac-dhero-chips] li:first-child {
    border-color: var(--color-accent);
    background: var(--color-accent);
    color: #ffffff;
  }

  [data-ac-dhero-title] {
    margin: 0;
    font-family: var(--font-display-stack);
    font-weight: var(--display-weight);
    color: #ffffff;
    text-wrap: balance;
  }

  [data-size="title"] [data-ac-dhero-title] {
    font-size: clamp(30px, 3.7vw, 56px);
    line-height: 1.08;
    letter-spacing: -0.025em;
  }

  [data-size="name"] [data-ac-dhero-title] {
    font-size: clamp(52px, 8vw, 116px);
    line-height: 1;
    letter-spacing: -0.03em;
  }

  [data-ac-dhero-lede] {
    max-width: 52ch;
    margin: clamp(16px, 2.4vh, 24px) 0 0;
    font-size: clamp(16px, 1.3vw, 19px);
    line-height: 1.5;
    color: var(--sec-soft);
  }

  [data-ac-dhero-facts] {
    display: flex;
    flex-wrap: wrap;
    gap: 18px clamp(24px, 3vw, 44px);
    margin: clamp(22px, 3.4vh, 34px) 0 0;
    padding-top: clamp(18px, 2.4vh, 24px);
    border-top: 1px solid var(--ac-line);
  }

  [data-ac-dhero-facts] dt {
    margin: 0 0 6px;
    color: var(--sec-muted);
  }

  [data-ac-dhero-facts] dd {
    margin: 0;
    font-size: 16px;
    font-weight: 500;
    color: #ffffff;
  }

  [data-ac-dhero-actions] {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
    margin-top: clamp(22px, 3.4vh, 34px);
  }

  [data-ac-dhero-action] {
    display: inline-flex;
    align-items: center;
    gap: 9px;
    min-height: 46px;
    padding: 0 22px;
    color: #ffffff;
    text-decoration: none;
    transition:
      background-color 200ms ease,
      border-color 200ms ease;
  }

  [data-ac-dhero-action="primary"] {
    background: var(--color-accent);
  }

  [data-ac-dhero-action="primary"]:hover {
    background: var(--color-accent-dark);
  }

  [data-ac-dhero-action="ghost"] {
    border: 1px solid rgb(255 255 255 / 0.28);
  }

  [data-ac-dhero-action="ghost"]:hover {
    border-color: #ffffff;
    background: rgb(255 255 255 / 0.06);
  }

  [data-ac-dhero-action]:focus-visible {
    outline: 2px solid #ffffff;
    outline-offset: 3px;
  }

  [data-ac-dhero-media] {
    position: relative;
    grid-column: 8 / 13;
    aspect-ratio: 4 / 3;
    padding: 10px;
    border: 1.5px solid var(--ac-line);
  }

  [data-ac-dhero-media] > [data-ac-joints] i {
    display: block;
  }

  /* The picture opens upward from its floor when the hero arrives. */
  [data-ac-dhero-photo] {
    position: absolute;
    inset: 10px;
    overflow: hidden;
    background: #0a1022;
    clip-path: inset(100% 0 0 0);
    transition: clip-path 1.2s cubic-bezier(0.65, 0, 0.35, 1) 150ms;
  }

  [data-ac-dhero][data-ac-in] [data-ac-dhero-photo] {
    clip-path: inset(0 0 0 0);
  }

  [data-ac-dhero-photo] img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  /* A device render: contained on the plain navy field, with one soft glow
     lifting it off the ground. Kept minimal, like the other heroes' photos. */
  [data-fit="contain"] [data-ac-dhero-photo] {
    background:
      radial-gradient(58% 58% at 50% 44%, rgb(80 122 247 / 0.26), transparent 72%),
      #0a1630;
  }

  [data-fit="contain"] [data-ac-dhero-photo] img {
    padding: clamp(10px, 1.4vw, 20px);
    object-fit: contain;
    filter: drop-shadow(0 24px 32px rgb(0 0 0 / 0.4));
  }

  /* Phones: open the same distance below the navbar as every other page. */
  @media (max-width: 767px) {
    [data-ac-dhero][data-ac-sec] {
      padding-top: var(--ac-hero-top, 92px);
    }
  }

  @media (max-width: 991px) {
    [data-ac-dhero-grid] {
      grid-template-columns: 1fr;
      row-gap: clamp(28px, 5vh, 44px);
    }

    [data-ac-dhero-copy],
    [data-ac-dhero-media] {
      grid-column: 1;
    }

    [data-ac-dhero-media] {
      aspect-ratio: 16 / 10;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    [data-ac-dhero-photo] {
      clip-path: none;
      transition: none;
    }

    [data-ac-dhero-action] {
      transition: none;
    }
  }
</style>

<script>
  import { toggleInView } from "@pg/page30/lib/in-view";
  import { followHero } from "@/lib/nav-tone";

  const hero = document.querySelector<HTMLElement>("[data-ac-dhero]")!;
  toggleInView(hero);
  followHero(hero);
</script>
