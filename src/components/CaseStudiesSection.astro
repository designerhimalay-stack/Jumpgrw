---
import Arrow from "@/components/icons/Arrow.astro";
import GridRules from "@/components/GridRules.astro";
import SectionHead from "@/components/SectionHead.astro";
import Joints from "@/components/process/Joints.astro";
import gunlox from "@/assets/cases/gunlox.jpg";
import loanMantra from "@/assets/cases/loan-mantra.jpg";
import vowtimer from "@/assets/cases/vowtimer.jpg";
import greenaider from "@/assets/cases/greenaider.jpg";
import gunloxVideo from "@/assets/cases/gunlox.webm?url";
import loanMantraVideo from "@/assets/cases/loan-mantra.webm?url";
import vowtimerVideo from "@/assets/cases/vowtimer.webm?url";
import greenaiderVideo from "@/assets/cases/greenaider.webm?url";
import { withBase } from "@/lib/paths";

/* "Proof is in the product." The page's dark section. The project list opens
   one project at a time; the open project's product video plays in the square
   panel on the right, and when it ends the next project opens. The ring on the
   open project mirrors that video's progress. See docs/components/case-studies.md.

   Summaries and stacks are the company's own (src/lib/projects.ts). Each
   project links to its card on the Case Studies page. Each video's poster is
   its own .jpg. */

const CASES = [
  {
    slug: "gunlox",
    name: "GunLox",
    tag: "Connected security",
    summary:
      "An easy-to-use companion app for managing authorized users, monitoring access attempts, and receiving timely notifications.",
    stack: ["Node.js", "React Native", "Nginx", "MongoDB"],
    image: gunlox,
    video: gunloxVideo,
  },
  {
    slug: "loan-mantra",
    name: "Loan Mantra",
    tag: "Fintech",
    summary:
      "Expert advisory and the BLUE™ lending platform, delivering tailored financing, from strategic advice to SBA loans, for small and middle-market businesses.",
    stack: [".NET", "Azure", "MS SQL Server"],
    image: loanMantra,
    video: loanMantraVideo,
  },
  {
    slug: "vowtimer",
    name: "VowTimer",
    tag: "Weddings",
    summary:
      "An app for wedding guests to connect before the ceremony and bet on how long it will take.",
    stack: ["Node.js", "React Native", "Angular", "MongoDB"],
    image: vowtimer,
    video: vowtimerVideo,
  },
  {
    slug: "greenaider",
    name: "Greenaider",
    tag: "Sustainability",
    summary:
      "A footprint calculator for people and organizations to measure, track and reduce their carbon footprint, with goals and green challenges.",
    stack: ["Node.js", "React Native", "Angular", "MongoDB"],
    image: greenaider,
    video: greenaiderVideo,
  },
];

const pad = (n: number) => String(n).padStart(2, "0");
---

<section data-ac-sec="dark" data-ac-cases id="case-studies">
  <GridRules />

  <div data-ac-sec-container>
    <SectionHead eyebrow={`Selected case studies / ${pad(CASES.length)}`} headline={["Proof is in", "the product."]} accent={1} />

    <div data-ac-sec-frame data-ac-cases-frame>
      <div data-ac-cases-cell="list">
        <Joints />
        <ol data-ac-cases-list>
          {CASES.map((item, i) => (
            <li data-ac-case data-active={i === 0 || undefined}>
              <h3 data-ac-case-head>
                <button
                  type="button"
                  data-ac-case-trigger
                  id={`case-${item.slug}-trigger`}
                  aria-expanded={i === 0 ? "true" : "false"}
                  aria-controls={`case-${item.slug}`}
                >
                  <span data-ac-case-number>{pad(i + 1)}</span>
                  <span data-ac-case-name>{item.name}</span>
                  <span data-ac-case-mark aria-hidden="true">
                    <svg data-ac-case-arrow width="16" height="16" viewBox="0 0 16 16" fill="none">
                      <path d="M4.5 11.5L11.5 4.5M11.5 4.5H5.5M11.5 4.5V10.5" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" />
                    </svg>
                    <svg data-ac-case-ring width="26" height="26" viewBox="0 0 26 26">
                      <circle cx="13" cy="13" r="11" />
                      <circle data-ac-case-progress cx="13" cy="13" r="11" pathLength="100" />
                    </svg>
                  </span>
                </button>
              </h3>
              <div
                data-ac-case-details
                id={`case-${item.slug}`}
                role="region"
                aria-labelledby={`case-${item.slug}-trigger`}
                inert={i !== 0}
              >
                <div data-ac-case-details-inner>
                  <p data-ac-case-summary>{item.summary}</p>
                  <p data-ac-case-stack class="mono-label">{item.stack.join(" · ")}</p>
                  <a data-ac-case-link class="mono-label" href={withBase(`/case-studies/#${item.slug}`)}>
                    View case study
                    <Arrow direction="diagonal" />
                  </a>
                </div>
              </div>
            </li>
          ))}
        </ol>
      </div>

      <div data-ac-cases-cell="media">
        <Joints />
        <div data-ac-cases-media aria-hidden="true">
          {CASES.map((item, i) => (
            <figure data-ac-case-media data-active={i === 0 || undefined}>
              <video
                data-ac-case-video
                src={item.video}
                poster={item.image.src}
                muted
                playsinline
                preload="metadata"
                width="630"
                height="630"
              ></video>
              <span data-ac-case-chip class="mono-label">{item.tag}</span>
            </figure>
          ))}
          <p data-ac-cases-count class="mono-label">
            <span data-ac-cases-current>01</span> / {pad(CASES.length)}
          </p>
        </div>
      </div>
    </div>
  </div>
</section>

<script>
  import { holdOnKeyboardFocus } from "@/lib/rotation";

  const section = document.querySelector<HTMLElement>("[data-ac-cases]")!;
  const frame = section.querySelector<HTMLElement>("[data-ac-cases-frame]")!;
  const list = section.querySelector<HTMLElement>("[data-ac-cases-list]")!;
  const items = Array.from(section.querySelectorAll<HTMLElement>("[data-ac-case]"));
  const media = Array.from(section.querySelectorAll<HTMLElement>("[data-ac-case-media]"));
  /* The videos sit in the media cell and the rings in the list, two separate
     subtrees, but both are in project order, so index i lines up across all
     three arrays. */
  const videos = media.map((figure) => figure.querySelector<HTMLVideoElement>("[data-ac-case-video]"));
  const rings = items.map((item) => item.querySelector<SVGCircleElement>("[data-ac-case-progress]"));
  const current = section.querySelector<HTMLElement>("[data-ac-cases-current]")!;

  const reduceMotion = window.matchMedia("(prefers-reduced-motion: reduce)");
  let active = 0;
  let inView = false;
  let held = false;

  /* The ring is drawn with pathLength 100 (dasharray 100). Offset 100 is empty,
     0 is a full ring, so a fraction p of the way through maps to 100 * (1 - p). */
  const setRing = (index: number, fraction: number) => {
    const ring = rings[index];
    if (ring) ring.style.strokeDashoffset = String(100 * (1 - Math.min(1, Math.max(0, fraction))));
  };

  const canPlay = () => !reduceMotion.matches && inView && !held;

  const playActive = () => {
    const video = videos[active];
    if (video && canPlay()) void video.play().catch(() => {});
  };

  const show = (index: number) => {
    active = (index + items.length) % items.length;
    items.forEach((item, i) => {
      const open = i === active;
      item.toggleAttribute("data-active", open);
      item.querySelector("[data-ac-case-trigger]")!.setAttribute("aria-expanded", String(open));
      item.querySelector<HTMLElement>("[data-ac-case-details]")!.inert = !open;
    });
    media.forEach((figure, i) => figure.toggleAttribute("data-active", i === active));
    current.textContent = String(active + 1).padStart(2, "0");

    /* Every video starts from its first frame; only the open one plays, and the
       rings reset to empty so the open one fills as its video plays. */
    videos.forEach((video, i) => {
      if (!video) return;
      video.pause();
      if (video.currentTime !== 0) video.currentTime = 0;
      setRing(i, 0);
    });
    playActive();
  };

  /* The open project's video is the timer: its progress drives the ring, and
     when it ends the next project opens. Choosing a project switches to it and
     its video plays from the start. Playback holds while the section is off
     screen or under keyboard focus; under reduced motion nothing plays and the
     poster frame stays. */
  videos.forEach((video, i) => {
    if (!video) return;
    video.addEventListener("timeupdate", () => {
      if (i === active && video.duration) setRing(i, video.currentTime / video.duration);
    });
    video.addEventListener("ended", () => {
      if (i === active) show(active + 1);
    });
  });

  /* Every project's details open to the height of the tallest, so the list
     keeps one height as it advances and nothing below it moves. */
  const measure = () => {
    const tallest = Math.max(
      ...items.map((item) => item.querySelector<HTMLElement>("[data-ac-case-details-inner]")!.scrollHeight),
    );
    list.style.setProperty("--ac-case-details-h", `${tallest}px`);
  };
  measure();
  new ResizeObserver(measure).observe(frame);
  document.fonts?.ready.then(measure);

  items.forEach((item, i) => {
    item.querySelector("[data-ac-case-trigger]")!.addEventListener("click", () => show(i));
  });

  /* Reversible entrance (data-ac-in), plus play/pause as the section enters and
     leaves the viewport — the same band every rotating section uses. */
  new IntersectionObserver(
    ([entry]) => {
      inView = entry.isIntersecting;
      section.toggleAttribute("data-ac-in", inView);
      if (inView) playActive();
      else videos.forEach((video) => video?.pause());
    },
    { threshold: 0, rootMargin: "-10% 0px -10% 0px" },
  ).observe(section);

  holdOnKeyboardFocus(section, frame, (on) => {
    held = on;
    if (on) videos.forEach((video) => video?.pause());
    else playActive();
  });

  reduceMotion.addEventListener("change", () => {
    if (reduceMotion.matches) videos.forEach((video) => video?.pause());
    else playActive();
  });
</script>
