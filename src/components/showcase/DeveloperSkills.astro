---
/* A role card with its skills branching off it on a dotted trunk. Laid out on
   a 476 × 410 canvas: every position below is in those units and is
   turned into a percentage, and every size is a multiple of --u (one canvas
   unit, 100cqw / 476), so the whole drawing scales with its card. */

const W = 476;
const H = 410;

const HEAD = { x: 44, y: 27, w: 388, h: 56 };
const TILE = 30.7;
const TILE_INSET = 13.4;
const SKILL = { x: 106.6, w: 325.4, h: 46, first: 105, step: 58 };
/* The trunk drops from the centre of the header's icon tile and turns into
   each skill card at its mid-height through a quarter circle. */
const TRUNK_X = HEAD.x + TILE_INSET + TILE / 2;
const ELBOW = 12;

type Icon = "frontend" | "backend" | "devops" | "databases" | "cloud";
const SKILLS: { label: string; icon: Icon }[] = [
  { label: "Frontend", icon: "frontend" },
  { label: "Backend", icon: "backend" },
  { label: "DevOps", icon: "devops" },
  { label: "Databases", icon: "databases" },
  { label: "Cloud", icon: "cloud" },
];

const pct = (value: number, total: number) => `${+((value / total) * 100).toFixed(4)}%`;
const box = (x: number, y: number, w: number, h: number) =>
  `left:${pct(x, W)};top:${pct(y, H)};width:${pct(w, W)};height:${pct(h, H)}`;

const mids = SKILLS.map((_, i) => SKILL.first + i * SKILL.step + SKILL.h / 2);
const last = mids.at(-1)!;
const elbow = (mid: number) =>
  `M ${TRUNK_X} ${mid - ELBOW} Q ${TRUNK_X} ${mid} ${TRUNK_X + ELBOW} ${mid} H ${SKILL.x}`;
const trunk = `M ${TRUNK_X} ${HEAD.y + HEAD.h} V ${last - ELBOW}`;
---

<div data-ac-dev>
  <svg data-ac-dev-lines viewBox={`0 0 ${W} ${H}`} aria-hidden="true">
    <path d={trunk} />
    {mids.map((mid) => <path d={elbow(mid)} />)}
  </svg>

  <div data-ac-dev-head style={box(HEAD.x, HEAD.y, HEAD.w, HEAD.h)}>
    <span data-ac-dev-tile aria-hidden="true">
      <svg viewBox="0 0 24 24">
        <polyline points="16 18 22 12 16 6" />
        <polyline points="8 6 2 12 8 18" />
      </svg>
    </span>
    <span data-ac-dev-label>Developer</span>
  </div>

  <ul data-ac-dev-skills aria-label="Developer skills">
    {SKILLS.map((skill, i) => (
      <li data-ac-dev-skill style={box(SKILL.x, SKILL.first + i * SKILL.step, SKILL.w, SKILL.h)}>
        <svg data-ac-dev-icon viewBox="0 0 24 24" aria-hidden="true">
          {skill.icon === "frontend" && (
            <>
              <rect x="2" y="4" width="20" height="16" rx="2" />
              <path d="M2 9h20" />
              <path d="M6 6.5h.01M9 6.5h.01" />
            </>
          )}
          {skill.icon === "backend" && (
            <>
              <rect x="2" y="3" width="20" height="8" rx="2" />
              <rect x="2" y="13" width="20" height="8" rx="2" />
              <path d="M6 7h.01M6 17h.01" />
            </>
          )}
          {skill.icon === "devops" && (
            <path d="M12 12c-2-2.67-4-4-6-4a4 4 0 1 0 0 8c2 0 4-1.33 6-4Zm0 0c2 2.67 4 4 6 4a4 4 0 0 0 0-8c-2 0-4 1.33-6 4Z" />
          )}
          {skill.icon === "databases" && (
            <>
              <ellipse cx="12" cy="5" rx="9" ry="3" />
              <path d="M3 5v14a9 3 0 0 0 18 0V5" />
              <path d="M3 12a9 3 0 0 0 18 0" />
            </>
          )}
          {skill.icon === "cloud" && <path d="M17.5 19H9a7 7 0 1 1 6.71-9h1.79a4.5 4.5 0 1 1 0 9Z" />}
        </svg>
        <span data-ac-dev-label>{skill.label}</span>
        <span data-ac-dev-check aria-hidden="true">
          <svg viewBox="0 0 24 24"><path d="M20 6 9 17l-5-5" /></svg>
        </span>
      </li>
    ))}
  </ul>
</div>
