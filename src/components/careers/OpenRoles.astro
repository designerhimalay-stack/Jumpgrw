---
import Arrow from "@pg/page30/components/icons/Arrow.astro";
import GridRules from "@pg/page30/components/GridRules.astro";
import SectionHead from "@pg/page30/components/SectionHead.astro";
import Joints from "@pg/page30/components/process/Joints.astro";
import { ROLES, ROLE_AREAS, type Role } from "@/lib/roles";

/* Open roles: a framed list, one row per role. A row shows the title, area,
   locations and experience; opening it (a native <details>, so it works by
   keyboard and without JavaScript) shows the summary, what the person does,
   what they bring and the stack, with a button that jumps to the application
   form and pre-selects the role's area. The filter chips above hide rows by
   area; with JavaScript off every role simply stays visible. The rows are
   closed on load and only a click opens one, so nothing moves by itself. */

interface Props {
  id?: string;
  eyebrow: string;
  headline: string[];
  lede?: string;
  /** The form the apply buttons jump to. */
  applyHref?: string;
  roles?: Role[];
}

const { id = "roles", eyebrow, headline, lede, applyHref = "#apply", roles = ROLES } = Astro.props;
const areas = ROLE_AREAS.filter((area) => roles.some((role) => role.area === area));
const pad = (n: number) => String(n).padStart(2, "0");
---

<section data-ac-sec="light" data-ac-roles id={id}>
  <GridRules />
  <div data-ac-sec-container>
    <SectionHead eyebrow={eyebrow} headline={headline} accent={headline.length - 1} lede={lede} />

    <div data-ac-roles-bar data-ac-sec-rise>
      <div data-ac-roles-filters role="group" aria-label="Filter roles by area">
        <button type="button" data-ac-roles-chip="all" aria-pressed="true" class="mono-label">All roles</button>
        {areas.map((area) => (
          <button type="button" data-ac-roles-chip={area} aria-pressed="false" class="mono-label">{area}</button>
        ))}
      </div>
      <p data-ac-roles-count class="mono-label" aria-live="polite">
        <span data-ac-roles-n>{roles.length}</span> open roles
      </p>
    </div>

    <div data-ac-sec-frame data-ac-sec-rise>
      <Joints />
      <ul data-ac-roles-list role="list">
        {roles.map((role, i) => (
          <li data-ac-role-item data-area={role.area}>
            <details data-ac-role>
              <summary data-ac-role-head>
                <span data-ac-role-num class="mono-label" aria-hidden="true">{pad(i + 1)}</span>
                <span data-ac-role-title>{role.title}</span>
                <span data-ac-role-area class="mono-label">{role.area}</span>
                <span data-ac-role-where>{role.locations.join(" · ")}</span>
                <span data-ac-role-exp class="mono-label">{role.type} · {role.experience}</span>
                <span data-ac-role-toggle aria-hidden="true">
                  <svg width="14" height="14" viewBox="0 0 16 16" fill="none"><path d="M3 6l5 5 5-5" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" /></svg>
                </span>
              </summary>
              <div data-ac-role-body>
                <p data-ac-role-summary>{role.summary}</p>
                <div data-ac-role-cols>
                  <div>
                    <p data-ac-role-sub class="mono-label">What you’ll do</p>
                    <ul role="list">
                      {role.does.map((line) => <li>{line}</li>)}
                    </ul>
                  </div>
                  <div>
                    <p data-ac-role-sub class="mono-label">What you bring</p>
                    <ul role="list">
                      {role.brings.map((line) => <li>{line}</li>)}
                    </ul>
                  </div>
                </div>
                <div data-ac-role-foot>
                  {role.stack && (
                    <ul data-ac-role-stack role="list" aria-label="Tools">
                      {role.stack.map((tool) => <li class="mono-label">{tool}</li>)}
                    </ul>
                  )}
                  <a data-ac-role-apply data-role={role.title} data-area={role.area} class="mono-label" href={applyHref}>
                    Apply for this role
                    <Arrow direction="right" />
                  </a>
                </div>
              </div>
            </details>
          </li>
        ))}
      </ul>
      <p data-ac-roles-empty hidden>No roles in this area right now. Send your details below and we’ll be in touch.</p>
    </div>

    <p data-ac-roles-note data-ac-sec-rise>
      Don’t see your role? <a href={applyHref}>Send your details</a> and tell us what you do best.
    </p>
  </div>
</section>

<style>
  [data-ac-roles-bar] {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 14px 24px;
    margin-bottom: clamp(16px, 1.6vw, 22px);
  }

  [data-ac-roles-filters] {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
  }

  [data-ac-roles-chip] {
    min-height: 44px;
    padding: 0 16px;
    border: 1px solid var(--ac-line);
    border-radius: 999px;
    background: #fff;
    color: rgb(10 16 34 / 0.7);
    cursor: pointer;
    transition:
      background-color 0.2s ease,
      color 0.2s ease,
      border-color 0.2s ease;
  }

  [data-ac-roles-chip]:hover {
    border-color: var(--color-accent);
    color: var(--color-accent);
  }

  [data-ac-roles-chip][aria-pressed="true"] {
    border-color: var(--color-accent);
    background: var(--color-accent);
    color: #fff;
  }

  [data-ac-roles-chip]:focus-visible,
  [data-ac-role-head]:focus-visible,
  [data-ac-role-apply]:focus-visible,
  [data-ac-roles-note] a:focus-visible {
    outline: 2px solid var(--color-accent);
    outline-offset: 2px;
  }

  [data-ac-roles-count] {
    margin: 0;
    color: rgb(10 16 34 / 0.55);
  }

  [data-ac-roles-list] {
    margin: 0;
    padding: 0;
    list-style: none;
    background: #fff;
  }

  [data-ac-role-item] + [data-ac-role-item] {
    border-top: 1px solid var(--ac-line);
  }

  [data-ac-role-item][hidden] {
    display: none;
  }

  [data-ac-role-head] {
    display: grid;
    grid-template-columns: 36px minmax(0, 2.2fr) minmax(0, 1.2fr) minmax(0, 1.5fr) minmax(0, 1.2fr) 28px;
    align-items: center;
    gap: clamp(12px, 1.6vw, 24px);
    min-height: 44px;
    padding: clamp(18px, 1.8vw, 26px) clamp(18px, 2vw, 28px);
    cursor: pointer;
    list-style: none;
    transition: background-color 0.25s ease;
  }

  [data-ac-role-head]::-webkit-details-marker {
    display: none;
  }

  [data-ac-role-head]:hover {
    background: color-mix(in srgb, var(--color-accent) 4%, #ffffff);
  }

  [data-ac-role-num] {
    color: rgb(10 16 34 / 0.4);
  }

  [data-ac-role-title] {
    font-family: var(--font-display-stack);
    font-size: clamp(18px, 1.5vw, 23px);
    line-height: 1.2;
    letter-spacing: -0.015em;
    color: #0a1022;
  }

  [data-ac-role-area] {
    color: var(--color-accent);
  }

  [data-ac-role-where] {
    font-size: 14px;
    line-height: 1.45;
    color: rgb(10 16 34 / 0.7);
  }

  [data-ac-role-exp] {
    color: rgb(10 16 34 / 0.55);
  }

  [data-ac-role-toggle] {
    display: grid;
    place-items: center;
    width: 28px;
    height: 28px;
    border: 1px solid var(--ac-line);
    border-radius: 50%;
    color: #0a1022;
    transition:
      transform 0.3s ease,
      background-color 0.2s ease,
      color 0.2s ease;
  }

  [data-ac-role][open] [data-ac-role-toggle] {
    transform: rotate(180deg);
    border-color: var(--color-accent);
    background: var(--color-accent);
    color: #fff;
  }

  [data-ac-role-body] {
    padding: 0 clamp(18px, 2vw, 28px) clamp(22px, 2.4vw, 34px);
    padding-left: calc(clamp(18px, 2vw, 28px) + 36px + clamp(12px, 1.6vw, 24px));
  }

  [data-ac-role-summary] {
    margin: 0 0 clamp(18px, 2vw, 26px);
    max-width: 62ch;
    font-size: clamp(15px, 1.15vw, 17px);
    line-height: 1.55;
    color: rgb(10 16 34 / 0.78);
  }

  [data-ac-role-cols] {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: clamp(20px, 3vw, 48px);
  }

  [data-ac-role-sub] {
    margin: 0 0 12px;
    color: var(--color-accent);
  }

  [data-ac-role-cols] ul {
    display: flex;
    flex-direction: column;
    gap: 10px;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  [data-ac-role-cols] li {
    position: relative;
    padding-left: 18px;
    font-size: 14.5px;
    line-height: 1.5;
    color: rgb(10 16 34 / 0.72);
  }

  [data-ac-role-cols] li::before {
    content: "";
    position: absolute;
    left: 0;
    top: 0.6em;
    width: 7px;
    height: 1px;
    background: var(--color-accent);
  }

  [data-ac-role-foot] {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 16px 24px;
    margin-top: clamp(20px, 2.2vw, 30px);
    padding-top: clamp(16px, 1.8vw, 22px);
    border-top: 1px solid var(--ac-line);
  }

  [data-ac-role-stack] {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  [data-ac-role-stack] li {
    padding: 5px 10px;
    border: 1px solid var(--ac-line);
    border-radius: 999px;
    color: rgb(10 16 34 / 0.65);
  }

  [data-ac-role-apply] {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 9px;
    min-height: 44px;
    padding: 0 20px;
    background: var(--color-accent);
    color: #fff;
    text-decoration: none;
    transition: background-color 0.2s ease;
  }

  [data-ac-role-apply]:hover {
    background: var(--color-accent-dark);
  }

  [data-ac-roles-empty] {
    margin: 0;
    padding: clamp(20px, 2vw, 28px);
    background: #fff;
    color: rgb(10 16 34 / 0.7);
  }

  [data-ac-roles-note] {
    margin: clamp(16px, 1.8vw, 24px) 0 0;
    font-size: 15px;
    color: rgb(10 16 34 / 0.65);
  }

  [data-ac-roles-note] a {
    color: var(--color-accent);
    font-weight: 500;
  }

  @media (max-width: 1099px) {
    [data-ac-role-head] {
      grid-template-columns: 30px minmax(0, 1fr) 28px;
      row-gap: 6px;
    }

    [data-ac-role-title] {
      grid-column: 2;
    }

    [data-ac-role-toggle] {
      grid-column: 3;
      grid-row: 1;
    }

    [data-ac-role-area],
    [data-ac-role-where],
    [data-ac-role-exp] {
      grid-column: 2 / -1;
    }

    [data-ac-role-body] {
      padding-left: clamp(18px, 2vw, 28px);
    }
  }

  @media (max-width: 699px) {
    [data-ac-role-cols] {
      grid-template-columns: 1fr;
    }

    [data-ac-role-apply] {
      width: 100%;
    }
  }

  /* Small phones: the collapsed rows carry the list's height, so the row
     padding tightens (the 44px tap target is kept by min-height). */
  @media (max-width: 560px) {
    [data-ac-role-head] {
      padding: 14px clamp(16px, 4vw, 20px);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    [data-ac-roles-chip],
    [data-ac-role-head],
    [data-ac-role-toggle],
    [data-ac-role-apply] {
      transition: none;
    }
  }
</style>

<script>
  import { toggleInView } from "@pg/page30/lib/in-view";

  document.querySelectorAll<HTMLElement>("[data-ac-roles]").forEach((section) => {
    toggleInView(section);

    const chips = section.querySelectorAll<HTMLButtonElement>("[data-ac-roles-chip]");
    const items = section.querySelectorAll<HTMLElement>("[data-ac-role-item]");
    const count = section.querySelector<HTMLElement>("[data-ac-roles-n]");
    const empty = section.querySelector<HTMLElement>("[data-ac-roles-empty]");

    chips.forEach((chip) => {
      chip.addEventListener("click", () => {
        const pick = chip.dataset.acRolesChip ?? "all";
        let shown = 0;
        chips.forEach((other) => other.setAttribute("aria-pressed", String(other === chip)));
        items.forEach((item) => {
          const match = pick === "all" || item.dataset.area === pick;
          item.hidden = !match;
          if (match) shown += 1;
        });
        if (count) count.textContent = String(shown);
        if (empty) empty.hidden = shown > 0;
      });
    });

    /* "Apply for this role" pre-selects the area in the application form and
       names the role in its message, unless the visitor has already typed. */
    section.querySelectorAll<HTMLAnchorElement>("[data-ac-role-apply]").forEach((link) => {
      link.addEventListener("click", () => {
        const form = document.querySelector<HTMLElement>(link.getAttribute("href") ?? "#apply");
        if (!form) return;
        const area = form.querySelector<HTMLSelectElement>("select[name='need']");
        const note = form.querySelector<HTMLTextAreaElement>("textarea[name='message']");
        if (area && link.dataset.area) area.value = link.dataset.area;
        if (note && !note.value.trim() && link.dataset.role) note.value = `Applying for: ${link.dataset.role}\n`;
      });
    });
  });
</script>
