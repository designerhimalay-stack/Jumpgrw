---
import Arrow from "@/components/icons/Arrow.astro";

/* The card that closes a legal page: who to write to with questions. Passed
   to ArticleBody as its children, so it ends the reading column. */

interface Props {
  title: string;
  body: string;
  email: string;
}

const { title, body, email } = Astro.props;
---

<aside data-ac-legal-contact>
  <p data-ac-legal-contact-title>{title}</p>
  <p data-ac-legal-contact-body>{body}</p>
  <a href={`mailto:${email}`} data-ac-legal-contact-link class="mono-label">
    {email}
    <Arrow direction="right" />
  </a>
</aside>

<style>
  [data-ac-legal-contact] {
    margin-top: clamp(44px, 5vw, 68px);
    padding: clamp(24px, 3vw, 36px);
    border: 1px solid rgb(80 122 247 / 0.22);
    border-radius: 12px;
    background: #f1f4fe;
  }

  [data-ac-legal-contact-title] {
    margin: 0 0 8px;
    font-family: var(--font-display-stack);
    font-size: clamp(22px, 2vw, 28px);
    line-height: 1.2;
    letter-spacing: -0.02em;
    color: #0a1022;
  }

  [data-ac-legal-contact-body] {
    margin: 0 0 20px;
    font-size: 16px;
    line-height: 1.6;
    color: rgb(10 16 34 / 0.72);
  }

  [data-ac-legal-contact-link] {
    display: inline-flex;
    align-items: center;
    gap: 9px;
    min-height: 44px;
    padding: 0 18px;
    background: var(--color-accent);
    color: #ffffff;
    text-decoration: none;
    overflow-wrap: anywhere;
    transition: background-color 0.2s ease;
  }

  [data-ac-legal-contact-link]:hover {
    background: var(--color-accent-dark);
  }

  [data-ac-legal-contact-link]:focus-visible {
    outline: 2px solid var(--color-accent);
    outline-offset: 2px;
  }

  @media (prefers-reduced-motion: reduce) {
    [data-ac-legal-contact-link] {
      transition: none;
    }
  }
</style>
