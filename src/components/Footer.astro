---
import { Image } from "astro:assets";
import GridRules from "@/components/GridRules.astro";
import RevealText from "@/components/RevealText.astro";
import { withBase } from "@/lib/paths";
import jumpgrowthLogoDark from "@/assets/jumpgrowth-logo-dark.webp";

/* Footer: the sign-off line set large across the columns, then the wordmark
   and three link columns on the same four-column grid as the page. Shared by
   every page: on the home page the section links scroll in-page, on any other
   page they jump to the home page and its anchor. See
   docs/components/cta-footer.md. */

const SIGN_OFF = ["The team", "behind the build."];

const COLUMNS = [
  {
    title: "Quick links",
    links: [
      { label: "Why JumpGrowth", href: "#why-agentcraft" },
      { label: "Case studies", href: withBase("/case-studies/") },
      { label: "Client stories", href: "#client-stories" },
      { label: "X-Shore", href: "#x-shore" },
      { label: "FAQ", href: withBase("/faq/") },
    ],
  },
  {
    title: "Team models",
    links: [
      { label: "MVP teams", href: withBase("/mvp-launch-teams/") },
      { label: "Production teams", href: withBase("/production-teams/") },
      { label: "Specialist developers", href: withBase("/specialist-developers/") },
      { label: "Team extension", href: withBase("/staff-augmentation/") },
    ],
  },
];

const ADDRESS = ["801 E Campbell Rd, Ste 365", "Richardson, TX 75081"];
const year = new Date().getFullYear();

const isHome = Astro.url.pathname.replace(/\/$/, "") === withBase("/").replace(/\/$/, "");
const fixHref = (href: string): string =>
  !isHome && href.startsWith("#") && href !== "#top" ? withBase(href) : href;
---

<footer data-ac-footer>
  <GridRules />

  <div data-ac-footer-inner>
    {/* The letters are aria-hidden for the reveal; a <p> can't carry an
        aria-label, so the sentence is read from a visually hidden copy. */}
    <p data-ac-footer-signoff>
      <span class="sr-only">{SIGN_OFF.join(" ")}</span>
      <span data-ac-footer-accent><RevealText text={SIGN_OFF[0]} /></span>
      {" "}
      <RevealText text={SIGN_OFF[1]} offset={Array.from(SIGN_OFF[0]).length + 1} />
    </p>

    <div data-ac-footer-grid>
      <div data-ac-footer-brand>
        <a href="#top" data-ac-footer-logo aria-label="JumpGrowth, back to top" class="inline-block">
          <Image
            src={jumpgrowthLogoDark}
            alt="JumpGrowth"
            class="h-[30px] w-auto object-contain"
            loading="lazy"
          />
        </a>
        <p>AI adds speed. People own the outcome.</p>
      </div>

      <nav data-ac-footer-col aria-label={COLUMNS[0].title}>
        <p class="mono-label">{COLUMNS[0].title}</p>
        <ul>
          {COLUMNS[0].links.map((link) => (
            <li><a href={fixHref(link.href)}>{link.label}</a></li>
          ))}
        </ul>
      </nav>

      <div data-ac-footer-col>
        <p class="mono-label">Headquarters</p>
        <address>
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="M12 21s-7-5.4-7-11a7 7 0 0 1 14 0c0 5.6-7 11-7 11Z" />
            <circle cx="12" cy="10" r="2.5" />
          </svg>
          <span>{ADDRESS.map((line, i) => (<Fragment>{i > 0 && <br />}{line}</Fragment>))}</span>
        </address>
      </div>

      <nav data-ac-footer-col aria-label={COLUMNS[1].title}>
        <p class="mono-label">{COLUMNS[1].title}</p>
        <ul>
          {COLUMNS[1].links.map((link) => (
            <li><a href={fixHref(link.href)}>{link.label}</a></li>
          ))}
        </ul>
      </nav>
    </div>

    <div data-ac-footer-base class="mono-label">
      <span>© <span data-ac-year>{year}</span> JumpGrowth. All rights reserved.</span>
      <a href="#top" data-ac-footer-top>
        Back to top
        <svg width="12" height="12" viewBox="0 0 16 16" fill="none" aria-hidden="true">
          <path d="M8 13V3M8 3L4 7M8 3L12 7" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" />
        </svg>
      </a>
    </div>
  </div>
</footer>

<script>
  import { toggleInView } from "@/lib/in-view";

  /* "#top" and the section links are handled by SmoothScroll. */
  toggleInView(document.querySelector<HTMLElement>("[data-ac-footer]")!);

  /* The year is written at build time; this keeps it current on a site that
     has not been rebuilt since the new year. */
  const yearEl = document.querySelector("[data-ac-year]");
  if (yearEl) yearEl.textContent = String(new Date().getFullYear());
</script>
