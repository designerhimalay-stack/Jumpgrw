---
import Arrow from "@/components/icons/Arrow.astro";
import GridRules from "@/components/GridRules.astro";
import SectionHead from "@/components/SectionHead.astro";
import Joints from "@/components/process/Joints.astro";
import { FAQS, type Faq } from "@/lib/faqs";

/* Frequently asked: the header holds its place on the left while the answers
   scroll past on the right. Native <details> sharing one name, so only one
   answer is open at a time and it all works without scripts. See
   docs/components/faq.md. By default it shows the company questions in
   src/lib/faqs.ts (the home page and /faq/); a page with questions of its own,
   like an industry page, passes them with its own headline. */

interface Props {
  faqs?: Faq[];
  eyebrow?: string;
  headline?: string[];
}

const {
  faqs = FAQS,
  eyebrow = "Frequently asked",
  headline = ["Straight answers", "about building", "your team."],
} = Astro.props;
const cta = "Ask a team specialist";

const pad = (n: number) => String(n).padStart(2, "0");
---

<section data-ac-sec="light" data-ac-faq id="faq">
  <GridRules />

  <div data-ac-sec-container data-ac-faq-layout>
    <div data-ac-faq-aside>
      <SectionHead eyebrow={`${eyebrow} / ${pad(faqs.length)}`} headline={headline} accent={headline.length - 1}>
        <a data-ac-faq-cta data-ac-sec-rise class="mono-label" href="#contact">
          {cta}
          <Arrow direction="diagonal" />
        </a>
      </SectionHead>
    </div>

    <div data-ac-sec-frame data-ac-faq-list>
      <Joints />
      {faqs.map((item, i) => (
        <details data-ac-faq-item name="faq" open={i === 0}>
          <summary data-ac-faq-question>
            <span data-ac-faq-number>{pad(i + 1)}</span>
            <span data-ac-faq-text>{item.q}</span>
            <span data-ac-faq-toggle aria-hidden="true" />
          </summary>
          <div data-ac-faq-answer>
            <p>{item.a}</p>
          </div>
        </details>
      ))}
    </div>
  </div>
</section>

<script>
  import { toggleInView } from "@/lib/in-view";

  toggleInView(document.querySelector<HTMLElement>("[data-ac-faq]")!);
</script>
