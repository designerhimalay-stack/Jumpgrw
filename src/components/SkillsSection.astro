---
import GridRules from "@/components/GridRules.astro";
import SectionHead from "@/components/SectionHead.astro";
import Joints from "@/components/process/Joints.astro";

/* The eight roles we staff, as a lattice on the page's four columns. Hover (or
   keyboard focus) lights a cell from the pointer, fills its icon tile, nudges
   the arrow and slides the name up to reveal what the role does. On touch
   screens the descriptions are simply shown. See docs/components/skills.md.

   Role names and descriptions are the brief's; the headline and lede are
   ours. Icons are drawn in the Feather style (MIT). */

const SKILLS = [
  {
    name: "Product Managers",
    body: "Shape the roadmap, coordinate decisions, and keep delivery tied to business outcomes.",
    icon: '<circle cx="12" cy="12" r="9"/><path d="m15.5 8.5-2 5-5 2 2-5 5-2Z"/>',
  },
  {
    name: "UX/UI Designers",
    body: "Turn user and product requirements into clear, useful digital experiences.",
    icon: '<path d="m12 19 7-7 3 3-7 7-3-3Z"/><path d="m18 13-1.5-7.5L2 2l3.5 14.5L13 18l5-5Z"/><path d="m2 2 7.6 7.6"/><circle cx="11" cy="11" r="2"/>',
  },
  {
    name: "Frontend Developers",
    body: "Build responsive, accessible interfaces across modern web stacks.",
    icon: '<rect x="2.5" y="4" width="19" height="16" rx="2"/><path d="M2.5 8.5h19"/><path d="m10 12.5-2 2 2 2"/><path d="m14 12.5 2 2-2 2"/>',
  },
  {
    name: "Backend Developers",
    body: "Design dependable services, APIs, data models, and integrations.",
    icon: '<rect x="3" y="3" width="18" height="7" rx="2"/><rect x="3" y="14" width="18" height="7" rx="2"/><path d="M7 6.5h.01M7 17.5h.01"/>',
  },
  {
    name: "Mobile Developers",
    body: "Create native and cross-platform applications for iOS and Android.",
    icon: '<rect x="6" y="2.5" width="12" height="19" rx="2.5"/><path d="M11 18h2"/>',
  },
  {
    name: "AI & ML Engineers",
    body: "Add intelligent features, automation, model integration, and evaluation.",
    icon: '<path d="M11 3.5 12.9 8.6 18 10.5l-5.1 1.9L11 17.5l-1.9-5.1L4 10.5l5.1-1.9L11 3.5Z"/><path d="m18.5 15 .8 2.2 2.2.8-2.2.8-.8 2.2-.8-2.2-2.2-.8 2.2-.8.8-2.2Z"/>',
  },
  {
    name: "QA Engineers",
    body: "Protect releases with manual, automated, performance, and functional testing.",
    icon: '<path d="M12 21.5s7.5-3.6 7.5-9.4V5.4L12 2.5 4.5 5.4v6.7c0 5.8 7.5 9.4 7.5 9.4Z"/><path d="m9 12 2.2 2.2L15.5 10"/>',
  },
  {
    name: "DevOps & Cloud Engineers",
    body: "Improve environments, deployment, observability, reliability, and scale.",
    icon: '<path d="M17.5 19H8a5.5 5.5 0 1 1 1.2-10.9A6 6 0 0 1 20.8 10 4.5 4.5 0 0 1 17.5 19Z"/><path d="m10.5 12.5-1.5 1.5 1.5 1.5M13.5 12.5l1.5 1.5-1.5 1.5"/>',
  },
];

const pad = (n: number) => String(n).padStart(2, "0");
---

<section data-ac-sec="light" data-ac-skills id="skills">
  <GridRules />

  <div data-ac-sec-container>
    <SectionHead
      eyebrow={`Skills / ${pad(SKILLS.length)}`}
      headline={["Every skill", "your product needs."]}
      accent={1}
      lede="Add one specialist or a full cross-functional team. Every role is matched to the work in front of you."
    />

    <ul data-ac-skills-grid>
      {SKILLS.map((skill, i) => (
        <li data-ac-skill style={`--i:${i}`}>
          <Joints />
          <a data-ac-skill-link href="#contact">
            <div data-ac-skill-top>
              <span data-ac-skill-number>{pad(i + 1)}</span>
              <svg data-ac-skill-arrow width="16" height="16" viewBox="0 0 16 16" fill="none" aria-hidden="true">
                <path d="M4.5 11.5L11.5 4.5M11.5 4.5H5.5M11.5 4.5V10.5" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" />
              </svg>
            </div>
            <span data-ac-skill-icon aria-hidden="true">
              <svg
                width="22"
                height="22"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="1.5"
                stroke-linecap="round"
                stroke-linejoin="round"
                set:html={skill.icon}
              />
            </span>
            <div data-ac-skill-copy>
              <h3 data-ac-skill-name>{skill.name}</h3>
              <div data-ac-skill-body>
                <p>{skill.body}</p>
              </div>
            </div>
          </a>
        </li>
      ))}
    </ul>
  </div>
</section>

<script>
  import { toggleInView } from "@/lib/in-view";

  const section = document.querySelector<HTMLElement>("[data-ac-skills]")!;

  /* The hover light follows the pointer across a cell. Without this it sits in
     the cell's centre. */
  section.querySelector("[data-ac-skills-grid]")!.addEventListener("pointermove", (event) => {
    const { clientX, clientY, target } = event as PointerEvent;
    const link = (target as Element).closest<HTMLElement>("[data-ac-skill-link]");
    if (!link) return;
    const box = link.getBoundingClientRect();
    link.style.setProperty("--mx", `${clientX - box.left}px`);
    link.style.setProperty("--my", `${clientY - box.top}px`);
  });

  toggleInView(section);
</script>
