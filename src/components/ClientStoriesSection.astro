---
import GridRules from "@/components/GridRules.astro";
import SectionHead from "@/components/SectionHead.astro";
import Joints from "@/components/process/Joints.astro";

/* "Teams that bring products to life." One client at a time: a YouTube video
   thumbnail, the quote, who said it, and a strip of all seven clients.
   Slides change ONLY on explicit user click — no auto-rotation.
   Clicking the thumbnail plays the video inline; YouTube's own controls
   handle play/pause. Switching slides kills the active video cleanly. */

type Story = { client: string; quote: string; name?: string; role: string; videoId: string };

const STORIES: Story[] = [
  {
    client: "SindyXR",
    quote: "They treated our XR roadmap like their own. Every sprint ended with something we could put in front of users.",
    role: "Founder",
    videoId: "b6_-fER-YCs",
  },
  {
    client: "GunLox",
    quote: "Security products leave no room for guesswork. The team shipped a companion app our customers trust from the first unlock.",
    role: "Head of Product",
    videoId: "SJ006Sre3Ns",
  },
  {
    client: "Steadfast",
    quote: "A steady, senior team that raised the quality bar early and kept it there, release after release.",
    role: "Engineering Director",
    videoId: "JFXWTm4BseA",
  },
  {
    client: "Ethnomet",
    quote:
      "Ethnomet's blend of telemedicine and digital health-as-a-service calls for product thinking that understands both technology and healthcare. JumpGrowth helped bring those worlds together.",
    name: "Mike Amanyi",
    role: "Chief Product Officer",
    videoId: "0c-BfY8DQes",
  },
  {
    client: "ShipITPro",
    quote: "We went from idea to production faster than we planned, without cutting corners on the parts that matter.",
    role: "CTO",
    videoId: "B50UV2k6hUY",
  },
  {
    client: "WakeSmart",
    quote: "Clear communication, honest estimates, and engineers who care about the product as much as we do.",
    role: "Product Manager",
    videoId: "mX5eZ_FTLWw",
  },
  {
    client: "DNAVibe",
    quote: "They understood the science and the software. That combination is rare, and it shows in the product.",
    role: "Co-founder",
    videoId: "ldhWd2TD2ic",
  },
];

const pad = (n: number) => String(n).padStart(2, "0");
---

<section data-ac-sec="light" data-ac-stories id="client-stories">
  <GridRules />

  <div data-ac-sec-container>
    <SectionHead eyebrow={`Client stories / ${pad(STORIES.length)}`} headline={["Teams that bring", "products to life."]} accent={1}>
      <div data-ac-stories-controls data-ac-sec-rise>
        <button type="button" data-ac-stories-step="-1" aria-label="Previous story">
          <svg width="16" height="16" viewBox="0 0 16 16" fill="none" aria-hidden="true">
            <path d="M13 8H3M3 8L7 4M3 8L7 12" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" />
          </svg>
        </button>
        <p data-ac-stories-count class="mono-label">
          <span><span data-ac-stories-current>01</span> / {pad(STORIES.length)}</span>
        </p>
        <button type="button" data-ac-stories-step="1" aria-label="Next story">
          <svg width="16" height="16" viewBox="0 0 16 16" fill="none" aria-hidden="true">
            <path d="M3 8H13M13 8L9 4M13 8L9 12" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" />
          </svg>
        </button>
      </div>
    </SectionHead>

    <div data-ac-sec-frame data-ac-stories-frame role="region" aria-roledescription="carousel" aria-label="Client stories">
      <div data-ac-stories-cell="photo">
        <Joints />
        <div data-ac-stories-photo>
          {STORIES.map((story, i) => (
            <figure
              data-ac-story-photo
              data-active={i === 0 || undefined}
              data-video-id={story.videoId}
            >
              <button
                type="button"
                data-ac-story-play
                aria-label={`Play ${story.client} testimonial video`}
              >
                {/* Starts at maxresdefault (1280x720, sharp on large screens).
                    The script steps it down to sddefault → hqdefault when a
                    video has no HD frame — see the quality fallback below. */}
                <img
                  src={`https://i.ytimg.com/vi/${story.videoId}/maxresdefault.jpg`}
                  alt={`${story.client} testimonial`}
                  width="1280"
                  height="720"
                  loading="lazy"
                  decoding="async"
                />
                <span data-ac-story-play-icon aria-hidden="true">
                  <svg width="80" height="56" viewBox="0 0 80 56" fill="none" xmlns="http://www.w3.org/2000/svg">
                    <rect width="80" height="56" rx="14" fill="#1a1a2e" fill-opacity="0.86"/>
                    <path d="M31 18L57 28L31 38V18Z" fill="white"/>
                  </svg>
                </span>
              </button>
            </figure>
          ))}
        </div>
      </div>

      <div data-ac-stories-cell="quote">
        <Joints />
        <svg data-ac-stories-mark width="32" height="24" viewBox="0 0 32 24" aria-hidden="true">
          <path
            fill="currentColor"
            d="M0 24V14.4C0 6.4 4.2 1.6 12.6 0l1.2 3.4C9.4 4.8 7.2 7.6 7 11.4h6.4V24H0Zm18.2 0V14.4C18.2 6.4 22.4 1.6 30.8 0L32 3.4c-4.4 1.4-6.6 4.2-6.8 8h6.4V24H18.2Z"
          />
        </svg>
        <div data-ac-stories-deck aria-live="off">
          {STORIES.map((story, i) => (
            <div
              data-ac-story
              data-active={i === 0 || undefined}
              role="group"
              aria-roledescription="slide"
              aria-label={`${i + 1} of ${STORIES.length}: ${story.client}`}
            >
              <blockquote data-ac-story-quote>
                <p>{story.quote}</p>
              </blockquote>
              <div data-ac-story-by>
                <span>
                  <span data-ac-story-name>{story.name ?? story.client}</span>
                  <span data-ac-story-role>{story.name ? `${story.role} · ${story.client}` : story.role}</span>
                </span>
              </div>
            </div>
          ))}
        </div>
      </div>

      <ol data-ac-stories-index>
        {STORIES.map((story, i) => (
          <li>
            <button type="button" data-ac-story-tab aria-current={i === 0 ? "true" : undefined}>
              <span data-ac-story-tab-number>{pad(i + 1)}</span>
              {story.client}
            </button>
          </li>
        ))}
      </ol>
    </div>
  </div>
</section>

<script>
  import { toggleInView } from "@/lib/in-view";
  import { holdOnKeyboardFocus } from "@/lib/rotation";

  const section = document.querySelector<HTMLElement>("[data-ac-stories]")!;
  const frame   = section.querySelector<HTMLElement>("[data-ac-stories-frame]")!;
  const deck    = section.querySelector<HTMLElement>("[data-ac-stories-deck]")!;
  const strip   = section.querySelector<HTMLElement>("[data-ac-stories-index]")!;
  const slides  = Array.from(section.querySelectorAll<HTMLElement>("[data-ac-story]"));
  const photos  = Array.from(section.querySelectorAll<HTMLElement>("[data-ac-story-photo]"));
  const tabs    = Array.from(section.querySelectorAll<HTMLElement>("[data-ac-story-tab]"));
  const counter = section.querySelector<HTMLElement>("[data-ac-stories-current]")!;
  const reduce  = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
  let active = 0;

  /* ── thumbnail quality fallback ──────────────────────────────────────────────
     YouTube serves a 120×90 gray placeholder (HTTP 200, not a 404) for
     maxresdefault when a video has no HD frame, so an onerror handler never
     fires. Detect it by the loaded width and step the src down the chain. */
  const THUMB_QUALITIES = ["maxresdefault", "sddefault", "hqdefault"];
  for (const photo of photos) {
    const img = photo.querySelector<HTMLImageElement>("img");
    const id = photo.dataset.videoId;
    if (!img || !id) continue;
    let qi = 0;
    const step = () => {
      if (qi >= THUMB_QUALITIES.length - 1) return;
      qi += 1;
      img.src = `https://i.ytimg.com/vi/${id}/${THUMB_QUALITIES[qi]}.jpg`;
    };
    img.addEventListener("error", step);
    img.addEventListener("load", () => {
      if (img.naturalWidth && img.naturalWidth <= 120) step();
    });
    if (img.complete && img.naturalWidth && img.naturalWidth <= 120) step();
  }

  /* ── video ───────────────────────────────────────────────────────────────── */

  /**
   * Stop the active video completely.
   *
   * Strategy: set src="about:blank" first — this is a *synchronous* browser
   * navigation that immediately destroys the iframe document, its JS heap, Web
   * Audio context and all media elements. Then wait one rAF (≈16 ms) before
   * removing the element from the DOM so the navigation has time to commit
   * before the node is detached. This is the only approach that reliably
   * silences cross-origin YouTube audio in every major browser.
   */
  function stopCurrentVideo() {
    const iframes = section.querySelectorAll<HTMLIFrameElement>("iframe");
    for (const iframe of iframes) {
      iframe.src = "about:blank";
      const photoEl = iframe.closest<HTMLElement>("[data-ac-story-photo]");
      photoEl?.removeAttribute("data-ac-playing");
      requestAnimationFrame(() => iframe.remove());
    }
  }

  /* Wire up every play button. The listener is permanent (no { once }) so the
     button works again after stopCurrentVideo() restores the thumbnail. */
  for (const photo of photos) {
    const playBtn = photo.querySelector<HTMLButtonElement>("[data-ac-story-play]");
    if (!playBtn) continue;

    playBtn.addEventListener("click", () => {
      if (photo.hasAttribute("data-ac-playing")) return;
      const videoId = photo.dataset.videoId;
      if (!videoId) return;

      stopCurrentVideo(); // silence any other video first

      photo.setAttribute("data-ac-playing", "");
      const iframe = document.createElement("iframe");
      /* No enablejsapi — we no longer listen to postMessage events */
      iframe.src   = `https://www.youtube-nocookie.com/embed/${videoId}?autoplay=1&rel=0&modestbranding=1`;
      iframe.title = playBtn.getAttribute("aria-label") ?? "Testimonial video";
      iframe.allow = "autoplay; encrypted-media; picture-in-picture";
      iframe.allowFullscreen = true;
      photo.appendChild(iframe);
    });
  }

  /* ── navigation (click-only, no auto-rotation) ───────────────────────────── */

  const show = (index: number) => {
    stopCurrentVideo(); // kill any playing/paused video before switching

    active = (index + slides.length) % slides.length;
    slides.forEach((s, i) => s.toggleAttribute("data-active", i === active));
    photos.forEach((p, i) => p.toggleAttribute("data-active", i === active));
    tabs.forEach((t, i) =>
      i === active
        ? t.setAttribute("aria-current", "true")
        : t.removeAttribute("aria-current")
    );
    counter.textContent = String(active + 1).padStart(2, "0");

    /* Keep active tab visible on the horizontal strip on small screens */
    if (strip.scrollWidth > strip.clientWidth) {
      const item = tabs[active].parentElement!;
      strip.scrollTo({
        left: item.offsetLeft - (strip.clientWidth - item.offsetWidth) / 2,
        behavior: reduce ? "auto" : "smooth",
      });
    }
  };

  for (const btn of section.querySelectorAll<HTMLElement>("[data-ac-stories-step]")) {
    btn.addEventListener("click", () => show(active + Number(btn.dataset.acStoriesStep)));
  }
  tabs.forEach((tab, i) => tab.addEventListener("click", () => show(i)));

  /* Announce the active slide to screen readers on keyboard focus */
  holdOnKeyboardFocus(section, frame, (on) =>
    deck.setAttribute("aria-live", on || reduce ? "polite" : "off")
  );
  if (reduce) deck.setAttribute("aria-live", "polite");

  toggleInView(section);
</script>
