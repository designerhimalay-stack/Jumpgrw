---
import GridRules from "@/components/GridRules.astro";
import SectionHead from "@/components/SectionHead.astro";
import Arrow from "@/components/icons/Arrow.astro";
import { withBase } from "@/lib/paths";

/* The shared lead form, placed before the footer on every page. Each page's
   form carries a hidden `source` (its path) so the CRM can tell which page a
   lead came from. The site is static: with FORM_ACTION set the form posts
   there; otherwise the script opens a mailto: to CONTACT_EMAIL with the brief.

   Replace CONTACT_PHONE with the number from the current JumpGrowth site, and
   set FORM_ACTION to the form service / CRM endpoint when there is one. */
const CONTACT_EMAIL = "hello@jumpgrowth.com";
const CONTACT_PHONE = "+1 (512) 837-2200";
const FORM_ACTION = "";

/* Hemant's options. "What do you need?" = type of team; "Preferred shore"
   replaces the old "When do you need help?". */
const TEAM_TYPES = [
  "New Launch (MVP)",
  "Small Team Extension",
  "Dev Pod (Scale)",
  "Single Developer",
  "Specialist Developers",
  "Not Sure Yet",
];
const SHORES = [
  "Onshore (USA)",
  "Nearshore (Mexico / Canada)",
  "Offshore (India)",
  "Hybrid",
  "Not Sure",
];

interface Props {
  id?: string;
  variant?: "team" | "paper";
  /** The white paper being requested (the "paper" variant). */
  paper?: string;
  eyebrow?: string;
  headline?: string[];
  body?: string;
  /** Opens the page: the navy hero field with the form in it (the Contact page). */
  hero?: boolean;
  /** The breadcrumb over a hero's headline. */
  trail?: string[];
  /** Short promises listed under the contact details (hero only). */
  promises?: string[];
}
const { id = "contact", variant = "team", paper = "", hero = false, trail = [], promises = [] } = Astro.props;
const request = variant === "paper";
const {
  eyebrow = request ? "Get the paper" : "Build your team",
  headline = request ? ["Request the", "white paper."] : ["Tell us what", "you’re building."],
  body = request
    ? "Tell us where to send it. We’ll email you the full paper and, if it helps, set up a call with the team that wrote it."
    : "Share where the roadmap is blocked and the capabilities you need. We’ll map a practical team and delivery model.",
} = Astro.props;

const source = Astro.url.pathname;
const tel = `tel:${CONTACT_PHONE.replace(/[^\d+]/g, "")}`;
const action = FORM_ACTION || `mailto:${CONTACT_EMAIL}`;
const f = (name: string) => `${id}-${name}`;
---

<section
  data-ac-sec={hero ? "dark" : "accent"}
  data-ac-contact
  data-ac-contact-hero={hero || undefined}
  id={id}
  data-email={CONTACT_EMAIL}
  data-has-action={FORM_ACTION ? "" : undefined}
>
  <GridRules />

  <div data-ac-sec-container data-ac-contact-grid>
    <div data-ac-contact-copy>
      {hero ? (
        <Fragment>
          {trail.length > 0 && (
            <nav data-ac-contact-trail class="mono-label" aria-label="Breadcrumb">
              <span aria-hidden="true">+</span>
              <ol>
                {trail.map((step, i) => (
                  <li aria-current={i === trail.length - 1 ? "page" : undefined}>{step}</li>
                ))}
              </ol>
            </nav>
          )}
          <h1 data-ac-contact-title aria-label={headline.join(" ")}>
            {headline.map((line, i) => (
              <Fragment>
                {i > 0 && <Fragment>{" "}<br aria-hidden="true" /></Fragment>}
                <span data-accent={i === headline.length - 1 || undefined}>{line}</span>
              </Fragment>
            ))}
          </h1>
        </Fragment>
      ) : (
        <SectionHead eyebrow={eyebrow} headline={headline} accent={headline.length - 1} />
      )}
      <div data-ac-sec-rise data-ac-contact-ways>
        <p data-ac-contact-body>{body}</p>
        <ul role="list">
          <li>
            <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <rect x="3" y="5" width="18" height="14" rx="2" /><path d="m3 7 9 6 9-6" />
            </svg>
            <a href={`mailto:${CONTACT_EMAIL}`}>{CONTACT_EMAIL}</a>
          </li>
          <li>
            <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <path d="M5 4h4l2 5-3 2a12 12 0 0 0 5 5l2-3 5 2v4a2 2 0 0 1-2 2A16 16 0 0 1 3 6a2 2 0 0 1 2-2Z" />
            </svg>
            <a href={tel}>{CONTACT_PHONE}</a>
          </li>
        </ul>
        {promises.length > 0 && (
          <ul data-ac-contact-promises role="list" aria-label="What to expect">
            {promises.map((promise) => (
              <li>
                <svg width="15" height="15" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                  <path d="M3 8.5l3.2 3L13 4.5" />
                </svg>
                {promise}
              </li>
            ))}
          </ul>
        )}
      </div>
    </div>

    <form
      data-ac-sec-frame
      data-ac-contact-form
      data-ac-sec-rise
      action={action}
      method="post"
      enctype={FORM_ACTION ? undefined : "text/plain"}
      data-subject={request ? "White paper" : "Team brief"}
    >
      <input type="hidden" name="source" value={source} />

      {request ? (
        <div data-ac-contact-fields>
          <div data-ac-field data-wide>
            <label for={f("need")}>White paper</label>
            <input id={f("need")} name="need" type="text" value={paper} readonly />
          </div>
          <div data-ac-field>
            <label for={f("name")}>Your name</label>
            <input id={f("name")} name="name" type="text" autocomplete="name" placeholder="Full name" required />
          </div>
          <div data-ac-field>
            <label for={f("email")}>Work email</label>
            <input id={f("email")} name="email" type="email" autocomplete="email" placeholder="you@company.com" required />
          </div>
          <div data-ac-field>
            <label for={f("company")}>Company <span>(optional)</span></label>
            <input id={f("company")} name="company" type="text" autocomplete="organization" placeholder="Company name" />
          </div>
          <div data-ac-field>
            <label for={f("phone")}>Phone <span>(optional)</span></label>
            <input id={f("phone")} name="phone" type="tel" autocomplete="tel" placeholder="Phone number" />
          </div>
        </div>
      ) : (
        <div data-ac-contact-fields>
          <div data-ac-field>
            <label for={f("name")}>Your name</label>
            <input id={f("name")} name="name" type="text" autocomplete="name" placeholder="Full name" required />
          </div>
          <div data-ac-field>
            <label for={f("company")}>Company <span>(optional)</span></label>
            <input id={f("company")} name="company" type="text" autocomplete="organization" placeholder="Company name" />
          </div>
          <div data-ac-field>
            <label for={f("email")}>Work email</label>
            <input id={f("email")} name="email" type="email" autocomplete="email" placeholder="you@company.com" required />
          </div>
          <div data-ac-field>
            <label for={f("phone")}>Phone <span>(optional)</span></label>
            <input id={f("phone")} name="phone" type="tel" autocomplete="tel" placeholder="Phone number" />
          </div>
          <div data-ac-field>
            <label for={f("need")}>What do you need?</label>
            <select id={f("need")} name="need" required>
              <option value="">Select one</option>
              {TEAM_TYPES.map((t) => <option>{t}</option>)}
            </select>
          </div>
          <div data-ac-field>
            <label for={f("shore")}>Preferred shore</label>
            <select id={f("shore")} name="shore">
              <option value="">Select one</option>
              {SHORES.map((s) => <option>{s}</option>)}
            </select>
          </div>
          <div data-ac-field data-wide>
            <label for={f("message")}>The role or skill you need <span>(optional)</span></label>
            <textarea id={f("message")} name="message" rows="3" placeholder="Share the role, tech stack or team gap"></textarea>
          </div>
        </div>
      )}

      <button type="submit" data-ac-contact-submit class="mono-label">
        {request ? "Send me the paper" : hero ? "Book my discovery call" : "Plan my team"}
        <Arrow direction="right" />
      </button>
      <p data-ac-form-status role="status" aria-live="polite" hidden></p>
      <p data-ac-contact-consent>
        By sending this form you agree to our <a href={withBase("/privacy-policy/")}>Privacy Policy</a> and <a href={withBase("/terms-of-use/")}>Terms of Use</a>.
      </p>
    </form>
  </div>
</section>

<style>
  [data-ac-contact-grid] {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1.05fr);
    gap: clamp(32px, 4vw, 64px);
    align-items: start;
  }

  [data-ac-contact-ways] {
    margin-top: clamp(20px, 2vw, 28px);
  }

  [data-ac-contact-body] {
    margin: 0 0 clamp(18px, 2vw, 26px);
    max-width: 42ch;
    font-size: clamp(15px, 1.15vw, 17px);
    line-height: 1.55;
    color: rgb(255 255 255 / 0.9);
  }

  [data-ac-contact-ways] ul {
    display: flex;
    flex-direction: column;
    gap: 0;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  [data-ac-contact-ways] li {
    display: flex;
    align-items: center;
    gap: 10px;
    color: rgb(255 255 255 / 0.75);
  }

  [data-ac-contact-ways] a {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    color: #fff;
    text-decoration: none;
    font-weight: 500;
  }

  [data-ac-contact-ways] a:hover {
    text-decoration: underline;
  }

  [data-ac-contact-form] {
    background: #fff;
    border-radius: 12px;
    padding: clamp(20px, 2.4vw, 34px);
    box-shadow: 0 24px 50px -30px rgb(10 16 34 / 0.5);
  }

  [data-ac-contact-fields] {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: clamp(14px, 1.4vw, 18px);
  }

  [data-ac-field] {
    display: flex;
    flex-direction: column;
    gap: 7px;
    min-width: 0;
  }

  [data-ac-field][data-wide] {
    grid-column: 1 / -1;
  }

  [data-ac-field] label {
    font-size: 13px;
    font-weight: 500;
    letter-spacing: -0.005em;
    color: #0a1022;
  }

  [data-ac-field] label span {
    color: rgb(10 16 34 / 0.45);
    font-weight: 400;
  }

  [data-ac-field] input,
  [data-ac-field] select,
  [data-ac-field] textarea {
    width: 100%;
    padding: 11px 13px;
    border: 1px solid rgb(10 16 34 / 0.16);
    border-radius: 8px;
    background: #fff;
    font: inherit;
    font-size: 15px;
    color: #0a1022;
    transition: border-color 0.18s, box-shadow 0.18s;
  }

  [data-ac-field] textarea {
    resize: vertical;
    min-height: 74px;
  }

  [data-ac-field] input::placeholder,
  [data-ac-field] textarea::placeholder {
    color: rgb(10 16 34 / 0.38);
  }

  [data-ac-field] input:focus-visible,
  [data-ac-field] select:focus-visible,
  [data-ac-field] textarea:focus-visible {
    outline: none;
    border-color: var(--color-accent);
    box-shadow: 0 0 0 3px color-mix(in srgb, var(--color-accent) 22%, transparent);
  }

  [data-ac-contact-submit] {
    display: inline-flex;
    align-items: center;
    gap: 9px;
    width: 100%;
    justify-content: center;
    margin-top: clamp(16px, 1.8vw, 22px);
    padding: 14px 20px;
    border: 0;
    background: var(--color-accent);
    color: #fff;
    cursor: pointer;
    transition: background 0.2s;
  }

  [data-ac-contact-submit]:hover {
    background: var(--color-accent-dark);
  }

  /* Messages: under a field when it needs fixing, and under the button once
     the form is sent (or can't be). Errors red, success green; both also
     announced to screen readers. The field messages are made by the script,
     so they carry no scoped-style attribute: :global reaches them. */
  [data-ac-field] :global([data-ac-field-error]) {
    margin: 0;
    font-size: 13px;
    line-height: 1.4;
    color: #c4262e;
  }

  [data-ac-field] [aria-invalid="true"] {
    border-color: #c4262e;
  }

  [data-ac-form-status] {
    margin: 14px 0 0;
    padding: 12px 14px;
    border-radius: 8px;
    font-size: 14px;
    line-height: 1.5;
  }

  [data-ac-form-status][data-kind="success"] {
    background: #eaf7ef;
    color: #14663a;
  }

  [data-ac-form-status][data-kind="error"] {
    background: #fdecec;
    color: #a1222a;
  }

  [data-ac-contact-consent] {
    margin: 12px 0 0;
    font-size: 13px;
    line-height: 1.5;
    text-align: center;
    color: rgb(10 16 34 / 0.55);
  }

  [data-ac-contact-consent] a {
    color: var(--color-accent);
  }

  /* As a page's opening: the subpage hero's navy field, the breadcrumb and a
     page-sized headline over the copy, the form in a white panel beside it. */
  [data-ac-contact-hero][data-ac-sec] {
    --ac-nav-h: 108px;
    padding-top: calc(var(--ac-nav-h) + clamp(32px, 6vh, 72px));
    padding-bottom: clamp(56px, 9vh, 110px);
    background:
      radial-gradient(55% 65% at 88% 18%, rgb(80 122 247 / 0.2), transparent 70%),
      linear-gradient(180deg, #000715 0%, #071127 34%, #0d1c41 74%, #132658 100%);
    overflow: clip;
  }

  [data-ac-contact-hero] [data-ac-contact-grid] {
    align-items: center;
  }

  @media (max-width: 767px) {
    [data-ac-contact-hero][data-ac-sec] {
      padding-top: var(--ac-hero-top, 92px);
    }
  }

  [data-ac-contact-trail] {
    display: flex;
    align-items: center;
    gap: 10px;
    margin: 0 0 clamp(18px, 3vh, 28px);
    color: var(--sec-muted);
  }

  [data-ac-contact-trail] > span {
    color: var(--color-accent);
  }

  [data-ac-contact-trail] ol {
    display: flex;
    flex-wrap: wrap;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  [data-ac-contact-trail] li + li::before {
    content: "/";
    margin: 0 8px;
    color: rgb(255 255 255 / 0.3);
  }

  [data-ac-contact-trail] li[aria-current] {
    color: #ffffff;
  }

  [data-ac-contact-title] {
    margin: 0;
    font-family: var(--font-display-stack);
    font-size: clamp(44px, 6vw, 92px);
    font-weight: var(--display-weight);
    line-height: 1;
    letter-spacing: -0.03em;
    color: #ffffff;
  }

  [data-ac-contact-title] [data-accent] {
    color: var(--color-accent);
  }

  [data-ac-contact-hero] [data-ac-contact-ways] {
    margin-top: clamp(22px, 3vh, 34px);
  }

  /* Written with the contact list's own prefix so its generic "ul" rule
     (no margin, no padding) doesn't flatten this list's spacing. */
  [data-ac-contact-ways] [data-ac-contact-promises] {
    display: flex;
    flex-direction: column;
    gap: 10px;
    margin: clamp(22px, 3vh, 32px) 0 0;
    padding: clamp(18px, 2.4vh, 24px) 0 0;
    list-style: none;
    border-top: 1px solid var(--ac-line);
  }

  [data-ac-contact-promises] li {
    display: flex;
    align-items: center;
    gap: 10px;
    font-size: 15px;
    color: rgb(255 255 255 / 0.82);
  }

  [data-ac-contact-promises] svg {
    flex: none;
    color: var(--color-accent);
  }

  @media (max-width: 860px) {
    [data-ac-contact-grid] {
      grid-template-columns: 1fr;
    }
  }

  @media (max-width: 479px) {
    [data-ac-contact-fields] {
      grid-template-columns: 1fr;
    }
  }
</style>

<script>
  import { toggleInView } from "@/lib/in-view";
  import { followHero } from "@/lib/nav-tone";

  document.querySelectorAll<HTMLElement>("[data-ac-contact]").forEach((section) => {
    toggleInView(section);

    /* Opening a page, the section sits under the fixed navbar, so the bar's
       tone follows it. */
    if (section.hasAttribute("data-ac-contact-hero")) followHero(section);

    const form = section.querySelector<HTMLFormElement>("[data-ac-contact-form]")!;
    const email = section.dataset.email ?? "";
    const status = form.querySelector<HTMLElement>("[data-ac-form-status]");
    type Field = HTMLInputElement | HTMLSelectElement | HTMLTextAreaElement;
    const fields = [...form.querySelectorAll<Field>("input:not([type=hidden]), select, textarea")];

    /* With scripts on, the form checks itself and explains each problem under
       its field (without scripts the browser's own checks still apply). */
    form.noValidate = true;

    const messageFor = (field: Field): string => {
      const v = field.validity;
      if (v.valid) return "";
      if (v.valueMissing) {
        if (field.name === "name") return "Please enter your name.";
        if (field.name === "email") return "Please enter your email address.";
        if (field instanceof HTMLSelectElement) return "Please choose an option.";
        return "Please fill in this field.";
      }
      if (v.typeMismatch && field.type === "email") return "Please enter a valid email address, like name@company.com.";
      return "Please check this field.";
    };

    const showError = (field: Field, message: string) => {
      const wrap = field.closest("[data-ac-field]");
      let note = wrap?.querySelector<HTMLElement>("[data-ac-field-error]");
      if (!message) {
        field.removeAttribute("aria-invalid");
        note?.remove();
        return;
      }
      if (!note && wrap) {
        note = document.createElement("p");
        note.setAttribute("data-ac-field-error", "");
        note.id = `${field.id}-error`;
        wrap.append(note);
      }
      if (note) note.textContent = message;
      field.setAttribute("aria-invalid", "true");
      field.setAttribute("aria-describedby", `${field.id}-error`);
    };

    const setStatus = (kind: "success" | "error" | "", message: string) => {
      if (!status) return;
      status.hidden = !message;
      status.dataset.kind = kind;
      status.textContent = message;
    };

    // A field that was flagged clears as soon as it's fixed.
    for (const field of fields) {
      const recheck = () => {
        if (field.hasAttribute("aria-invalid")) showError(field, messageFor(field));
      };
      field.addEventListener("input", recheck);
      field.addEventListener("change", recheck);
    }

    /* Returns true when every field is valid; otherwise marks each problem and
       moves focus to the first. */
    const validate = () => {
      let first: Field | null = null;
      for (const field of fields) {
        const message = messageFor(field);
        showError(field, message);
        if (message && !first) first = field;
      }
      if (first) {
        setStatus("error", "Please fix the highlighted fields and send again.");
        first.focus();
        return false;
      }
      return true;
    };

    /* With a form service set, the form posts in the background and says
       whether it arrived. */
    if (section.hasAttribute("data-has-action")) {
      form.addEventListener("submit", async (event) => {
        event.preventDefault();
        if (!validate()) return;
        const button = form.querySelector<HTMLButtonElement>("[data-ac-contact-submit]");
        if (button) button.disabled = true;
        setStatus("", "");
        try {
          const response = await fetch(form.action, { method: "POST", body: new FormData(form), headers: { Accept: "application/json" } });
          if (!response.ok) throw new Error(String(response.status));
          form.reset();
          setStatus("success", "Thank you. Your details have reached our team, and a specialist will be in touch.");
        } catch {
          setStatus("error", `Sorry, the form didn't send. Please try again, or email us at ${email}.`);
        } finally {
          if (button) button.disabled = false;
        }
      });
      return;
    }

    form.addEventListener("submit", (event) => {
      event.preventDefault();
      if (!validate()) return;
      const lines: string[] = [];
      form.querySelectorAll<HTMLInputElement | HTMLSelectElement | HTMLTextAreaElement>("input, select, textarea").forEach((field) => {
        if (field.type === "hidden") {
          if (field.value.trim()) lines.push(`Page: ${field.value.trim()}`);
          return;
        }
        const label = form.querySelector(`label[for="${field.id}"]`)?.firstChild?.textContent?.trim() ?? field.name;
        if (field.value.trim()) lines.push(`${label}: ${field.value.trim()}`);
      });
      const need = form.querySelector<HTMLSelectElement>("select[name='need']")?.value ?? "";
      const prefix = form.dataset.subject ?? "Team brief";
      const subject = encodeURIComponent(need ? `${prefix}: ${need}` : prefix);
      window.location.href = `mailto:${email}?subject=${subject}&body=${encodeURIComponent(lines.join("\n"))}`;
      setStatus(
        "success",
        `Thank you. Your email app is opening with your details filled in. Send that email to reach our team, or write to ${email}.`,
      );
    });
  });
</script>
