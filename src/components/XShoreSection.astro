---
import { Image } from "astro:assets";
import type { ImageMetadata } from "astro";
import RevealText from "@/components/RevealText.astro";
import Joints from "@/components/process/Joints.astro";
import { REFERENCE_TZ, clock, isWorking, tileState, tilesSummary, type Zone, type ZoneTile } from "@/lib/timezones";
import zoneUs from "@/assets/xshore/zone-us.jpg";
import zoneCanada from "@/assets/xshore/zone-canada.jpg";
import zoneMexico from "@/assets/xshore/zone-mexico.jpg";
import zoneIndia from "@/assets/xshore/zone-india.jpg";

/* Three delivery regions, and one working day across four locations. The
   clocks, the tiles and the summary are live: the script below redraws them
   from the visitor's clock. What renders here is computed with the same
   helpers at build time, so the page is complete without it. See
   docs/components/xshore.md. */

const COPY = {
  eyebrow: "X-Shore delivery",
  headline: ["One team.", "Three talent regions."],
  lede: "Choose one region or combine all three. We design the team around collaboration, capability, continuity, and the work—not a one-size-fits-all location rule.",
  caption: "One operating rhythm · Multiple time zones",
};

/* The city clocks on each region card. */
const ZONES: Zone[] = [
  { id: "dallas", city: "Dallas", region: "onshore", tz: REFERENCE_TZ },
  { id: "toronto", city: "Toronto", region: "nearshore", tz: "America/Toronto" },
  { id: "mexico-city", city: "Mexico City", region: "nearshore", tz: "America/Mexico_City" },
  { id: "delhi", city: "Delhi", region: "offshore", tz: "Asia/Kolkata" },
  { id: "pune", city: "Pune", region: "offshore", tz: "Asia/Kolkata" },
];

/* The four location tiles. */
const TILES: (ZoneTile & { region: string; image: ImageMetadata; alt: string })[] = [
  { tz: REFERENCE_TZ, place: "United States", region: "Onshore", image: zoneUs, alt: "A product lead walking a team through a sticky-note plan at a workshop" },
  { tz: "America/Toronto", place: "Canada", region: "Nearshore", image: zoneCanada, alt: "Two developers pairing on a change at a laptop in an open office" },
  { tz: "America/Mexico_City", place: "Mexico", region: "Nearshore", image: zoneMexico, alt: "A team of engineers in headphones working at laptops around a shared table" },
  { tz: "Asia/Kolkata", place: "India", region: "Offshore", abbr: "IST", image: zoneIndia, alt: "A developer coding on a laptop late in a dimly lit room" },
];

const REGIONS = [
  {
    key: "onshore",
    number: "01",
    label: "Onshore",
    title: "United States",
    body: "Local product and technical leadership for close stakeholder alignment, workshops, and high-context collaboration.",
  },
  {
    key: "nearshore",
    number: "02",
    label: "Nearshore",
    title: "Mexico + Canada",
    body: "Experienced teammates with strong working-hour overlap for planning, pairing, review, and daily delivery.",
  },
  {
    key: "offshore",
    number: "03",
    label: "Offshore",
    title: "India",
    body: "Deep engineering capacity, specialist access, and extended delivery coverage for sustained product execution.",
  },
];

const now = new Date();
const refClock = clock(REFERENCE_TZ, now);
const summary = tilesSummary(TILES, now);
---

<section data-ac-xshore id="x-shore">
  <div data-ac-grid-rules aria-hidden="true">
    <span />
    <span />
    <span />
    <span />
    <span />
  </div>

  <div data-ac-xshore-container>
    <div data-ac-xshore-head>
      <p data-ac-xshore-eyebrow class="mono-label">
        <span aria-hidden="true">+</span>
        {COPY.eyebrow}
      </p>
      <h2 data-ac-xshore-headline aria-label={`${COPY.headline[0]} ${COPY.headline[1]}`}>
        <RevealText text={COPY.headline[0]} />
        <br aria-hidden="true" />
        <span data-ac-xshore-accent>
          <RevealText text={COPY.headline[1]} offset={Array.from(COPY.headline[0]).length + 1} />
        </span>
      </h2>
      <p data-ac-xshore-lede>{COPY.lede}</p>
    </div>

    <div data-ac-xshore-frame>
      <div data-ac-frame-head data-ac-xshore-caption>
        <Joints />
        {/* Split at the dot so phones can set each phrase on its own line. */}
        <p class="mono-label">
          {COPY.caption.split(" · ").map((phrase, i) => (
            <Fragment>{i > 0 && <span data-ac-xshore-sep> · </span>}<span data-ac-xshore-phrase>{phrase}</span></Fragment>
          ))}
        </p>
        <p class="mono-label" data-ac-xshore-now>
          <span aria-hidden="true" data-ac-xshore-pulse />
          Dallas <time data-ac-clock={REFERENCE_TZ}>{refClock.time}</time> <span data-ac-clock-zone={REFERENCE_TZ}>{refClock.zone}</span>
        </p>
      </div>

      <div data-ac-xshore-cell="photo">
        <Joints />
        <div data-ac-xshore-photo>
          <div data-ac-xshore-zones>
            {TILES.map((tile) => {
              const state = tileState(tile, now);
              return (
                <figure
                  data-ac-xshore-zone
                  data-tz={tile.tz}
                  data-place={tile.place}
                  data-abbr={tile.abbr}
                  data-working={state.on || undefined}
                >
                  <Image
                    src={tile.image}
                    alt={tile.alt}
                    widths={[360, 540, 900]}
                    sizes="(max-width: 1199px) 50vw, 25vw"
                    quality={78}
                  />
                  <div data-ac-xshore-zone-top>
                    <span data-ac-xshore-zone-region class="mono-label">{tile.region}</span>
                    <span data-ac-xshore-zone-status class="mono-label">
                      <i aria-hidden="true" />
                      <span data-status>{state.on ? "Working" : "Off hours"}</span>
                    </span>
                  </div>
                  <figcaption data-ac-xshore-zone-bottom>
                    <span data-ac-xshore-zone-place>{tile.place}</span>
                    <span data-ac-xshore-zone-time>
                      <time data-time>{state.time}</time><span data-ampm>{state.ampm}</span><span data-ac-xshore-zone-abbr data-abbr-text>{state.abbr}</span>
                    </span>
                    <span data-ac-xshore-zone-day aria-hidden="true">
                      <span data-ac-xshore-zone-shift />
                      <span data-ac-xshore-zone-now data-now style={`--now: ${state.now}%`} />
                    </span>
                    <span data-ac-xshore-zone-note data-note>{state.note}</span>
                  </figcaption>
                </figure>
              );
            })}
          </div>

          {/* The point the four make together, live. */}
          <dl data-ac-xshore-sum>
            <div>
              <dt class="mono-label">Teams working now</dt>
              <dd><strong data-working-count>{summary.working}</strong> of {TILES.length}</dd>
            </div>
            <div>
              <dt class="mono-label">Covered every day</dt>
              <dd><strong data-coverage>{summary.coverage}</strong> of 24</dd>
            </div>
            <div>
              <dt class="mono-label" data-next-label>{summary.nextLabel}</dt>
              <dd><strong data-next>{summary.next}</strong></dd>
            </div>
          </dl>
        </div>
      </div>

      {REGIONS.map((region) => (
        <article data-ac-xshore-cell="region" data-region={region.key}>
          <Joints />
          <div data-ac-xshore-region>
            <div data-ac-xshore-region-top>
              <p data-ac-xshore-label class="mono-label">
                <span data-ac-frame-number>{region.number}</span>
                {region.label}
              </p>
              <ul data-ac-xshore-clocks>
                {ZONES.filter((zone) => zone.region === region.key).map((zone) => (
                  <li>
                    <span data-ac-xshore-dot data-ac-zone-tz={zone.tz} data-working={isWorking(zone.tz, now) || undefined} aria-hidden="true" />
                    {zone.city}
                    <time data-ac-clock={zone.tz}>{clock(zone.tz, now).time}</time>
                  </li>
                ))}
              </ul>
            </div>
            <h3 data-ac-xshore-title>{region.title}</h3>
            <p data-ac-xshore-body>{region.body}</p>
          </div>
        </article>
      ))}
    </div>
  </div>
</section>

<script>
  import { clock, isWorking, tileState, tilesSummary, type ZoneTile } from "@/lib/timezones";

  const section = document.querySelector<HTMLElement>("[data-ac-xshore]")!;
  const tiles = Array.from(section.querySelectorAll<HTMLElement>("[data-ac-xshore-zone]")).map((el) => ({
    el,
    tile: { tz: el.dataset.tz!, place: el.dataset.place!, abbr: el.dataset.abbr } satisfies ZoneTile,
  }));
  const set = (selector: string, text: string) => {
    const el = section.querySelector(selector);
    if (el) el.textContent = text;
  };

  /* Redraws the clocks, the working dots, the four tiles and their summary.
     Cheap, so it simply runs on a timer. */
  const draw = () => {
    const now = new Date();
    for (const el of section.querySelectorAll<HTMLElement>("[data-ac-clock]")) {
      el.textContent = clock(el.dataset.acClock!, now).time;
    }
    for (const el of section.querySelectorAll<HTMLElement>("[data-ac-clock-zone]")) {
      el.textContent = clock(el.dataset.acClockZone!, now).zone;
    }
    for (const dot of section.querySelectorAll<HTMLElement>("[data-ac-xshore-dot]")) {
      dot.toggleAttribute("data-working", isWorking(dot.dataset.acZoneTz!, now));
    }
    for (const { el, tile } of tiles) {
      const state = tileState(tile, now);
      el.toggleAttribute("data-working", state.on);
      el.querySelector("[data-time]")!.textContent = state.time;
      el.querySelector("[data-ampm]")!.textContent = state.ampm;
      el.querySelector("[data-abbr-text]")!.textContent = state.abbr;
      el.querySelector<HTMLElement>("[data-now]")!.style.setProperty("--now", `${state.now}%`);
      el.querySelector("[data-status]")!.textContent = state.on ? "Working" : "Off hours";
      el.querySelector("[data-note]")!.textContent = state.note;
    }
    const summary = tilesSummary(tiles.map(({ tile }) => tile), now);
    set("[data-working-count]", String(summary.working));
    set("[data-coverage]", summary.coverage);
    set("[data-next-label]", summary.nextLabel);
    set("[data-next]", summary.next);
  };

  draw();
  window.setInterval(draw, 30_000);

  /* Reversible entrance, as in the other sections: the header fills in on
     approach and resets on the way out. */
  new IntersectionObserver(
    ([entry]) => section.toggleAttribute("data-ac-in", entry.isIntersecting),
    { threshold: 0, rootMargin: "-10% 0px -10% 0px" },
  ).observe(section);
</script>
